ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): a virtual base initialized by the most derived class
; (M : L, L : virtual V, V(int)): the complete constructor runs the vbase
; MEMINIT, the base constructors never do.  Delegating and default constructors.
;   struct V { int v; V(int); virtual ~V(); };
;   struct L : virtual V { L(); L(int); };  struct M : L { M(); };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1LC2Ev(%arg0: !cir.ptr<!rec_L>, %arg1: !cir.ptr<!cir.ptr<!void>>)
; CHECK-LABEL: cir.func {{.*}}@_ZN1MC1Ev(
; CHECK: cir.call @_ZN1VC2Ei(
; CHECK: cir.vtt.address_point @_ZTT1M, offset = 1
; CHECK: cir.call @_ZN1LC2Ei(
; CHECK: cir.global {{.*}}@_ZTC1M0_1L = #cir.vtable<

