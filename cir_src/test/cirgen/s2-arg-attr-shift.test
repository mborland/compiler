  LOAD 0
  CAST 0 3
  ADD 1
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION supp
  TY_VOID 15
  STR 18 "V"
  TY_RECORD_DECL 16 0 18
  TY_PTR 17 16
  TY_FUNC 18 15 0 [17, 7] supp{15: 6}
  TY_VPTR 19
  TY_RECORD_BODY 16 16 12 8 4 2
  REC_FIELD 19 0 nil nil nil 1
  REC_FIELD 5 8 nil nil nil 65
  STR 19 "1V"
  CLASS_MANGLE 16 19
  CLASS_INFO 16 8 8 nil 0
  CLASS_BASES 16 [1, 1]
  STR 20 "_ZN1VC1ERi"
  DECL_FUNC 20 18 0 0 20
  STR 21 "_ZN1VC2ERi"
  DECL_FUNC 21 18 0 0 21
  STRUCTOR 20 21 2
  DECL_FUNC 20 18 0 1 20
  DECL_FUNC 21 18 0 1 21
  CLASS_VFUNCS 16 []
  CLASS_OVERRIDES 16 []
  FUNC_BEGIN 20 0
  PARAM 1 17 17 12 1
  PARAM 2 7 7 13 0
  VPTR_INIT
  BLOCK_BEGIN
  LOCAL 3 1 nil 0 0
  LREF 3
  LREF 2
  LOAD 0
