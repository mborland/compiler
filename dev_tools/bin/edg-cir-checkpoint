#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Run a slice checkpoint of the CIR back end on the x86-64 box.

Run it on the Mac, from the repository root.  The host is $EDG_CIR_HOST
(default matt@clang4.cpp.al) and the ssh key $EDG_CIR_SSH_KEY (default
~/.ssh/id_rsa); ssh and rsync run with -o BatchMode=yes -i <key>.  An open SSH
master socket is used only if $EDG_CIR_SSH_SOCKET names it (the old
workflow's EDG_BOX_SOCKET is ignored: a stale socket of the retired box would
send rsync --delete there), and the box must report the host name
$EDG_CIR_HOSTNAME (default clang4) before anything is synced.  Docker runs
directly (the user is in the docker group); set EDG_CIR_SG_DOCKER=1 to run it through
`sg docker -c` as the old box needed:

  edg-cir-checkpoint                # sync, clean build, the default steps
  edg-cir-checkpoint --quick        # build, smoke, cpp-smoke only
  edg-cir-checkpoint --steps build,ctest --detach
  edg-cir-checkpoint --lean toolchain --lean-base HEAD --tree m6r-int
  edg-cir-checkpoint --milestone --tree m6r-int --detach
  edg-cir-checkpoint --milestone --check-baselines   # list what it needs
  edg-cir-checkpoint --tree m6r-int --prune 3 --quick

It does, in this order:

  0. prints the free disk space of the box (a warning under 40 GB) and, with
     --prune N, deletes all but the newest N of the tests/runs/* and
     .tmp/checkpoint-* directories of the tree (--prune-only does just that;
     --prune-evidence adds .tmp/gate-{evidence,asm,cpp-asm,identity,perf}/*).
     Never pruned: the trees day-base and m5-int (the baselines and the
     evidence they came from), a tree with a file KEEP, an entry with a file KEEP, an entry younger than 6
     hours or one that a process uses.
  1. rsync --checksum --no-times of the working tree to ~/edg-cir-config/<tree>
     on the box (default tree m6r-int; build/, tests/runs/, .tmp/ and .git/
     are not touched).  --no-times gives changed files the time of the
     transfer: with `rsync -a` a changed source can keep a time older than
     the objects of an earlier build, and ninja then rebuilds nothing.  The
     sync deletes files of the box tree that this tree lacks (--delete),
     except in a protected tree (see PROTECTED_TREES: day-base, m5-int) and in
     a tree with a KEEP file, which are only added to.  A protected tree is
     also never synced into or wiped (step 2) unless --allow-protected: a
     sync overwrites its sources, the wipe removes its CIR build directories,
     and it holds the baselines and the evidence they came from (use
     --no-sync --incremental to run in it as it is).
  2. wipes the CIR build directories (build/cir, build/cir-*, build/gcc-cir,
     build/gcc-release-cir), unless --incremental.
  3. runs edg-cir-gate-evidence there with the chosen steps, in the
     background (nohup, with an exit file), and polls until it is done.  The
     gate runs every container command under `nice -n 10` (EDG_DOCKER_NICE,
     which edgdocker applies inside the container) with --jobs as the cap of
     the build, test and lit jobs.
  4. prints the PASS/FAIL table and the paths of the evidence.

The default steps are:

  build identity smoke corpus asm-diff writer-stress cpp-smoke
  cpp-writer-stress crash-sweep ctest

that is the C smoke and corpus (statuses against the recorded expectations),
the C assembly against the M5 baseline (--asm-baseline, default
~/edg-cir-config/m6r-base-asm: every difference is listed with its class and
cause; the frame description directives (.cfi_*) are ignored from S1 on,
when every function gets unwind tables: --no-asm-normalize-cfi shows them;
personality, lsda and escape directives stay visible), the ASan
debug front end with ECIL_GID_STRESS over the writer tests, the C++ smoke list
in both configs (a crash fails; with --smoke-all-pass every test must pass),
the crash sweep (every test type of both corpora, eh/, rtti/ and cir/ through
edg_x86_64_cir: only crashes, kills and timeouts that the reference does not
have are gated, against the allowlist tests/.edgy/filters/
cir-excused-crashes.txt), and the four cir_src presets from clean build
directories.  About 25 minutes.  Day, stress, rss, perf, modes, cpp-corpus,
cpp-modes and cpp-asm-diff (the C++ assembly against --cpp-asm-baseline,
default ~/edg-cir-config/m6r-base-cpp-asm, made with the corpus filter
that includes eh/ and rtti/) are left for the gates; name them
with --steps (they exist in the gate tool).

With --lean AREAS the steps come from edg-cir-gate-evidence --lean (its
docstring has the area mapping), and the areas are first checked, before
anything is synced, against the files that differ from --lean-base (default
HEAD, plus the untracked files); a change set that the areas do not cover is
refused, and so is an empty change set (--allow-empty-change-set).  The list
of files goes to the evidence directory (changed-files.txt; a failed upload
stops the run) and the gate checks it again.

Every run records a tree fingerprint (a hash of src, cir_src, dev_tools/bin,
tests/.edgy and cmake, without build directories) of this tree and of the box
tree in fingerprint.txt and at the top of summary.md of the evidence
directory.  It syncs again (up to three times) if this tree changes while it
is synced, and refuses to run (status 2) if the box tree is not this tree,
which with --no-sync means a stale box tree; --allow-stale runs anyway and
records "STALE".

Exit status: 0 if every step passed, 1 otherwise (2 for a setup problem).
'''

import argparse
import hashlib
import os
import re
import shlex
import subprocess
import sys
import time

from datetime import datetime
from pathlib import Path
from typing import List

BOX = os.environ.get('EDG_CIR_HOST', 'matt@clang4.cpp.al')
SSH_KEY = os.environ.get('EDG_CIR_SSH_KEY', '~/.ssh/id_rsa')
SOCKET = os.environ.get('EDG_CIR_SSH_SOCKET', '')
# The host name (`hostname -s`) that the box must report before a sync.
EXPECTED_HOSTNAME = os.environ.get('EDG_CIR_HOSTNAME', 'clang4')
SG_DOCKER = os.environ.get('EDG_CIR_SG_DOCKER', '') not in ('', '0')
# The default tree is wiped and rebuilt by every checkpoint; the trees that
# hold baselines or the evidence they came from are not (see PROTECTED_TREES).
DEFAULT_TREE = 'm6r-int'
LOW_DISK_GB = 40
DEFAULT_STEPS = ('build,identity,smoke,corpus,asm-diff,writer-stress,'
                 'cpp-smoke,cpp-writer-stress,crash-sweep,ctest')
QUICK_STEPS = 'build,smoke,cpp-smoke'
EXCLUDES = ['/build/', '/tests/runs/', '/.tmp/', '/cmake-build-debug/',
            '/.idea/', '/.mypy_cache/', '/dev-pref.json', '/.git/',
            '/boost-bug-*.md', '/monthly_report/', '/*.int.c', '/*.ti',
            '__pycache__/', '.DS_Store']


# The tree fingerprint: a hash over the files that decide what a checkpoint
# tests (src, cir_src, dev_tools/bin, tests/.edgy and cmake; not build
# directories, caches or runs), so that a run on a stale tree is caught.
FINGERPRINT_DIRS = ('src', 'cir_src', 'dev_tools/bin', 'tests/.edgy',
                    'cmake')
FINGERPRINT_SKIP = ('build', '.tmp', '__pycache__', '.git', '.DS_Store')
FINGERPRINT_SOURCE = '''
import hashlib, os, sys
root = sys.argv[1]
dirs = %r
skip = %r
lines = []
for top in dirs:
  for base, names, files in os.walk(os.path.join(root, top)):
    names[:] = sorted(n for n in names if n not in skip)
    for name in sorted(files):
      path = os.path.join(base, name)
      if name in skip or name.endswith('.pyc') or os.path.islink(path):
        continue
      digest = hashlib.sha256(open(path, 'rb').read()).hexdigest()
      lines.append('%%s %%s' %% (os.path.relpath(path, root), digest))
lines.sort()
print(hashlib.sha256('\\n'.join(lines).encode()).hexdigest(), len(lines))
''' % (FINGERPRINT_DIRS, FINGERPRINT_SKIP)


def local_fingerprint(root: Path) -> str:
  '''"<hash> <number of files>" of a tree on this machine.'''
  import subprocess as sp
  proc = sp.run([sys.executable, '-c', FINGERPRINT_SOURCE, str(root)],
                stdout = sp.PIPE, text = True, check = True)
  return proc.stdout.strip()


def ssh_options() -> List[str]:
  '''The ssh options: batch mode and the key, and the master socket if
  EDG_CIR_SSH_SOCKET names one.'''
  options = ['-o', 'BatchMode=yes', '-i', str(Path(SSH_KEY).expanduser())]
  if SOCKET:
    options += ['-o', f"ControlPath={Path(SOCKET).expanduser()}",
                '-o', 'ControlMaster=no']
  return options


def ssh_command() -> str:
  '''The ssh command for rsync's -e.'''
  return shlex.join(['ssh', *ssh_options()])


def docker_wrap(command: str) -> str:
  '''The shell command that runs `command` as a user that can run docker:
  directly, or through `sg docker -c` with EDG_CIR_SG_DOCKER=1.'''
  return f"sg docker -c {shlex.quote(command)}" if SG_DOCKER else command


def hostname_problem(reported: str) -> str:
  '''"" if `reported` (the output of `hostname -s` on the box) is the
  expected host, else the message.  A stale ssh ControlPath sends a command to
  another host whatever name was given, and the sync below deletes files.'''
  reported = (reported.strip().splitlines() or [''])[-1]
  if reported == EXPECTED_HOSTNAME:
    return ''
  return (f"the host answers as {reported!r}, not {EXPECTED_HOSTNAME!r} "
          f"(EDG_CIR_HOST={BOX}; a stale ssh ControlPath? "
          f"EDG_CIR_HOSTNAME names another expected host)")


def box_reachable() -> bool:
  '''Whether the box answers (the master socket's check, or a plain ssh).'''
  if SOCKET:
    command = ['ssh', '-O', 'check', *ssh_options(), BOX]
  else:
    command = ['ssh', *ssh_options(), '-o', 'ConnectTimeout=15', BOX, 'true']
  return subprocess.run(command, stdout = subprocess.DEVNULL,
                        stderr = subprocess.DEVNULL).returncode == 0


# Directories of a tree of which --prune keeps the newest few (relative to
# the tree; each entry of them is one run or one checkpoint).  The evidence
# directories of the gates are pruned only with --prune-evidence.
PRUNE_DIRS = ('tests/runs',)
EVIDENCE_DIRS = ('.tmp/gate-evidence', '.tmp/gate-asm', '.tmp/gate-cpp-asm',
                 '.tmp/gate-identity', '.tmp/gate-perf')
# Trees that are never pruned (the gate evidence is kept in them); any tree
# or entry that holds a file named KEEP is not pruned either.
PROTECTED_TREES = ('day-base', 'm5-int')


def protected_refusal(tree: str, protected: bool, no_sync: bool,
                      incremental: bool, allowed: bool,
                      prune_only: bool = False,
                      check_baselines: bool = False) -> str:
  '''Why this run must not touch the protected tree `tree` ('' if it may):
  a sync overwrites its sources (even without --delete) and, unless
  `incremental`, the run removes its CIR build directories; both need
  `allowed` (--allow-protected).  A pruning run and a run in an unprotected
  tree are never refused; --check-baselines wipes nothing.'''
  actions = []
  if protected and not allowed and not prune_only:
    if not no_sync:
      actions.append('overwrite its sources (rsync)')
    if not incremental and not check_baselines:
      actions.append('remove its build/cir* directories')
  if not actions:
    return ''
  return (f"{tree} is a protected tree (it holds baselines or the evidence "
          f"they came from): this run would {' and '.join(actions)}; "
          f"--allow-protected says that is meant, or use --no-sync "
          f"--incremental to run in it as it is")


def rsync_command(tree: str, protected: bool) -> List[str]:
  '''The rsync command that syncs this tree to `tree` on the box; it
  deletes files there (--delete) except in a protected tree, which keeps
  every file it has (the baselines and the evidence they came from).'''
  command = ['rsync', '-az', '--checksum', '--no-times']
  if not protected:
    command.append('--delete')
  command += ['-e', ssh_command()]
  for exclude in EXCLUDES:
    command += ['--exclude', exclude]
  return command + ['./', f"{BOX}:edg-cir-config/{tree}/"]
RECENT_MINUTES = 360


def prune_command(keep: int, evidence: bool = False,
                  recent: int = RECENT_MINUTES) -> str:
  '''The shell command (run in the tree) that deletes all but the newest
  `keep` entries of PRUNE_DIRS, of .tmp/checkpoint-* and, with `evidence`, of
  EVIDENCE_DIRS.  An entry is kept, and reported, if it holds a file named
  KEEP, if it is younger than `recent` minutes (a run in progress has no
  exit file to look for) or if a process mentions its name (an edgy or
  edg-docker-test run that uses it).'''
  parts = []
  dirs = (*PRUNE_DIRS, *(EVIDENCE_DIRS if evidence else ()))
  for pattern in (*(f"{d}/*" for d in dirs), '.tmp/checkpoint-*'):
    parts.append(
      f"ls -1dt {pattern} 2>/dev/null | tail -n +{keep + 1} | "
      f"while read -r d; do "
      f"if [ -e \"$d/KEEP\" ]; then echo \"kept (KEEP marker) $d\"; "
      f"elif [ -n \"$(find \"$d\" -maxdepth 0 -mmin -{recent})\" ]; then "
      f"echo \"kept (younger than {recent} min) $d\"; "
      f"elif pgrep -f -- \"$(basename \"$d\")\" > /dev/null; then "
      f"echo \"kept (in use) $d\"; "
      f"else rm -rf \"$d\" && echo \"pruned $d\" || "
      f"echo \"could not remove $d\"; fi; done")
  return '; '.join(parts)


def headroom_gb(text: str) -> int:
  '''The free space in GB of a `df -BG --output=avail` output.'''
  lines = [l.strip() for l in text.splitlines() if l.strip()]
  digits = re.sub(r'\D', '', lines[-1]) if lines else ''
  return int(digits) if digits else -1


# The day suite of the baseline commit (a link to its tests/runs/<ts> in the
# day-base tree; the same as the gate's default) and the perf baselines: the
# regression one is the M5 run (--perf-baseline), the S1 targets are against
# the M5a run.
DAY_BASELINE = '~/edg-cir-config/day-base/baseline-64'
DAY32_BASELINE = '~/edg-cir-config/day-base/baseline-32'
PERF_BASELINE = '~/edg-cir-config/m6r-base-perf.json'
PERF_TARGETS_BASELINE = '~/edg-cir-config/m5a-base-perf.json'
# The perf step measures the pinned real-world units at -O0 and -O2 whenever
# it runs: its baseline has those rows, and a run without them would lack
# rows of the baseline (which fails).
PERF_OPTIONS = (('--perf-realworld', 'pinned'), ('--perf-levels', '0,2'))
MILESTONE_OPTIONS = (*PERF_OPTIONS, ('--perf-targets', 's1'))


def milestone_extra(extra: str) -> str:
  '''The extra arguments of a milestone run: the pinned real-world units and
  the S1 targets in the perf step, both levels, each unless `extra` already
  has the option.'''
  return with_options(MILESTONE_OPTIONS, extra)


def with_options(options: tuple, extra: str) -> str:
  '''`extra` with each (name, value) of `options` that it lacks put first.'''
  added = [f"{name} {value}" for name, value in options
           if name not in extra.split()]
  return ' '.join([*added, extra]).strip()


def load_gate_tool():
  '''The module of edg-cir-gate-evidence (for its area tables and the area
  check of --lean).'''
  import importlib.machinery
  import importlib.util
  path = str(Path(__file__).resolve().with_name('edg-cir-gate-evidence'))
  loader = importlib.machinery.SourceFileLoader('edg_cir_gate_evidence', path)
  spec = importlib.util.spec_from_loader(loader.name, loader)
  module = importlib.util.module_from_spec(spec)
  loader.exec_module(module)
  return module


def is_synced(path: str) -> bool:
  """Whether `path` (relative to the repository root) goes to the box: the
  files of EXCLUDES' anchored entries (another session's untracked files)
  never do, so they are no part of the change set that the areas cover."""
  import fnmatch
  for exclude in EXCLUDES:
    if not exclude.startswith('/'):
      continue
    pattern = exclude[1:]
    if pattern.endswith('/'):
      if path.startswith(pattern):
        return False
    elif fnmatch.fnmatchcase(path, pattern):
      return False
  return True


def upload_changed_files(out: str, text: str) -> int:
  '''Write the list of changed files to <out>/changed-files.txt on the box;
  the exit status of the ssh command.'''
  return subprocess.run(['ssh', *ssh_options(), BOX,
                         f"cat > {out}/changed-files.txt"],
                        input = text, text = True).returncode


def ssh(command: str, capture: bool = False) -> subprocess.CompletedProcess:
  return subprocess.run(
    ['ssh', *ssh_options(), BOX, command], text = True,
    stdout = subprocess.PIPE if capture else None,
    stderr = subprocess.STDOUT if capture else None
  )


def report_headroom() -> int:
  '''Print the box's disk usage of the home directory; return the free GB
  (-1 if unknown).'''
  usage = ssh('df -h ~ | tail -n 1', capture = True).stdout.strip()
  free = headroom_gb(ssh('df -BG --output=avail ~', capture = True).stdout)
  print(f"box disk: {usage} ({free} GB free)", flush = True)
  return free


def main() -> None:
  parser = argparse.ArgumentParser(
    description = __doc__.split('\n')[0],
    formatter_class = argparse.RawDescriptionHelpFormatter,
    epilog = __doc__.split('\n', 2)[2]
  )
  parser.add_argument('--tree', default = DEFAULT_TREE,
                      help = 'name of the tree under ~/edg-cir-config')
  parser.add_argument('--steps', default = DEFAULT_STEPS,
                      help = 'comma separated edg-cir-gate-evidence steps')
  parser.add_argument('--lean', default = '', metavar = 'AREAS',
                      help = 'a lean gate for these changed areas instead of '
                             '--steps (edg-cir-gate-evidence --lean; see its '
                             'docstring): the steps and their skip reasons '
                             'come from there, and the areas are checked '
                             'against the files that differ from --lean-base '
                             'before anything is synced')
  parser.add_argument('--lean-base', default = 'HEAD', metavar = 'REF',
                      help = 'the commit that --lean compares the tree with '
                             '(default HEAD)')
  parser.add_argument('--allow-empty-change-set', action = 'store_true',
                      help = 'with --lean: no file differs from --lean-base '
                             '(refused otherwise: usually a wrong base)')
  parser.add_argument('--milestone', action = 'store_true',
                      help = 'the full milestone gate (edg-cir-gate-evidence '
                             '--milestone: every step, lazy, attr, chunk, '
                             'names, speed and crash-sweep included) against '
                             'the m6r-base-* baselines, with the perf options '
                             'of milestone_extra and the S1 targets against '
                             'm5a-base-perf.json')
  parser.add_argument('--quick', action = 'store_true',
                      help = f"only {QUICK_STEPS}")
  parser.add_argument('--prune', type = int, nargs = '?', const = 3,
                      default = 0, metavar = 'N',
                      help = 'first delete all but the newest N (default 3) '
                             'tests/runs/*, .tmp/checkpoint-* and evidence '
                             'directories of the tree')
  parser.add_argument('--prune-evidence', action = 'store_true',
                      help = 'also prune the .tmp/gate-* evidence '
                             'directories (never done by default)')
  parser.add_argument('--prune-only', action = 'store_true',
                      help = 'prune (--prune, default 3) and stop')
  parser.add_argument('--allow-stale', action = 'store_true',
                      help = 'with --no-sync: run although the fingerprint '
                             'of the tree on the box differs from this '
                             'tree\'s (the evidence then says so)')
  parser.add_argument('--incremental', action = 'store_true',
                      help = 'keep the CIR build directories')
  parser.add_argument('--allow-protected', action = 'store_true',
                      help = 'sync into, and wipe the CIR build directories '
                             'of, a protected tree (PROTECTED_TREES or a '
                             'KEEP marker); refused otherwise')
  parser.add_argument('--no-sync', action = 'store_true',
                      help = 'do not rsync (the tree is up to date)')
  parser.add_argument('--asm-baseline', default = '~/edg-cir-config/'
                      'm6r-base-asm')
  parser.add_argument('--cpp-asm-baseline', default = '~/edg-cir-config/'
                      'm6r-base-cpp-asm')
  parser.add_argument('--asm-normalize-cfi', action = 'store_true',
                      default = True,
                      help = 'asm-diff steps ignore .cfi_* directives '
                             '(the default)')
  parser.add_argument('--no-asm-normalize-cfi', dest = 'asm_normalize_cfi',
                      action = 'store_false',
                      help = 'asm-diff steps compare .cfi_* directives too')
  parser.add_argument('--identity-baseline',
                      default = '~/edg-cir-config/identity-m6r')
  parser.add_argument('--perf-baseline', default = PERF_BASELINE,
                      help = 'the perf regression baseline (the M6.R gate)')
  parser.add_argument('--perf-targets-baseline',
                      default = PERF_TARGETS_BASELINE,
                      help = 'the baseline of --perf-targets (the M5a run)')
  parser.add_argument('--day-baseline-run', default = DAY_BASELINE,
                      help = 'the day suite of the baseline commit')
  parser.add_argument('--check-baselines', action = 'store_true',
                      help = 'list the baselines that the selected steps '
                             'need (path, whether it exists and is not '
                             'empty, whether the images match) and exit '
                             '(1 if one is missing); syncs first, since it '
                             'runs the gate tool of the box tree')
  parser.add_argument('--day32-baseline-run', default = DAY32_BASELINE,
                      help = 'the 32-bit day suite of the baseline commit '
                             '(step day32)')
  parser.add_argument('--smoke-all-pass', action = 'store_true',
                      help = 'cpp-smoke fails unless every test passes')
  parser.add_argument('--jobs', type = int, default = 12)
  parser.add_argument('--detach', action = 'store_true',
                      help = 'start it and return; print how to look at it')
  parser.add_argument('--extra', default = '',
                      help = 'more arguments for edg-cir-gate-evidence')
  args = parser.parse_args()

  root = Path.cwd()
  if not (root / 'src' / 'cfe.c').exists():
    print('run it from the repository root', file = sys.stderr)
    sys.exit(2)
  if not box_reachable():
    print(f"the host {BOX} does not answer (EDG_CIR_HOST, EDG_CIR_SSH_KEY, "
          f"EDG_CIR_SSH_SOCKET): check `ssh -o BatchMode=yes -i {SSH_KEY} "
          f"{BOX} true`", file = sys.stderr)
    sys.exit(2)

  problem = hostname_problem(ssh('hostname -s', capture = True).stdout)
  if problem:
    print(problem, file = sys.stderr)
    sys.exit(2)

  steps = QUICK_STEPS if args.quick else args.steps
  if args.milestone:
    if args.lean or args.quick:
      print('--milestone excludes --lean and --quick', file = sys.stderr)
      sys.exit(2)
    if '--allow-missing-baselines' in args.extra.split():
      print('--allow-missing-baselines is refused with --milestone (it '
            'turns the status checks off)', file = sys.stderr)
      sys.exit(2)
    steps = 'every step (--milestone)'
  changed = ''
  if args.lean:
    gate_tool = load_gate_tool()
    areas = [a for a in args.lean.split(',') if a]
    unknown = [a for a in areas if a not in gate_tool.AREA_STEPS]
    if unknown:
      print(f"unknown area(s) {', '.join(unknown)}; the areas are "
            f"{', '.join(gate_tool.AREA_STEPS)}", file = sys.stderr)
      sys.exit(2)
    paths = [p for p in gate_tool.changed_paths(root, args.lean_base, '')
             if is_synced(p)]
    problems = gate_tool.uncovered_areas(paths, areas)
    print(f"change set against {args.lean_base}: {len(paths)} file(s), areas "
          f"{','.join(sorted(gate_tool.required_areas(paths))) or 'none'}",
          flush = True)
    if problems:
      print('the declared areas do not cover the change set: '
            + '; '.join(problems), file = sys.stderr)
      sys.exit(2)
    if not paths and not args.allow_empty_change_set:
      print(f"--lean with an empty change set: nothing differs from "
            f"{args.lean_base} (a wrong --lean-base?); "
            f"--allow-empty-change-set if that is meant", file = sys.stderr)
      sys.exit(2)
    changed = '\n'.join(paths) + '\n'
    steps = ','.join(gate_tool.lean_steps(areas)[0])
  tree = f"~/edg-cir-config/{args.tree}"
  stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
  out = f"{tree}/.tmp/checkpoint-{stamp}"
  log = f"~/edg-cir-config/checkpoint-{args.tree}.log"
  done = f"~/edg-cir-config/checkpoint-{args.tree}.exit"

  ssh(f"mkdir -p {tree}")
  protected = args.tree in PROTECTED_TREES or ssh(
    f"test -e {tree}/KEEP", capture = True).returncode == 0
  refusal = protected_refusal(args.tree, protected, args.no_sync,
                              args.incremental, args.allow_protected,
                              args.prune_only, args.check_baselines)
  if refusal:
    print(refusal, file = sys.stderr)
    sys.exit(2)
  if protected and not args.no_sync:
    print(f"{args.tree} is a protected tree: synced without --delete (a file "
          f"removed here stays there, and the fingerprint check says so)",
          flush = True)
  if args.prune or args.prune_only:
    keep = args.prune or 3
    if protected:
      print(f"not pruning {args.tree}: it is a protected tree or has a KEEP "
            f"marker", flush = True)
    else:
      print(f"pruning {args.tree} (keeping the newest {keep}) ...",
            flush = True)
      print(ssh(f"cd {tree} && {prune_command(keep, args.prune_evidence)}",
                capture = True).stdout.strip() or 'nothing to prune')
  free = report_headroom()
  if args.prune_only:
    return
  if 0 <= free < LOW_DISK_GB:
    print(f"WARNING: only {free} GB free on the box (< {LOW_DISK_GB} GB): a "
          f"checkpoint tree takes 10-15 GB; use --prune N or delete old "
          f"trees", file = sys.stderr, flush = True)
  def box_fingerprint() -> str:
    return ssh(f"cd {tree} && python3 -c {shlex.quote(FINGERPRINT_SOURCE)} "
               f"\"$PWD\"", capture = True).stdout.strip()

  # Sync (unless --no-sync) until this tree, before and after the sync, and
  # the box tree have one fingerprint: other work can change this tree while
  # rsync runs, and a tree that is not what was fingerprinted is not what
  # was tested.
  attempts = 1 if args.no_sync else 3
  for attempt in range(attempts):
    before = local_fingerprint(root)
    if not args.no_sync:
      print(f"syncing to {args.tree} ..." + (
        f" (again: the tree changed while syncing)" if attempt else ''),
            flush = True)
      if subprocess.run(rsync_command(args.tree, protected)).returncode != 0:
        print('rsync failed', file = sys.stderr)
        sys.exit(2)
    local = local_fingerprint(root)
    remote = box_fingerprint()
    stale = local != remote or local != before
    print(f"tree fingerprint {local} (this tree); {remote} (box)"
          + ("; DIFFERENT" if stale else "; equal"), flush = True)
    if not stale:
      break
  if stale and not args.allow_stale:
    why = ('it was not synced: drop --no-sync or sync it first'
           if args.no_sync else
           'this tree keeps changing while it is synced (is another agent '
           'editing it?); wait and retry')
    print(f"refusing to run: the box tree {args.tree} is not this tree "
          f"({why}); --allow-stale runs anyway and records it",
          file = sys.stderr)
    sys.exit(2)
  note = f"STALE (this tree {local})" if stale else 'equal to this tree'
  fingerprint = f"{remote} ({note})"
  ssh(f"mkdir -p {out} && printf '%s\\n' "
      f"{shlex.quote('tree fingerprint: ' + fingerprint)} "
      f"{shlex.quote('checkpoint started: ' + stamp)} "
      f"{shlex.quote('synced: ' + ('no' if args.no_sync else 'yes'))} "
      f"> {out}/fingerprint.txt")

  selection = ['--only', steps]
  if args.milestone:
    selection = ['--milestone']
    args.extra = milestone_extra(args.extra)
  elif 'perf' in steps.split(','):
    args.extra = with_options(PERF_OPTIONS, args.extra)
  if args.lean:
    # The gate picks the steps itself (and records why the others are
    # skipped); it checks the areas again against the list of changed files.
    status = upload_changed_files(out, changed)
    if status != 0:
      print(f"could not upload the list of changed files to {out} (ssh "
            f"status {status}); the gate would check nothing",
            file = sys.stderr)
      sys.exit(2)
    selection = ['--lean', args.lean, '--changed-files',
                 f"{out}/changed-files.txt"]
    if args.allow_empty_change_set:
      selection.append('--allow-empty-change-set')
  gate = [
    'python3', 'dev_tools/bin/edg-cir-gate-evidence', '--tree', '$T',
    '--tree-fingerprint', fingerprint,
    '--jobs', str(args.jobs), *selection, '--out', out,
    '--identity-baseline', args.identity_baseline,
    '--asm-baseline', args.asm_baseline,
    '--cpp-asm-baseline', args.cpp_asm_baseline,
    '--perf-baseline', args.perf_baseline,
    '--perf-targets-baseline', args.perf_targets_baseline,
    '--day-baseline-run', args.day_baseline_run,
    '--day32-baseline-run', args.day32_baseline_run
  ]
  if args.smoke_all_pass:
    gate.append('--cpp-smoke-all-pass')
  if args.asm_normalize_cfi:
    gate.append('--asm-normalize-cfi')
  gate_command = ' '.join(
    a if a == '$T' or a.startswith('~') else shlex.quote(a) for a in gate
  ) + (f" {args.extra}" if args.extra else '')
  if args.check_baselines:
    # The gate tool of the box tree lists what the selected steps need (the
    # box is where the baselines and the images are).
    check = ssh(f"T=$(cd {tree} && pwd); cd $T; "
                f"export PATH=$T/dev_tools/bin:$PATH "
                f"PYTHONPATH=$T/dev_tools/pylibs"
                f"{' EDG_CIR_SG_DOCKER=1' if SG_DOCKER else ''}; "
                f"{gate_command} --check-baselines", capture = True)
    print(check.stdout.rstrip())
    sys.exit(check.returncode)
  wipe = '' if args.incremental else (
    'rm -rf build/cir build/cir-* build/gcc-cir build/gcc-cir-nopoison '
    'build/gcc-release-cir; ')
  script = (
    f"T=$(cd {tree} && pwd); cd $T; mkdir -p .git/hooks .tmp; "
    f"export PATH=$T/dev_tools/bin:$PATH PYTHONPATH=$T/dev_tools/pylibs"
    f"{' EDG_CIR_SG_DOCKER=1' if SG_DOCKER else ''}; "
    f"[ -f dev-pref.json ] || {docker_wrap('python3 dev-init.py docker')} "
    f">/dev/null 2>&1; {wipe}rm -f {done}; "
    f"nice -n 10 {gate_command} > {log} 2>&1; echo $? > {done}"
  )
  started = time.time()
  ssh(f"nohup bash -c {shlex.quote(script)} > /dev/null 2>&1 &")
  print(f"started {steps} in {args.tree}; evidence {out}\n"
        f"log: {log}   (on the box)", flush = True)
  if args.detach:
    print(f"look: ssh ... 'tail {log}; cat {done}'")
    return

  while True:
    time.sleep(20)
    result = ssh(f"cat {done} 2>/dev/null", capture = True)
    if result.stdout.strip().isdigit():
      status = int(result.stdout.strip())
      break
  table = ssh(f"sed -n '/^| step/,$p' {log}", capture = True).stdout
  print('\n'.join(line for line in table.splitlines()
                  if 'SKIPPED' not in line))
  print(f"{(time.time() - started) / 60:.0f} min; evidence {out}")
  sys.exit(0 if status == 0 else 1)


if __name__ == '__main__':
  main()
