; C++ (ECIL v1): a data size that stops short of the end of the last member.
; The front end reports data size 13 for D2 below although a member of class
; type B (size 8) ends at 16; a data member keeps its tail padding, so the
; Itanium data size of D2 is 16.  The library raises the value to the end of
; the last member: D2 is not packed, needs no ".base" record, and a class
; derived from it places its own member at 16.
;   struct B { int a; char c; };           // size 8, a POD: data size 8
;   struct D2 : B { B inner; };            // size 16
;   struct E3 : D2 { char x; };            // size 20, x at 16
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s

; CHECK-DAG: !rec_B = !cir.struct<"B" {data !s32i, data !s8i}>
; CHECK-DAG: !rec_D2 = !cir.struct<"D2" {data !rec_B, data !rec_B}>
; CHECK-DAG: !rec_E3 = !cir.struct<"E3" packed {data !rec_D2, data !s8i, pad !cir.array<!u8i x 3>}>
; CHECK-NOT: D2.base

frame DECLS
  STR 11 "B"
  STR 12 "D2"
  STR 13 "E3"
  STR 14 "gd2"
  STR 15 "ge3"
  TY_RECORD_DECL 21 0 11
  TY_RECORD_BODY 21 8 8 4 0 2
  REC_FIELD 1 0 nil nil nil 0
  REC_FIELD 4 4 nil nil nil 0
  TY_RECORD_DECL 22 0 12
  TY_RECORD_BODY 22 16 13 4 0 2
  REC_FIELD 21 0 nil nil nil 48
  REC_FIELD 21 8 nil nil nil 0
  TY_RECORD_DECL 23 0 13
  TY_RECORD_BODY 23 20 17 4 0 2
  REC_FIELD 22 0 nil nil nil 48
  REC_FIELD 4 16 nil nil nil 0
  DECL_VAR 201 22 0 1 4 14
  C_ZERO 22
  VAR_INIT 201
  DECL_VAR 202 23 0 1 4 15
  C_ZERO 23
  VAR_INIT 202
frame END
  END auto 0
