; __int128 (!cir.int<s|u, 128>): constants (i128/u128 tags), shifts, unsigned
; and signed arithmetic and comparisons (division through libgcc), casts to
; and from narrower integers and double, by-value arguments and results
; (CallConvLowering), bswap, globals with 128-bit initializers and stores.
; Run on the box; the program returns the number of the first failing check.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: !s128i = !cir.int<s, 128>
; CHECK-DAG: !u128i = !cir.int<u, 128>
