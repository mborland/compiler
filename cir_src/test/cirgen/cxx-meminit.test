; C++ (ECIL v1): MEMINIT groups at the start of constructor bodies: a base
; (kind 1, through BASE_CAST), members (kind 2) including a
; compiler_generated one (flag 1) and a default member initializer (flag 2),
; and a delegating constructor (kind 3, alone, idx 0).  The groups are
; ordinary code; the program checks the values.
;   struct Base { int b; Base(int v) { b = v; } };
;   struct D : Base { int m; int n = 5;
;     D(int a) : Base(a), m(a + 1) {}   D() : D(7) {} };
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1DC2Ei
; CHECK: cir.base_class_addr
; CHECK: cir.call @_ZN4BaseC2Ei
; CHECK: cir.get_member {{.*}}[1] {name = "m"}
; CHECK: cir.get_member {{.*}}[2] {name = "n"}
; CHECK-LABEL: cir.func {{.*}}@_ZN1DC2Ev
; CHECK: cir.call @_ZN1DC2Ei

frame DECLS
  STR 11 "Base"
  STR 12 "D"
  STR 13 "b"
  STR 14 "m"
  STR 15 "n"
  STR 16 "_ZN4BaseC2Ei"
  STR 17 "_ZN1DC2Ei"
  STR 18 "_ZN1DC2Ev"
  STR 19 "main"
  TY_RECORD_DECL 21 0 11
