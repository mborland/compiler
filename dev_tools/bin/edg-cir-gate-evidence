  count = re.search(r'stressing (\d+) tests', text)
  return code == 0, (f"{count.group(1) if count else '?'} tests; " +
                     (match.group(0) if match else 'no result line'))


# The workloads of the rss step: (name, edg-cir-rss generator and input
# options).  Each is measured with the ASan front end (quarantine off) and the
# release front end, in the rows of RSS_ROWS (the rows of edg-cir-rss that run
# the CIR back end; the plain cpfe row is for reference only).
RSS_WORKLOADS = ('c', 'cxx', 'tmpl')
RSS_BUILDS = (('asan', 'build/gcc-cir'), ('release', 'build/gcc-release-cir'))
RSS_ROWS = ('inproc', 'keep', '2p-fe', '2p-edg-cir')
# The peak RSS (MB) that a row may not exceed, per (workload, build, row):
# 1.25 times the value measured on the box at gate M5p (2026-10-19, tree
# m5p-int, fingerprint 9e1c852a, pin 2d6f180e; rounded up to 10 MB), for the
# default sizes (--rss-functions 6000 C functions and C++ functions,
# --rss-template-units 300).  The value is the minimum of 3 runs for the ASan
# in-process and keep rows and a single run for the others (m5p-base-rss.txt
# in ~/edg-cir-config has them).  The ceilings are derived from these very
# measurements, so the gate that measured them needs no re-run to pass; the
# M4.1 ceilings were derived from a loaded run (the template workload's
# in-process ASan row had 755 MB there against 1017 MB idle).  A change that
# makes memory grow by more than a quarter must raise a ceiling deliberately
# (and say why).  The peak of an ASan row with the quarantine off depends on
# timing and fragmentation (755 to 1017 MB on one M4.1 build, 793 to 970 MB on
# the M4 build, 988 to 989 MB in three M5p runs), so the ASan in-process rows
# are measured ASAN_REPEATS times and judged on the minimum; the release rows
# are strict.
# M5.1 session 3 (clang4, m51-int, after the size rule of the chunk decision):
# no ceiling was raised.  The only rows that moved because of the new rule are
# the generated C++ unit's edg-cir rows (cxx 2p-edg-cir: 116 -> 144 MB ASan,
# 118 -> 150 MB release): the unit (6000 functions, about 0.85 MB of emitted
# bodies) used to be lowered in 13 chunks and is now one piece, as L-a
# predicted (138-147 MB for edg-cir alone); both stay under their ceiling of
# 200 MB.  The other rows are at or below the session-1 values
# (m5-base-rss.txt), the highest at 77% of its ceiling.
# M6.R (decision 56): the C rows are 1.25 times the M5.1 values of
# m51-base-rss.txt (clang4, m51-int: ASan in-process 438, keep 571, 2p-fe 113,
# 2p-edg-cir 232 MB; release 183, 251, 65, 211), rounded up to a multiple of
# 10 MB (550, 720, 150, 290; 90), except the release in-process, keep and
# 2p-edg-cir rows (320, 430 and 290 MB): the M6.R gate measured 253, 344 and
# 232 MB there.  The M5.1 release front end and library (m51-int) measure the
# same on that input today (249-250 and 340-341; M5, m5-base-rss.txt: 255, 344
# and 232) while their own record says 183, 251 and 211: the host, not main's
# front end (same ECIL stream, same 14 chunks), moved them
# (.tmp/m6/s1/cir-config-gate.md).  Those three are 1.25 times the gate's
# values.
RSS_CEILINGS_MB: Dict[Tuple[str, str, str], int] = {
  ('c', 'asan', 'inproc'): 550,
  ('c', 'asan', 'keep'): 720,
  ('c', 'asan', '2p-fe'): 150,
  ('c', 'asan', '2p-edg-cir'): 290,
  ('cxx', 'asan', 'inproc'): 380,
  ('cxx', 'asan', 'keep'): 400,
  ('cxx', 'asan', '2p-fe'): 140,
  ('cxx', 'asan', '2p-edg-cir'): 200,
  ('tmpl', 'asan', 'inproc'): 1240,
  ('tmpl', 'asan', 'keep'): 1290,
  ('tmpl', 'asan', '2p-fe'): 630,
  ('tmpl', 'asan', '2p-edg-cir'): 450,
  ('c', 'release', 'inproc'): 320,
  ('c', 'release', 'keep'): 430,
  ('c', 'release', '2p-fe'): 90,
  ('c', 'release', '2p-edg-cir'): 290,
  ('cxx', 'release', 'inproc'): 240,
  ('cxx', 'release', 'keep'): 260,
  ('cxx', 'release', '2p-fe'): 80,
  ('cxx', 'release', '2p-edg-cir'): 200,
  ('tmpl', 'release', 'inproc'): 860,
  ('tmpl', 'release', 'keep'): 890,
  ('tmpl', 'release', '2p-fe'): 450,
  ('tmpl', 'release', '2p-edg-cir'): 450
}


def parse_rss(text: str) -> Dict[Tuple[str, str, str], Tuple[int, float]]:
  '''(workload, build, row) -> (exit status, peak MB) of the output of the
  rss step: `== RSS <workload> <build>` marks a block of edg-cir-rss rows.  A
  row that was measured several times (the ASan in-process rows are, see
  step_rss) is the minimum of its peaks, and the first failing exit status.'''
  rows: Dict[Tuple[str, str, str], Tuple[int, float]] = {}
  block: Optional[Tuple[str, str]] = None
  for line in text.splitlines():
    match = re.match(r'^== RSS (\S+) (\S+)$', line)
    if match:
      block = (match.group(1), match.group(2))
      continue
    match = re.match(r'^(inproc|keep|2p-fe|2p-edg-cir)\s+(\S+)\s+(\S+)\s+'
                     r'(-?\d+)$', line)
    if match and block:
      try:
        megabytes = float(match.group(3))
      except ValueError:
        megabytes = float('inf')
      key = (block[0], block[1], match.group(1))
      status = int(match.group(4))
      if key in rows:
        old_status, old_megabytes = rows[key]
        rows[key] = (old_status or status, min(old_megabytes, megabytes))
      else:
        rows[key] = (status, megabytes)
  return rows


def judge_rss(text: str, ceilings: Dict[Tuple[str, str, str], int]
              ) -> Tuple[bool, str]:
  '''The rule of the rss step: a row for every key of `ceilings`, each with
  exit status 0 and a peak RSS within its ceiling (for a row measured more
  than once, its minimum).'''
  rows = parse_rss(text)
  problems: List[str] = []
  worst = 0.0
  for key in sorted(ceilings):
    name = '/'.join(key)
    if key not in rows:
      problems.append(f"{name}: no measurement")
      continue
    status, megabytes = rows[key]
    if status != 0:
      problems.append(f"{name}: exit status {status}")
    elif megabytes > ceilings[key]:
      problems.append(f"{name}: {megabytes:.0f} MB over the ceiling of "
                      f"{ceilings[key]} MB")
    else:
      worst = max(worst, megabytes / ceilings[key])
  detail = (f"{len(rows)} measurements, {len(ceilings)} ceilings; the "
            f"highest row is at {100 * worst:.0f}% of its ceiling")
  if not ceilings:
    problems.append('no ceiling is defined')
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems[:6]) + ' | ' + detail
  return not problems, detail


ASAN_REPEATS = 3
RSS_DEFAULT_FUNCTIONS = 6000
RSS_DEFAULT_TEMPLATE_UNITS = 300


def step_rss(ctx: Context) -> Tuple[bool, str]:
  '''Peak memory of the CIR front end and library on a generated C file, a
  generated C++ file and a template-heavy C++ file, ASan (quarantine off) and
  release; every row has a ceiling.'''
  if (ctx.args.rss_functions, ctx.args.rss_template_units) != (
      RSS_DEFAULT_FUNCTIONS, RSS_DEFAULT_TEMPLATE_UNITS):
    return False, (f"the ceilings are for {RSS_DEFAULT_FUNCTIONS} functions "
                   f"and {RSS_DEFAULT_TEMPLATE_UNITS} template units; "
                   f"--rss-functions and --rss-template-units must keep "
                   f"those values")
  # One container: /tmp is not shared between edg-exec runs.
  rss = 'python3 dev_tools/bin/edg-cir-rss'
  inputs = {
    'c': ('/tmp/gate-big.c',
          f"--generate-functions {ctx.args.rss_functions}", ''),
    'cxx': ('/tmp/gate-bigxx.cpp',
            f"--generate-cxx-functions {ctx.args.rss_functions}", '--cxx '),
    'tmpl': ('/tmp/gate-tmpl.cpp',
             f"--generate-cxx-templates {ctx.args.rss_template_units}",
             '--cxx ')
  }
  steps = [f"{rss} {gen} -o {path}" for path, gen, _ in inputs.values()]
  rows = ','.join(RSS_ROWS)
  for build_name, build in RSS_BUILDS:
    for workload in RSS_WORKLOADS:
      path, _, flag = inputs[workload]
      env = ('ASAN_OPTIONS=quarantine_size_mb=0 '
             if build_name == 'asan' else '')
      steps.append(f"echo '== RSS {workload} {build_name}'")
      steps.append(f"{env}{rss} --fe-build {build} --only {rows} "
                   f"{flag}{path}")
      if build_name == 'asan':
        # The in-process rows again (see ASAN_REPEATS): the minimum counts.
        for _ in range(ASAN_REPEATS - 1):
          steps.append(f"echo '== RSS {workload} {build_name}'")
          steps.append(f"{env}{rss} --fe-build {build} --only "
                       f"inproc,keep {flag}{path}")
  code = in_cir_env(ctx, 'rss', ' && '.join(steps))
  text = (ctx.out / 'rss' / 'log.txt').read_text()
  ok, detail = judge_rss(text, RSS_CEILINGS_MB)
  return ok and code == 0, (detail if code == 0 else
                            f"failed (see log.txt) | {detail}")


def _status_lines(run: Path, suites: Optional[List[str]] = None
                  ) -> Dict[str, List[str]]:
  '''Per config: sorted status lines of the run's suite-*.elog files.

  suites, if given, restricts them to those test suites.
  '''
  data = {}
  for config_dir in sorted(p for p in run.iterdir() if p.is_dir()):
    lines: List[str] = []
    for elog in sorted(config_dir.glob('suite-*.elog')):
      if suites is not None and elog.stem[len('suite-'):] not in suites:
        continue
      lines += [f"{elog.name}:{l.strip()}" for l in elog.read_text(
        errors = 'replace').splitlines() if l.strip()]
    data[config_dir.name] = sorted(lines)
  return data


def cache_edg_base(text: str) -> Optional[str]:
  '''The value of the EDG_BASE entry of a CMakeCache.txt, whatever its type
  (`EDG_BASE:STRING=`, `:PATH=`, `:FILEPATH=` or `:UNINITIALIZED=`: the type
  depends on how it was set), or None if the cache has no such entry.'''
  found = re.search(r'^EDG_BASE:[A-Z]+=(.*)$', text, re.M)
  return found.group(1) if found else None


def drop_stale_builds(ctx: Context, posture: str) -> List[str]:
  '''Remove the build directories of the day posture (the built-in one, or
  the posture file `posture`) whose CMake cache has another EDG_BASE (of any
  cache type, see cache_edg_base) than the posture's.  The identity step
  configures every preset (for the compile commands) with the default
  EDG_BASE; edg-docker-test only builds a directory that exists, so the i686
  build would keep the x86-64 base (the runtime library then fails to
  compile).  Returns the directories removed.'''
  if posture:
    builds = json.loads((ctx.tree / posture).read_text())['builds']
  else:
    builds = [{'build_path': 'build/gcc',
               'edg_base': 'bases/docker/dev-env/gcc'}]
  removed = []
  for build in builds:
    directory = ctx.tree / build['build_path']
    cache = directory / 'CMakeCache.txt'
    wanted = f"/edg/workspace/{build['edg_base']}"
    if cache.exists() and cache_edg_base(cache.read_text()) != wanted:
      shutil.rmtree(directory)
      removed.append(build['build_path'])
  return removed


def _day_step(ctx: Context, step: str, baseline: str, configs: Tuple[str, ...],
              posture: str = '') -> Tuple[bool, str]:
  '''Run the day suite (edg-docker-test; with `posture` a posture file of
  the tree, else the built-in day posture) and compare the status lines of
  `configs` with the day suite `baseline` of the baseline commit.'''
  if not baseline:
    return False, f"--{step}-baseline-run is required"
  (ctx.out / step).mkdir(parents = True, exist_ok = True)
  for removed in drop_stale_builds(ctx, posture):
    with open(ctx.out / step / 'log.txt', 'a') as log:
      log.write(f"[removed {removed}: its CMake cache has another EDG_BASE]\n")
  before = runs_before(ctx)
  day_command = [str(ctx.tree / 'dev_tools/bin/edg-docker-test'),
                 '--non-interactive', '--jobs', str(BUILD_JOBS)]
  if posture:
    day_command += ['--posture', f"@{posture}"]
  suites = None
  if ctx.args.day_filter:
    # A partial run (for testing the script): compare only those suites.
    day_command.append(ctx.args.day_filter)
    suites = sorted({f.split('/')[0] for f in ctx.args.day_filter.split(',')})
  run_logged(ctx, step, docker_argv(day_command))
  run = newest_run(ctx, before)
  if run is None:
    return False, 'no run produced'
  base_lines = _status_lines(Path(baseline).resolve(), suites)
  new_lines = _status_lines(run, suites)
  problems = []
  for config in configs:
    if base_lines.get(config) != new_lines.get(config):
      problems.append(config)
      only_old = set(base_lines.get(config, [])) - set(new_lines.get(config, []))
      only_new = set(new_lines.get(config, [])) - set(base_lines.get(config, []))
      with open(ctx.out / step / 'diff.txt', 'a') as diff:
        diff.write(f"== {config}\n")
        diff.writelines(f"- {l}\n" for l in sorted(only_old))
        diff.writelines(f"+ {l}\n" for l in sorted(only_new))
  executed = {c: len((run / c / 'executed.elist').read_text().splitlines())
              for c in configs if (run / c / 'executed.elist').exists()}
  detail = f"run {run.name}; executed {executed}; "
  return not problems, detail + (
    f"statuses differ in {problems} (diff.txt)" if problems else
    'statuses identical to the baseline')


def step_day(ctx: Context) -> Tuple[bool, str]:
  return _day_step(ctx, 'day', ctx.args.day_baseline_run,
                   ('edg_x86_64', 'edg_x86_64_cp'))


def step_day32(ctx: Context) -> Tuple[bool, str]:
  '''The day suite of the 32-bit configurations (edg_x86_32, edg_x86_32_cp:
  the i686 build, the posture file tests/.edgy/postures/day32.json) against
  baseline-32 of the day-base tree.'''
  return _day_step(ctx, 'day32', ctx.args.day32_baseline_run,
                   ('edg_x86_32', 'edg_x86_32_cp'), ctx.args.day32_posture)


def step_ctest(ctx: Context) -> Tuple[bool, str]:
  presets_file = ctx.tree / 'cir_src' / 'CMakePresets.json'
  data = json.loads(presets_file.read_text())
  failures = []
  ran = []
  wanted = [p for p in ctx.args.ctest_presets.split(',') if p]
  for preset in data['configurePresets']:
    if preset.get('hidden') or (wanted and preset['name'] not in wanted):
      continue
    name = preset['name']
    binary = preset['binaryDir'].replace('${sourceDir}', 'cir_src')
    binary = os.path.normpath(binary)
    commands = [] if ctx.args.keep_ctest_builds else [f"rm -rf {binary}"]
    commands += [
      f"cd cir_src && cmake --preset {name}",
      f"cmake --build {binary} -j{BUILD_JOBS}",
      f"ctest --test-dir {binary} --output-on-failure -j{BUILD_JOBS}"
    ]
    # The lit test of the preset would use every CPU of the box otherwise.
    codes = [in_cir_env(ctx, 'ctest', c,
                        extra_env = {'LIT_OPTS': f"-j{BUILD_JOBS}"})
             for c in commands]
    ran.append(name)
    if any(codes):
      failures.append(name)
  return not failures, (f"{len(ran) - len(failures)}/{len(ran)} presets pass"
                        + (f"; failed: {', '.join(failures)}"
                           if failures else ''))


# A label that starts a symbol block: a name, or a local label that names
# data (.L.str.3) rather than a place in a function body.
_SYMBOL_LABEL_REGEX = re.compile(
  r'^([A-Za-z_$][\w.$@]*|\.L(?!BB\d|tmp\d|func_end\d|func_begin\d|cfi\d|'
  r'pcsection\d|exception\d)[\w.$@]*):')
# Labels of a function body, numbered per function by the code generator.
_BODY_LABEL_REGEX = re.compile(
  r'\.(LBB|Ltmp|Lfunc_end|Lcfi|Lfunc_begin|Lpcsection)\d+(_\d+)?')
# Lines that end the block before them (they belong to the previous symbol).
_BLOCK_END_REGEX = re.compile(r'^\s*(\.size\b|\.cfi_endproc\b|#)')


def split_symbol_blocks(text: str) -> List[Tuple[str, List[str]]]:
  '''Split assembly into (symbol name, lines) blocks.

  A block runs from the directives before a (non-local) symbol label, such as
  .globl and .type, through the lines after it, up to the directives of the
  next symbol.  Lines before the first symbol form a block named "".
  '''
  lines = text.splitlines()
  starts = [i for i, l in enumerate(lines) if _SYMBOL_LABEL_REGEX.match(l)]
  boundaries = []
  for index in starts:
    # Walk back over the directives that belong to this symbol.
    begin = index
    while begin > 0:
      previous = lines[begin - 1]
      if (_BLOCK_END_REGEX.match(previous) or previous.strip() == '' or
          not previous.lstrip().startswith('.') or
          re.match(r'^\.?[A-Za-z_$][\w.$@]*:', previous)):
        break
      begin -= 1
    boundaries.append(begin)
  blocks: List[Tuple[str, List[str]]] = []
  if not starts:
    return [('', lines)]
  if boundaries[0] > 0:
    blocks.append(('', lines[:boundaries[0]]))
  for number, index in enumerate(starts):
    end = boundaries[number + 1] if number + 1 < len(starts) else len(lines)
    name = _SYMBOL_LABEL_REGEX.match(lines[index]).group(1)
    blocks.append((name, lines[boundaries[number]:end]))
  return blocks


def renumber_body_labels(lines: List[str]) -> List[str]:
  '''Rename the per-function labels of a block in order of appearance.'''
  names: Dict[str, str] = {}
  def replace(match: 're.Match[str]') -> str:
    name = match.group(0)
    if name not in names:
      names[name] = f".L{match.group(1)}{len(names)}"
    return names[name]
  return [_BODY_LABEL_REGEX.sub(replace, l) for l in lines]


def normalize_layout(lines: List[str]) -> List[str]:
  '''The block without trivial branches and unused labels, labels renumbered.

  A `jmp L` that is followed directly by `L:` is dropped, then so is every
  per-function label that no line refers to.  This is what merging two
  basic blocks looks like in assembly.
  '''
  kept: List[str] = []
  index = 0
  while index < len(lines):
    line = lines[index]
    jump = re.match(r'^\s*jmp\s+(\.\w+)\s*$', line)
    if (jump and index + 1 < len(lines) and
        lines[index + 1].strip() == f"{jump.group(1)}:"):
      index += 1
      continue
    kept.append(line)
    index += 1
  text = '\n'.join(kept)
  result = []
  for line in kept:
    label = re.match(r'^(\.(?:LBB|Ltmp)\d+(?:_\d+)?):\s*(#.*)?$', line)
    if label and len(re.findall(re.escape(label.group(1)) + r'(?![\w$.])',
                                text)) <= 1:
      continue
    result.append(line)
  return renumber_body_labels(result)


def classify_asm_difference(old: str, new: str) -> Tuple[str, List[str]]:
  '''Classify two different assembly texts; return (kind, details).

  Both are split into symbol blocks (a symbol with its directives and body).
  The kind is one of:

    order    the same blocks (line for line), in a different order
    labels   the same after the per-function labels (.LBB0_3, .Ltmp1, ...)
             are renumbered in each block, perhaps in a different order
    layout   the same after also dropping jumps to the next line and unused
             labels (basic blocks merged or split), blocks possibly reordered
    symbols  blocks were added, removed or renamed (e.g. .N suffixes)
    other    a block with the same name has other content; details say, per
             block, whether it has the same lines in another order
             ("reordered") or other lines ("changed")
  '''
  old_blocks = split_symbol_blocks(old)
  new_blocks = split_symbol_blocks(new)
  old_map = {n: '\n'.join(b) for n, b in old_blocks}
  new_map = {n: '\n'.join(b) for n, b in new_blocks}
  if len(old_map) == len(old_blocks) and len(new_map) == len(new_blocks):
    if old_map == new_map:
      return 'order', []
    old_norm = {n: '\n'.join(renumber_body_labels(b)) for n, b in old_blocks}
    new_norm = {n: '\n'.join(renumber_body_labels(b)) for n, b in new_blocks}
    if old_norm == new_norm:
      changed = sorted(n for n in old_map if old_map[n] != new_map[n])
      return 'labels', [f"labels renumbered in {len(changed)} block(s): "
                        f"{', '.join(changed[:6])}"]
    if set(old_map) == set(new_map):
      layout = [n for n in old_map if old_norm[n] != new_norm[n]]
      if all(normalize_layout(dict(old_blocks)[n]) ==
             normalize_layout(dict(new_blocks)[n]) for n in layout):
        return 'layout', [f"block layout (jumps to the next block, unused "
                          f"labels) in {len(layout)} block(s): "
                          f"{', '.join(layout[:6])}"]
      details = []
      for name in sorted(old_map):
        if old_norm[name] == new_norm[name]:
          continue
        same = sorted(old_norm[name].splitlines()) == sorted(
          new_norm[name].splitlines())
        details.append(f"{name}: {'reordered' if same else 'changed'}")
      return 'other', details
  only_old = sorted(set(old_map) - set(new_map))
  only_new = sorted(set(new_map) - set(old_map))
  if only_old or only_new:
    return 'symbols', [f"only in baseline: {', '.join(only_old[:8])}",
                       f"only now: {', '.join(only_new[:8])}"]
  return 'other', ['duplicate symbol names; compare by hand']


# Hints from the source of a test for the cause of a difference.
_CAUSE_REGEXES = (
  ('for-init (W3)', re.compile(
    r'\bfor\s*\(\s*(?:(?:const|volatile|unsigned|signed|long|short|register|struct\s+'
    r'\w+|enum\s+\w+|union\s+\w+)\s+)*[A-Za-z_]\w*\s*\**\s*[A-Za-z_]\w*'
    r'\s*(?:=|;|\[|,)')),
  ('alloca (B3)', re.compile(r'\balloca\s*\(|__builtin_alloca')),
)


def source_of(tests_dir: Path, asm_name: str) -> str:
  '''The text of the test an assembly file name (see --save-asm) is for.'''
  stem = asm_name.rsplit('.', 2)[0]
  path = tests_dir / stem.replace('__', '/')
  try:
    text = path.read_text(errors = 'replace')
  except OSError:
    return ''
  # Not the declarations and line markers of preprocessed headers.
  return re.sub(r'^\s*(extern\b|#).*$', '', text, flags = re.M)


# The frame description directives that --asm-normalize-cfi removes: what an
# unwind table (uwtable) adds to a function.  .cfi_personality, .cfi_lsda,
# .cfi_escape, .cfi_signal_frame and .cfi_sections are NOT among them: they
# say how an exception is handled or what kind of frame it is, and a
# difference in them must stay visible.
_CFI_NORMALIZED = (
  'startproc', 'endproc', 'def_cfa', 'def_cfa_offset', 'def_cfa_register',
  'def_cfa_expression', 'adjust_cfa_offset', 'offset', 'rel_offset',
  'register', 'restore', 'remember_state', 'restore_state', 'undefined',
  'same_value', 'window_save'
)
_CFI_REGEX = re.compile(
  r'^[ \t]*\.cfi_(?:' + '|'.join(_CFI_NORMALIZED) + r')\b.*(?:\n|$)', re.M)


def strip_cfi(text: str) -> str:
  '''The assembly without its frame description directives
  (--asm-normalize-cfi; see _CFI_NORMALIZED).'''
  return _CFI_REGEX.sub('', text)


def compare_asm_dirs(baseline_dir: Path, new_dir: Path, tests_dir: Path,
                     normalize_cfi: bool = False
                     ) -> Tuple[Dict[str, List[str]], List[str]]:
  '''Compare two --save-asm directories.

  Returns (groups, report lines): the case names by class and the
  description of every case that is not identical.  With normalize_cfi the
  .cfi_* directives are removed from both sides first, and a case that only
  differs in them is in the group "cfi" (and has no report entry).
  '''
  old_manifest = json.loads((baseline_dir / 'manifest.json').read_text())
  new_manifest = json.loads((new_dir / 'manifest.json').read_text())
  groups: Dict[str, List[str]] = {
    'identical': [], 'cfi': [], 'order': [], 'labels': [], 'layout': [],
    'symbols': [], 'other': [],
    'status': [], 'only-old': [], 'only-new': []
  }
  details: List[str] = []
  alloca_users: Dict[str, str] = {}
  for name in sorted(set(old_manifest) | set(new_manifest)):
    if name in new_manifest and name in old_manifest and (
        _CAUSE_REGEXES[1][1].search(source_of(tests_dir, name))):
      alloca_users[name] = 'identical'
    if name not in new_manifest:
      groups['only-old'].append(name)
      details.append(f"ONLY-OLD {name}")
      continue
    if name not in old_manifest:
      groups['only-new'].append(name)
      details.append(f"ONLY-NEW {name}")
      continue
    old, new = old_manifest[name], new_manifest[name]
    if old != new:
      groups['status'].append(name)
      details.append(f"STATUS {name}: baseline {old}, now {new}")
      continue
    if not old['asm']:
      groups['identical'].append(name)
      continue
    old_text = (baseline_dir / name).read_bytes().decode('utf-8', 'replace')
    new_text = (new_dir / name).read_bytes().decode('utf-8', 'replace')
    if old_text == new_text:
      groups['identical'].append(name)
      continue
    if normalize_cfi:
      old_text, new_text = strip_cfi(old_text), strip_cfi(new_text)
      if old_text == new_text:
        groups['cfi'].append(name)
        continue
    kind, why = classify_asm_difference(old_text, new_text)
    groups[kind].append(name)
    if name in alloca_users:
      alloca_users[name] = kind
    source = source_of(tests_dir, name)
    causes = [c for c, regex in _CAUSE_REGEXES if regex.search(source)]
    details.append(f"{kind.upper()} {name} (exit status {new['rc']}; "
                   f"source has: {', '.join(causes) or 'no known cause'})")
    details.extend('    ' + w[:200] for w in why[:12])
    if kind in ('other', 'symbols') and not causes:
      diff = list(difflib.unified_diff(
        old_text.splitlines(), new_text.splitlines(), 'baseline', 'now',
        lineterm = '', n = 0))
      details.extend('    ' + line[:160] for line in diff[:16])
  details.append(f"ALLOCA-USERS {len(alloca_users)} corpus cases call "
                 f"alloca or __builtin_alloca* (name: class of the diff)")
  details.extend(f"    {n}: {k}" for n, k in sorted(alloca_users.items()))
  return groups, details


def _run_asm_diff(ctx: Context, step: str, filters: str, baseline: str,
                  new: str, types: str, cxx: bool) -> Tuple[bool, str]:
  '''The assembly of a corpus against the baseline's (asm-diff for C,
  cpp-asm-diff for C++).'''
  option = 'cpp-asm-baseline' if cxx else 'asm-baseline'
  if not baseline:
    return False, f"--{option} is required"
  baseline_dir = Path(baseline).resolve()
  if not (baseline_dir / 'manifest.json').exists():
    return False, f"{baseline_dir} has no manifest.json"
  if new:
    # Re-classify assembly that an earlier run produced.
    new_dir = Path(new).resolve()
  else:
    # The corpus assembly of this tree; in a container, so inside the tree.
    new_dir = ctx.tree / '.tmp' / ('gate-cpp-asm' if cxx else 'gate-asm') / \
      ctx.out.name
    command = (f"python3 dev_tools/bin/edg-cir-compare-modes "
               f"{'--cxx ' if cxx else ''}{shlex.quote(filters)} "
               f"-j {BUILD_JOBS} "
               f"--save-asm {shlex.quote(rel(ctx, new_dir))} "
               f"--in-process-only")
    if types:
      command += f" --types {types}"
    in_cir_env(ctx, step, command)
  if not (new_dir / 'manifest.json').exists():
    return False, 'could not produce the assembly of this tree'
  groups, details = compare_asm_dirs(baseline_dir, new_dir,
                                     ctx.tree / 'tests' / 'tests',
                                     ctx.args.asm_normalize_cfi)
  (ctx.out / step).mkdir(parents = True, exist_ok = True)
  (ctx.out / step / 'report.txt').write_text('\n'.join(details) + '\n')
  differing = sum(len(v) for k, v in groups.items()
                  if k not in ('identical', 'cfi'))
  detail = (f"{len(groups['identical'])} identical, "
            + (f"{len(groups['cfi'])} .cfi_* directives only, "
               if ctx.args.asm_normalize_cfi else '') +
            f"{len(groups['order'])} "
            f"order only, {len(groups['labels'])} label numbers only, "
            f"{len(groups['layout'])} block layout only, "
            f"{len(groups['symbols'])} symbols added/removed/renamed, "
            f"{len(groups['other'])} other, {len(groups['status'])} status "
            f"changed, {len(groups['only-old'])}/{len(groups['only-new'])} "
            f"only in baseline/now (report.txt)")
  allowed = len(groups['order']) if ctx.args.asm_allow_order else 0
  return differing == allowed, detail


def step_asm_diff(ctx: Context) -> Tuple[bool, str]:
  return _run_asm_diff(ctx, 'asm-diff', ctx.args.corpus_filter,
                       ctx.args.asm_baseline, ctx.args.asm_new,
                       ctx.args.types, False)


def step_cpp_asm_diff(ctx: Context) -> Tuple[bool, str]:
  return _run_asm_diff(ctx, 'cpp-asm-diff', ctx.args.cpp_corpus_filter,
                       ctx.args.cpp_asm_baseline, ctx.args.cpp_asm_new,
                       'rp,lp', True)


# The filters of the crash sweep: the corpora of the C and C++ milestones with
# the directories they exclude (every test type is run), and the directories
# that the C++ corpus leaves out for M4 plus the CIR tests.
SWEEP_EXTRA_FILTER = 'imported/gnu/cpp/eh/,imported/gnu/cpp/rtti/,cir/'


def read_crash_allowlist(path: Path
                         ) -> Dict[Tuple[str, str], Tuple[str, str, str]]:
  '''The reviewed allowlist of crashes (tests/.edgy/filters/
  cir-excused-crashes.txt): one line per test,

    <test path> | [variant=<options> |] assertion=<text> | <reason>
    <test path> | [variant=<options> |] signal=<SIGSEGV|SIGABRT|...> | <reason>

  variant is the case's options as in the status logs (without it every case
  of the test).  One of assertion and signal is required.  An assertion is a
  literal text that the crash line must contain (the front end's assertion
  line): a test on the list whose crash is another one is not excused.  A
  signal pins a bare signal crash (no identity): the front end must die of
  that signal and its compile output must still equal the reference's
  recording (without the CIR back end's notes); another signal or a
  different output is a problem.  The reason is required.  Patterns are not
  allowed: a path or variant with * ? [ or ] is an error.  # starts a comment
  line.  Returns {(path, variant): (assertion, signal, reason)}.
  '''
  allow: Dict[Tuple[str, str], Tuple[str, str, str]] = {}
  if not path.exists():
    return allow
  for number, raw in enumerate(path.read_text().splitlines(), 1):
    if not raw.strip() or raw.lstrip().startswith('#'):
      continue
    parts = [p.strip() for p in raw.split('|')]
    test, variant, assertion, signal_name = parts[0], '', '', ''
    if len(parts) < 3 or not parts[-1] or not test:
      raise ValueError(f"{path}:{number}: expected '<test path> | "
                       f"[variant=<options> | ](assertion=<text> | "
                       f"signal=<SIGNAL>) | <reason>'")
    for field in parts[1:-1]:
      if field.startswith('variant=') and not variant:
        variant = field[len('variant='):].strip()
      elif field.startswith('assertion=') and not assertion:
        assertion = field[len('assertion='):].strip()
      elif field.startswith('signal=') and not signal_name:
        signal_name = field[len('signal='):].strip()
        if signal_name not in {s.name for s in signal.Signals}:
          raise ValueError(f"{path}:{number}: unknown signal "
                           f"'{signal_name}'")
      else:
        raise ValueError(f"{path}:{number}: unknown field '{field[:30]}'")
    if not assertion and not signal_name:
      raise ValueError(f"{path}:{number}: an assertion= or a signal= is "
                       f"required")
    if assertion and signal_name:
      raise ValueError(f"{path}:{number}: assertion= and signal= are "
                       f"exclusive")
    if re.search(r'[*?\[\]]', test + variant):
      raise ValueError(f"{path}:{number}: patterns are not allowed, list "
                       f"each test")
    allow[(test, variant)] = (assertion, signal_name, parts[-1])
  return allow


def allowlist_excuses(entry: Tuple[str, str, str], result: dict) -> bool:
  '''Whether an allowlist entry excuses a crash: its assertion is in the
  crash line, or the front end died of its signal and the output equals the
  reference's (the reference crashing the same way).'''
  assertion, signal_name, _ = entry
  if assertion:
    return assertion in (result.get('crash_line') or '')
  return (result.get('signal') == signal_name and
          bool(result.get('ref_output_same')) and
          _summary.crash_class(str(result['status'])) ==
          _summary.crash_class(str(result.get('ref_status', ''))) != '')


def is_real_crash(result: dict) -> bool:
  '''Whether a result in the FE_CRASH or LIB_CRASH bucket is a crash: an
  abort or signal, an assertion or internal error, a sanitizer report.  A
  CATASTROPHE status alone (the front end's fatal diagnostic, "1
  catastrophic error detected") is a normal fatal error, not a crash.'''
  text = f"{result.get('crash_line', '')} {result.get('message', '')}"
  return (_summary.crash_class(str(result['status'])) == 'ABORT' or
          _summary._CRASH_REGEX.search(text) is not None or
          _summary._LIB_INTERNAL_REGEX.search(text) is not None)


def sweep_report(results: List[dict], label: str, config: str,
                 killed: List[str],
                 allow: Optional[Dict[Tuple[str, str],
                                      Tuple[str, str, str]]] = None
                 ) -> Tuple[List[str], List[str], List[str], Dict[str, int]]:
  '''The problems of the results of one sweep run.

  Returns (problems, excused, fatal errors, counts) as lines for
  crashes.txt.  A problem is a real crash (see is_real_crash) that
  split_crashes does not excuse, and a killed or timed out test that the
  reference does not have too (its recorded status is not TIMEOUT or
  KILLED).  A fatal error that the reference does not have (a CATASTROPHE
  that is no crash) is listed, but is no problem.  A crash on the reviewed
  allowlist (`allow`, see read_crash_allowlist) is excused, with its reason.
  '''
  allow = allow or {}
  crashes, excused = split_crashes(results)
  problems: List[str] = []
  fatal: List[str] = []
  def line(r: dict, why: str) -> str:
    command = (f"edg-docker-test --non-interactive --posture cir "
               f"--only-configs {config} -T 180 {r['path']}")
    return (f"{label} {r['path']} [{r['test_type']}] "
            f"{r['variant']} {r['status']} {r['bucket']}: "
            f"{r.get('crash_line') or r.get('message', '')[:160]} | "
            f"reference {r.get('ref_status') or 'passes or not recorded'} | "
            f"{why} | reproduce: {command}")
  for r in crashes:
    entry = allow.get((r['path'], r['variant'])) or allow.get(
      (r['path'], ''))
    if is_real_crash(r) and entry is not None and allowlist_excuses(entry,
                                                                    r):
      excused.append(dict(r, _allowed = entry[2]))
    elif is_real_crash(r):
      pinned = ''
      if entry is not None:
        pinned = ("; the test is allowlisted for the assertion "
                  f"'{entry[0]}'" if entry[0] else
                  f"; the test is allowlisted for the signal {entry[1]} with "
                  "the reference's output")
        pinned += ', this crash differs'
      problems.append(line(r, 'not excused: ' +
                           _summary.crash_excuse(r)[1] + pinned))
    else:
      fatal.append(line(r, 'fatal error, not a crash; the reference '
                           'does not have it'))
  for r in results:
    if r['bucket'] in ('KILLED', 'TIMEOUT') and not str(
        r.get('ref_status', '')).startswith(('TIMEOUT', 'KILLED')):
      problems.append(line(r, 'killed or timed out, the reference not'))
  for name in killed:
    if not any(name in p for p in problems):
      problems.append(f"{label} {name}: cancelled by edgy (an X line)")
  excused_lines = [
    line(r, 'excused: ' + (f"allowlisted: {r['_allowed']}" if '_allowed' in r
                           else _summary.crash_excuse(r)[1]))
    for r in excused]
  counts = {'cases': len(results), 'excused': len(excused),
            'fatal': len(fatal), 'problems': len(problems)}
  return problems, excused_lines, fatal, counts


def step_crash_sweep(ctx: Context) -> Tuple[bool, str]:
  '''Run every test type of the C and C++ corpus directories (and of eh/,
  rtti/ and cir/) through edg_x86_64_cir and report the crashes that the
  reference does not have.  The statuses are not gated.'''
  config = 'edg_x86_64_cir'
  step_dir = ctx.out / 'crash-sweep'
  step_dir.mkdir(parents = True, exist_ok = True)
  try:
    allow = read_crash_allowlist(ctx.tree / ctx.args.excused_crashes)
  except ValueError as error:
    return False, f"bad allowlist: {error}"
  used: set = set()
  all_problems: List[str] = []
  excused_all: List[str] = []
  fatal_all: List[str] = []
  parts: List[str] = []
  for label, filters in (('c', ctx.args.corpus_filter),
                         ('c++', ctx.args.cpp_corpus_filter),
                         ('extra', SWEEP_EXTRA_FILTER)):
    started = time.time()
    run = edgy_run(ctx, 'crash-sweep', config, filters, '',
                   timeout = ctx.args.sweep_timeout)
    if run is None:
      return False, f"no run for {label}"
    results, _ = summarize_run(ctx, 'crash-sweep', run, config,
                               f"{label}.json".replace('+', 'x'),
                               text_tag = f"-{label}".replace('+', 'x'))
    killed = killed_tests(ctx, 'crash-sweep', results)
    # A test that edgy cancelled (it ran out of its time under the load of
    # the sweep) is run alone once more: if it completes then, it was slow,
    # not hung, and its result counts as that of the sweep.
    log = step_dir / 'log.txt'
    if log.exists():
      log.rename(step_dir / f"log-{label}.txt".replace('+', 'x'))
    rerun: List[str] = []
    for name in sorted(set(killed)):
      if not name.endswith(('.c', '.cpp', '.cc', '.C', '.cxx')):
        continue
      again = edgy_run(ctx, 'crash-sweep', config, name, '',
                       timeout = ctx.args.sweep_timeout)
      if again is None:
        continue
      more, _ = summarize_run(ctx, 'crash-sweep', again, config,
                              f"{label}-rerun.json".replace('+', 'x'),
                              text_tag = f"-{label}-rerun".replace('+', 'x'))
      cancelled = killed_tests(ctx, 'crash-sweep', more)
      again_log = step_dir / 'log.txt'
      if again_log.exists():
        with open(step_dir / f"log-{label}.txt".replace('+', 'x'),
                  'a') as handle:
          handle.write(f"\n# re-run of {name} alone\n"
                       + again_log.read_text(errors = 'replace'))
        again_log.unlink()
      if not cancelled and more:
        results = [r for r in results if r['path'] != name] + more
        killed = [k for k in killed if k != name]
        rerun.append(name)
    problems, excused, fatal, counts = sweep_report(results, label, config,
                                                    killed, allow)
    used.update(k for k in allow if any(
      r['path'] == k[0] and k[1] in ('', r['variant']) for r in results))
    types = collections_counter(r['test_type'] for r in results)
    parts.append(f"{label}: {counts['cases']} cases "
                 f"({', '.join(f'{t} {n}' for t, n in sorted(types.items()))}"
                 f"), {counts['excused']} excused, {counts['fatal']} fatal "
                 f"errors, {counts['problems']} problem(s), "
                 f"{(time.time() - started) / 60:.0f} min"
                 + (f", {len(rerun)} cancelled test(s) completed when run "
                    f"alone ({', '.join(Path(r).name for r in rerun)})"
                    if rerun else ''))
    all_problems += problems
    excused_all += excused
    fatal_all += fatal
    killed.clear()
    # The log of this run must not count again in the next one.
    log = step_dir / 'log.txt'
    if log.exists():
      log.rename(step_dir / f"log-{label}.txt".replace('+', 'x'))
  (step_dir / 'crashes.txt').write_text(
    '\n'.join(['# CIR-specific crashes, kills and timeouts', *all_problems,
                '# excused: the reference has the same crash', *excused_all,
                '# fatal errors (CATASTROPHE, no crash) that the reference '
                'does not have: not gated', *fatal_all,
                '# allowlist entries (' + ctx.args.excused_crashes + ') '
                'whose test was not run', *(f"{k[0]} | {k[1]}"
                                            for k in sorted(set(allow) -
                                                            used))]
               ) + '\n')
  return not all_problems, '; '.join(parts) + (
    f"; PROBLEMS {len(all_problems)} (crashes.txt)" if all_problems else
    '; no CIR-specific crash')


def collections_counter(items) -> Dict[str, int]:
  counts: Dict[str, int] = {}
  for item in items:
    counts[item] = counts.get(item, 0) + 1
  return counts


# The default limit of the perf step (percent): the instruction count of any
# row (a generated C or C++ file through the front end and the library, the
# library on a generated C++ stream, the corpus totals) may grow by this much
# against the baseline.  The counts are cachegrind Ir, so they do not depend on
# the load of the box: two M4 gate runs of unchanged library code differed by
# at most 0.23% on the library rows (and by 0.02% on the corpus total); the
# front end rows moved by up to 5.7% only when the front end itself changed
# (the pinned test macros).  A deliberate cost (the M4 exception handling was
# +13.6%) is accepted by raising the limit for that gate.
DEFAULT_PERF_MAX_REGRESSION = 2.0


def perf_baseline_path(args: argparse.Namespace) -> str:
  '''The perf regression baseline ("" for none).  --perf-measure-only
  measures and compares with nothing, whatever --perf-baseline says (its
  default names a file that may not exist yet).'''
  if not args.perf_baseline or args.perf_measure_only:
    return ''
  return str(Path(args.perf_baseline).expanduser())


def step_perf(ctx: Context) -> Tuple[bool, str]:
  work = ctx.tree / '.tmp' / 'gate-perf' / ctx.out.name
  work.mkdir(parents = True, exist_ok = True)
  new_json = work / 'perf.json'
  command = (f"python3 dev_tools/bin/edg-cir-perf -j {BUILD_JOBS} "
             f"--big-functions {ctx.args.rss_functions} "
             f"--json {shlex.quote(rel(ctx, new_json))}")
  only = ['big', 'corpus']
  if (ctx.tree / 'cir_src/scripts/ecil-stress-gen.py').exists():
    # The library on a generated C++ stream (a first look at C++ shapes).
    only.append('streams')
    command += ' --stream cxx_funcs:6000'
  if ctx.args.perf_realworld:
    # The pinned real-world units (their library instructions are the
    # targets of slice S1); the Boost ones need the Boost headers inside the
    # tree.
    only.append('realworld')
    command += (f" --units {shlex.quote(ctx.args.perf_realworld)} "
                f"--boost-include {shlex.quote(ctx.args.boost_include)} "
                f"--no-clang")
  if 'cxx' in ctx.args.perf_only:
    # A generated C++ file through the front end (four configurations) and
    # through the default C generating front end and gcc.  The default
    # front end of build/gcc-release must be built first.
    in_cir_env(ctx, 'perf', "cmake --preset linux-gcc-release && cmake "
               f"--build build/gcc-release --target cpfe edg_decode "
               f"edg_prelink -j{BUILD_JOBS}")
    only.append('cxx')
  command += f" --only {','.join(only)}"
  if ctx.args.perf_levels != '0':
    command += f" --levels {ctx.args.perf_levels}"
  if ctx.args.perf_sample > 1:
    command += f" --sample {ctx.args.perf_sample}"
  if in_cir_env(ctx, 'perf', command) != 0 or not new_json.exists():
    return False, 'edg-cir-perf failed (see log.txt)'
  shutil.copy2(new_json, ctx.out / 'perf' / 'perf.json')
  table_command = [sys.executable,
                   str(ctx.tree / 'dev_tools/bin/edg-cir-perf'),
                   '--table-only', '--json', str(new_json)]
  baseline = perf_baseline_path(ctx.args)
  if baseline:
    table_command += ['--baseline', str(Path(baseline).resolve())]
  proc = subprocess.run(table_command, env = ctx.env, text = True,
                        stdout = subprocess.PIPE, stderr = subprocess.STDOUT)
  (ctx.out / 'perf' / 'table.md').write_text(proc.stdout)
  print(proc.stdout, flush = True)
  if proc.returncode != 0:
    return False, 'could not print the table'
  after = json.loads(new_json.read_text())
  problems: List[str] = []
  if baseline:
    if not Path(baseline).exists():
      return False, f"the perf baseline {baseline} does not exist"
    limit = ctx.args.perf_max_regression
    before = json.loads(Path(baseline).read_text())
    worst, compared, problems = perf_worst_change(before, after)
    detail = (f"largest instruction count change {worst:+.2f}% over "
              f"{compared} rows (limit {limit}%; table.md)")
    if compared == 0:
      problems.append('no row of the perf run could be compared with the '
                      'baseline')
    passes = limit is None or worst <= limit
  elif ctx.args.perf_measure_only:
    # No regression check, but the targets below are still evaluated.
    detail = 'measured (--perf-measure-only: no baseline, no limit)'
    passes = True
  else:
    return False, ('no --perf-baseline: nothing to compare with (give one, '
                   'or --perf-measure-only to only measure)')
  if ctx.args.perf_targets:
    # The targets of a slice are against their own baseline (S1: the M5a
    # run), not against the regression baseline.
    targets_file = Path(ctx.args.perf_targets_baseline).expanduser() \
      if ctx.args.perf_targets_baseline else None
    if targets_file is None or not targets_file.exists():
      return False, (f"the targets baseline {targets_file} does not exist "
                     f"(--perf-targets-baseline)")
    perf = _load_tool('edg-cir-perf')
    targets_ok, report = perf.check_targets(
      json.loads(targets_file.read_text()), after, ctx.args.perf_targets)
    (ctx.out / 'perf' / 'targets.txt').write_text('\n'.join(report) + '\n')
    missed = [l for l in report if l.startswith('FAIL')]
    detail += (f" | targets {ctx.args.perf_targets} against "
               f"{targets_file.name}: "
               f"{'met' if targets_ok else 'MISSED'} ({len(report)} rows"
               f"{'; ' + missed[0] if missed else ''}; targets.txt)")
    passes = passes and targets_ok
  if problems:
    return False, 'PROBLEMS: ' + '; '.join(problems[:6]) + ' | ' + detail
  return passes, detail


def perf_worst_change(before: dict, after: dict
                      ) -> Tuple[float, int, List[str]]:
  '''The largest increase (percent, negative if every row shrank) of an
  instruction count between two perf.json files, the number of rows that both
  have, and the problems: a row of the baseline (with a count) that the new
  run lacks or has with a count of zero (which would hide a regression).'''
  worst = None
  compared = 0
  problems: List[str] = []

  def note(old: float, new: float) -> None:
    nonlocal worst, compared
    change = 100.0 * (new - old) / old
    worst = change if worst is None else max(worst, change)
    compared += 1

  for section in ('big', 'big_cxx', 'streams', 'big_O2', 'big_cxx_O2'):
    for name, entry in before.get(section, {}).items():
      old = entry.get('ir')
      if not old:
        continue
      new = after.get(section, {}).get(name, {}).get('ir')
      if new:
        note(old, new)
      else:
        problems.append(f"{section}/{name} is missing or 0 in the new run")
  for key in ('fe_ir', 'cir_ir'):
    old = before.get('corpus', {}).get(key)
    if old:
      new = after.get('corpus', {}).get(key)
      if new:
        note(old, new)
      else:
        problems.append(f"corpus/{key} is missing or 0 in the new run")
  # The real-world units, when this run measured them (--perf-realworld): a
  # unit of the baseline that the run lacks, or that stopped compiling, fails.
  if 'realworld' in after:
    for unit, levels in before.get('realworld', {}).items():
      for level_name, old_entry in levels.items():
        if 'error' in old_entry:
          continue
        new_entry = after['realworld'].get(unit, {}).get(level_name, {})
        for key in ('fe_ir', 'cir_ir'):
          old = old_entry.get(key)
          if not old:
            continue
          new = new_entry.get(key)
          if new:
            note(old, new)
          else:
            problems.append(f"realworld/{unit}/{level_name}/{key} is "
                            f"missing or 0 in the new run")
  return (0.0 if worst is None else worst), compared, problems


# ----------------------------------------------------------------------------
# The steps of gate M4: the ABI and exception harnesses.

# The files of abi-diff whose "missing" blocks are known limits of the tool:
# clang prints the vtable of a class template specialization under the
# template name without its arguments, so Box<int> and Box<double> are one
# name, and ecil-dump prints the mangled name; the blocks cannot be paired.
# (edg-cir-symbols compares their vtables and typeinfo by symbol.)
ABI_KNOWN_LIMITS = {
  'template.cpp': 'clang names Box<int> and Box<double> alike',
  'clone-impl.cpp': 'clang names clone_impl<my_error> without arguments'
}

# The differences of edg-cir-symbols that are accepted, as
# (file, symbol, difference): why.  Each is about the structors of a class
# that has no explicit constructor, which every translation unit emits for
# itself when it uses it (an implicit inline constructor is not an external
# interface), and one spelling of an internal-linkage typeinfo name.
KNOWN_SYMBOL_DIFFERENCES = {
  ('anon.cpp', '_ZN12_GLOBAL__N_14ImplC2Ev', 'missing in ours'):
    'implicit constructor: ours emits only the complete-object variant',
  ('anon.cpp', '_ZN4BaseC2Ev', 'missing in ours'):
    'implicit constructor: ours emits only the complete-object variant',
  ('anon.cpp', '_ZTSN12_GLOBAL__N_14ImplE', 'differs'):
    'the typeinfo name of an internal-linkage class has the "*" prefix of '
    'the Itanium ABI (g++ does too; clang omits it)',
  ('key-external.cpp', '_ZN1AC2Ev', 'missing in ours'):
    'implicit constructor: ours emits only the complete-object variant',
  ('key-external.cpp', '_ZN1BC2Ev', 'missing in ours'):
    'implicit constructor: ours emits only the complete-object variant',
  ('key-external.cpp', '_ZTV1A', 'missing in ours'):
    "ours does not reference the vtable of A: B's constructor sets its own",
  ('no-key.cpp', '_ZN1AD0Ev', 'only in ours'):
    'ours emits the (weak) deleting destructor of A that clang drops',
  ('no-key.cpp', '_ZTV1A', 'only in ours'):
    'ours emits the (weak) vtable of A that clang drops'
}

# The cases of m4-stress, "kind:n": the time (ms) and the peak memory (MB)
# that the measurements of research/m4_stress.md show on the box, multiplied
# by the margins below (5 times the time, at least 2 s; 3 times the memory,
# at least 100 MB).
M4_STRESS_CASES = {
  'wide:2500': (107, 59), 'vchain:500': (585, 82), 'diamond:40': (460, 113),
  'diamond:80': (3887, 590), 'vbases:200': (38, 51), 'tuple:1000': (432, 67),
  'tries:500': (1500, 57), 'news:1250': (2700, 113),
  'unwind:1000': (1060, 80), 'unwindcall:1000': (1080, 88)
}


def stress_limits(measured: Tuple[int, int]) -> Tuple[int, int]:
  '''(time ms, memory MB) limits of an m4-stress case.'''
  return max(2000, 5 * measured[0]), max(100, 3 * measured[1])


def parse_abi_batch(text: str) -> Dict[str, Dict[str, object]]:
  '''The files of the output of `edg-cir-abi-diff batch`: name -> {counts,
  status, missing (the MISSING lines)}; "" if there was no result.'''
  files: Dict[str, Dict[str, object]] = {}
  current: Optional[str] = None
  for line in text.splitlines():
    match = re.match(r'^==== (\S+?): (\w+) (.*)$', line)
    if match:
      current = Path(match.group(1)).name
      counts = {k: int(v) for k, v in re.findall(r'(\w+) (\d+)',
                                                 match.group(3))}
      files[current] = {'status': match.group(2), 'counts': counts,
                        'missing': []}
      continue
    match = re.match(r'^==== (\S+)$', line)
    if match:
      current = Path(match.group(1)).name
      files[current] = {'status': 'NONE', 'counts': {}, 'missing': []}
      continue
    if current and line.startswith('MISSING '):
      files[current]['missing'].append(line)  # type: ignore[union-attr]
  return files


def judge_abi_batch(text: str) -> Tuple[bool, str]:
  '''The rule of the abi-diff step.'''
  if 'SKIP:' in text:
    return False, text.strip().splitlines()[0][:200]
  files = parse_abi_batch(text)
  if len(files) < 10:
    return False, f"only {len(files)} file(s) were compared"
  totals: Dict[str, int] = {}
  problems: List[str] = []
  limited = 0
  for name, entry in sorted(files.items()):
    counts = entry['counts']  # type: ignore[assignment]
    for key, value in counts.items():  # type: ignore[union-attr]
      totals[key] = totals.get(key, 0) + value
    if entry['status'] not in ('PASS', 'DIFF'):
      problems.append(f"{name}: {entry['status']}")
      continue
    for key in ('ours', 'fe', 'unknown'):
      if counts.get(key):  # type: ignore[union-attr]
        problems.append(f"{name}: {counts[key]} {key}")  # type: ignore
    # Every file must have compared something (an empty comparison is not a
    # pass), the files of the known tool limits too.
    compared = (counts.get('identical', 0) +  # type: ignore[union-attr]
                counts.get('spelling', 0))  # type: ignore[union-attr]
    if compared == 0:
      problems.append(f"{name}: no block was compared")
    missing = counts.get('missing', 0)  # type: ignore[union-attr]
    if missing and name in ABI_KNOWN_LIMITS:
      limited += missing
    elif missing:
      problems.append(f"{name}: {missing} missing")
  # A file that failed to compile or dump is listed in the result table.
  for line in text.splitlines():
    match = re.match(r'^(\S+\.cpp)\s+(CLANG-FAIL|DUMP-FAIL|FE-REJECT|SKIP)$',
                     line)
    if match:
      problems.append(f"{match.group(1)}: {match.group(2)}")
  detail = (f"{len(files)} files; identical {totals.get('identical', 0)} "
            f"(+{totals.get('normalized', 0)} normalized, "
            f"{totals.get('spelling', 0)} in the loose form); ours "
            f"{totals.get('ours', 0)}, fe {totals.get('fe', 0)}; "
            f"{limited} missing from known tool limits "
            f"({', '.join(sorted(ABI_KNOWN_LIMITS))})")
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems[:8]) + ' | ' + detail
  return not problems, detail


def parse_symbols(text: str) -> Dict[str, Dict[str, object]]:
  '''The files of the output of `edg-cir-symbols` over several sources:
  name -> {rows: [(symbol, difference)] of ours against the reference,
  notes: SKIP or FAIL lines}.'''
  files: Dict[str, Dict[str, object]] = {}
  current: Optional[str] = None
  in_ours = False
  for line in text.splitlines():
    match = re.match(r'^==== (\S+)$', line)
    if match:
      current = Path(match.group(1)).name
      files[current] = {'rows': [], 'notes': []}
      in_ours = False
      continue
    if current is None:
      continue
    if re.search(r'ABI-family symbols in the reference', line):
      in_ours = True
      continue
    if ' against the reference' in line:
      in_ours = False
      continue
    if line.startswith(('SKIP:', 'FAIL:', 'edg-cir-symbols:')):
      files[current]['notes'].append(line)  # type: ignore[union-attr]
    if in_ours:
      match = re.match(r'^(\S+)\s+(\S+)\s+(missing in ours|only in ours|'
                       r'defined/undefined|differs)\s', line)
      if match:
        files[current]['rows'].append(  # type: ignore[union-attr]
          (match.group(2), match.group(3)))
  return files


def judge_symbols(text: str) -> Tuple[bool, str]:
  '''The rule of the symbols step.'''
  files = parse_symbols(text)
  if len(files) < 10:
    return False, f"only {len(files)} file(s) were compared"
  problems: List[str] = []
  seen = set()
  accepted = 0
  for name, entry in sorted(files.items()):
    for note in entry['notes']:  # type: ignore[union-attr]
      problems.append(f"{name}: {str(note)[:80]}")
    for symbol, difference in entry['rows']:  # type: ignore[union-attr]
      key = (name, symbol, difference)
      if key in KNOWN_SYMBOL_DIFFERENCES:
        seen.add(key)
        accepted += 1
      else:
        problems.append(f"{name}: {symbol} {difference}")
  stale = sorted(k for k in KNOWN_SYMBOL_DIFFERENCES if k not in seen)
  detail = (f"{len(files)} files; {accepted} known difference(s) allowed "
            f"(KNOWN_SYMBOL_DIFFERENCES)"
            + (f"; no longer seen, remove: "
               f"{', '.join(k[1] for k in stale)}" if stale else ''))
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems[:8]) + ' | ' + detail
  return not problems, detail


MIXED_TU_DIRECTIONS = ('ref+ours', 'ours+ref')
MIXED_TU_HOSTS = ('g++', 'clang')


def load_mixed_tu_cases(cases_dir: Path) -> Dict[str, set]:
  '''The cases of edg-cir-mixed-tu in cases_dir: name -> the set of
  directions that the case lists in its xfail file.'''
  tool = _load_tool('edg-cir-mixed-tu')
  return {case.name: set(case.xfail) for case in tool.find_cases(cases_dir)}


def judge_mixed_tu(text: str, cases: Dict[str, set]) -> Tuple[bool, str]:
  '''The rule of one run of the mixed-tu step (one reference compiler):
  exactly one row for every case and direction (the rows of `cases` x
  MIXED_TU_DIRECTIONS), each PASS, or XFAIL for a direction in the xfail set
  of its case.  An XPASS is a stale xfail line and fails.'''
  seen: Dict[Tuple[str, str], str] = {}
  problems: List[str] = []
  for line in text.splitlines():
    # A case whose baseline (all-ref) does not build or run has one such row
    # in place of its direction rows: name it.
    baseline = re.match(r'^(\S+?)\s*all-ref\s+(REF-FAIL)\s*(.*)$', line)
    if baseline:
      problems.append(f"{baseline.group(1)}: REF-FAIL (the baseline itself "
                      f"fails: {baseline.group(3)[:80]})")
      continue
    match = re.match(r'^(\S+?)\s*(ref\+ours|ours\+ref|all-ours)\s+(\S+)', line)
    if not match:
      continue
    key = (match.group(1), match.group(2))
    if key in seen:
      problems.append(f"{key[0]} {key[1]}: two rows")
    seen[key] = match.group(3)
  expected = {(name, d) for name in cases for d in MIXED_TU_DIRECTIONS}
  named = {p.split(':')[0] for p in problems if 'REF-FAIL' in p}
  for key in sorted(expected - set(seen)):
    if key[0] not in named:
      problems.append(f"{key[0]} {key[1]}: no row")
  for key in sorted(set(seen) - expected):
    problems.append(f"{key[0]} {key[1]}: a row that no case expects")
  results: Dict[str, int] = {}
  for key in sorted(expected & set(seen)):
    result = seen[key]
    results[result] = results.get(result, 0) + 1
    if result == 'PASS':
      continue
    if result == 'XFAIL' and key[1] in cases[key[0]]:
      continue
    if result == 'XPASS':
      problems.append(f"{key[0]} {key[1]}: XPASS, remove the direction from "
                      f"its xfail file")
    elif result == 'XFAIL':
      problems.append(f"{key[0]} {key[1]}: XFAIL but not in the xfail file")
    else:
      problems.append(f"{key[0]} {key[1]}: {result}")
  detail = (f"{len(seen)} of {len(expected)} rows (" +
            ', '.join(f"{k} {v}" for k, v in sorted(results.items())) + ')')
  if not cases:
    problems.append('no case found')
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems[:6]) + ' | ' + detail
  return not problems, detail


def parse_stress(text: str) -> List[Tuple[str, int, int, int, int]]:
  '''The lines of box_m4_stress.sh: (kind:n, rc, total ms, rss KB, 0).'''
  rows = []
  for line in text.splitlines():
    match = re.match(r'^(\w+)\s+(\d+)\s+rc=(-?\d+)\s+total_ms=(\d+)\s.*?'
                     r'rss=(\d*)', line)
    if match:
      rows.append((f"{match.group(1)}:{match.group(2)}",
                   int(match.group(3)), int(match.group(4)),
                   int(match.group(5) or 0), 0))
    elif re.match(r'^\w+:\d+ (GEN|ASM)-FAIL', line):
      rows.append((line.split()[0], 99, 0, 0, 0))
  return rows


def judge_stress(text: str) -> Tuple[bool, str]:
  '''The rule of the m4-stress step.'''
  rows = {r[0]: r for r in parse_stress(text)}
  problems = []
  worst = 0.0
  for case, measured in M4_STRESS_CASES.items():
    if case not in rows:
      problems.append(f"{case}: no result")
      continue
    _, rc, total, rss_kb, _ = rows[case]
    limit_ms, limit_mb = stress_limits(measured)
    worst = max(worst, total / limit_ms)
    if rc != 0:
      problems.append(f"{case}: rc {rc}")
    elif total > limit_ms:
      problems.append(f"{case}: {total} ms > {limit_ms} ms")
    elif rss_kb / 1024.0 > limit_mb:
      problems.append(f"{case}: {rss_kb // 1024} MB > {limit_mb} MB")
  detail = (f"{len(rows)} case(s); the slowest at {100 * worst:.0f}% of its "
            f"time limit")
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems[:8]) + ' | ' + detail
  return not problems, detail


def _read_step_output(ctx: Context, step: str, name: str) -> str:
  path = ctx.out / step / name
  return path.read_text(errors = 'replace') if path.exists() else ''


def stage_clang_tests(ctx: Context) -> Optional[str]:
  '''Copy the clang tests of the abi-diff step to .tmp/clang-tests of the
  tree (the container does not have the llvm-project); None if they are not
  there.'''
  tool = importlib.machinery.SourceFileLoader(
    'edg_cir_abi_diff', str(ctx.tree / 'dev_tools/bin/edg-cir-abi-diff'))
  spec = importlib.util.spec_from_loader('edg_cir_abi_diff', tool)
  module = importlib.util.module_from_spec(spec)
  tool.exec_module(module)
  source = Path(ctx.args.llvm_project).expanduser() / \
    'clang/test/CodeGenCXX'
  dest = ctx.tree / '.tmp' / 'clang-tests'
  dest.mkdir(parents = True, exist_ok = True)
  copied = 0
  for name in module.BATCH_TESTS:
    if (source / name).exists():
      shutil.copy2(source / name, dest / name)
      copied += 1
  return str(dest) if copied == len(module.BATCH_TESTS) else None


def step_abi_diff(ctx: Context) -> Tuple[bool, str]:
  if stage_clang_tests(ctx) is None:
    return False, (f"the clang tests are missing from "
                   f"{ctx.args.llvm_project}/clang/test/CodeGenCXX")
  out = rel(ctx, ctx.out / 'abi-diff' / 'batch.txt')
  (ctx.out / 'abi-diff').mkdir(parents = True, exist_ok = True)
  in_cir_env(ctx, 'abi-diff',
             f"python3 dev_tools/bin/edg-cir-abi-diff batch --vbases "
             f"dev_tools/cir-abi-cases/s1 dev_tools/cir-abi-cases/s2 "
             f"--clang-tests .tmp/clang-tests > {out} 2>&1")
  return judge_abi_batch(_read_step_output(ctx, 'abi-diff', 'batch.txt'))


def step_symbols(ctx: Context) -> Tuple[bool, str]:
  out = rel(ctx, ctx.out / 'symbols' / 'symbols.txt')
  (ctx.out / 'symbols').mkdir(parents = True, exist_ok = True)
  in_cir_env(ctx, 'symbols',
             f"python3 dev_tools/bin/edg-cir-symbols "
             f"dev_tools/cir-abi-cases/s1 dev_tools/cir-abi-cases/s2 "
             f"--ref $EDG_LLVM_CIR_PREFIX/bin/clang --also g++ "
             f"> {out} 2>&1")
  return judge_symbols(_read_step_output(ctx, 'symbols', 'symbols.txt'))


def step_mixed_tu(ctx: Context) -> Tuple[bool, str]:
  '''Both hosts: rows = cases x directions x 2 hosts, each PASS or an
  XFAIL that the case lists; an XPASS fails.'''
  (ctx.out / 'mixed-tu').mkdir(parents = True, exist_ok = True)
  cases = load_mixed_tu_cases(ctx.tree / 'dev_tools' / 'cir-mixed-tu-cases')
  parts = []
  ok = True
  for name, ref in (('g++', 'g++'), ('clang',
                                      '$EDG_LLVM_CIR_PREFIX/bin/clang')):
    out = rel(ctx, ctx.out / 'mixed-tu' / f"{name}.txt")
    in_cir_env(ctx, 'mixed-tu',
               f"python3 dev_tools/bin/edg-cir-mixed-tu --ref {ref} "
               f"> {out} 2>&1")
    passed, detail = judge_mixed_tu(
      _read_step_output(ctx, 'mixed-tu', f"{name}.txt"), cases)
    ok = ok and passed
    parts.append(f"{name}: {detail}")
  return ok, '; '.join(parts)


def judge_eh_probes(text: str, skip: set, expected: int
                    ) -> Tuple[bool, str]:
  '''The rule of the eh-probes step: all `expected` probes ran; each is PASS,
  or UNSUPPORTED and on the skip list; a probe of the skip list that passes
  must be removed from it.'''
  results: Dict[str, str] = {}
  for line in text.splitlines():
    match = re.match(r'^(\S+\.cpp)\s*(\w[\w-]*)\*?(?:\s|$)', line)
    if match:
      results[match.group(1)] = match.group(2)
  problems: List[str] = []
  if expected < 1:
    problems.append('no probe file was found (at least one is required)')
  if len(results) != expected:
    problems.append(f"{len(results)} probe(s) ran, {expected} expected")
  for name, result in sorted(results.items()):
    if result == 'PASS':
      if name in skip:
        problems.append(f"{name} passes: remove it from the skip list")
    elif result == 'UNSUPPORTED' and name in skip:
      continue
    else:
      problems.append(f"{name}: {result}")
  passed = sum(1 for r in results.values() if r == 'PASS')
  if passed < 1:
    problems.append('no probe passed')
  detail = (f"{len(results)} probe(s): {passed} PASS, "
            f"{len(results) - passed} UNSUPPORTED (allowed, on the skip list)")
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems[:8]) + ' | ' + detail
  return not problems, detail


def step_eh_probes(ctx: Context) -> Tuple[bool, str]:
  (ctx.out / 'eh-probes').mkdir(parents = True, exist_ok = True)
  out = rel(ctx, ctx.out / 'eh-probes' / 'probes.txt')
  skip = Path(ctx.args.eh_probes_skip)
  skip_option = f"--list-skip {shlex.quote(str(skip))} " \
    if (ctx.tree / skip).exists() else ''
  in_cir_env(
    ctx, 'eh-probes',
    f"python3 dev_tools/bin/edg-cir-run-diff cir_src/test/writer/probes/m4 "
    f"--glob '^(e|s4_|s5_)' {skip_option}> {out} 2>&1")
  text = _read_step_output(ctx, 'eh-probes', 'probes.txt')
  names = set()
  if (ctx.tree / skip).exists():
    for line in (ctx.tree / skip).read_text().splitlines():
      line = line.split('#')[0].strip()
      if line:
        names.add(line)
  probes = [p for p in (ctx.tree / 'cir_src/test/writer/probes/m4').glob(
    '*.cpp') if re.match(r'^(e|s4_|s5_)', p.name)]
  return judge_eh_probes(text, names, len(probes))


def step_m4_stress(ctx: Context) -> Tuple[bool, str]:
  (ctx.out / 'm4-stress').mkdir(parents = True, exist_ok = True)
  out = rel(ctx, ctx.out / 'm4-stress' / 'stress.txt')
  cases = ' '.join(M4_STRESS_CASES)
  in_cir_env(ctx, 'm4-stress',
             f"STRESS_DIR=/tmp/m4stress-gate TMO=300 "
             f"bash cir_src/scripts/box_m4_stress.sh {cases} > {out} 2>&1")
  return judge_stress(_read_step_output(ctx, 'm4-stress', 'stress.txt'))


# ----------------------------------------------------------------------------
# The step opt-corpus: both corpora at -O2 (--cir_opt_level=2).

OPT_LEVEL = 2
# The categories of a status change at -O2 against -O0 (the triage file
# tests/.edgy/filters/cir-opt-triage.txt, one line per test case:
#   <test path> | <variant> | <category> | <reason>
# with the path and variant as in the status JSON of edg-cir-summary).
OPT_CATEGORIES = {
  'ub': 'undefined or unspecified behavior in the test (the reference '
        'compiler changes its behavior between -O0 and -O2 too)',
  'dg-option': 'needs a dg-option that the harness ignores (-fwrapv, '
               '-fno-strict-aliasing)',
  'ref-fails': 'the reference does not pass the test at -O2',
  'our-ir': 'our IR (the writer or the library) is wrong',
  'upstream': 'the upstream CIR passes or LLVM (clang -fclangir -O2 fails '
              'too)'
}
OPT_TRIAGE_FILE = 'tests/.edgy/filters/cir-opt-triage.txt'
OPT_CRASH_BUCKETS = ('FE_CRASH', 'LIB_CRASH', 'TIMEOUT', 'KILLED')
# The -O2 canary: a test that passes at every level and prints whether
# __OPTIMIZE__ is defined, so that its output differs from the -O0 recording
# exactly when -O2 reached the run (status PASS--OUTPUT MISMATCH).
OPT_CANARY = 'cir/config/opt-level-canary.sft.c'
OPT_CANARY_CPP = 'cir/config/opt-level-canary-cpp.sft.cpp'


def read_opt_triage(path: Path) -> Dict[Tuple[str, str], Tuple[str, str]]:
  '''The attributions of the triage file: (path, variant) -> (category,
  reason).  A line with an unknown category raises ValueError.'''
  table: Dict[Tuple[str, str], Tuple[str, str]] = {}
  if not path.exists():
    return table
  for number, line in enumerate(path.read_text().splitlines(), 1):
    line = line.strip()
    if not line or line.startswith('#'):
      continue
    parts = [p.strip() for p in line.split('|', 3)]
    if len(parts) != 4 or parts[2] not in OPT_CATEGORIES:
      raise ValueError(f"{path}:{number}: expected 'path | variant | "
                       f"category | reason' with a category of "
                       f"{sorted(OPT_CATEGORIES)}")
    table[(parts[0], parts[1])] = (parts[2], parts[3])
  return table


def status_map(results: List[dict]) -> Dict[Tuple[str, str], str]:
  '''(test path, variant) -> bucket of the results of edg-cir-summary.'''
  return {(r['path'], r.get('variant', '')): r['bucket'] for r in results}


def judge_opt_changes(before: Dict[Tuple[str, str], str],
                      after: Dict[Tuple[str, str], str],
                      triage: Dict[Tuple[str, str], Tuple[str, str]],
                      label: str) -> Tuple[bool, str, Dict[str, list]]:
  '''The rule for one corpus: `after` (-O2) has exactly the cases of `before`
  (-O0), none is missing; every PASS->not PASS case is in the triage file.  A
  triage line for a case that did not change is stale and fails.  Returns
  (ok, detail, lists) with the lists "unattributed", "stale", "our-ir",
  "improved" and the other categories of the attributed cases.'''
  lists: Dict[str, list] = {'unattributed': [], 'stale': [], 'improved': [],
                            'other': []}
  problems: List[str] = []
  if not before:
    problems.append('no -O0 statuses to compare with')
  if set(after) != set(before):
    problems.append(
      f"{len(after)} case(s) at -O2 against {len(before)} at -O0 "
      f"({len(set(before) - set(after))} missing, "
      f"{len(set(after) - set(before))} new)")
  # PASS -> not PASS, and any new crash, kill or timeout at -O2 whatever the
  # -O0 status was (a FAIL that becomes a crash is a new problem).
  worse = [k for k in sorted(set(before) & set(after))
           if (before[k] == 'PASS' and after[k] != 'PASS') or
           (after[k] in OPT_CRASH_BUCKETS and before[k] not in
            OPT_CRASH_BUCKETS)]
  for key in sorted(set(before) & set(after)):
    if before[key] != 'PASS' and after[key] == 'PASS':
      lists['improved'].append(key)
    elif before[key] != after[key] and key not in worse:
      lists['other'].append(key)
  counts: Dict[str, int] = {}
  for key in worse:
    if key in triage:
      category = triage[key][0]
      counts[category] = counts.get(category, 0) + 1
      lists.setdefault(category, []).append(key)
    else:
      lists['unattributed'].append(key)
  for key in sorted(triage):
    if key not in worse:
      lists['stale'].append(key)
  if lists['unattributed']:
    problems.append(f"{len(lists['unattributed'])} worse case(s) (PASS->FAIL "
                    f"or a new crash) without a triage line, e.g. "
                    f"{lists['unattributed'][0]}")
  if lists['stale']:
    problems.append(f"{len(lists['stale'])} triage line(s) for a case that "
                    f"did not get worse, e.g. {lists['stale'][0]}")
  by_category = ', '.join(f"{k} {v}" for k, v in sorted(counts.items()))
  detail = (f"{label}: {len(after)} cases, {len(worse)} worse "
            f"({by_category or 'none'}), {len(lists['improved'])} FAIL->PASS")
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems) + ' | ' + detail
  return not problems, detail, lists


def judge_opt_asm(o0: Path, o2: Path, label: str) -> Tuple[bool, str]:
  '''The non-vacuity rule for one smoke list: both --save-asm directories
  (edg-cir-compare-modes --opt-level 0 / 2, whose modes comparison also
  passed, so the two-process assembly equals the saved in-process one) have
  the same cases, at least one has assembly, and the assembly of every case
  at -O2 differs from the one at -O0.'''
  try:
    m0 = json.loads((o0 / 'manifest.json').read_text())
    m2 = json.loads((o2 / 'manifest.json').read_text())
  except (OSError, ValueError) as error:
    return False, f"{label}: no manifest ({error})"
  problems: List[str] = []
  if set(m0) != set(m2):
    problems.append(f"the cases differ ({len(set(m0) ^ set(m2))})")
  with_asm = [n for n in sorted(set(m0) & set(m2))
              if m0[n]['asm'] and m2[n]['asm']]
  lost = [n for n in sorted(set(m0) & set(m2))
          if m0[n]['asm'] != m2[n]['asm']]
  if lost:
    problems.append(f"{len(lost)} case(s) with assembly at one level only, "
                    f"e.g. {lost[0]}")
  same = [n for n in with_asm
          if (o0 / n).read_bytes() == (o2 / n).read_bytes()]
  if not with_asm:
    problems.append('no case has assembly')
  if same:
    problems.append(f"{len(same)} case(s) with the same assembly at -O0 and "
                    f"-O2, e.g. {same[0]}")
  detail = f"{label}: {len(with_asm) - len(same)}/{len(with_asm)} differ"
  if problems:
    detail = 'PROBLEMS: ' + '; '.join(problems) + ' | ' + detail
  return not problems, detail


def _o0_statuses(ctx: Context, name: str, fallback: str
                 ) -> Dict[Tuple[str, str], str]:
  '''The -O0 statuses of a corpus: the JSON of the step of this evidence
  directory (`corpus`, `cpp-corpus`), else the baseline directory
  (--opt-baseline-status).'''
  step = {'c': 'corpus', 'cpp': 'cpp-corpus'}[name]
  here = ctx.out / step / 'edg_x86_64_cir.json'
  path = here if here.exists() else (
    Path(ctx.args.opt_baseline_status).expanduser() / fallback)
  if not path.exists():
    return {}
  data = json.loads(path.read_text())
  return status_map(data.get('edg_x86_64_cir', []))


def canary_output(run: Path, config: str, canary_path: str
                  ) -> Optional[str]:
  '''The output that edgy kept of the canary test in a run (the .rt.tar.gz
  of a case whose output differs from its recording), or None if it has
  none.'''
  archive = run / config / re.sub(r'\.[A-Za-z]+$', '', canary_path)
  archive = archive.with_name(archive.name + '.rt.tar.gz')
  if not archive.exists():
    return None
  texts = []
  with tarfile.open(archive) as tar:
    for member in tar.getmembers():
      if member.name.endswith('output.txt'):
        handle = tar.extractfile(member)
        if handle:
          texts.append(handle.read().decode('utf-8', 'replace'))
  return '\n'.join(texts)


def step_opt_corpus(ctx: Context) -> Tuple[bool, str]:
  '''Both corpora at -O2 in edg_x86_64_cir, the smoke lists at -O2 in
  edg_x86_64_cir_2p, and the non-vacuity check on the smoke assembly.

  The level reaches eccp through EDG_CPFE_DEFAULT_OPTIONS (set for the
  edg-docker-test runs of this step only).  Statuses are compared with the
  -O0 statuses of the corpus steps of this evidence directory (or
  --opt-baseline-status), and every PASS->FAIL and every new crash must be
  attributed in the triage file (see OPT_CATEGORIES); the `our-ir` ones are
  listed in our-ir.txt.  Every run also has a canary test (OPT_CANARY, and
  OPT_CANARY_CPP for the C++ runs), which proves that -O2 reached it.'''
  step = 'opt-corpus'
  (ctx.out / step).mkdir(parents = True, exist_ok = True)
  parts: List[str] = []
  ok = True
  runs: Dict[str, List[dict]] = {}
  # The level reaches eccp through EDG_CPFE_DEFAULT_OPTIONS, which edgdocker
  # forwards into the container of the run when it is set (for this process
  # only: nothing is left behind if the step is killed).
  level_env = {'EDG_CPFE_DEFAULT_OPTIONS': f"--cir_opt_level={OPT_LEVEL}"}
  for key, config, filters, types, summary_args in (
      ('c', 'edg_x86_64_cir', ctx.args.corpus_filter, ctx.args.types, []),
      ('cpp', 'edg_x86_64_cir', ctx.args.cpp_corpus_filter, 'rp,lp',
       ['--language', 'cxx', '--types', 'rp,lp']),
      ('c-smoke', 'edg_x86_64_cir_2p', ctx.args.smoke_filter,
       ctx.args.types, []),
      ('cpp-smoke', 'edg_x86_64_cir_2p', ctx.args.cpp_smoke_filter,
       'rp,lp', ['--language', 'cxx', '--types', 'rp,lp'])):
    # The canary rides along in every run: its output differs from its -O0
    # recording exactly when the level reached the run.
    canary_path = OPT_CANARY_CPP if 'cxx' in ' '.join(summary_args) \
      else OPT_CANARY
    run = edgy_run(ctx, step, config, f"{filters},{canary_path}", types,
                   extra_env = level_env)
    if run is None:
      return False, f"no run for {key}"
    results, _ = summarize_run(ctx, step, run, config, f"{key}.json",
                               summary_args, text_tag = f"-{key}")
    canary = [r for r in results if r['path'] == canary_path]
    results = [r for r in results if r['path'] != canary_path]
    seen = canary_output(run, config, canary_path)
    if len(canary) != 1 or canary[0]['status'] != 'PASS--OUTPUT MISMATCH' or \
        (seen is not None and 'canary: optimizing' not in seen):
      ok = False
      parts.append(f"PROBLEMS: {key}: the -O2 canary "
                   f"({canary_path}) did not show -O2 in the run: "
                   f"{[r['status'] for r in canary] or 'it did not run'}")
    runs[key] = results
  killed = killed_tests(ctx, step, [])
  if killed:
    ok = False
    parts.append(f"PROBLEMS: {len(killed)} test(s) killed or cancelled at "
                 f"-O2: {', '.join(killed[:3])}")
  # Statuses against -O0.  A triage line belongs to the corpus that has its
  # case; one that no corpus has is stale.
  triage = read_opt_triage(ctx.tree / OPT_TRIAGE_FILE)
  baselines = {'c': 'c_edg_x86_64_cir.json',
               'cpp': 'cpp_edg_x86_64_cir.json'}
  before = {key: _o0_statuses(ctx, key, baselines[key])
            for key in ('c', 'cpp')}
  absent = [baselines[k] for k in ('c', 'cpp') if not before[k]]
  if absent and not getattr(ctx.args, 'allow_missing_baselines', False):
    return False, (f"no -O0 statuses to compare with: {', '.join(absent)} "
                   f"neither in this evidence directory (corpus, cpp-corpus) "
                   f"nor in --opt-baseline-status {ctx.args.opt_baseline_status}")
  all_lists: Dict[str, Dict[str, list]] = {}
  for key in ('c', 'cpp'):
    mine = {k: v for k, v in triage.items() if k in before[key]}
    passed, detail, lists = judge_opt_changes(
      before[key], status_map(runs[key]), mine, key.upper())
    ok = ok and passed
    parts.append(detail)
    all_lists[key] = lists
  unknown = [k for k in triage if k not in before['c'] and
             k not in before['cpp']]
  if unknown:
    ok = False
    parts.append(f"PROBLEMS: {len(unknown)} triage line(s) for a case that "
                 f"no corpus has, e.g. {unknown[0]}")
  # The smoke lists: every test passes?  (recorded, not required here)
  for key in ('c-smoke', 'cpp-smoke'):
    buckets: Dict[str, int] = {}
    for result in runs[key]:
      buckets[result['bucket']] = buckets.get(result['bucket'], 0) + 1
    if not runs[key]:
      ok = False
    parts.append(f"{key} (2p) {buckets.get('PASS', 0)}/{len(runs[key])}")
  with open(ctx.out / step / 'changes.txt', 'w') as listing:
    for key, lists in all_lists.items():
      for name, items in sorted(lists.items()):
        for item in items:
          note = triage.get(item, ('', ''))
          listing.write(f"{key} {name} {item[0]} [{item[1]}] {note[1]}\n")
  with open(ctx.out / step / 'unattributed.txt', 'w') as listing:
    for key, lists in all_lists.items():
      after = status_map(runs[key])
      for item in lists['unattributed']:
        listing.write(f"{item[0]} | {item[1]} | {after[item]}\n")
  ours = [i for lists in all_lists.values() for i in lists.get('our-ir', [])]
  (ctx.out / step / 'our-ir.txt').write_text(
    ''.join(f"{p} [{v}] {triage[(p, v)][1]}\n" for p, v in ours))
  if ours:
    parts.append(f"{len(ours)} worse case(s) attributed to our IR "
                 f"(our-ir.txt)")
  # Non-vacuity: the assembly of the smoke lists at -O2 differs from -O0 (and
  # the two modes agree at both levels).
  asm_root = ctx.tree / '.tmp' / 'gate-opt' / ctx.out.name
  for key, filters, flags in (
      ('c-smoke', ctx.args.smoke_filter, ''),
      ('cpp-smoke', ctx.args.cpp_smoke_filter, ' --cxx --types rp,lp')):
    for level in (0, OPT_LEVEL):
      target = asm_root / f"{key}-O{level}"
      if target.exists():
        shutil.rmtree(target)
      code = in_cir_env(
        ctx, step, f"python3 dev_tools/bin/edg-cir-compare-modes "
        f"{shlex.quote(filters)} -j {BUILD_JOBS} --opt-level {level} "
        f"--save-asm {rel(ctx, target)}{flags}")
      if code != 0:
        ok = False
        parts.append(f"{key} modes at -O{level}: edg-cir-compare-modes "
                     f"failed (see log.txt)")
    passed, detail = judge_opt_asm(asm_root / f"{key}-O0",
                                   asm_root / f"{key}-O{OPT_LEVEL}", key)
    ok = ok and passed
    parts.append(detail)
  return ok, '; '.join(parts)



# The images the evidence was made with.  A baseline records them in a sidecar
# file (<baseline>.images.txt, see --record-images); a comparison against a
# baseline made with other images says so in the step's detail.
IMAGE_REFS = ('ghcr.io/edgcpp/dev-env:latest',
              'ghcr.io/edgcpp/llvm-cir:latest',
              'ghcr.io/edgcpp/cir-env:latest')


def image_inspect_ref(ref: str) -> str:
  '''The reference that `docker image inspect` gets for an IMAGE_REFS entry:
  the dev-env image that the runs use is the pinned one (edgdocker), not
  whatever ghcr.io/edgcpp/dev-env:latest is on this host; the records keep
  the name of the entry.'''
  if ref == 'ghcr.io/edgcpp/dev-env:latest':
    try:
      import edgdocker
      return edgdocker.get_latest_image_tag('dev-env')
    except ImportError:
      pass
  return ref


def image_ids() -> Dict[str, str]:
  '''The image ID of every IMAGE_REFS entry ("missing" if the image is not
  on this host).'''
  ids: Dict[str, str] = {}
  for ref in IMAGE_REFS:
    proc = subprocess.run(
      docker_argv(['docker', 'image', 'inspect', '--format', '{{.Id}}',
                   image_inspect_ref(ref)]),
      stdout = subprocess.PIPE, stderr = subprocess.DEVNULL, text = True)
    ids[ref] = proc.stdout.strip() if proc.returncode == 0 and \
      proc.stdout.strip() else 'missing'
  return ids


def image_record_path(baseline: str) -> Path:
  '''The sidecar file with the image IDs of a baseline.'''
  path = Path(baseline).expanduser()
  return path.with_name(path.name + '.images.txt')


def write_image_record(baseline: str) -> Path:
  '''Write the current image IDs next to a baseline.'''
  path = image_record_path(baseline)
  path.write_text(''.join(f"{ref} {i}\n" for ref, i in image_ids().items()))
  return path


def read_image_record(path: Path) -> Dict[str, str]:
  '''The image IDs of a record file ({} if it does not exist).  The records
  made before the images moved to ghcr.io name them edgcpp/<image>:latest;
  those names read as the ghcr.io ones.'''
  records: Dict[str, str] = {}
  if path.exists():
    for line in path.read_text().splitlines():
      parts = line.split()
      if len(parts) == 2:
        name = parts[0]
        if name.startswith('edgcpp/'):
          name = f"ghcr.io/{name}"
        records[name] = parts[1]
  return records


def image_note(baseline: str, current: Dict[str, str]) -> str:
  '''"" if the baseline was made with the current images, else the note
  for the step detail (different images, or no record).'''
  if not baseline or not Path(baseline).expanduser().exists():
    return ''
  recorded = read_image_record(image_record_path(baseline))
  if not recorded:
    return f"IMAGES: {Path(baseline).name} has no image record"
  differ = [f"{ref.split('/')[-1].split(':')[0]} "
            f"{recorded.get(ref, 'none')[7:19]} -> "
            f"{current.get(ref, 'none')[7:19]}" for ref in IMAGE_REFS
            if recorded.get(ref) != current.get(ref)]
  return (f"IMAGES DIFFER from the baseline's ({Path(baseline).name}: "
          f"{'; '.join(differ)})" if differ else '')


# The options of the baselines that a step reads (see step_baseline_options
# for perf, which reads fewer in some runs).
STEP_BASELINES = {
  'identity': ('identity_baseline',), 'day': ('day_baseline_run',),
  'day32': ('day32_baseline_run',),
  'asm-diff': ('asm_baseline',), 'cpp-asm-diff': ('cpp_asm_baseline',),
  'corpus': ('status_baseline',), 'cpp-corpus': ('status_baseline',),
  'opt-corpus': ('opt_baseline_status',),
  'perf': ('perf_baseline', 'perf_targets_baseline'),
}


def step_baseline_options(args: argparse.Namespace, step: str
                          ) -> Tuple[str, ...]:
  '''The options of the baselines that `step` reads in this run: perf reads
  the regression baseline unless it only measures, and the targets baseline
  only with --perf-targets (the same rule as baseline_requirements).'''
  options = STEP_BASELINES.get(step, ())
  if step == 'perf':
    options = tuple(
      o for o in options
      if (o == 'perf_baseline' and not args.perf_measure_only) or
      (o == 'perf_targets_baseline' and args.perf_targets))
  return options


def baseline_requirements(args: argparse.Namespace, steps: List[str]
                          ) -> List[Tuple[str, str, str, str]]:
  '''(option, path, kind, steps) of every baseline that the selected steps
  read.  The kinds: `dir` (a directory with files), `manifest` (a directory
  with a manifest.json), `json` (a file with a JSON document) and
  `status:A,B` (a directory with these status JSON files, each with
  results).  The same option and path are listed once.'''
  rows: Dict[Tuple[str, str, str], List[str]] = {}

  def add(step: str, option: str, kind: str) -> None:
    key = (option, str(getattr(args, option.replace('-', '_'), '')), kind)
    rows.setdefault(key, []).append(step)

  configs = [c for c in args.cpp_configs.split(',') if c]
  for step in steps:
    if step == 'identity':
      add(step, 'identity-baseline', 'dir')
    elif step == 'day':
      add(step, 'day-baseline-run', 'dir')
    elif step == 'day32':
      add(step, 'day32-baseline-run', 'dir')
    elif step == 'asm-diff':
      add(step, 'asm-baseline', 'manifest')
    elif step == 'cpp-asm-diff':
      add(step, 'cpp-asm-baseline', 'manifest')
    elif step == 'corpus':
      add(step, 'status-baseline', 'status:c_edg_x86_64_cir.json')
    elif step == 'cpp-corpus':
      add(step, 'status-baseline',
          'status:' + ','.join(f"cpp_{c}.json" for c in configs))
    elif step == 'opt-corpus' and not (
        'corpus' in steps and 'cpp-corpus' in steps):
      add(step, 'opt-baseline-status',
          'status:c_edg_x86_64_cir.json,cpp_edg_x86_64_cir.json')
    elif step == 'perf':
      if not args.perf_measure_only:
        add(step, 'perf-baseline', 'json')
      if args.perf_targets:
        add(step, 'perf-targets-baseline', 'json')
  merged: Dict[Tuple[str, str], Tuple[List[str], List[str]]] = {}
  for (option, path, kind), names in rows.items():
    kinds, used = merged.setdefault((option, path), ([], []))
    kinds.append(kind)
    used.extend(n for n in names if n not in used)
  result = []
  for (option, path), (kinds, used) in merged.items():
    files = sorted({f for k in kinds if k.startswith('status:')
                    for f in k[7:].split(',')})
    kind = ('status:' + ','.join(files)) if files else kinds[0]
    result.append((option, path, kind, ','.join(used)))
  return result


def baseline_state(path: str, kind: str) -> Tuple[bool, str]:
  '''(usable, what is wrong or the size) of one baseline.'''
  if not path:
    return False, 'no path (option not set)'
  target = Path(path).expanduser()
  if not target.exists():
    return False, 'MISSING'

  def readable(file: Path) -> Tuple[bool, str]:
    if not file.is_file() or file.stat().st_size == 0:
      return False, f"{file.name} missing or empty"
    try:
      data = json.loads(file.read_text())
    except ValueError:
      return False, f"{file.name} is not JSON"
    if not data:
      return False, f"{file.name} has no content"
    if kind.startswith('status:') and not any(
        isinstance(v, list) and v for v in data.values()):
      return False, f"{file.name} has no results"
    return True, ''

  if kind == 'json':
    ok, why = readable(target)
    return ok, why or f"{target.stat().st_size} bytes"
  if not target.is_dir():
    return False, 'not a directory'
  if kind == 'manifest':
    ok, why = readable(target / 'manifest.json')
    return ok, why or f"{len(list(target.iterdir()))} entries"
  if kind.startswith('status:'):
    for name in kind[7:].split(','):
      ok, why = readable(target / name)
      if not ok:
        return False, why
    return True, kind[7:]
  count = sum(1 for _ in target.iterdir())
  return count > 0, f"{count} entries" if count else 'EMPTY'


def check_baselines(args: argparse.Namespace, steps: List[str]
                    ) -> Tuple[bool, List[str]]:
  '''(all usable, table lines): the baselines that the steps need, with
  path, state and whether the images match the current ones.'''
  rows = baseline_requirements(args, steps)
  current = image_ids() if rows else {}
  lines = ['| option | path | state | images | steps |',
           '| --- | --- | --- | --- | --- |']
  ok = True
  for option, path, kind, used in rows:
    usable, state = baseline_state(path, kind)
    ok = ok and usable
    note = image_note(path, current) if path else ''
    images = ('same' if not note else
              'none recorded' if 'no image record' in note else 'DIFFER')
    lines.append(f"| --{option} | {path} | "
                 f"{'ok: ' if usable else 'FAIL: '}{state} | "
                 f"{images if usable else '-'} | {used} |")
  if not rows:
    lines.append('| (no selected step reads a baseline) | | | | |')
  return ok, lines


# The support table's gate (cir_src/doc/support/make_support.py --gate): the
# gate whose thresholds support-sweep enforces.  Every gate sets it to its
# own id (it must be one of make_support.py's GATES).
SUPPORT_GATE = 'M6.1a'
SUPPORT_DIR = 'cir_src/doc/support'
SUPPORT_FEATURES = 'tests/tests/cir/features'
# The configurations that the sweep runs; the second one only runs the
# tests of the cir suite (the corpora are not run in it).
SUPPORT_CONFIGS = ('edg_x86_64_cir', 'edg_x86_64_cir_2p')
MIXED_TU_CASES = 'dev_tools/cir-mixed-tu-cases'


def support_selection(sections: List[dict], features: List[str]
                      ) -> Dict[str, List[str]]:
  '''The tests that the rows of the support table name, by how the sweep
  runs them.  `edgy`: `<suite>/<test>` of tests/tests that must pass (and
  all of `features`, the tests of tests/tests/cir/features); `failing`:
  those the rows call failing (they run, but are expected to fail as
  recorded); `lit`: the paths under cir_src/test (ctest runs them);
  `mixed`: the case directories of dev_tools/cir-mixed-tu-cases.'''
  edgy = set(features)
  failing = set()
  lit = set()
  mixed = set()
  for section in sections:
    for group in section.get('groups', []):
      for row in group.get('rows', []):
        for test in row.get('tests', []):
          path = str(test.get('path', ''))
          if path.startswith('tests/tests/'):
            name = path[len('tests/tests/'):]
            (failing if test.get('kind') == 'failing' else edgy).add(name)
          elif path.startswith(MIXED_TU_CASES + '/'):
            mixed.add(path[len(MIXED_TU_CASES) + 1:].split('/')[0])
          elif path.startswith('cir_src/test/'):
            lit.add(path)
  return {'edgy': sorted(edgy), 'failing': sorted(failing - edgy),
          'lit': sorted(lit), 'mixed': sorted(mixed)}


def feature_tests(tree: Path) -> List[str]:
  '''`<suite>/<test>` of every test file of tests/tests/cir/features (the
  recordings of .*.rto directories and hidden files are not tests).'''
  base = tree / SUPPORT_FEATURES
  tests_dir = tree / 'tests' / 'tests'
  if not base.is_dir():
    return []
  return sorted(
    str(path.relative_to(tests_dir)) for path in base.rglob('*')
    if path.is_file() and '.sft.' in path.name and
    not any(part.startswith('.') for part in path.relative_to(base).parts))


def judge_support_run(config: str, selection: Dict[str, List[str]],
                      results: List[dict], log_text: str
                      ) -> Tuple[List[str], str]:
  '''(problems, a note) of one edgy run of the sweep: a result for every
  test that the rows name (a vacuous run is a problem); every case of the
  tests that must pass passes; and no line differs from the recorded
  expectations (which also holds the failing tests to their statuses).  The
  second configuration only runs the cir suite.'''
  problems: List[str] = []
  wanted = [n for n in [*selection['edgy'], *selection['failing']]
            if config == SUPPORT_CONFIGS[0] or n.startswith('cir/')]
  if not results:
    return [f"{config}: no results"], ''
  by_path: Dict[str, List[dict]] = {}
  for result in results:
    by_path.setdefault(result['path'], []).append(result)
  missing = [n for n in wanted if n not in by_path]
  if missing:
    problems.append(f"{config}: {len(missing)} named test(s) did not run: "
                    f"{', '.join(missing[:5])}")
  must_pass = set(selection['edgy'])
  bad = [f"{n} [{r.get('variant', '')}] {r['status']}"
         for n in sorted(must_pass & set(by_path))
         for r in by_path[n] if r['bucket'] != 'PASS']
  if bad:
    problems.append(f"{config}: {len(bad)} case(s) do not pass: "
                    f"{'; '.join(bad[:5])}")
  changes = [l for l in log_text.splitlines() if re.match(r'^[+-] \S', l)]
  if changes:
    problems.append(f"{config}: {len(changes)} line(s) differ from the "
                    f"recorded expectations: {'; '.join(changes[:3])}")
  return problems, f"{config} {len(results)} cases of {len(wanted)} tests"


def earlier_result(ctx: Context, step: str) -> Optional[str]:
  '''The status ("PASS" or "FAIL") that `step` recorded in this evidence
  directory, or None if it has not run.'''
  path = ctx.out / step / 'result.json'
  if not path.exists():
    return None
  return str(json.loads(path.read_text()).get('status'))


def support_external(ctx: Context, selection: Dict[str, List[str]]
                     ) -> Tuple[List[str], List[str]]:
  '''(problems, notes) for the paths that the edgy runs do not cover: the
  lit and lib tests under cir_src/test (the ctest step's result of this
  evidence, else ctest in build/cir) and the mixed-tu cases (the mixed-tu
  step's result, else the named cases run with g++ and with clang).'''
  problems: List[str] = []
  notes: List[str] = []
  if selection['lit']:
    earlier = earlier_result(ctx, 'ctest')
    if earlier is None:
      code = in_cir_env(
        ctx, 'support-sweep',
        f"ctest --test-dir build/cir --output-on-failure -j{BUILD_JOBS}",
        extra_env = {'LIT_OPTS': f"-j{BUILD_JOBS}"})
      earlier = 'PASS' if code == 0 else 'FAIL'
      notes.append(f"ctest ran in build/cir: {earlier}")
    else:
      notes.append(f"ctest of this evidence: {earlier}")
    if earlier != 'PASS':
      problems.append(f"{len(selection['lit'])} lit/lib test path(s): "
                      'ctest does not pass')
  if selection['mixed']:
    earlier = earlier_result(ctx, 'mixed-tu')
    if earlier is None:
      tool = _load_tool('edg-cir-mixed-tu')
      cases_dir = ctx.tree / MIXED_TU_CASES
      expected = {case.name: set(case.xfail) for name in selection['mixed']
                  for case in tool.expand_case(cases_dir / name)}
      earlier = 'PASS'
      for name, ref in (('g++', 'g++'), ('clang',
                                          '$EDG_LLVM_CIR_PREFIX/bin/clang')):
        out = rel(ctx, ctx.out / 'support-sweep' / f"mixed-tu-{name}.txt")
        in_cir_env(ctx, 'support-sweep',
                   f"python3 dev_tools/bin/edg-cir-mixed-tu --ref {ref} "
                   f"{' '.join(selection['mixed'])} > {out} 2>&1")
        passed, detail = judge_mixed_tu(
          _read_step_output(ctx, 'support-sweep', f"mixed-tu-{name}.txt"),
          expected)
        if not passed:
          earlier = 'FAIL'
          problems.append(f"mixed-tu with {name}: {detail}")
      notes.append(f"{len(selection['mixed'])} mixed-tu case(s) ran: "
                   f"{earlier}")
    else:
      notes.append(f"mixed-tu of this evidence: {earlier}")
      if earlier != 'PASS':
        problems.append(f"{len(selection['mixed'])} mixed-tu case(s): the "
                        'mixed-tu step does not pass')
  return problems, notes


def step_support_sweep(ctx: Context) -> Tuple[bool, str]:
  '''Run every test that the rows of the support table name (and all of
  tests/tests/cir/features, at -O0 and -O2 through their cases) in
  edg_x86_64_cir, and the cir ones also in edg_x86_64_cir_2p; take the lit
  and mixed-tu paths from the ctest and mixed-tu results of this evidence
  (or run them); then run make_support.py --check --gate SUPPORT_GATE.'''
  step_dir = ctx.out / 'support-sweep'
  step_dir.mkdir(parents = True, exist_ok = True)
  support = ctx.tree / SUPPORT_DIR
  sections = [json.loads(path.read_text()) for path in
              sorted(support.glob('*.json'))]
  selection = support_selection(sections, feature_tests(ctx.tree))
  names = [*selection['edgy'], *selection['failing']]
  problems: List[str] = []
  notes: List[str] = []
  for config in SUPPORT_CONFIGS:
    chosen = [n for n in names
              if config == SUPPORT_CONFIGS[0] or n.startswith('cir/')]
    filter_file = step_dir / f"tests-{config}.txt"
    filter_file.write_text('\n'.join(chosen) + '\n')
    try:
      filter_name = str(filter_file.relative_to(ctx.tree))
    except ValueError:
      filter_name = str(filter_file)
    log_file = step_dir / 'log.txt'
    before = log_file.read_text(errors = 'replace') if log_file.exists() \
      else ''
    run = edgy_run(ctx, 'support-sweep', config, f"@{filter_name}", '')
    if run is None:
      problems.append(f"{config}: no run")
      continue
    results, _ = summarize_run(ctx, 'support-sweep', run, config,
                               f"{config}.json")
    log_text = log_file.read_text(errors = 'replace')[len(before):]
    found, note = judge_support_run(config, selection, results, log_text)
    problems += found
    notes.append(note)
  found, more = support_external(ctx, selection)
  problems += found
  notes += more
  code = run_logged(
    ctx, 'support-sweep',
    [sys.executable, str(support / 'make_support.py'), '--check', '--gate',
     SUPPORT_GATE])
  log_text = (step_dir / 'log.txt').read_text(errors = 'replace')
  last = re.findall(r'^gate \S+: \d+ errors, \d+ warnings$', log_text, re.M)
  notes.append(f"make_support.py --check --gate {SUPPORT_GATE}: "
               f"{last[-1] if last else 'no result line'}")
  if code != 0 or not last:
    problems.append(f"make_support.py --check --gate {SUPPORT_GATE} "
                    f"failed (exit {code})")
  detail = '; '.join(notes)
  if problems:
    detail = f"PROBLEMS: {'; '.join(problems[:6])} | {detail}"
  return not problems, detail


STEP_FUNCTIONS: Dict[str, Callable[[Context], Tuple[bool, str]]] = {
  'build': step_build, 'identity': step_identity,
  'isolation': step_isolation, 'smoke': step_smoke, 'corpus': step_corpus,
  'modes': step_modes, 'stress': step_stress,
  'writer-stress': step_writer_stress,
  'cpp-smoke': step_cpp_smoke, 'cpp-corpus': step_cpp_corpus,
  'cpp-modes': step_cpp_modes, 'cpp-writer-stress': step_cpp_writer_stress,
  'cir-suite': step_cir_suite, 'poison': step_poison, 'release-smoke': step_release_smoke, 'cpp-stress': step_cpp_stress, 'cpp-stress-asan': step_cpp_stress_asan,
  'rss': step_rss,
  'day': step_day, 'day32': step_day32, 'ctest': step_ctest, 'asm-diff': step_asm_diff,
  'cpp-asm-diff': step_cpp_asm_diff,
  'tools-test': step_tools_test, 'lazy-identity': step_lazy_identity,
  'attr-diff': step_attr_diff, 'codequality': step_codequality,
  'chunk-identity': step_chunk_identity, 'chunk-rss': step_chunk_rss,
  'slow-below-threshold': step_slow_below_threshold,
  'names-check': step_names_check, 'support-sweep': step_support_sweep,
  'crash-sweep': step_crash_sweep, 'abi-diff': step_abi_diff,
  'symbols': step_symbols, 'mixed-tu': step_mixed_tu,
  'eh-probes': step_eh_probes, 'm4-stress': step_m4_stress,
  'opt-corpus': step_opt_corpus,
  'perf': step_perf
}


def main() -> None:
  parser = argparse.ArgumentParser(description = __doc__.split('\n')[0],
                                   formatter_class =
                                   argparse.RawDescriptionHelpFormatter,
                                   epilog = __doc__.split('\n', 2)[2])
  parser.add_argument('--tree', default = '.')
  parser.add_argument('--out', default = '',
                      help = 'evidence directory (reuse one to resume)')
  parser.add_argument('--only', default = '', help = 'comma separated steps')
  parser.add_argument('--skip', default = '', help = 'comma separated steps')
  parser.add_argument('--lean', default = '', metavar = 'AREAS',
                      help = 'lean gate: run the steps that these changed '
                             'areas can affect (' + ','.join(AREA_STEPS) +
                             '; see the docstring), the others SKIPPED '
                             'with a reason')
  parser.add_argument('--lean-base', default = '', metavar = 'REF',
                      help = 'the area check of --lean: the changed files '
                             'are those of `git diff --name-only REF` and '
                             'the untracked ones')
  parser.add_argument('--changed-files', default = '', metavar = 'FILE',
                      help = 'the area check of --lean: the changed files, '
                             'one path a line ("-": standard input)')
  parser.add_argument('--allow-empty-change-set', action = 'store_true',
                      help = '--lean with no changed file at all (it fails '
                             'otherwise: usually a wrong --lean-base)')
  parser.add_argument('--no-area-check', action = 'store_true',
                      help = '--lean without comparing the areas with the '
                             'change set')
  parser.add_argument('--steps-for', default = '', metavar = 'AREAS',
                      help = 'print the steps of --lean for these areas '
                             'and exit')
  parser.add_argument('--force', action = 'store_true',
                      help = 're-run steps that already PASSed')
  parser.add_argument('--check-baselines', action = 'store_true',
                      help = 'print the baselines that the selected steps '
                             'need, with their state, and exit (1 if one is '
                             'missing or empty)')
  parser.add_argument('--allow-missing-baselines', action = 'store_true',
                      help = 'run although a baseline is unusable: the status '
                             'checks are then off (the detail says so)')
  parser.add_argument('--record-images', default = '', metavar = 'BASELINE',
                      help = 'write the image IDs next to BASELINE '
                             '(BASELINE.images.txt) and exit')
  parser.add_argument('--identity-baseline',
                      default = '~/edg-cir-config/identity-m6r',
                      help = 'identity capture of the M6.R gate tree (a '
                             'edg-macro-identity-check capture tree)')
  parser.add_argument('--identity-allow', default = IDENTITY_ALLOW,
                      help = 'the allow-list of the identity step (a file of '
                             'the tree: the files whose preprocessed output '
                             'may differ from the baseline, each with its '
                             'reason; "" for none)')
  parser.add_argument('--day-baseline-run',
                      default = DEFAULT_DAY_BASELINE,
                      help = 'tests/runs/<ts> of a full day suite of the '
                             'baseline commit (day-base tree)')
  parser.add_argument('--day32-baseline-run',
                      default = DEFAULT_DAY32_BASELINE,
                      help = 'tests/runs/<ts> of a full 32-bit day suite '
                             '(edg_x86_32, edg_x86_32_cp) of the baseline '
                             'commit (day-base/baseline-32; step day32)')
  parser.add_argument('--day32-posture', default = DEFAULT_DAY32_POSTURE,
                      help = 'the posture file of the day32 step (a path in '
                             'the tree: the i686 build and the two 32-bit '
                             'configurations)')
  parser.add_argument('--day-filter', default = '',
                      help = 'run only these suites in the day step (for '
                             'trying the script; the gate run has none)')
  parser.add_argument('--asm-baseline',
                      default = '~/edg-cir-config/m6r-base-asm',
                      help = 'directory of the corpus assembly of the '
                             'baseline commit (step asm-diff)')
  parser.add_argument('--asm-new', default = '',
                      help = 'compare this --save-asm directory instead of '
                             'compiling the corpus (step asm-diff)')
  parser.add_argument('--cpp-asm-baseline',
                      default = '~/edg-cir-config/m6r-base-cpp-asm',
                      help = 'directory of the C++ corpus assembly of the '
                             'baseline commit (step cpp-asm-diff)')
  parser.add_argument('--cpp-asm-new', default = '',
                      help = 'compare this --save-asm directory instead of '
                             'compiling the C++ corpus (step cpp-asm-diff)')
  parser.add_argument('--asm-normalize-cfi', action = 'store_true',
                      help = 'remove the frame description directives '
                             '(.cfi_startproc, .cfi_def_cfa*, .cfi_offset, '
                             '...; not .cfi_personality, .cfi_lsda, '
                             '.cfi_escape) from both sides in asm-diff and '
                             'cpp-asm-diff (every function has an unwind '
                             'table); off by default')
  parser.add_argument('--asm-allow-order', action = 'store_true',
                      help = 'asm-diff passes if files differ only in the '
                             'order of their lines')
  parser.add_argument('--perf-baseline',
                      default = '~/edg-cir-config/m6r-base-perf.json',
                      help = 'perf.json of the baseline commit for the '
                             'regression check (step perf; default: the M6.R '
                             'gate\'s)')
  parser.add_argument('--perf-targets-baseline',
                      default = '~/edg-cir-config/m5a-base-perf.json',
                      help = 'perf.json that --perf-targets compares with '
                             '(S1: the M5a run, which has the real-world '
                             'section)')
  parser.add_argument('--perf-levels', default = None,
                      help = 'optimization levels of the big files of the '
                             'perf step (0,2 adds the -O2 rows big_O2 and '
                             'big_cxx_O2; the default is 0, the M4 set, and '
                             '0,2 with --milestone)')
  parser.add_argument('--perf-measure-only', action = 'store_true',
                      help = 'step perf may run without a baseline (pass '
                             '--perf-baseline "" and this); it then only '
                             'measures')
  parser.add_argument('--perf-max-regression', type = float,
                      default = DEFAULT_PERF_MAX_REGRESSION,
                      help = 'step perf fails if an instruction count grows '
                             'by more than this many percent (default '
                             f"{DEFAULT_PERF_MAX_REGRESSION})")
  parser.add_argument('--perf-realworld', default = None, metavar = 'UNITS',
                      help = 'the perf step also measures these real-world '
                             'units (`pinned`: the pinned list, at the '
                             '--perf-levels), for the S1 targets; needs '
                             '--boost-include for the Boost units (default: '
                             'none, `pinned` with --milestone)')
  parser.add_argument('--perf-targets', default = None, metavar = 'NAME',
                      help = 'the perf step also checks the targets of a '
                             'slice (edg-cir-perf --targets; `s1`) against '
                             '--perf-targets-baseline, which needs the same '
                             'sections (the M5a one has the real-world one; '
                             'default: none, `s1` with --milestone)')
  parser.add_argument('--boost-include', default = '.tmp/boost-inc',
                      help = 'the Boost headers (merged into one tree, '
                             'inside the tree) for the pinned Boost units '
                             'of the perf step and the lazy-identity step')
  parser.add_argument('--chunk-target', type = float, default = 0.55,
                      help = 'the forced-chunking peak of c12000 may be at '
                             'most this share of the unchunked peak of the '
                             'same run (S3)')
  parser.add_argument('--perf-only', default = 'cxx',
                      help = 'extra measurements of the perf step: cxx (a '
                             'generated 6000-function C++ file, with the C '
                             'generating baseline); "" for none')
  parser.add_argument('--perf-sample', type = int, default = 1,
                      help = 'step perf measures every Nth corpus case only '
                             '(for trying the script)')
  parser.add_argument('--keep-ctest-builds', action = 'store_true',
                      help = 'the ctest step reuses the existing cir_src '
                             'build directories instead of wiping them')
  parser.add_argument('--allow-status-changes', action = 'store_true',
                      help = 'the corpus step may differ from the recorded '
                             'expectations (it then lists the lines)')
  parser.add_argument('--with-cpp', action = 'store_true',
                      help = 'also run the C++ steps (cpp-smoke, cpp-corpus, '
                             'cpp-modes, cpp-writer-stress)')
  parser.add_argument('--tree-fingerprint', default = '',
                      help = 'the fingerprint of the tree (edg-cir-checkpoint '
                             'computes it); written at the top of summary.md')
  parser.add_argument('--command-timeout', type = int,
                      default = COMMAND_TIMEOUT,
                      help = 'the time limit (seconds) of one command of a '
                             'step: it is killed, the step\'s containers '
                             'stop and the step fails (STEP_TIMEOUTS has '
                             'shorter limits for some steps)')
  parser.add_argument('--stress-timeout', type = int, default = 3600,
                      help = 'per-case limit of edg-cir-stress in the stress '
                             'step (the 20000-rung else-if ladder takes '
                             'about 24 minutes on clang4 and 3 minutes on '
                             'the old box: it is quadratic and latency '
                             'bound)')
  parser.add_argument('--step-timeout', action = 'append', default = [],
                      metavar = 'STEP=SECONDS',
                      help = 'a time limit for the commands of one step')
  parser.add_argument('--milestone', action = 'store_true',
                      help = 'the steps of a milestone gate (the M5 gate in '
                             'particular): every step, which is --with-cpp '
                             'and --with-m4; lazy-identity (lazy against '
                             '--eager-bodies over both corpora and the '
                             'pinned units) is one of them')
  parser.add_argument('--with-m4', action = 'store_true',
                      help = 'also run the steps of gate M4 (abi-diff, '
                             'symbols, mixed-tu, eh-probes, m4-stress)')
  parser.add_argument('--llvm-project',
                      default = '~/edg-cir-config/llvm-project',
                      help = 'the llvm-project checkout that has the clang '
                             'tests of the abi-diff step (copied into '
                             '.tmp/clang-tests)')
  parser.add_argument('--eh-probes-skip',
                      default = 'tests/.edgy/filters/cir-eh-probes-skip.txt',
                      help = 'probes for which the eh-probes step accepts an '
                             'unsupported-construct diagnostic')
  parser.add_argument('--excused-crashes',
                      default = 'tests/.edgy/filters/cir-excused-crashes.txt',
                      help = 'the reviewed allowlist of crashes that the '
                             'crash-sweep step excuses (one line per test)')
  parser.add_argument('--sweep-timeout', type = int, default = 180,
                      help = 'per-test limit (-T) of the crash-sweep step')
  parser.add_argument('--cpp-configs',
                      default = 'edg_x86_64_cir,edg_x86_64_cir_2p',
                      help = 'the configs of the C++ steps')
  parser.add_argument('--cpp-smoke-filter',
                      default = '@tests/.edgy/filters/cir-cpp-smoke.txt')
  parser.add_argument('--cpp-corpus-filter',
                      default = '@tests/.edgy/filters/cir-cpp-corpus.txt')
  parser.add_argument('--cpp-stress-seconds', type = int, default = 30,
                      help = 'time limit of a case of the cpp-stress steps; '
                             'a case is also killed at a hard limit of 10 '
                             'times this (20 times for cpp-stress-asan), '
                             'which is a TIMEOUT failure')
  parser.add_argument('--cpp-stress-rss-mb', type = int, default = 400,
                      help = 'peak memory limit of a case of cpp-stress')
  parser.add_argument('--cpp-stress-asan-rss-mb', type = int, default = 1200,
                      help = 'peak memory limit of a case of cpp-stress-asan '
                             '(the sanitizer inflates memory about 3x)')
  parser.add_argument('--cpp-smoke-all-pass', action = 'store_true',
                      help = 'cpp-smoke fails unless every test passes (the '
                             'M3 gate)')
  parser.add_argument('--smoke-filter',
                      default = '@tests/.edgy/filters/cir-c-smoke.txt')
  parser.add_argument('--status-baseline',
                      default = '~/edg-cir-config/m6r-base-status',
                      help = 'directory with the statuses of the baseline '
                             '(c_edg_x86_64_cir.json, cpp_<config>.json): '
                             'the corpus and cpp-corpus steps fail on a '
                             'PASS->not PASS case unless '
                             'tests/.edgy/filters/cir-status-triage.txt has '
                             'a line for it (an empty value is a setup '
                             'error, status 2; --allow-missing-baselines '
                             'turns the check off)')
  parser.add_argument('--opt-baseline-status',
                      default = '~/edg-cir-config/m6r-base-status',
                      help = 'directory with the -O0 statuses of both '
                             'corpora (c_edg_x86_64_cir.json, '
                             'cpp_edg_x86_64_cir.json) for the opt-corpus '
                             'step when this evidence directory has no '
                             'corpus and cpp-corpus step')
  parser.add_argument('--corpus-filter',
                      default = '@tests/.edgy/filters/cir-c-corpus.txt')
  parser.add_argument('--types', default = 'rp,lp')
  parser.add_argument('--jobs', type = int, default = 12,
                      help = 'parallel build and test jobs')
  parser.add_argument('--rss-functions', type = int,
                      default = RSS_DEFAULT_FUNCTIONS,
                      help = 'functions of the generated files of the rss '
                             'step (the ceilings are for the default)')
  parser.add_argument('--rss-template-units', type = int,
                      default = RSS_DEFAULT_TEMPLATE_UNITS,
                      help = 'units of the template-heavy C++ file of the '
                             'rss step')
  parser.add_argument('--identity-presets', default = ','.join(PRESETS),
                      help = 'CMake presets of the identity step')
  parser.add_argument('--ctest-presets', default = '',
                      help = 'cir_src presets of the ctest step (default: '
                             'every one)')
  args = parser.parse_args()

  skip_reasons: Dict[str, str] = {}
  lean_areas = [a for a in (args.lean or args.steps_for).split(',') if a]
  bad_areas = [a for a in lean_areas if a not in AREA_STEPS]
  if bad_areas or (args.lean and args.steps_for):
    parser.error(f"unknown area(s): {', '.join(bad_areas) or 'both options'}"
                 f"; the areas are {', '.join(AREA_STEPS)}")
  if lean_areas:
    if args.only:
      parser.error('--lean and --only exclude each other (use --skip)')
    check = args.lean_base or args.changed_files
    if args.lean and not check and not args.no_area_check:
      parser.error('--lean needs the change set to check the areas against: '
                   '--lean-base REF or --changed-files FILE (or '
                   '--no-area-check, and say why in the report)')
    if check:
      try:
        paths = changed_paths(Path(args.tree).resolve(), args.lean_base,
                              args.changed_files)
      except (OSError, RuntimeError) as error:
        parser.error(f"cannot list the changed files: {error}")
      problems = uncovered_areas(paths, lean_areas)
      print(f"change set: {len(paths)} file(s), areas "
            f"{','.join(sorted(required_areas(paths))) or 'none'}")
      if args.lean and not paths and not args.allow_empty_change_set:
        parser.error('--lean with an empty change set: nothing differs '
                     f"from {args.lean_base or args.changed_files} (a wrong "
                     '--lean-base?); --allow-empty-change-set if that is '
                     'meant')
      if problems:
        parser.error('; '.join(problems))
    lean_set, skip_reasons = lean_steps(lean_areas)
    print(f"lean gate for {','.join(lean_areas)}: run "
          f"{', '.join(lean_set)}")
    for step, reason in skip_reasons.items():
      print(f"  skipped {step}: {reason}")
    if args.steps_for:
      sys.exit(0)
    args.only = ','.join(lean_set)

  resolve_perf_options(args)
  if args.milestone and args.allow_missing_baselines:
    parser.error('--allow-missing-baselines turns the status checks off and '
                 'is refused with --milestone')
  global BUILD_JOBS
  BUILD_JOBS = args.jobs
  if args.record_images:
    print(f"wrote {write_image_record(args.record_images)}")
    sys.exit(0)
  only = [s for s in args.only.split(',') if s] or default_steps(
    args.with_cpp or args.milestone, args.with_m4 or args.milestone)
  skip = set(s for s in args.skip.split(',') if s)
  unknown = [s for s in [*only, *skip] if s not in STEPS]
  if unknown:
    parser.error(f"unknown step(s): {', '.join(unknown)}")
  selected = [s for s in STEPS if s in only and s not in skip]
  # A baseline that is missing or empty is a failure, not a silent skip.
  baselines_ok, baseline_lines = check_baselines(args, selected)
  baseline_problems = [
    f"{cells[0]} {cells[1]}: {cells[2][6:]}" for cells in
    ([c.strip() for c in l.split('|')[1:-1]] for l in baseline_lines)
    if len(cells) == 5 and cells[2].startswith('FAIL:')]
  if args.check_baselines or not baselines_ok:
    print('\n'.join(baseline_lines))
  if args.check_baselines:
    sys.exit(0 if baselines_ok else 1)
  if not baselines_ok and not args.allow_missing_baselines:
    print('a baseline that a selected step needs is missing or empty '
          '(--allow-missing-baselines runs anyway, with the checks off)',
          file = sys.stderr)
    sys.exit(2)
  ctx = Context(args)
  ctx.out.mkdir(parents = True, exist_ok = True)
  (ctx.out / 'baselines.txt').write_text('\n'.join(baseline_lines) + '\n')
  images = image_ids()
  (ctx.out / 'images.txt').write_text(
    ''.join(f"{ref} {i}\n" for ref, i in images.items()))

  print(f"evidence directory: {ctx.out}")
  table: List[Tuple[str, str, str, float]] = []
  for step in STEPS:
    if step not in only or step in skip:
      table.append((step, 'SKIPPED',
                    skip_reasons.get(step, 'not selected'), 0.0))
      continue
    result_file = ctx.out / step / 'result.json'
    if result_file.exists() and not args.force:
      previous = json.loads(result_file.read_text())
      if previous['status'] == 'PASS':
        table.append((step, 'PASS', previous['detail'] + ' (cached)', 0.0))
        print(f"{step}: PASS (cached)")
        continue
    # Every execution starts with a clean log.
    old_log = ctx.out / step / 'log.txt'
    if old_log.exists():
      old_log.unlink()
    print(f"{step}: running ...", flush = True)
    started = time.time()
    try:
      passed, detail = STEP_FUNCTIONS[step](ctx)
    except Exception as error:  # a broken step must not hide the others
      passed, detail = False, f"script error: {error!r}"
    seconds = time.time() - started
    notes = []
    for option in step_baseline_options(args, step):
      note = image_note(str(getattr(args, option, '')), images)
      if note and note not in notes:
        notes.append(note)
    if notes:
      detail = f"{detail} | {'; '.join(notes)}"
    if step in ctx.timed_out:
      passed = False
      detail = (f"TIMEOUT: {len(ctx.timed_out[step])} command(s) stopped at "
                f"their limit ({ctx.timed_out[step][0]}) | {detail}")
    status = 'PASS' if passed else 'FAIL'
    (ctx.out / step).mkdir(parents = True, exist_ok = True)
    result_file.write_text(json.dumps(
      {'status': status, 'detail': detail, 'seconds': round(seconds)}
    ))
    table.append((step, status, detail, seconds))
    print(f"{step}: {status} - {detail}", flush = True)

  lines = ['| step | result | detail | time |', '| --- | --- | --- | ---: |']
  for step, status, detail, seconds in table:
    lines.append(f"| {step} | {status} | {detail} | {seconds:.0f} s |")
  summary = '\n'.join(lines)
  if args.tree_fingerprint:
    summary = f"Tree fingerprint: {args.tree_fingerprint}\n\n" + summary
  summary = ('Images: ' + ', '.join(
    f"{ref.split('/')[-1]} {i[7:19]}" for ref, i in images.items()) +
    '\n\n' + summary)
  if args.allow_missing_baselines:
    summary = ('WARNING: --allow-missing-baselines: ' + (
      f"{len(baseline_problems)} baseline(s) were unusable and the status "
      f"checks that read them are OFF ({'; '.join(baseline_problems)})"
      if baseline_problems else 'every baseline was usable') +
      '\n\n' + summary)
  (ctx.out / 'summary.md').write_text(summary + '\n')
  print('\n' + summary)
  failed = [t for t in table if t[1] == 'FAIL']
  print(f"\nGATE: {'FAIL' if failed else 'PASS'} "
        f"({len(failed)} failing step(s)); evidence in {ctx.out}")
  sys.exit(1 if failed else 0)


if __name__ == '__main__':
  main()
