; C++ (ECIL 1.2): the null value of a union that contains a pointer to a data
; member.  Like clang's EmitNullConstant, only the first member of the union
; is filled in with its null constant (a data member pointer is -1; the rest
; of the union is zero): the first-member pointer of U reads as null, V's first
; member is a long 0.  Also an array of U and a struct that holds a U.
;   struct D { int a, b; };  union U { int D::*p; long x; };
;   union V { long x; int D::*p; };  struct S { int k; U u; };
;   U gu1; V gv; U gu_arr[2]; S gs;       (all zero-initialized)
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -std=c++17 -w %S/Inputs/s4_union_null_host.cpp %t.o -o %t.exe
; RUN: %t.exe
; RUN: %edg-cir --emit=obj -O2 -o %t2.o %t.ecil
; RUN: g++ -std=c++17 -w %S/Inputs/s4_union_null_host.cpp %t2.o -o %t2.exe
; RUN: %t2.exe

; CHECK-DAG: @gu1 = #cir.const_record<{#cir.data_member<null>
; CHECK-DAG: @gv = #cir.const_record<{#cir.int<0>

frame DECLS
  STR 100 "D"
  STR 101 "a"
  STR 102 "b"
  STR 103 "U"
  STR 104 "V"
  STR 105 "S"
  STR 106 "p"
  STR 107 "x"
  STR 108 "k"
  STR 109 "u"
  STR 110 "gu1"
  STR 111 "gv"
  STR 112 "gu_arr"
  STR 113 "gs"
  TY_RECORD_DECL 201 0 100
  TY_RECORD_BODY 201 8 8 4 0 2
  REC_FIELD 1 0 nil nil 101 0
  REC_FIELD 1 4 nil nil 102 0
  TY_DATA_MEMBER 232 1 201
  TY_RECORD_DECL 202 1 103
  TY_RECORD_BODY 202 8 8 8 0 2
  REC_FIELD 232 0 nil nil 106 0
  REC_FIELD 3 0 nil nil 107 0
  TY_RECORD_DECL 203 1 104
  TY_RECORD_BODY 203 8 8 8 0 2
  REC_FIELD 3 0 nil nil 107 0
  REC_FIELD 232 0 nil nil 106 0
  TY_RECORD_DECL 204 0 105
  TY_RECORD_BODY 204 16 16 8 0 2
  REC_FIELD 1 0 nil nil 108 0
  REC_FIELD 202 8 nil nil 109 0
  TY_ARRAY 205 202 2 0
  DECL_VAR 301 202 0 1 8 110
  DECL_VAR 302 203 0 1 8 111
  DECL_VAR 303 205 0 1 8 112
  DECL_VAR 304 204 0 1 8 113
frame REGION
  C_ZERO 202
  VAR_INIT 301
  C_ZERO 203
  VAR_INIT 302
  C_ZERO 205
  VAR_INIT 303
  C_ZERO 204
  VAR_INIT 304
frame END
  END auto 0
