; An ECIL 1.2 flag on a 1.0 record: a VIRTUAL_BASE field.
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 4'

; CHECK: ECIL 1.2 record REC_FIELD with the VIRTUAL_BASE flag is not supported yet

frame DECLS
  STR 10 "V"
  STR 11 "D"
  TY_RECORD_DECL 21 0 10
  TY_RECORD_BODY 21 4 4 4 0 1
  REC_FIELD 1 0 nil nil nil 0
  TY_RECORD_DECL 22 0 11
  TY_RECORD_BODY 22 8 8 4 0 1
  REC_FIELD 21 4 nil nil nil 64
frame END
  END auto 0
