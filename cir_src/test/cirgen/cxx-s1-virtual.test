; C++ (ECIL 1.2, slice S1): polymorphism without virtual bases.  A class with
; its own vptr (A) and a derived class that shares it (B): the .base record of
; A (nvsize 12 in a 16-byte class), VPTR_INIT in constructors and destructors
; (the address points of _ZTV1A and _ZTV1B), a virtual call through slot 0, a
; virtual delete through D0 (slot 2), the vtables, the class typeinfo (class and
; single-inheritance) and the synthesized deleting destructors.  The program
; checks the dispatch and the destruction order.
;   struct A { virtual int f(int); virtual ~A(); int x; A(); };
;   struct B : A { int f(int) override; ~B(); int y; B(); };
;   int A::f(int v) { return v + 1; }  int B::f(int v) { return v + 2; }
;   int use(A *p) { return p->f(10); }
;   int main() { B b; int r = use(&b); A *q = new B; r += q->f(0);
;                delete q; return (r - 14) + (g_d - 2); }
; RUN: cat %S/Inputs/header12_cxx_rtti.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; CHECK-DAG: !rec_A2Ebase = !cir.struct<"A.base" packed {data !cir.vptr, data !s32i}>
; CHECK-DAG: !rec_A = !cir.struct<"A" packed {data !cir.vptr, data !s32i, pad !cir.array<!u8i x 4>}>
; CHECK-DAG: !rec_B = !cir.struct<"B" {data !rec_A2Ebase, data !s32i}>
; CHECK-LABEL: cir.func {{.*}}@_ZN1AD0Ev
; CHECK: cir.cleanup.scope {
; CHECK: cir.call @_ZN1AD1Ev
; CHECK: } cleanup normal {
; CHECK: cir.call @_ZdlPvm({{.*}}) nothrow
; CHECK-LABEL: cir.func {{.*}}@_ZN1AC2Ev
; CHECK: cir.vtable.address_point(@_ZTV1A, address_point = <index = 0, offset = 2>) : !cir.vptr
; CHECK: cir.vtable.get_vptr
; CHECK-LABEL: cir.func {{.*}}@_ZN1BC2Ev
; CHECK: cir.call @_ZN1AC2Ev
; CHECK: cir.vtable.address_point(@_ZTV1B, address_point = <index = 0, offset = 2>) : !cir.vptr
; CHECK-LABEL: cir.global {{.*}}@_ZTI1A = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv117__class_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTS1A> : !cir.ptr<!u8i>}>
; CHECK: cir.global {{.*}}@_ZTV1A = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1A> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1A1fEi> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1AD1Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1AD0Ev> : !cir.ptr<!u8i>]>
; CHECK: cir.global {{.*}}@_ZTI1B = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv120__si_class_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTS1B> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1A> : !cir.ptr<!u8i>}>
; CHECK: cir.global {{.*}}@_ZTV1B = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1B> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1B1fEi> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1BD1Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1BD0Ev> : !cir.ptr<!u8i>]>
; CHECK-LABEL: cir.func {{.*}}@_Z3useP1A
; CHECK: cir.vtable.get_vptr
; CHECK: cir.vtable.get_virtual_fn_addr {{.*}}[0]
; CHECK-LABEL: cir.func {{.*}}@main
; CHECK: cir.vtable.get_virtual_fn_addr {{.*}}[2]
; CHECK-DAG: cir.global {{.*}}@_ZTS1B = #cir.const_array<"1B"

; SYMS-DAG: D _ZTV1A
; SYMS-DAG: D _ZTV1B
; SYMS-DAG: D _ZTI1A
; SYMS-DAG: D _ZTI1B
; SYMS-DAG: T _ZN1AD0Ev
; SYMS-DAG: T _ZN1BD0Ev
; SYMS-DAG: R _ZTS1A
; SYMS-DAG: R _ZTS1B

