; C++ (ECIL 1.2, slice S1): vptrs in constants (12.7).  No record names a vptr:
; the constant of a dynamic class lists its data members, and the library
; stores every vptr of the object: for a base subobject the address point of
; the vtable group of the complete object's class (the B base of D is the
; primary base, shares the vptr at 0 and gets the address point of _ZTV1D),
; for a member that of the member's own class (M::b: _ZTV1B).  The program
; calls through the vtable that the constants hold.
;   struct B { int x; virtual int f() const; constexpr B(int v) : x(v) {} };
;   struct C { int c; };
;   struct D : C, B { int y; constexpr D() : C{3}, B(7), y(9) {}
;                     int f() const override { return B::f() + y; } };
;   struct M { B b; int m; constexpr M() : b(2), m(5) {} };
;   const D gd;  const M gm;
;   int main() { const B *p = &gd; return (p->f() - 16) + (gm.b.f() - 2); }
; RUN: cat %S/Inputs/header12_cxx_rtti.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: cir.global constant external dso_local @gd = #cir.const_record<{#cir.const_record<{#cir.global_view<@_ZTV1D, [0 : i32, 2 : i32], address_point true> : !cir.vptr, #cir.int<7> : !s32i}> : !rec_B2Ebase, #cir.const_record<{#cir.int<3> : !s32i}> : !rec_C, #cir.int<9> : !s32i, #cir.zero : !cir.array<!u8i x 4>}> : !rec_D
; CHECK-DAG: cir.global constant external dso_local @gm = #cir.const_record<{#cir.const_record<{#cir.global_view<@_ZTV1B, [0 : i32, 2 : i32], address_point true> : !cir.vptr, #cir.int<2> : !s32i, #cir.zero : !cir.array<!u8i x 4>}> : !rec_B, #cir.int<5> : !s32i, #cir.zero : !cir.array<!u8i x 4>}> : !rec_M

