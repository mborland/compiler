ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S3): typeid and dynamic_cast as the writer streams them:
; typeid of a polymorphic glvalue (through the vtable, null-checked for *p) and
; of a type (static), dynamic_cast to a derived class, to a class with a virtual
; base, across (M1 to M2 in Both), to void * and to a reference.
;   &typeid(*pa) == &typeid(B); dynamic_cast<C *>(pa) == nullptr; dynamic_cast<M2 *>(m1)
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: %edg-cir --emit=obj -O2 -o %t.o2.o %t.ecil
; RUN: g++ %t.o2.o -o %t.o2.exe
; RUN: %t.o2.exe

; CHECK-DAG: cir.vtable.get_type_info
; CHECK-DAG: cir.dyn_cast ptr
; CHECK-DAG: cir.dyn_cast ref
; CHECK-DAG: cir.dyn_cast ptr %{{.*}} : !cir.ptr<!rec_A> -> !cir.ptr<!void>

