ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): a diamond with a virtual base.  L and R derive virtually
; from V (polymorphic), X derives from both: X has a vptr in each of L and R and
; V as a virtual base at offset 32.  Checks the hidden VTT parameter of C2, the
; VTT_ADDR operands (the sub-VTT of L and R) in C1 and C2, VPTR_INIT (static
; address points in C1; vtt.address_point loads in C2, the virtual base's vptr
; stored through the vbase offset read from the vtable), the VTT (_ZTT1X), its
; construction vtables (_ZTC1X0_1L, _ZTC1X16_1R) and the virtual thunks
; (_ZTv0_n24_) of the destructors.  The program reads the virtual base through
; all three paths and calls virtual functions through them.
;   struct V { int v; V(); virtual ~V(); virtual int f(); };
;   struct L : virtual V { int l; L(); };  struct R : virtual V { int r; R(); };
;   struct X : L, R { int x; X(); };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1XC1Ev(%arg0: !cir.ptr<!rec_X>)
; CHECK: cir.base_class_addr nonnull %{{.*}} [32] : !cir.ptr<!rec_X> -> !cir.ptr<!rec_V>
; CHECK: cir.call @_ZN1VC2Ev(
; CHECK: cir.vtt.address_point @_ZTT1X, offset = 1
; CHECK: cir.call @_ZN1LC2Ev({{.*}}) nothrow : (!cir.ptr<!rec_L>, !cir.ptr<!cir.ptr<!void>>) -> ()
; CHECK: cir.vtt.address_point @_ZTT1X, offset = 3
; CHECK: cir.call @_ZN1RC2Ev(
; CHECK: cir.vtable.address_point(@_ZTV1X, address_point = <index = 0, offset = 3>)
; CHECK: cir.vtable.address_point(@_ZTV1X, address_point = <index = 2, offset = 4>)
; CHECK-LABEL: cir.func {{.*}}@_ZN1XC2Ev(%arg0: !cir.ptr<!rec_X>, %arg1: !cir.ptr<!cir.ptr<!void>>)
; CHECK: cir.vtt.address_point %arg1 : !cir.ptr<!cir.ptr<!void>>, offset = 1
; CHECK: cir.call @_ZN1LC2Ev(
; CHECK: cir.vtt.address_point %arg1 : !cir.ptr<!cir.ptr<!void>>, offset = 3
; CHECK: cir.call @_ZN1RC2Ev(
; CHECK: cir.vtt.address_point %arg1 : !cir.ptr<!cir.ptr<!void>>, offset = 0
; CHECK: cir.vtt.address_point %arg1 : !cir.ptr<!cir.ptr<!void>>, offset = 5
; CHECK: cir.const #cir.int<-24> : !s64i
; CHECK: cir.ptr_stride
; CHECK: cir.vtt.address_point %arg1 : !cir.ptr<!cir.ptr<!void>>, offset = 6
; CHECK-LABEL: cir.func {{.*}}@_ZN1XD1Ev(%arg0: !cir.ptr<!rec_X>)
; CHECK: cir.vtt.address_point @_ZTT1X, offset = 0
; CHECK: cir.call @_ZN1XD2Ev({{.*}}) nothrow : (!cir.ptr<!rec_X>, !cir.ptr<!cir.ptr<!void>>) -> ()
; CHECK: cir.base_class_addr nonnull %{{.*}} [32] : !cir.ptr<!rec_X> -> !cir.ptr<!rec_V>
; CHECK: cir.call @_ZN1VD2Ev(
; CHECK-DAG: cir.global {{.*}}@_ZTT1X = #cir.const_array<[#cir.global_view<@_ZTV1X, [0 : i32, 3 : i32], address_point true> : !cir.ptr<!u8i>, #cir.global_view<@_ZTC1X0_1L, [0 : i32, 3 : i32], address_point true> : !cir.ptr<!u8i>, #cir.global_view<@_ZTC1X0_1L, [1 : i32, 4 : i32], address_point true> : !cir.ptr<!u8i>, #cir.global_view<@_ZTC1X16_1R, [0 : i32, 3 : i32], address_point true>
; CHECK-DAG: cir.global {{.*}}@_ZTC1X0_1L = #cir.vtable<
; CHECK-DAG: cir.global {{.*}}@_ZTC1X16_1R = #cir.vtable<
; CHECK-DAG: cir.func {{.*}}@_ZTv0_n24_N1XD1Ev

