; C++ flag bits on existing records (here LOCAL TEMPORARY) are rejected by the
; emitter as "not supported yet", not ignored.
; RUN: cat %S/Inputs/header08.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 4'

; CHECK: LOCAL: C++ constructs (ECIL v1 flag bits) are not supported yet

frame DECLS
  STR 10 "f"
  TY_FUNC 21 11 0 []
  DECL_FUNC 40 21 0 1 10
frame REGION
  FUNC_BEGIN 40 0
  LOCAL 1 1 nil 4 2
  FUNC_END 1
frame END
  END auto 0
