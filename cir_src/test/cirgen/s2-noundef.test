; S2: noundef on the parameters and results of functions and calls, by type,
; as CIRGen's determineNoUndef: every scalar (integer, bool, floating point,
; pointer) argument and parameter, not a record by value.  The result of a C++
; function is noundef too, with three exceptions: an extern "C" function (the
; DECL_FUNC flag EXTERN_C, 0x100), a function with a value-less `return;` in
; its body (a GNU extension here; the library's own guard against promising
; a value that is not defined), and everything in C (a C result is never
; marked).  Variadic arguments are noundef.  The calls of such a function
; carry the same result attribute, judged by the callee.
; RUN: sed 's/^ecil 1.2/ecil 1.3/' %S/Inputs/header12_cxx_eh.txt > %t.h
; RUN: cat %t.h %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --no-llvm-passes --emit=llvm %t.ecil | %FileCheck %s
; RUN: cat %S/Inputs/header.txt %S/s2-noundef-c.inc > %t.c.txt
; RUN: %ecil-asm %t.c.txt -o %t.c.ecil
; RUN: %edg-cir --no-llvm-passes --emit=llvm %t.c.ecil | %FileCheck %s --check-prefix=C

; CHECK-DAG: declare noundef i32 @scalars(i32 noundef, double noundef, ptr noundef, i1 noundef zeroext, i32)
; CHECK-DAG: declare i32 @extern_c(i32 noundef)
; CHECK-DAG: define {{.*}}i32 @valueless(i32 noundef %0)
; CHECK-DAG: define {{.*}}noundef i32 @normal(i32 noundef %0)
; CHECK-LABEL: define {{.*}}noundef i32 @main()
; CHECK: call noundef i32 @scalars(i32 noundef 1, double noundef {{.*}}, ptr noundef {{.*}}, i1 noundef zeroext {{.*}}, i32 %{{.*}})
; CHECK: call i32 @extern_c(i32 noundef 2)
; CHECK: call i32 @valueless(i32 noundef 3)
; CHECK: call noundef i32 @normal(i32 noundef 4)
; C: declare i32 @cf(i32 noundef)
; C: call i32 @cf(i32 noundef 5)

frame DECLS
  STR 100 "scalars"
  STR 101 "extern_c"
  STR 102 "valueless"
  STR 103 "normal"
  STR 104 "main"
  STR 105 "R"
  STR 106 "r"
  TY_RECORD_DECL 30 0 105
  TY_RECORD_BODY 30 4 4 4 0 1
  REC_FIELD 1 0 nil nil 106 0
  TY_PTR 31 1
  TY_FUNC 40 1 0 [1, 10, 31, 15, 30]
  TY_FUNC 41 1 0 [1]
  TY_FUNC 42 1 0 []
  DECL_FUNC 50 40 0 0 100
  DECL_FUNC 51 41 0 256 101
  DECL_FUNC 52 41 0 1 102
  DECL_FUNC 53 41 0 1 103
  DECL_FUNC 54 42 0 9 104
frame REGION
  FUNC_BEGIN 52 0
  PARAM 1 1 1 nil 0
  RETURN_STMT false
  FUNC_END 0
  FUNC_BEGIN 53 0
  PARAM 1 1 1 nil 0
  LREF 1
  LOAD 0
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 54 0
  LOCAL 1 30 nil 4 0
  LOCAL 2 1 nil 4 0
  CONST_INT 1 1
  CONST_FLOAT 10 f64:0x4000000000000000
  CONST_NULL 31
  CONST_INT 15 1
  LREF 1
  LOAD 0
  CALL 50 40 5 0
  DROP
  CONST_INT 1 2
  CALL 51 41 1 0
  DROP
  CONST_INT 1 3
  CALL 52 41 1 0
  DROP
  CONST_INT 1 4
  CALL 53 41 1 0
  DROP
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
