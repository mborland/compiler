; C++ (ECIL v1): the destruction of an NRVO variable on the exits that are not
; the return.  The writer sends the usual cleanup for the variable; the consumer
; guards it with CIRGen's "nrvo" flag, which RETURN_FROM_SLOT sets, so a goto out
; of the scope destroys the object and the return does not:
;   A foo() { int cnt = 3; lab: A a; if (cnt--) goto lab; return a; }
;   main: foo();  -> 4 constructions, 4 destructions in all
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_Z3foov
; CHECK: cir.alloca "nrvo"
; CHECK: cir.goto "
; CHECK: } cleanup normal {
; CHECK: cir.not
; CHECK: cir.call @_ZN1AD1Ev

frame DECLS
  STR 11 "A"
  STR 12 "_ZN1AC1Ev"
  STR 13 "_ZN1AD1Ev"
  STR 14 "_Z3foov"
  STR 15 "main"
  STR 16 "g_ctor"
  STR 17 "g_dtor"
  STR 18 "cnt"
  TY_RECORD_DECL 31 0 11
  TY_RECORD_BODY 31 4 4 4 12 1
  REC_FIELD 1 0 nil nil nil 0
  TY_PTR 32 31
  TY_FUNC 33 11 0 [32]
  TY_FUNC 34 31 0 []
  TY_FUNC 35 1 0 []
  DECL_FUNC 100 33 0 1 12
  DECL_FUNC 101 33 0 1 13
  DECL_FUNC 102 34 0 1 14
  DECL_FUNC 103 35 0 9 15
  DECL_VAR 301 1 0 1 4 16
  DECL_VAR 302 1 0 1 4 17
frame REGION
  FUNC_BEGIN 100 0
  PARAM 1 32 32 nil 1
  GREF 301
  GREF 301
  LOAD 0
  CONST_INT 1 1
  ADD 1
  STORE 0 0
  FUNC_END 1
  FUNC_BEGIN 101 0
  PARAM 1 32 32 nil 1
  GREF 302
  GREF 302
  LOAD 0
  CONST_INT 1 1
  ADD 1
  STORE 0 0
  FUNC_END 1
  FUNC_BEGIN 102 0
  BLOCK_BEGIN
  LOCAL 1 1 18 0 0
  LREF 1
  CONST_INT 1 3
  STORE 0 0
  LABEL 2 nil
  LOCAL 3 31 nil 0 1
  LREF 3
  ADDR
  CALL 100 33 1 0
  CLEANUP_BEGIN 3 nil 0
  LREF 3
  ADDR
  CALL 101 33 1 0
  CLEANUP_BODY
  LREF 1
  INC_DEC 3 1
  TO_BOOL
  IF_BEGIN false
  BLOCK_BEGIN
  GOTO_STMT 2 0
  BLOCK_END
  IF_END
  RETURN_FROM_SLOT
  BLOCK_END
  FUNC_END 0
  FUNC_BEGIN 103 0
  BLOCK_BEGIN
  FULLEXPR_BEGIN
  LOCAL 1 31 nil 0 2
  LREF 1
  CALL 102 34 0 0
  STORE 2 0
  CLEANUP_BEGIN 3 nil 0
  LREF 1
  ADDR
  CALL 101 33 1 0
  CLEANUP_BODY
  FULLEXPR_END
  GREF 301
  LOAD 0
  CONST_INT 1 4
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 1
  RETURN_STMT true
  IF_END
  GREF 302
  LOAD 0
  CONST_INT 1 4
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 2
  RETURN_STMT true
  IF_END
  CONST_INT 1 0
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame END
  END auto 0
