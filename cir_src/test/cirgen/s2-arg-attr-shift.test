frame GLOBALS
  STR 25 "1A"
  CLASS_MANGLE 5 25
  CLASS_INFO 5 4 4 nil 0
  CLASS_BASES 5 []
  DECL_ABI_DATA 24 2 5 3 3 nil
  DECL_ABI_DATA 25 2 16 3 3 nil
  DECL_ABI_DATA 26 0 16 3 3 nil
  DECL_ABI_DATA 27 1 16 3 3 nil
frame NAMES
frame END
  END 8 0
