; ZERO_BYTES through a glvalue rooted in a named object (here a FIELD of a
; local) is bounded by that glvalue's type: 8 bytes through a 4-byte int field
; would write into the next field's neighbour.  Only a glvalue made by DEREF
; (the first element of a new[] allocation) may exceed its type.
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s

; CHECK: error [1001]: ZERO_BYTES of 8 bytes through a glvalue of a 4-byte type: more than the object it designates

frame DECLS
  STR 100 "S"
  STR 102 "f"
  TY_RECORD_DECL 201 0 100
  TY_RECORD_BODY 201 8 8 4 0 2
  REC_FIELD 1 0 nil nil nil 0
  REC_FIELD 1 4 nil nil nil 0
  TY_FUNC 204 11 0 []
  DECL_FUNC 300 204 0 1 102
frame REGION
  FUNC_BEGIN 300 0
  LOCAL 1 201 nil 4 0
  LREF 1
  FIELD 201 0
  ZERO_BYTES 8
  FUNC_END 1
frame END
  END auto 0
