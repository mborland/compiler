ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): Boost's exception wrapper shape: clone_impl<T> : T,
; virtual clone_base, a template instance whose class has a polymorphic
; non-virtual base, a polymorphic virtual base with pure virtual functions, and
; overrides (clone, rethrow) that need virtual thunks.
;   struct clone_base { virtual ~clone_base(); virtual clone_base *clone() const = 0;
;                       virtual void rethrow() const = 0; };
;   template <class T> struct clone_impl : T, virtual clone_base { ... };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK: cir.global {{.*}}@_ZTT10clone_implI8my_errorE =
; CHECK: cir.func {{.*}}@_ZTv0_n32_NK10clone_implI8my_errorE5cloneEv
; CHECK: cir.func {{.*}}@_ZTv0_n40_NK10clone_implI8my_errorE7rethrowEv

