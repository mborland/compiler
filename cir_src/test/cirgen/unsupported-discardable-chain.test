; Unsupported policy, chains: an unreferenced internal function `dead_user`
; that calls a dropped internal function `dropped` goes with it (its body would
; name an erased symbol); the whole chain vanishes.  `live_user` is called from
; main and also calls a dropped function: that one stays an error (second RUN).
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: cat %S/Inputs/header08_cxx.txt %S/Inputs/unsupported_chain_live.txt > %t2.txt
; RUN: %ecil-asm %t2.txt -o %t2.ecil
; RUN: %not %edg-cir --emit=cir %t2.ecil 2>&1 | %FileCheck %s --check-prefix=LIVE
; CHECK: warning [1003]: the unused definition of 'dropped' was dropped and erased
; CHECK-NOT: dead_user
; CHECK: cir.func {{.*}}@main
; LIVE: error [1003]: the definition of 'dropped' was dropped: it uses a construct the CIR back end cannot express (and it is referenced)

frame DECLS
  STR 11 "dropped"
  STR 12 "dead_user"
  STR 13 "main"
  TY_FUNC 21 1 0 []
  DECL_FUNC 41 21 1 32 11
  DECL_FUNC 42 21 1 1 12
  DECL_FUNC 43 21 0 9 13
frame REGION
  FUNC_BEGIN 42 0
  CALL 41 21 0 0
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 43 0
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
