    args.perf_measure_only = True
    self.assertEqual(gate.perf_baseline_path(args), '')
    args.perf_measure_only = False
    args.perf_baseline = ''
    self.assertEqual(gate.perf_baseline_path(args), '')

  def test_the_targets_have_their_own_baseline_option(self):
