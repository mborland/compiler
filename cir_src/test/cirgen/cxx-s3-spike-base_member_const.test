ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S3): an int D::* that designates a member of a non-virtual base (an empty base, bases at non-zero offsets): globals, locals, comparisons (spike K6d).  The stream is the writer's output for
; Inputs/s3_mp_base_cir.cpp; a g++ unit prints what it reads and the result of the
; mixed build must equal the all-g++ build's.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s3_mp_base_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.mixed
; RUN: %t.mixed > %t.mixed.out
; RUN: g++ -std=c++17 -w -I%S/Inputs %S/Inputs/s3_mp_base_cir.cpp %S/Inputs/s3_mp_base_host.cpp -o %t.ref
; RUN: %t.ref > %t.ref.out
; RUN: diff %t.mixed.out %t.ref.out
; RUN: %edg-cir --emit=obj -O2 -o %t.o2.o %t.ecil
; RUN: g++ %t.host.o %t.o2.o -o %t.mixed2
; RUN: %t.mixed2 > %t.mixed2.out
; RUN: diff %t.mixed2.out %t.ref.out
