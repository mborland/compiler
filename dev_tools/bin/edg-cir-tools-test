    self.assertIn("'--perf-targets-baseline'", text)
    self.assertIn('m5a-base-perf.json', text)


class MilestonePreparation(unittest.TestCase):
  def test_the_status_triage_holds_the_accepted_regressions_only(self):
    # pr101373 failed in the M5p baseline, not in the M5 one (it fails in
    # both); a triage line for a case that did not regress is stale.  M6.1a:
    # pr78468 passed at -O0 in the M6.R baseline and is a diagnosed gap now
    # (__builtin_alloca_with_align above 16 bytes).
    triage, problems = gate.read_status_triage(
      BIN.parent.parent / gate.STATUS_TRIAGE)
    self.assertEqual(problems, [])
    self.assertEqual(list(triage), [
      ('imported/gnu/c/pr78468.sft.c', '-DTEST_NUMBER=1',
       'edg_x86_64_cir')])

  def test_slow_below_threshold_runs_with_two_jobs(self):
    import inspect
    self.assertEqual(gate.SLOW_JOBS, 2)
    source = inspect.getsource(gate.step_slow_below_threshold)
    self.assertIn('-j {SLOW_JOBS}', source)
    self.assertNotIn('BUILD_JOBS', source)



def gate_context(tmp: str, **values):
  '''A gate Context over a scratch evidence directory (the tree is this
  one unless `tree` is given) with the arguments the steps under test read.'''
  import types
  tree = values.pop('tree', str(BIN.parent.parent))
  args = types.SimpleNamespace(
    tree = tree, out = str(Path(tmp) / 'out'), command_timeout = 60,
    step_timeout = [])
  for key, value in values.items():
    setattr(args, key, value)
  ctx = gate.Context(args)
  ctx.out.mkdir(parents = True, exist_ok = True)
  return ctx


def run_gate_main(argv: List[str], steps = None):
  '''gate.main() with `argv`, `steps` ({name: function}) replacing steps and
  the image lookup stubbed: (exit code, stderr).'''
  saved = (sys.argv, gate.image_ids, dict(gate.STEP_FUNCTIONS))
  sys.argv = ['edg-cir-gate-evidence', *argv]
  gate.image_ids = lambda: {
    'ghcr.io/edgcpp/cir-env:latest': 'sha256:' + 'a' * 64}
  gate.STEP_FUNCTIONS.update(steps or {})
  try:
    with contextlib.redirect_stdout(io.StringIO()), \
         contextlib.redirect_stderr(io.StringIO()) as err:
      try:
        gate.main()
        code = None
      except SystemExit as raised:
        code = raised.code
  finally:
    sys.argv, gate.image_ids = saved[0], saved[1]
    gate.STEP_FUNCTIONS.clear()
    gate.STEP_FUNCTIONS.update(saved[2])
  return code, err.getvalue()


class GatePreflight(unittest.TestCase):
  '''main(): the baselines check, --allow-missing-baselines and the
  milestone perf options.'''

  def argv(self, tmp, *more):
    return ['--tree', tmp, '--out', str(Path(tmp) / 'ev'), *more]

  def test_a_missing_baseline_stops_the_gate_with_status_2(self):
    with tempfile.TemporaryDirectory() as tmp:
      ran: List[str] = []
      code, err = run_gate_main(
        self.argv(tmp, '--only', 'identity', '--identity-baseline',
                  str(Path(tmp) / 'none')),
        {'identity': lambda ctx: ran.append('x') or (True, 'ok')})
      self.assertEqual(code, 2)
      self.assertIn('--allow-missing-baselines', err)
      self.assertEqual(ran, [])

  def test_allow_missing_baselines_runs_and_leaves_a_banner(self):
    with tempfile.TemporaryDirectory() as tmp:
      code, _ = run_gate_main(
        self.argv(tmp, '--only', 'identity', '--allow-missing-baselines',
                  '--identity-baseline', str(Path(tmp) / 'none')),
        {'identity': lambda ctx: (True, 'ok')})
      self.assertEqual(code, 0)
      summary = (Path(tmp) / 'ev' / 'summary.md').read_text()
      self.assertTrue(summary.startswith(
        'WARNING: --allow-missing-baselines: 1 baseline(s) were unusable'),
        summary)
      self.assertIn('identity-baseline', summary.splitlines()[0])
      self.assertIn('| identity | PASS |', summary)

  def test_no_banner_without_the_option(self):
    with tempfile.TemporaryDirectory() as tmp:
      code, _ = run_gate_main(self.argv(tmp, '--only', 'smoke'),
                              {'smoke': lambda ctx: (True, 'ok')})
      self.assertEqual(code, 0)
      self.assertNotIn('WARNING', (Path(tmp) / 'ev' / 'summary.md').read_text())

  def test_the_milestone_refuses_allow_missing_baselines(self):
    with tempfile.TemporaryDirectory() as tmp:
      code, err = run_gate_main(
        self.argv(tmp, '--milestone', '--allow-missing-baselines'))
      self.assertEqual(code, 2)
      self.assertIn('refused with --milestone', err)

  def perf_args(self, tmp, *more):
    seen: List[object] = []
    base = Path(tmp) / 'p.json'
    base.write_text('{"a": 1}')
    code, _ = run_gate_main(
      self.argv(tmp, '--only', 'perf', '--perf-baseline', str(base),
                '--perf-targets-baseline', str(base), *more),
      {'perf': lambda ctx: seen.append(ctx.args) or (True, 'ok')})
    self.assertEqual(code, 0)
    return seen[0]

  def test_the_milestone_evaluates_the_perf_options_itself(self):
    with tempfile.TemporaryDirectory() as tmp:
      args = self.perf_args(tmp, '--milestone')
      self.assertEqual((args.perf_realworld, args.perf_levels,
                        args.perf_targets), ('pinned', '0,2', 's1'))
      self.assertEqual(
        {'perf_realworld': args.perf_realworld,
         'perf_levels': args.perf_levels, 'perf_targets': args.perf_targets},
        gate.MILESTONE_PERF)

  def test_a_given_perf_option_wins_over_the_milestone_one(self):
    with tempfile.TemporaryDirectory() as tmp:
      args = self.perf_args(tmp, '--milestone', '--perf-levels', '0',
                            '--perf-targets', '')
      self.assertEqual((args.perf_realworld, args.perf_levels,
                        args.perf_targets), ('pinned', '0', ''))

  def test_without_the_milestone_the_perf_options_are_plain(self):
    with tempfile.TemporaryDirectory() as tmp:
      args = self.perf_args(tmp)
      self.assertEqual((args.perf_realworld, args.perf_levels,
                        args.perf_targets), ('', '0', ''))

  def test_the_checkpoint_and_the_gate_agree_on_the_milestone_options(self):
    gate_options = {f"--{k.replace('_', '-')}": v
                    for k, v in gate.MILESTONE_PERF.items()}
    self.assertEqual(dict(checkpoint.MILESTONE_OPTIONS), gate_options)

  def test_the_checkpoint_refuses_allow_missing_with_the_milestone(self):
    saved = (checkpoint.box_reachable, checkpoint.ssh, sys.argv, os.getcwd())
    checkpoint.box_reachable = lambda: True
    checkpoint.ssh = lambda command, capture = False: \
      subprocess.CompletedProcess([], 0, stdout = 'clang4\n')
    sys.argv = ['edg-cir-checkpoint', '--milestone', '--extra',
                '--allow-missing-baselines --jobs 3']
    os.chdir(BIN.parent.parent)
    try:
      with self.assertRaises(SystemExit) as raised, \
           contextlib.redirect_stderr(io.StringIO()) as err:
        checkpoint.main()
    finally:
      checkpoint.box_reachable, checkpoint.ssh, sys.argv, directory = saved
      os.chdir(directory)
    self.assertEqual(raised.exception.code, 2)
    self.assertIn('refused with --milestone', err.getvalue())


class PerfStep(unittest.TestCase):
  '''step_perf with a faked measurement (the judging is real).'''

  def run_step(self, tmp, after, baseline_json = None, **values):
    import types
    from unittest import mock
    targets_file = Path(tmp) / 'm5a.json'
    before, _ = pinned_perf()
    targets_file.write_text(json.dumps(before))
    options = dict(
      rss_functions = 10, perf_realworld = 'pinned', boost_include = 'b',
      perf_only = '', perf_levels = '0,2', perf_sample = 1,
      perf_baseline = '', perf_measure_only = True, perf_targets = 's1',
      perf_targets_baseline = str(targets_file), perf_max_regression = 2.0)
    options.update(values)
    ctx = gate_context(tmp, tree = tmp, **options)
    (ctx.out / 'perf').mkdir(exist_ok = True)
    (Path(tmp) / 'cir_src/scripts').mkdir(parents = True, exist_ok = True)
    seen: List[str] = []
    def measure(ctx, step, command, *a, **k):
      seen.append(command)
      work = ctx.tree / '.tmp' / 'gate-perf' / ctx.out.name
      (work / 'perf.json').write_text(json.dumps(after))
      return 0
    done = subprocess.CompletedProcess([], 0, stdout = 'table')
    with mock.patch.object(gate, 'in_cir_env', measure), \
         mock.patch.object(gate.subprocess, 'run', return_value = done), \
         contextlib.redirect_stdout(io.StringIO()):
      passed, detail = gate.step_perf(ctx)
    return passed, detail, seen

  def test_measure_only_still_checks_the_targets(self):
    with tempfile.TemporaryDirectory() as tmp:
      _, after = pinned_perf()
      passed, detail, seen = self.run_step(tmp, after)
      self.assertTrue(passed, detail)
      self.assertIn('--perf-measure-only', detail)
      self.assertIn('targets s1 against m5a.json: met', detail)
      self.assertIn('--levels 0,2', seen[0])
      self.assertIn("--units pinned", seen[0])
      _, after = pinned_perf(ratio_chrono = 0.71)
      passed, detail, _ = self.run_step(tmp, after)
      self.assertFalse(passed, detail)
      self.assertIn('MISSED', detail)

  def test_measure_only_without_targets_only_measures(self):
    with tempfile.TemporaryDirectory() as tmp:
      _, after = pinned_perf(ratio_chrono = 0.71)
      passed, detail, _ = self.run_step(tmp, after, perf_targets = '')
      self.assertTrue(passed, detail)
      self.assertNotIn('targets', detail)

  def test_no_baseline_and_not_measure_only_fails(self):
    with tempfile.TemporaryDirectory() as tmp:
      _, after = pinned_perf()
      passed, detail, _ = self.run_step(tmp, after, perf_measure_only = False)
      self.assertFalse(passed)
      self.assertIn('no --perf-baseline', detail)

  def test_a_baseline_and_the_targets_are_both_judged(self):
    with tempfile.TemporaryDirectory() as tmp:
      before, after = pinned_perf()
      base = Path(tmp) / 'base.json'
      base.write_text(json.dumps(before))
      passed, detail, _ = self.run_step(
        tmp, after, perf_baseline = str(base), perf_measure_only = False)
      self.assertTrue(passed, detail)
      self.assertIn('largest instruction count change', detail)
      self.assertIn('targets s1', detail)

  def test_the_unused_baselines_leave_no_image_note_option(self):
    import types
    args = types.SimpleNamespace(perf_measure_only = True, perf_targets = '')
    self.assertEqual(gate.step_baseline_options(args, 'perf'), ())
    args.perf_targets = 's1'
    self.assertEqual(gate.step_baseline_options(args, 'perf'),
                     ('perf_targets_baseline',))
    args.perf_measure_only = False
    self.assertEqual(gate.step_baseline_options(args, 'perf'),
                     ('perf_baseline', 'perf_targets_baseline'))
    args.perf_targets = ''
    self.assertEqual(gate.step_baseline_options(args, 'perf'),
                     ('perf_baseline',))
    self.assertEqual(gate.step_baseline_options(args, 'day32'),
                     ('day32_baseline_run',))


class ContainerLimits(unittest.TestCase):
  def test_the_gate_sets_a_nice_value_for_the_containers(self):
    saved = os.environ.pop('EDG_DOCKER_NICE', None)
    try:
      with tempfile.TemporaryDirectory() as tmp:
        self.assertEqual(gate_context(tmp).env['EDG_DOCKER_NICE'], '10')
        os.environ['EDG_DOCKER_NICE'] = '5'
        self.assertEqual(gate_context(tmp).env['EDG_DOCKER_NICE'], '5')
    finally:
      os.environ.pop('EDG_DOCKER_NICE', None)
      if saved is not None:
        os.environ['EDG_DOCKER_NICE'] = saved

  def test_edgdocker_runs_the_container_command_under_nice(self):
    sys.path.insert(0, str(BIN.parent / 'pylibs'))
    try:
      import edgdocker
    finally:
      sys.path.pop(0)
    saved = os.environ.get('EDG_DOCKER_NICE')
    texts = {}
    try:
      with tempfile.TemporaryDirectory() as tmp:
        for value in ('', '10'):
          os.environ['EDG_DOCKER_NICE'] = value
          out = io.StringIO()
          with contextlib.redirect_stdout(out):
            edgdocker.exec_docker_cmd('dev-env', Path(tmp),
                                      PurePosixPath('/edg/workspace'),
                                      'ninja -C build', dry_run = True)
          texts[value] = out.getvalue()
    finally:
      if saved is None:
        os.environ.pop('EDG_DOCKER_NICE', None)
      else:
        os.environ['EDG_DOCKER_NICE'] = saved
    self.assertIn("edg-container-exec ninja -C build", texts[''])
    self.assertIn("edg-container-exec nice -n 10 bash -c 'ninja -C build'",
                  texts['10'])

  def test_ctest_caps_lit_and_the_build(self):
    from unittest import mock
    calls = []
    with tempfile.TemporaryDirectory() as tmp:
      ctx = gate_context(tmp, ctest_presets = 'linux-cir-asan',
                         keep_ctest_builds = True)
      with mock.patch.object(gate, 'in_cir_env',
                             lambda ctx, step, command, wdir = '',
                             extra_env = None: calls.append(
                               (command, extra_env)) or 0), \
           mock.patch.object(gate, 'BUILD_JOBS', 5):
        passed, detail = gate.step_ctest(ctx)
    self.assertTrue(passed, detail)
    self.assertEqual(len(calls), 3)
    self.assertTrue(any('-j5' in c and 'ctest' in c for c, _ in calls))
    self.assertTrue(any('linux-cir-asan' in c for c, _ in calls))
    for _, extra in calls:
      self.assertEqual(extra, {'LIT_OPTS': '-j5'})

  def test_the_stress_timeout_reaches_edg_cir_stress(self):
    from unittest import mock
    seen = []
    with tempfile.TemporaryDirectory() as tmp:
      ctx = gate_context(tmp, stress_timeout = 1234)
      (ctx.out / 'stress').mkdir()
      (ctx.out / 'stress' / 'log.txt').write_text('RESULT: PASS (3 cases)\n')
      with mock.patch.object(gate, 'in_cir_env', lambda c, s, command, *a,
                             **k: seen.append(command) or 0):
        passed, detail = gate.step_stress(ctx)
    self.assertTrue(passed)
    self.assertIn('edg-cir-stress --timeout 1234', seen[0])
    self.assertEqual(detail, 'RESULT: PASS (3 cases)')

  @unittest.skipIf(os.path.exists('/.dockerenv'),
                   'edg-docker-test does not run inside a container')
  def test_edg_docker_test_jobs_default_changes_nothing(self):
    env = dict(os.environ, PATH = f"{BIN}:{os.environ['PATH']}",
               PYTHONPATH = str(BIN.parent / 'pylibs'))
    root = BIN.parent.parent
    before = set((root / '.tmp').glob('tmp*')) if (root / '.tmp').exists() \
      else set()
    def dry(*options):
      proc = subprocess.run(
        [sys.executable, str(BIN / 'edg-docker-test'), '--dry-run',
         '--non-interactive', *options], env = env, text = True, timeout = 120,
        stdout = subprocess.PIPE, stderr = subprocess.STDOUT)
      self.assertEqual(proc.returncode, 0, proc.stdout)
      return proc.stdout
    try:
      plain = dry()
      capped = dry('--jobs', '7')
    finally:
      for path in set((root / '.tmp').glob('tmp*')) - before:
        shutil.rmtree(path, ignore_errors = True)
    self.assertNotRegex(plain, r'cmake --build \S+ -j\d')
    self.assertNotIn('--jobs=', plain)
    self.assertRegex(capped, r'cmake --build build/gcc -j7')
    self.assertIn('exec edgy --config=', capped)
    self.assertIn('--jobs=7', capped)


class Day32(unittest.TestCase):
  def test_the_posture_file_names_the_32_bit_configurations(self):
    root = BIN.parent.parent
    path = root / gate.DEFAULT_DAY32_POSTURE
    posture = json.loads(path.read_text())
    build, = posture['builds']
    self.assertEqual(build['test_configs'], ['edg_x86_32', 'edg_x86_32_cp'])
    self.assertEqual(build['cmake_preset'], 'linux-i686-gcc-debug')
    self.assertTrue((root / build['edg_base']).is_dir())
    presets = json.loads((root / 'CMakePresets.json').read_text())
    self.assertIn(build['cmake_preset'],
                  [p['name'] for p in presets['configurePresets']])
    self.assertEqual(posture['test_filters'], '')
    self.assertFalse(posture['record_tests'])

  def test_the_step_and_its_areas(self):
    self.assertIn('day32', gate.STEPS)
    self.assertIn('day32', gate.STEP_FUNCTIONS)
    for area in ('shared-src', 'tests-reference', 'pylibs'):
      self.assertIn('day32', gate.AREA_STEPS[area], area)
    self.assertIn('day32', gate.default_steps(False, False))
    self.assertEqual(gate.areas_of('tests/.edgy/postures/day32.json'),
                     ('tests-reference',))
    self.assertEqual(gate.areas_of(
      'tests/expectations/edg_x86_32/edg.log'), ('tests-reference',))
    self.assertEqual(checkpoint.DAY32_BASELINE,
                     '~/edg-cir-config/day-base/baseline-32')
    self.assertEqual(gate.DEFAULT_DAY32_BASELINE, checkpoint.DAY32_BASELINE)

  def test_a_gate_for_the_m51b_areas_runs_day_in_four_configurations(self):
    steps, _ = gate.lean_steps(['writer', 'library', 'attr', 'tests-triage',
                                'shared-src', 'crashes', 'perf'])
    for step in ('day', 'day32', 'identity', 'isolation', 'ctest',
                 'crash-sweep', 'symbols', 'mixed-tu', 'opt-corpus', 'perf',
                 'attr-diff', 'codequality'):
      self.assertIn(step, steps)

  def test_the_baseline_of_day32_is_checked(self):
    import types
    args = types.SimpleNamespace(
      day32_baseline_run = '/b32', perf_measure_only = False,
      perf_targets = '', cpp_configs = 'edg_x86_64_cir')
    rows = gate.baseline_requirements(args, ['day32'])
    self.assertEqual([(o, p, k) for o, p, k, _ in rows],
                     [('day32-baseline-run', '/b32', 'dir')])

  def test_a_build_dir_with_another_edg_base_is_dropped(self):
    with tempfile.TemporaryDirectory() as tmp:
      ctx = gate_context(tmp, tree = tmp)
      posture = Path(tmp) / 'p.json'
      posture.write_text(json.dumps({'builds': [
        {'build_path': 'build/gcc-i686',
         'edg_base': 'bases/docker/dev-env/gcc-i686'},
        {'build_path': 'build/other', 'edg_base': 'bases/x'}]}))
      for name, base in (('gcc-i686', 'gcc'), ('other', 'x')):
        directory = Path(tmp) / 'build' / name
        directory.mkdir(parents = True)
        (directory / 'CMakeCache.txt').write_text(
          f"A:B=1\nEDG_BASE:STRING=/edg/workspace/bases/docker/dev-env/{base}"
          '\n' if name == 'gcc-i686' else
          'EDG_BASE:STRING=/edg/workspace/bases/x\n')
      self.assertEqual(gate.drop_stale_builds(ctx, 'p.json'),
                       ['build/gcc-i686'])
      self.assertFalse((Path(tmp) / 'build/gcc-i686').exists())
      self.assertTrue((Path(tmp) / 'build/other').exists())
      # a directory that is not there is left for edg-docker-test to build
      self.assertEqual(gate.drop_stale_builds(ctx, 'p.json'), [])
      # the built-in posture is build/gcc with the x86-64 base
      directory = Path(tmp) / 'build/gcc'
      directory.mkdir()
      (directory / 'CMakeCache.txt').write_text(
        'EDG_BASE:STRING=/edg/workspace/bases/docker/dev-env/gcc\n')
      self.assertEqual(gate.drop_stale_builds(ctx, ''), [])

  def test_the_edg_base_of_any_cache_type_is_compared(self):
    self.assertEqual(gate.cache_edg_base('A:B=1\nEDG_BASE:PATH=/x\n'), '/x')
    self.assertEqual(gate.cache_edg_base('EDG_BASE:FILEPATH=/y z\n'), '/y z')
    self.assertEqual(gate.cache_edg_base('EDG_BASE:STRING=/s'), '/s')
    self.assertIsNone(gate.cache_edg_base('NOT_EDG_BASE:STRING=/x\n'))
    self.assertIsNone(gate.cache_edg_base('# EDG_BASE:STRING=/x\n'))
    wanted = '/edg/workspace/bases/docker/dev-env/gcc'
    for kind, value, removed in (
        ('PATH', wanted, False), ('FILEPATH', wanted, False),
        ('UNINITIALIZED', wanted, False), ('STRING', wanted, False),
        ('PATH', '/edg/workspace/bases/docker/dev-env/gcc-i686', True),
        ('FILEPATH', '/elsewhere', True)):
      with tempfile.TemporaryDirectory() as tmp:
        ctx = gate_context(tmp, tree = tmp)
        directory = Path(tmp) / 'build/gcc'
        directory.mkdir(parents = True)
        (directory / 'CMakeCache.txt').write_text(
          f"A:B=1\nEDG_BASE:{kind}={value}\nC:D=2\n")
        self.assertEqual(gate.drop_stale_builds(ctx, ''),
                         ['build/gcc'] if removed else [], (kind, value))
        self.assertEqual(directory.exists(), not removed)
    # a cache without the entry cannot be said to match
    with tempfile.TemporaryDirectory() as tmp:
      ctx = gate_context(tmp, tree = tmp)
      directory = Path(tmp) / 'build/gcc'
      directory.mkdir(parents = True)
      (directory / 'CMakeCache.txt').write_text('A:B=1\n')
      self.assertEqual(gate.drop_stale_builds(ctx, ''), ['build/gcc'])

  def day_run(self, tmp, base_lines, new_lines):
    from unittest import mock
    calls = []
    ctx = gate_context(tmp, day32_baseline_run = str(Path(tmp) / 'base'),
                       day32_posture = 'tests/.edgy/postures/day32.json',
                       day_filter = '')
    (ctx.out / 'day32').mkdir()
    run = Path(tmp) / 'new'
    run.mkdir()
    lines = iter([base_lines, new_lines])
    with mock.patch.object(gate, 'run_logged', lambda c, s, cmd, **k:
                           calls.append((s, cmd)) or 0), \
         mock.patch.object(gate, 'drop_stale_builds', lambda c, p: []), \
         mock.patch.object(gate, 'runs_before', lambda c: set()), \
         mock.patch.object(gate, 'newest_run', lambda c, b: run), \
         mock.patch.object(gate, '_status_lines', lambda r, s: next(lines)):
      passed, detail = gate.step_day32(ctx)
    return passed, detail, calls, ctx

  def test_the_step_runs_the_posture_and_compares_the_32_bit_configs(self):
    with tempfile.TemporaryDirectory() as tmp:
      same = {'edg_x86_32': ['a:PASS'], 'edg_x86_32_cp': ['b:PASS']}
      passed, detail, calls, _ = self.day_run(tmp, same, dict(same))
      self.assertTrue(passed, detail)
      step, command = calls[0]
      self.assertEqual(step, 'day32')
      self.assertEqual(command[-2:], ['--posture',
                                      '@tests/.edgy/postures/day32.json'])
      self.assertIn('statuses identical', detail)

  def test_a_status_change_in_a_32_bit_config_fails(self):
    with tempfile.TemporaryDirectory() as tmp:
      base = {'edg_x86_32': ['a:PASS'], 'edg_x86_32_cp': ['b:PASS']}
      new = {'edg_x86_32': ['a:PASS'], 'edg_x86_32_cp': ['b:FAIL']}
      passed, detail, _, ctx = self.day_run(tmp, base, new)
      self.assertFalse(passed)
      self.assertIn("['edg_x86_32_cp']", detail)
      diff = (ctx.out / 'day32' / 'diff.txt').read_text()
      self.assertIn('- b:PASS', diff)
      self.assertIn('+ b:FAIL', diff)

  def test_the_64_bit_step_has_no_posture_argument(self):
    from unittest import mock
    calls = []
    with tempfile.TemporaryDirectory() as tmp:
      ctx = gate_context(tmp, day_baseline_run = str(Path(tmp)),
                         day_filter = '')
      (ctx.out / 'day').mkdir()
      with mock.patch.object(gate, 'run_logged', lambda c, s, cmd, **k:
                             calls.append(cmd) or 0), \
           mock.patch.object(gate, 'drop_stale_builds', lambda c, p: []), \
           mock.patch.object(gate, 'runs_before', lambda c: set()), \
           mock.patch.object(gate, 'newest_run', lambda c, b: Path(tmp)), \
           mock.patch.object(gate, '_status_lines',
                             lambda r, s: {'edg_x86_64': ['a:PASS']}):
        passed, detail = gate.step_day(ctx)
    self.assertTrue(passed, detail)
    self.assertNotIn('--posture', calls[0])


class IdentityAllowList(unittest.TestCase):
  OUT = (
    'linux-gcc-debug: preprocessed output differs: cpfe/src/lower_name.c.i.gz\n'
    '    --- before\n'
    'linux-gcc-debug: preprocessed output differs: cpfe-cp/src/macro.c.i.gz\n'
    'DIFFERENT: 180 files compared across 4 presets, 2 problem(s)\n')
  ALLOWED = [('*/src/lower_name.c.i.gz', 'the W3 mangler changes'),
             ('*/src/macro.c.i.gz', 'the W4 __has_builtin values')]

  def test_a_run_whose_only_differences_are_allowed_passes(self):
    ok, detail, used = gate.judge_identity(self.OUT, 1, self.ALLOWED)
    self.assertTrue(ok, detail)
    self.assertIn('all 2 on the allow-list', detail)
    self.assertIn('W3 mangler', detail)
    self.assertEqual(sorted(used), sorted(e[0] for e in self.ALLOWED))

  def test_another_file_fails(self):
    out = self.OUT.replace('macro.c', 'types.c')
    ok, detail, _ = gate.judge_identity(out, 1, self.ALLOWED)
    self.assertFalse(ok)
    self.assertIn('1 of the problems are on the allow-list', detail)

  def test_a_dump_or_generated_difference_is_never_allowed(self):
    out = self.OUT.replace('preprocessed output differs: cpfe/src/macro.c',
                           'dump differs beyond allowed changes: dump/cpfe.txt'
                           ).replace('i.gz', 'txt')
    out = out.replace('cpfe/src/lower_name.c.txt', 'cpfe/src/lower_name.c.i.gz')
    allowed = self.ALLOWED + [('dump/*', 'a dump may differ')]
    self.assertFalse(gate.judge_identity(out, 1, allowed)[0])

  def test_a_stale_entry_fails(self):
    out = self.OUT.replace(
      'linux-gcc-debug: preprocessed output differs: cpfe-cp/src/macro.c.i.gz'
      '\n', '').replace('2 problem(s)', '1 problem(s)')
    ok, detail, _ = gate.judge_identity(out, 1, self.ALLOWED)
    self.assertFalse(ok)
    self.assertIn('STALE', detail)
    # identical output with entries left over is stale too, without: a pass
    same = 'IDENTICAL: 180 files compared across 4 presets, 0 problem(s)\n'
    self.assertFalse(gate.judge_identity(same, 0, self.ALLOWED)[0])
    self.assertTrue(gate.judge_identity(same, 0, [])[0])

  def test_a_failure_without_a_count_fails(self):
    self.assertFalse(gate.judge_identity('crash\n', 1, self.ALLOWED)[0])
    self.assertFalse(gate.judge_identity('', 1, self.ALLOWED)[0])

  def test_the_checked_in_list_is_empty(self):
    # The M6.R entries (the files that the CIR project changes ungated, against
    # identity-main) went with the identity-m6r capture.
    path = BIN.parent.parent / gate.IDENTITY_ALLOW
    entries, problems = gate.read_identity_allowlist(str(path))
    self.assertEqual(problems, [])
    self.assertEqual(entries, [])
    self.assertEqual(gate.areas_of(gate.IDENTITY_ALLOW), ('shared-src',))

  def test_an_empty_list_is_valid_and_judges_identical_output(self):
    with tempfile.TemporaryDirectory() as tmp:
      path = Path(tmp) / 'allow.txt'
      path.write_text('# only comments\n\n# and blank lines\n')
      self.assertEqual(gate.read_identity_allowlist(str(path)), ([], []))
    same = 'IDENTICAL: 180 files compared across 4 presets, 0 problem(s)\n'
    ok, detail, used = gate.judge_identity(same, 0, [])
    self.assertTrue(ok, detail)
    self.assertEqual(used, [])
    # a difference is a problem when nothing is allowed
    ok, detail, _ = gate.judge_identity(self.OUT, 1, [])
    self.assertFalse(ok)
    self.assertIn('0 of the problems are on the allow-list', detail)

  def test_a_compare_of_nothing_fails(self):
    none = 'IDENTICAL: 0 files compared across 4 presets, 0 problem(s)\n'
    ok, detail, _ = gate.judge_identity(none, 0, [])
    self.assertFalse(ok)
    self.assertIn('compared nothing', detail)
    self.assertFalse(gate.judge_identity(none, 0, self.ALLOWED)[0])
    # no output at all, or no count line, is no verdict either
    self.assertFalse(gate.judge_identity('', 0, [])[0])
    ok, detail, _ = gate.judge_identity('fine\n', 0, [])
    self.assertFalse(ok)
    self.assertIn('no `N files compared` line', detail)

  def test_the_default_baseline_is_the_m6r_capture(self):
    self.assertIn("default = '~/edg-cir-config/identity-m6r'",
                  (BIN / 'edg-cir-checkpoint').read_text())
    text = (BIN / 'edg-cir-gate-evidence').read_text()
    self.assertIn("default = '~/edg-cir-config/identity-m6r'", text)
    self.assertNotIn('identity-m0c', text)
    self.assertNotIn('identity-m0c', (BIN / 'edg-cir-checkpoint').read_text())

  def test_the_list_is_checked_when_it_is_read(self):
    with tempfile.TemporaryDirectory() as tmp:
      path = Path(tmp) / 'allow.txt'
      path.write_text('*/src/a.c.i.gz | short\n')
      problems = gate.read_identity_allowlist(str(path))[1]
      self.assertTrue(any('real reason' in p for p in problems))
      self.assertTrue(any('no comment line' in p for p in problems))
      path.write_text('# c\n*/src/a.c.i.gz | a real reason here\n'
                      '# c\n*/src/a.c.i.gz | a real reason here\n')
      self.assertTrue(any('twice' in p for p in
                          gate.read_identity_allowlist(str(path))[1]))
      self.assertEqual(
        gate.read_identity_allowlist(str(Path(tmp) / 'none')), ([], []))


class ImageRecords(unittest.TestCase):
  def test_the_dev_env_image_is_the_pinned_one(self):
    sys.path.insert(0, str(BIN.parent / 'pylibs'))
    try:
      import edgdocker
    finally:
      sys.path.pop(0)
    self.assertEqual(gate.image_inspect_ref('ghcr.io/edgcpp/dev-env:latest'),
                     edgdocker.get_latest_image_tag('dev-env'))
    self.assertEqual(gate.image_inspect_ref('ghcr.io/edgcpp/cir-env:latest'),
                     'ghcr.io/edgcpp/cir-env:latest')

  def test_a_record_from_before_the_move_to_ghcr_still_matches(self):
    ids = {ref: 'sha256:' + c * 64
           for ref, c in zip(gate.IMAGE_REFS, 'abc')}
    with tempfile.TemporaryDirectory() as tmp:
      base = Path(tmp) / 'm51-base-asm'
      base.mkdir()
      gate.image_record_path(str(base)).write_text(''.join(
        f"{r.replace('ghcr.io/', '')} {i}\n" for r, i in ids.items()))
      self.assertEqual(gate.image_note(str(base), ids), '')

  def test_the_record_keeps_the_name_of_the_entry(self):
    from unittest import mock
    asked = []
    def fake(argv, **kw):
      asked.append(argv[-1])
      return subprocess.CompletedProcess(argv, 0, stdout = 'sha256:abc\n')
    with mock.patch.object(gate.subprocess, 'run', fake):
      ids = gate.image_ids()
    self.assertEqual(list(ids), list(gate.IMAGE_REFS))
    self.assertNotEqual(asked[0], 'ghcr.io/edgcpp/dev-env:latest')
    self.assertEqual(asked[1:], list(gate.IMAGE_REFS[1:]))


class DevEnvTag(unittest.TestCase):
  '''tag_dev_env_for_cir never retags an existing :latest of another image.'''

  def run_tag(self, ids):
    sys.path.insert(0, str(BIN.parent / 'pylibs'))
    try:
      import edgdocker
    finally:
      sys.path.pop(0)
    from unittest import mock
    tags = []
    def fake(argv, **kw):
      if argv[:3] == ['docker', 'image', 'inspect']:
        found = ids.get(argv[-1])
        return subprocess.CompletedProcess(
          argv, 0 if found else 1, stdout = (found or '') + '\n')
      tags.append(argv[2:])
      return subprocess.CompletedProcess(argv, 0)
    with mock.patch.object(edgdocker.subprocess, 'run', fake), \
         mock.patch.object(edgdocker, 'get_latest_image_tag',
                           lambda name, respect_pins = True:
                           'PIN' if respect_pins else 'LATEST'), \
         contextlib.redirect_stderr(io.StringIO()) as err:
      try:
        result = edgdocker.tag_dev_env_for_cir()
        code = None
      except SystemExit as raised:
        result, code = None, raised.code
    return result, code, tags, err.getvalue()

  ID = 'sha256:' + '1c1cf78d322b' + '0' * 52

  def test_a_host_without_latest_gets_it(self):
    result, code, tags, _ = self.run_tag({'PIN': self.ID})
    self.assertIsNone(code)
    self.assertEqual(result, 'ghcr.io/edgcpp/dev-env:cir-1c1cf78d322b')
    self.assertEqual(tags, [['PIN', result], ['PIN', 'LATEST']])

  def test_the_same_latest_is_left_alone(self):
    result, code, tags, _ = self.run_tag({'PIN': self.ID, 'LATEST': self.ID})
    self.assertIsNone(code)
    self.assertEqual(tags, [['PIN', result]])

  def test_another_latest_is_not_retagged(self):
    other = 'sha256:' + 'f' * 64
    result, code, tags, err = self.run_tag({'PIN': self.ID, 'LATEST': other})
    self.assertEqual(code, 1)
    self.assertNotIn(['PIN', 'LATEST'], tags)
    self.assertIn('not retagged', err)

  def test_the_llvm_build_container_names_are_unique_per_process(self):
    text = (BIN.parent / 'docker/llvm-cir/prebuild.py').read_text()
    self.assertNotIn("'cir-config-llvm-build'", text)
    self.assertNotIn("'cir-config-llvm-strip'", text)
    self.assertIn('cir-config-llvm-build-{os.getpid()}', text)
    self.assertNotIn("'ghcr.io/edgcpp/dev-env:latest'", text)


class PrebuildNice(unittest.TestCase):
  '''The llvm-cir prebuild runs its containers under nice -n 10 with or
  without EDG_LLVM_CIR_JOBS (the hosts are shared).'''

  def docker_commands(self, jobs):
    import runpy
    from unittest import mock
    sys.path.insert(0, str(BIN.parent / 'pylibs'))
    try:
      import edgdocker
    finally:
      sys.path.pop(0)
    commands: List[List[str]] = []
    def fake(argv, **kw):
      commands.append(list(argv))
      return subprocess.CompletedProcess(argv, 0, stdout = 'x\n')
    env = {k: v for k, v in os.environ.items()
           if not k.startswith('EDG_LLVM_CIR_')}
    with tempfile.TemporaryDirectory() as tmp:
      env['EDG_LLVM_CIR_WORKDIR'] = str(Path(tmp) / 'work')
      if jobs:
        env['EDG_LLVM_CIR_JOBS'] = jobs
      (Path(tmp) / 'work' / 'install').mkdir(parents = True)
      saved = os.getcwd()
      os.chdir(tmp)
      try:
        with mock.patch.dict(os.environ, env, clear = True), \
             mock.patch.object(subprocess, 'run', fake), \
             mock.patch.object(edgdocker, 'tag_dev_env_for_cir',
                               lambda: 'dev-env:cir-x'), \
             mock.patch('shutil.copytree', lambda *a, **k: None):
          sys.path.insert(0, str(BIN.parent / 'pylibs'))
          try:
            runpy.run_path(str(BIN.parent / 'docker/llvm-cir/prebuild.py'))
          finally:
            sys.path.pop(0)
      finally:
        os.chdir(saved)
    return [c for c in commands if c[:2] == ['docker', 'run']]

  def check(self, jobs):
    docker = self.docker_commands(jobs)
    self.assertEqual(len(docker), 2, docker)
    build, strip = docker
    self.assertEqual(build[build.index('dev-env:cir-x') + 1:][:4],
                     ['nice', '-n', '10', 'edg-build-llvm-cir'], build)
    self.assertEqual(strip[strip.index('dev-env:cir-x') + 1:][:3],
                     ['nice', '-n', '10'], strip)
    self.assertEqual('--jobs' in build, bool(jobs))

  def test_without_jobs(self):
    self.check('')

  def test_with_jobs(self):
    self.check('48')


class OptCorpusBaselines(unittest.TestCase):
  def test_absent_o0_baselines_fail_the_step(self):
    from unittest import mock
    with tempfile.TemporaryDirectory() as tmp:
      ctx = gate_context(
        tmp, tree = tmp, corpus_filter = 'c', cpp_corpus_filter = 'cc',
        smoke_filter = 's', cpp_smoke_filter = 'cs', types = 'rp',
        opt_baseline_status = str(Path(tmp) / 'no-baseline'))
      def summarize(ctx, step, run, config, json_name, extra = None,
                    text_tag = ''):
        return [{'path': gate.OPT_CANARY_CPP if 'cxx' in ' '.join(extra or [])
                 else gate.OPT_CANARY, 'status': 'PASS--OUTPUT MISMATCH',
                 'variant': '', 'test_type': 'rp', 'bucket': 'PASS'}], ''
      with mock.patch.object(gate, 'edgy_run', lambda *a, **k: Path(tmp)), \
           mock.patch.object(gate, 'summarize_run', summarize), \
           mock.patch.object(gate, 'canary_output', lambda *a: None), \
           mock.patch.object(gate, 'killed_tests', lambda *a: []):
        passed, detail = gate.step_opt_corpus(ctx)
      self.assertFalse(passed)
      self.assertIn('no -O0 statuses to compare with', detail)
      self.assertIn('c_edg_x86_64_cir.json', detail)
      self.assertEqual(gate._o0_statuses(ctx, 'c', 'c_edg_x86_64_cir.json'),
                       {})

  def test_a_baseline_directory_supplies_the_statuses(self):
    with tempfile.TemporaryDirectory() as tmp:
      base = Path(tmp) / 'base'
      base.mkdir()
      (base / 'c_edg_x86_64_cir.json').write_text(json.dumps(
        {'edg_x86_64_cir': [{'path': 'a', 'variant': '-D', 'bucket': 'PASS',
                             'status': 'PASS'}]}))
      ctx = gate_context(tmp, tree = tmp, opt_baseline_status = str(base))
      got = gate._o0_statuses(ctx, 'c', 'c_edg_x86_64_cir.json')
      self.assertEqual(len(got), 1)


class AttrQualifiers(unittest.TestCase):
  '''C1: the known entries can name a position (a glob category), a
  symbol and a unit.'''

  def known(self, text):
    with tempfile.TemporaryDirectory() as tmp:
      path = Path(tmp) / 'known.txt'
      path.write_text(text)
      return attr.validate_known(str(path))

  ROW = ('# a checked row\n'
         'param* | 2 | only-clangir:dereferenceable(*) '
         'symbol=_ZNSt*_Base_manager* unit=libstdcxx/* | accepted, checked '
         '2026-11-06: final classes, clangir uses the full size\n')

  def test_a_checked_row_with_qualifiers_is_valid(self):
    entries, problems = self.known(self.ROW)
    self.assertEqual(problems, [])
    self.assertEqual(len(entries), 1)
    self.assertEqual(len(entries[0]), 4)

  def test_the_position_is_a_glob_of_the_category(self):
    entries, _ = self.known(
      '# any parameter\nparam* | * | only-ours:nonnull | an improvement\n')
    for category in ('param0', 'param12'):
      self.assertIsNotNone(attr.known_entry(
        entries, 0, category, 'only-ours:nonnull'), category)
    for category in ('ret', 'fn', 'call'):
      self.assertIsNone(attr.known_entry(
        entries, 0, category, 'only-ours:nonnull'), category)

  def test_the_symbol_narrows_an_entry(self):
    entries, _ = self.known(self.ROW)
    detail = 'only-clangir:dereferenceable(16)'
    sym = '_ZNSt14_Base_managerIiE7_M_initEv'
    self.assertIsNotNone(attr.known_entry(
      entries, 2, 'param0', detail, sym, 'libstdcxx/memory'))
    self.assertIsNone(attr.known_entry(
      entries, 2, 'param0', detail, '_ZN3fooEv', 'libstdcxx/memory'))
    # a caller that gives no symbol or unit cannot match a narrowed entry
    self.assertIsNone(attr.known_entry(entries, 2, 'param0', detail))
    self.assertIsNone(attr.known_entry(entries, 2, 'param0', detail, sym))

  def test_the_unit_narrows_an_entry(self):
    entries, _ = self.known(self.ROW)
    detail = 'only-clangir:dereferenceable(16)'
    sym = '_ZNSt14_Base_managerIiE7_M_initEv'
    self.assertIsNone(attr.known_entry(
      entries, 2, 'param0', detail, sym, 'boost/mp11'))
    self.assertIsNone(attr.known_entry(
      entries, 0, 'param0', detail, sym, 'libstdcxx/memory'))

  def test_a_symbol_only_and_a_unit_only_entry(self):
    entries, problems = self.known(
      '# one function\nfn | * | only-ours:nounwind symbol=main | the entry '
      'point is nounwind in ours\n'
      '# one unit\nret | * | only-ours:noundef unit=boost/mp11 | tested '
      'only in this unit\n')
    self.assertEqual(problems, [])
    self.assertIsNotNone(attr.known_entry(entries, 0, 'fn',
                                          'only-ours:nounwind', 'main', 'u'))
    self.assertIsNone(attr.known_entry(entries, 0, 'fn',
                                       'only-ours:nounwind', 'main2', 'u'))
    self.assertIsNotNone(attr.known_entry(
      entries, 0, 'ret', 'only-ours:noundef', 'f', 'boost/mp11'))
    self.assertIsNone(attr.known_entry(
      entries, 0, 'ret', 'only-ours:noundef', 'f', 'boost/other'))

  def test_a_detail_with_a_space_keeps_it(self):
    entries, problems = self.known(
      '# the alignment\ncall | * | only-ours:llvm.memset:arg0:align 8 '
      'symbol=_Z3f* | we claim less\n')
    self.assertEqual(problems, [])
    self.assertIsNotNone(attr.known_entry(
      entries, 0, 'call', 'only-ours:llvm.memset:arg0:align 8', '_Z3fv'))
    self.assertIsNone(attr.known_entry(
      entries, 0, 'call', 'only-ours:llvm.memset:arg0:align', '_Z3fv'))

  def test_entries_without_qualifiers_are_as_wide_as_before(self):
    entries, _ = self.known(GOOD_KNOWN)
    self.assertIsNotNone(attr.known_entry(entries, 0, 'param0',
                                          'only-ours:nonnull'))
    self.assertIsNotNone(attr.known_entry(entries, 0, 'param0',
                                          'only-ours:nonnull', 'f', 'u'))
    self.assertTrue(attr.explained(entries, 0, 'param0',
                                   'only-ours:nonnull', 'f', 'u'))

  def test_an_unknown_qualifier_a_pair_qualifier_and_an_empty_one_are_refused(
      self):
    _, problems = self.known(
      '# c\nret | * | only-ours:noundef symbl=x | a real reason here\n')
    self.assertTrue(any('unknown qualifier' in p for p in problems), problems)
    _, problems = self.known(
      '# c\npair | * | structor-variants unit=x | a real reason here\n')
    self.assertTrue(any('no pair matcher' in p for p in problems), problems)
    _, problems = self.known(
      '# c\nret | * | only-ours:noundef symbol= | a real reason here\n')
    self.assertTrue(any('empty qualifier' in p for p in problems), problems)
    _, problems = self.known(
      '# c\nret | * | symbol=f | a real reason here\n')
    self.assertTrue(any('no detail' in p for p in problems), problems)

  def test_a_checked_reason_needs_a_date_and_a_why(self):
    for reason in ('accepted, checked: because', 'accepted, checked '
                   '2026-11-06: short', 'accepted, checked 2026-11-06'):
      _, problems = self.known(
        f"# c\nret | * | only-ours:noundef | {reason}\n")
      self.assertTrue(any('checked row' in p or 'real reason' in p
                          for p in problems), reason)
    _, problems = self.known(
      '# c\nret | * | only-ours:noundef | accepted, checked 2026-11-06: '
      'the callee is a builtin in ours\n')
    self.assertEqual(problems, [])

  def test_two_entries_that_differ_only_in_qualifiers_are_not_duplicates(
      self):
    _, problems = self.known(
      '# a\nret | * | only-ours:noundef symbol=a | a real reason here\n'
      '# b\nret | * | only-ours:noundef symbol=b | a real reason here\n')
    self.assertEqual(problems, [])

  def test_the_gate_judges_stale_entries_with_qualifiers(self):
    entries, _ = self.known(self.ROW)
    ok, detail = gate.judge_attr_diff(
      {'probe': (0, {'compared': {'0': 5}, 'explained': 0, 'unexplained': [],
                     'known_used': [], 'uncompared': [], 'nounwind': {},
                     'nounwind_below': [], 'no_llvm_passes': True,
                     'residue': {}})}, entries)
    self.assertFalse(ok)
    self.assertIn('stale', detail)
    used = [' | '.join(e) for e in entries]
    ok, detail = gate.judge_attr_diff(
      {'probe': (0, {'compared': {'0': 5}, 'explained': 1, 'unexplained': [],
                     'known_used': used, 'uncompared': [], 'nounwind': {},
                     'nounwind_below': [], 'no_llvm_passes': True,
                     'residue': {}})}, entries)
    self.assertTrue(ok, detail)

  def test_the_policy_text_describes_the_qualifiers_and_checked_rows(self):
    text = (BIN.parent.parent / gate.ATTR_KNOWN).read_text()
    self.assertIn('symbol=GLOB', text)
    self.assertIn('unit=GLOB', text)
    self.assertIn('accepted, checked', text)


class ExpectationInheritance(unittest.TestCase):
  '''The CIR tools read the expectations by main's rules: the default
  configuration's lines under the configuration's own.'''

  PARENT = ('a.cpp:rp:-DT=1:FAIL:\nb.cpp:rp:-DT=1:CATASTROPHE:\n'
            'd.cpp:rp:-DT=1:SKIPPED:\n')
  OWN = ('a.cpp:rp:-DT=1:PASS:\nc.cpp:rp:-DT=1:FAIL(COMPILE):\n'
         'd.cpp:rp:-DT=1:FAIL:\n')

  def make_tree(self, tmp):
    for config, text in (('edg_x86_64', self.PARENT),
                         ('edg_x86_64_cir', self.OWN)):
      directory = Path(tmp) / 'tests' / 'expectations' / config
      directory.mkdir(parents = True)
      (directory / 'imported.log').write_text(text)
    return Path(tmp) / 'tests' / 'expectations'

  def test_the_reference_failures_are_the_effective_ones(self):
    with tempfile.TemporaryDirectory() as tmp:
      root = self.make_tree(tmp)
      cir = summary.load_reference_failures(root / 'edg_x86_64_cir')
      self.assertEqual(dict(cir), {
        'imported/b.cpp': {'-DT=1': 'CATASTROPHE'},
        'imported/c.cpp': {'-DT=1': 'FAIL(COMPILE)'},
        'imported/d.cpp': {'-DT=1': 'FAIL'}})
      default = summary.load_reference_failures(root / 'edg_x86_64')
      self.assertEqual(set(default),
                       {'imported/a.cpp', 'imported/b.cpp', 'imported/d.cpp'})

  def test_the_record_patch_writes_the_delta(self):
    text = (BIN / 'edg-cir-record').read_text()
    code = text.split('REMOTE_PATCH = r"""')[1].split('"""')[0]
    with tempfile.TemporaryDirectory() as tmp:
      root = self.make_tree(tmp)
      # b.cpp now passes (its parent line is overridden), c.cpp changes,
      # e.cpp fails where the parent expects a pass.
      (Path(tmp) / 'run.log').write_text(
        '- imported/b.cpp rp:-DT=1:CATASTROPHE:\n'
        '- imported/c.cpp rp:-DT=1:FAIL(COMPILE):\n'
        '+ imported/c.cpp rp:-DT=1:FAIL:\n'
        '+ imported/e.cpp rp:-DT=1:FAIL:\n')
      env = dict(os.environ, PYTHONPATH = str(BIN.parent / 'pylibs'))
      subprocess.run([sys.executable, '-', 'edg_x86_64_cir', 'run.log'],
                     input = code, text = True, cwd = tmp, env = env,
                     check = True, stdout = subprocess.DEVNULL)
      # The delta from the default configuration's lines: a and b are the
      # explicit passes (the parent expects a failure), d and e differ
      # from the parent, c has none there.
      self.assertEqual(
        (root / 'edg_x86_64_cir' / 'imported.log').read_text().splitlines(),
        ['a.cpp:rp:-DT=1:PASS:', 'b.cpp:rp:-DT=1:PASS:',
         'c.cpp:rp:-DT=1:FAIL:', 'd.cpp:rp:-DT=1:FAIL:',
         'e.cpp:rp:-DT=1:FAIL:'])
      self.assertEqual(
        (root / 'edg_x86_64' / 'imported.log').read_text(), self.PARENT)

  def test_the_cir_files_are_deltas_in_the_main_format(self):
    # The CIR logs hold the differences from the default configuration's: an
    # explicit PASS line only for a case of a type that a status-gated run
    # executes (rp, lp) where the default configuration fails it, no line
    # equal to the default configuration's, sorted, and no effective PASS
    # line.  (No assertion depends on the default configuration's failures
    # themselves: main may fix a case.)
    root = BIN.parent.parent / 'tests' / 'expectations'
    for config in ('edg_x86_64_cir', 'edg_x86_64_cir_2p'):
      self.assertEqual((root / config / 'INHERITS').read_text(),
                       'edg_x86_64\n')
      for log in sorted((root / config).glob('*.log')):
        parent = summary.read_log_lines(root / 'edg_x86_64' / log.name)
        own = summary.read_log_lines(log)
        self.assertEqual(own, sorted(own), log)
        effective = summary.effective_expectation_lines(config, parent, own)
        self.assertFalse([l for l in effective if ':PASS:' in l], log)
        for line in own:
          fields = line.split(':')
          if fields[3] == 'PASS':
            self.assertIn(fields[1], ('rp', 'lp'), line)

class SupportChecker(unittest.TestCase):
  '''The test-kind rules of make_support.py (README.md "Test kinds"), run
  on a scratch tree: the checker's paths are redirected to it.'''

  def setUp(self):
    self.tmp = tempfile.TemporaryDirectory()
    self.addCleanup(self.tmp.cleanup)
    self.root = Path(self.tmp.name)
    for name, value in (
        ('ROOT', self.root), ('TESTS', self.root / 'tests' / 'tests'),
        ('FILTERS', self.root / 'tests' / '.edgy' / 'filters'),
        ('EXPECTATIONS', self.root / 'tests' / 'expectations' / 'cir'),
        ('REFERENCE', self.root / 'tests' / 'expectations' / 'ref')):
      patcher = unittest.mock.patch.object(support, name, value)
      patcher.start()
      self.addCleanup(patcher.stop)

  def put(self, rel, text = ''):
    path = self.root / rel
    path.parent.mkdir(parents = True, exist_ok = True)
    path.write_text(text)
    return rel

  def record(self, rel, text = 'Error: CIR back end: does not support x',
             configs = None, case = 1):
    '''The .rto recordings of a test file, for each configuration.'''
    path = self.root / rel
    directory = path.parent / ('.' + path.name.split('.')[0] + '.rto')
    directory.mkdir(parents = True, exist_ok = True)
    for config in configs or support.CIR_CONFIGS:
      (directory / f"{config}.{case}.1.txt").write_text(text)

  def check(self, status, tests, gate, group = 'cxx20', **fields):
    '''The (errors, warnings) of one row, without the rules unrelated to
    the test kinds.'''
    row = {'id': f"{group}.x", 'feature': 'F', 'papers': [], 'macro': None,
           'status': status, 'since': 'M3' if status in ('yes', 'partial')
           else None, 'planned': None if status in ('yes', 'partial')
           else 'M6.2', 'note': 'n', 'tests': tests, 'refs': []}
    row.update(fields)
    section = {'schema': 1, 'section': 'cxx', 'title': 'T', 'intro': '',
               'groups': [{'id': group, 'title': 'G', 'rows': [row]}]}
    report = support.Report()
    support.check_data([section], gate, report)
    skip = ('needs a negative test', 'needs a refs entry', 'needs a refs')
    return ([e for e in report.errors if not any(k in e for k in skip)],
            [w for w in report.warnings if not any(k in w for k in skip)])

  def e2e(self, rel, options = None, test_type = 'rp'):
    lines = [f"//type:{test_type}"]
    if options is not None:
      lines.append(f"//options:{options}")
    self.put(rel, '\n'.join(lines) + '\nint main() { return 0; }\n')
    return {'path': rel, 'kind': 'e2e-run'}

  def test_per_case_types_must_be_rp(self):
    # (a) from M6.1a an override other than rp is an error (a warning
    # before), and the mode comes from the rp cases.
    test = self.e2e('tests/tests/cir/a.sft.cpp',
                    '--c++11;fn:--c++20;rp:--c++23')
    errors, warnings = self.check('yes', [test], 'M6.1a')
    self.assertEqual(len(errors), 1, errors)
    self.assertIn('every case must be rp', errors[0])
    errors, warnings = self.check('yes', [test], 'M6.0')
    self.assertEqual(errors, [])
    self.assertTrue(any('every case must be rp' in w for w in warnings))
    # The fn case's C++11 does not lower the mode: C++20 satisfies cxx20.
    self.assertFalse(any('needs an e2e-run test in' in e
                         for e in self.check('yes', [test], 'M6.1a')[0]))
    mode = support.test_mode(self.root / test['path'],
                             support.read_directives(self.root / test['path']))
    self.assertEqual(mode, ('cpp', 2020))
    ok = self.e2e('tests/tests/cir/b.sft.cpp', '--c++20;rp:--c++23 -O2')
    self.assertEqual(self.check('yes', [ok], 'M6.1a'), ([], []))
    # The override list is edgy's: "x" after a semicolon is no override.
    other = self.e2e('tests/tests/cir/c.sft.cpp', '--c++20 -DX=a;b')
    self.assertEqual(self.check('yes', [other], 'M6.1a'), ([], []))

  def test_a_mixed_tu_case_with_xfail_is_not_e2e_run(self):
    # (b)
    self.put('dev_tools/cir-mixed-tu-cases/ok/a.cpp')
    self.put('dev_tools/cir-mixed-tu-cases/ok/xfail', '\n')
    self.put('dev_tools/cir-mixed-tu-cases/bad/a.cpp')
    self.put('dev_tools/cir-mixed-tu-cases/bad/xfail', 'ref+ours\n')
    ok = {'path': 'dev_tools/cir-mixed-tu-cases/ok', 'kind': 'e2e-run'}
    bad = {'path': 'dev_tools/cir-mixed-tu-cases/bad', 'kind': 'e2e-run'}
    self.assertEqual(self.check('yes', [ok], 'M6.1a',
                                mode_independent = True), ([], []))
    errors, _ = self.check('yes', [bad], 'M6.1a', mode_independent = True)
    self.assertEqual(len(errors), 1, errors)
    self.assertIn('non-empty xfail', errors[0])

  def test_negative_tests(self):
    # (c) type fp/fn/fc/cn and a CIR diagnosis in both recordings.
    def negative(rel, test_type = 'fn', **record):
      self.put(rel, f"//type:{test_type}\nint x;\n")
      self.record(rel, **record)
      return {'path': rel, 'kind': 'negative'}
    base = 'tests/tests/cir/n'
    for index, (test_type, text) in enumerate(
        (('fn', 'Error: CIR back end: x does not support y'),
         ('fp', 'warning: CIR back end: it cannot express z'),
         ('fc', 'Command-line error: CIR back end: no'),
         ('cn', 'unknown option: --q'))):
      test = negative(f"{base}{index}.sft.c", test_type, text = text)
      self.assertEqual(self.check('no', [test], 'M6.1a'), ([], []), text)
    # The wrong type, no CIR diagnosis, and a missing second configuration.
    wrong = negative(f"{base}5.sft.c", 'rp')
    self.assertIn('//type:rp', self.check('no', [wrong], 'M6.1a')[0][0])
    plain = negative(f"{base}6.sft.c", text = 'error: something else')
    errors, _ = self.check('no', [plain], 'M6.1a')
    self.assertEqual(len(errors), 2, errors)
    one = negative(f"{base}7.sft.c", configs = ['edg_x86_64_cir'])
    errors, _ = self.check('no', [one], 'M6.1a')
    self.assertEqual(len(errors), 1, errors)
    self.assertIn('edg_x86_64_cir_2p', errors[0])
    # Not under tests/tests/cir/.
    outside = negative('tests/tests/imported/o.sft.c')
    self.assertIn('must be a test under', self.check(
      'no', [outside], 'M6.1a')[0][0])
    # Lit negatives: a CHECK line that expects an error; not bad-*.
    self.put('cir_src/test/lit/errors.test',
             '# RUN: x\n# NOFILE: cannot read\n# TRIPLE: error{{.*}}no\n')
    self.put('cir_src/test/lit/dump.test', '# RUN: error out\n# CHECK: ok\n')
    self.put('cir_src/test/lit/bad-x.test', '# CHECK: error: bad\n')
    good = {'path': 'cir_src/test/lit/errors.test', 'kind': 'negative'}
    self.assertEqual(self.check('no', [good], 'M6.1a'), ([], []))
    for name in ('dump', 'bad-x'):
      test = {'path': f"cir_src/test/lit/{name}.test", 'kind': 'negative'}
      self.assertEqual(len(self.check('no', [test], 'M6.1a')[0]), 1, name)

  def test_every_case_of_a_negative_test_shows_the_diagnosis(self):
    rel = 'tests/tests/cir/m.sft.c'
    self.put(rel, '//type:fn\n')
    test = {'path': rel, 'kind': 'negative'}
    self.record(rel, case = 1)
    self.record(rel, 'Error: CIR back end: x does not support y', case = 2)
    self.assertEqual(self.check('no', [test], 'M6.1a'), ([], []))
    # The -O2 case lost the diagnosis: one error for each configuration.
    self.record(rel, 'no diagnostics at all\n', case = 2)
    errors, _ = self.check('no', [test], 'M6.1a')
    self.assertEqual(len(errors), 2, errors)
    self.assertIn('case 2', errors[0])

  def test_only_a_diagnosis_line_counts(self):
    warning = ("edg-cir: warning [1003]: the unused definition of '_Z1fv' "
               'was dropped and erased: it uses a construct the CIR back '
               'end cannot express: the builtin function x')
    self.assertFalse(support.shows_diagnosis(warning))
    self.assertTrue(support.shows_diagnosis(
      warning + '\nError: CIR back end: the definition of f was dropped: '
      'it uses a construct the CIR back end cannot express: x'))
    # A marker outside the CIR back end's lines and the errors.
    self.assertFalse(support.shows_diagnosis('note: it does not support x'))
    self.assertTrue(support.shows_diagnosis('error: x does not support y'))
    self.assertTrue(support.shows_diagnosis(
      'eccp: unknown option: --nope'))
    rel = 'tests/tests/cir/w.sft.cpp'
    self.put(rel, '//type:fp\n')
    self.record(rel, warning)
    errors, _ = self.check(
      'no', [{'path': rel, 'kind': 'negative'}], 'M6.1a')
    self.assertEqual(len(errors), 2, errors)

  def test_a_lit_not_check_is_no_error_expectation(self):
    self.put('cir_src/test/lit/n.test',
             '# RUN: x\n# CHECK-NOT: error\n# TRIPLE-NOT: error{{.*}}\n')
    self.put('cir_src/test/lit/y.test',
             '# RUN: x\n# CHECK-NOT: error\n# CHECK: error: bad\n')
    no = {'path': 'cir_src/test/lit/n.test', 'kind': 'negative'}
    yes = {'path': 'cir_src/test/lit/y.test', 'kind': 'negative'}
    self.assertEqual(len(self.check('no', [no], 'M6.1a')[0]), 1)
    self.assertEqual(self.check('no', [yes], 'M6.1a'), ([], []))

  def failing(self, rows):
    self.put('tests/expectations/cir/imported.log', rows)
    self.put('tests/tests/imported/f.sft.c', '//type:rp\n')
    return {'path': 'tests/tests/imported/f.sft.c', 'kind': 'failing'}

  def test_failing_tests_of_a_no_row_fail_loudly(self):
    # (d) FAIL(COMPILE) for an rp test, FAIL for an lp test.
    loud = self.failing('f.sft.c:rp:-DTEST_NUMBER=1:FAIL(COMPILE):\n')
    self.assertEqual(self.check('no', [loud], 'M6.1a'), ([], []))
    quiet = self.failing('f.sft.c:rp:-DTEST_NUMBER=1:FAIL:\n')
    errors, _ = self.check('no', [quiet], 'M6.1a')
    self.assertEqual(len(errors), 1, errors)
    self.assertIn('FAIL(COMPILE) for rp', errors[0])
    errors, warnings = self.check('no', [quiet], 'M6.0')
    self.assertEqual(errors, [])
    self.assertEqual(len(warnings), 1, warnings)
    # An lp test that fails in the link, and an output mismatch.
    link = self.failing('f.sft.c:lp:-DTEST_NUMBER=1:FAIL:\n')
    self.assertEqual(self.check('no', [link], 'M6.1a'), ([], []))
    mismatch = self.failing(
      'f.sft.c:rp:-DTEST_NUMBER=1:FAIL(COMPILE)--OUTPUT MISMATCH:\n')
    self.assertEqual(len(self.check('no', [mismatch], 'M6.1a')[0]), 1)
    # A partial row keeps any failing status.
    errors, _ = self.check('partial', [quiet, self.e2e(
      'tests/tests/cir/p.sft.cpp', '--c++20')], 'M6.1a')
    self.assertEqual(errors, [])

  def test_the_mode_rule_applies_to_partial_rows(self):
    # (e)
    old = self.e2e('tests/tests/cir/old.sft.cpp', '--c++11')
    errors, _ = self.check('partial', [old], 'M6.1a')
    self.assertEqual(len(errors), 1, errors)
    self.assertIn('needs an e2e-run test in C++ mode 2020', errors[0])
    errors, warnings = self.check('partial', [old], 'M6.0')
    self.assertEqual(errors, [])
    self.assertEqual(len(warnings), 1, warnings)
    self.assertEqual(self.check('partial', [old], 'M6.1a',
                                mode_independent = True), ([], []))

  def test_writer_and_lib_directories(self):
    # The writer and lib kinds have directory rules.
    self.put('tests/tests/cir/w.sft.c',
             '//type:fp\n//script:edg-cir-ecil-dump\n')
    self.put('tests/tests/cir/nw.sft.c', '//type:fp\n')
    self.put('cir_src/test/writer/x.test')
    self.put('cir_src/test/cirgen/y.test')
    self.put('tests/tests/imported/z.sft.c', '//script:edg-cir-ecil-dump\n')
    def kind(rel, name):
      return self.check('yes', [{'path': rel, 'kind': name},
                                self.e2e('tests/tests/cir/e.sft.cpp',
                                         '--c++20')], 'M6.1a')[0]
    self.assertEqual(kind('tests/tests/cir/w.sft.c', 'writer'), [])
    self.assertEqual(kind('cir_src/test/writer/x.test', 'writer'), [])
    self.assertEqual(len(kind('tests/tests/cir/nw.sft.c', 'writer')), 1)
    self.assertEqual(len(kind('tests/tests/imported/z.sft.c', 'writer')), 1)
    self.assertEqual(len(kind('cir_src/test/cirgen/y.test', 'writer')), 1)
    self.assertEqual(kind('cir_src/test/cirgen/y.test', 'lib'), [])
    self.assertEqual(len(kind('cir_src/test/writer/x.test', 'lib')), 1)
    self.assertEqual(len(kind('tests/tests/cir/w.sft.c', 'lib')), 1)


class SupportSweep(unittest.TestCase):
  '''The support-sweep step: where it is wired in, what it selects and
  how it judges an edgy run.'''

  def test_the_step_is_wired_in(self):
    self.assertIn('support-sweep', gate.STEPS)
    self.assertIn('support-sweep', gate.STEP_FUNCTIONS)
    self.assertIn('support-sweep', gate.M4_STEPS)
    self.assertIn('support-sweep', gate.default_steps(True, True))
    self.assertNotIn('support-sweep', gate.default_steps(False, False))
    # It uses the results of ctest and mixed-tu of the same evidence.
    for earlier in ('ctest', 'mixed-tu'):
      self.assertLess(gate.STEPS.index(earlier),
                      gate.STEPS.index('support-sweep'))
    for area in ('writer', 'library', 'eccp', 'toolchain', 'support'):
      self.assertIn('support-sweep', gate.AREA_STEPS[area], area)
    self.assertIn(gate.SUPPORT_GATE, support.GATES)

  def test_the_areas_of_the_support_files(self):
    self.assertEqual(
      gate.areas_of('tests/tests/cir/features/libstdcxx/a.sft.cpp'),
      ('tests', 'support'))
    self.assertEqual(gate.areas_of('cir_src/doc/support/c.json'),
                     ('support', 'tooling'))
    # The rest of the CIR documentation still needs no step.
    self.assertEqual(gate.areas_of('cir_src/doc/design.md'), ())
    self.assertEqual(gate.areas_of('tests/tests/cir/config/a.sft.c'),
                     ('tests',))
    steps, _ = gate.lean_steps(['support', 'tooling'])
    self.assertEqual(steps, ['build', 'tools-test', 'support-sweep'])

  def test_the_selection(self):
    sections = [{'groups': [{'rows': [
      {'tests': [{'path': 'tests/tests/cir/a.sft.c', 'kind': 'e2e-run'},
                 {'path': 'tests/tests/imported/gnu/c/b.sft.c',
                  'kind': 'failing'},
                 {'path': 'cir_src/test/lit/errors.test',
                  'kind': 'negative'},
                 {'path': 'dev_tools/cir-mixed-tu-cases/s1-x',
                  'kind': 'e2e-run'}]},
      {'tests': [{'path': 'tests/tests/cir/features/c/f.sft.c',
                  'kind': 'negative'}]},
      {'tests': []}]}]}]
    selection = gate.support_selection(
      sections, ['cir/features/c/f.sft.c', 'cir/features/c/g.sft.c'])
    self.assertEqual(selection, {
      'edgy': ['cir/a.sft.c', 'cir/features/c/f.sft.c',
               'cir/features/c/g.sft.c'],
      'failing': ['imported/gnu/c/b.sft.c'],
      'lit': ['cir_src/test/lit/errors.test'], 'mixed': ['s1-x']})

  def test_the_feature_tests_are_the_test_files(self):
    with tempfile.TemporaryDirectory() as tmp:
      base = Path(tmp) / 'tests' / 'tests' / 'cir' / 'features'
      for name in ('cxx/a.sft.cpp', 'cxx/.a.rto/edg_x86_64_cir.1.1.txt',
                   'c/b.sft.c', 'c/.hidden.sft.c', 'c/notes.txt'):
        (base / name).parent.mkdir(parents = True, exist_ok = True)
        (base / name).write_text('')
      self.assertEqual(
        gate.feature_tests(Path(tmp)),
        ['cir/features/c/b.sft.c', 'cir/features/cxx/a.sft.cpp'])
      self.assertEqual(gate.feature_tests(Path(tmp) / 'none'), [])

  def test_an_edgy_run_is_judged(self):
    selection = {'edgy': ['cir/a.sft.c', 'imported/b.sft.c'],
                 'failing': ['imported/f.sft.c'], 'lit': [], 'mixed': []}

    def result(path, bucket = 'PASS', status = 'PASS'):
      return {'path': path, 'bucket': bucket, 'status': status,
              'variant': '-D'}
    first, second = gate.SUPPORT_CONFIGS
    good = [result('cir/a.sft.c'), result('imported/b.sft.c'),
            result('imported/f.sft.c', 'FE_FAIL', 'FAIL(COMPILE)')]
    problems, note = gate.judge_support_run(first, selection, good, '')
    self.assertEqual(problems, [])
    self.assertIn('3 tests', note)
    # The second configuration runs the cir suite only.
    problems, _ = gate.judge_support_run(second, selection, good[:1], '')
    self.assertEqual(problems, [])
    # A vacuous run, a test that did not run, a case that does not pass and
    # a difference from the recorded expectations are problems.
    self.assertEqual(len(gate.judge_support_run(first, selection, [],
                                                '')[0]), 1)
    self.assertIn('did not run', gate.judge_support_run(
      first, selection, good[:1], '')[0][0])
    bad = [result('cir/a.sft.c', 'FAIL', 'FAIL'), *good[1:]]
    self.assertIn('do not pass', gate.judge_support_run(
      first, selection, bad, '')[0][0])
    problems, _ = gate.judge_support_run(
      first, selection, good, '- imported/f.sft.c rp:-D:FAIL(COMPILE):\nok\n')
    self.assertEqual(len(problems), 1)
    self.assertIn('differ from the recorded', problems[0])
    # A failing test is not required to pass.
    self.assertEqual(gate.judge_support_run(first, selection, good,
                                            '')[0], [])


class SandboxWrapper(unittest.TestCase):
  '''The cir-security sandbox wrapper (edg-cir-sandbox): the docker command
  line it builds, what it refuses, and the symlink-proof readers (no box,
  no Docker).'''

  TOOL = BIN / 'edg-cir-sandbox'
  FULL_ID = ('sha256:cd5c7f63e579bd757e9e2169bd945e3424adf92635bd6'
             '74515b95729e1a17286')

  def expected_argv(self, root, audit, number, timeout):
    return [
      '/usr/bin/timeout', '-k', '30', str(timeout + 60),
      '/usr/bin/docker', 'run', '-i', '--rm', '--pull', 'never', '--init',
      '--log-driver', 'none', '--network', 'none', '--ipc', 'private',
      '--pids-limit', '512', '--cap-drop', 'ALL',
      '--security-opt', 'no-new-privileges', '--user', '65534:65534',
      '--cpus', '8', '--memory', '16g', '--memory-swap', '16g',
      '--ulimit', 'core=0', '--ulimit', 'fsize=2147483648',
      '--ulimit', 'nofile=4096', '--read-only',
      '--tmpfs', '/tmp:rw,exec,nosuid,nodev,size=4g',
      '-e', 'HOME=/tmp', '-e', 'ASAN_OPTIONS=detect_leaks=0',
      '-e', 'ASAN_SYMBOLIZER_PATH=/edg/llvm-cir/bin/llvm-symbolizer',
      '--name', f"cir-sec-{audit}-{number}",
      '--label', f"edg.job=cir-sec-{audit}",
      '-v', f"{root}/{audit}/snap:/edg/workspace:ro",
      '-v', f"{root}/{audit}/work/{number}:/work", '-w', '/work',
      self.FULL_ID, 'nice', '-n', '10', 'timeout', '-k', '10', str(timeout),
      'bash', '-s']

  def run_tool(self, *args, stdin = ''):
    return subprocess.run([sys.executable, '-I', str(self.TOOL), *args],
                          input = stdin, capture_output = True, text = True)

  def test_the_shebang_runs_python_isolated(self):
    first = self.TOOL.read_text().splitlines()[0]
    self.assertEqual(first, '#!/usr/bin/python3 -I')
    self.assertTrue(os.access(self.TOOL, os.X_OK))

  def test_the_argv_is_pinned_flag_by_flag(self):
    argv = sandbox.docker_argv('/s', 'sec1', '7', 600)
    self.assertEqual(argv, self.expected_argv('/s', 'sec1', '7', 600))
    # The security flags, one by one (a regression names the flag).
    pairs = {'--network': 'none', '--ipc': 'private', '--pids-limit': '512',
             '--cap-drop': 'ALL', '--security-opt': 'no-new-privileges',
             '--user': '65534:65534', '--cpus': '8', '--memory': '16g',
             '--memory-swap': '16g', '--pull': 'never', '--log-driver': 'none',
             '--tmpfs': '/tmp:rw,exec,nosuid,nodev,size=4g'}
    for flag, value in pairs.items():
      self.assertEqual(argv[argv.index(flag) + 1], value, flag)
    for flag in ('--rm', '--init', '--read-only', '-i'):
      self.assertEqual(argv.count(flag), 1, flag)
    for bad in ('--privileged', '--pid', '--userns', '--cap-add',
                '--device', '--net', '--volumes-from', '--add-host'):
      self.assertNotIn(bad, argv)
    ulimits = [argv[i + 1] for i, a in enumerate(argv) if a == '--ulimit']
    self.assertEqual(ulimits, ['core=0', 'fsize=2147483648', 'nofile=4096'])
    # The image is the full ID, and every -v is the snapshot (read-only) or
    # the one work directory.
    self.assertEqual(argv[argv.index('-w') + 2], self.FULL_ID)
    mounts = [argv[i + 1] for i, a in enumerate(argv) if a == '-v']
    self.assertEqual(mounts, ['/s/sec1/snap:/edg/workspace:ro',
                              '/s/sec1/work/7:/work'])
    self.assertNotIn('docker.sock', ' '.join(argv))
    # nice and the in-container timeout come after the image.
    tail = argv[argv.index(self.FULL_ID) + 1:]
    self.assertEqual(tail, ['nice', '-n', '10', 'timeout', '-k', '10', '600',
                            'bash', '-s'])
    # The outer timeout is the inner one plus 60 s.
    self.assertEqual(argv[:4], ['/usr/bin/timeout', '-k', '30', '660'])

  def test_the_dry_run_prints_the_argv(self):
    result = self.run_tool('run', 'delta-abc-1', '12', '--timeout=90',
                           '--dry-run')
    self.assertEqual(result.returncode, 0, result.stderr)
    lines = [l for l in result.stdout.splitlines() if not l.startswith('#')]
    self.assertEqual(len(lines), 1)
    argv = shlex.split(lines[0])
    root = sandbox.scratch_root()
    self.assertEqual(argv, self.expected_argv(root, 'delta-abc-1', '12', 90))
    # The default timeout, and the option order does not matter.
    result = self.run_tool('run', '--dry-run', 'sec4', '0')
    line = [l for l in result.stdout.splitlines()
            if not l.startswith('#')][0]
    self.assertEqual(shlex.split(line),
                     self.expected_argv(root, 'sec4', '0', 600))

  def test_bad_audits_are_refused(self):
    for bad in ('sec0', 'sec5', 'SEC1', 'sec1 ', 'sec1\n', 'sec1/x',
                '../sec1', 'delta-', 'delta-A', 'delta-' + 'a' * 33,
                'delta_x', 'delta-a/b', '', 'sec', 'x'):
      with self.assertRaises(sandbox.SandboxError, msg = repr(bad)):
        sandbox.check_audit(bad)
    for good in ('sec1', 'sec4', 'delta-m6-1', 'delta-' + 'a' * 32):
      self.assertEqual(sandbox.check_audit(good), good)

  def test_bad_run_numbers_are_refused(self):
    for bad in ('', 'a', '-1', '12345', '1 ', '1\n', '1.0', '+1', '0x1',
                '../1'):
      with self.assertRaises(sandbox.SandboxError, msg = repr(bad)):
        sandbox.check_number(bad)
    for good in ('0', '7', '0007', '9999'):
      self.assertEqual(sandbox.check_number(good), good)

  def test_bad_paths_are_refused(self):
    bad = ['/etc/passwd', '..', '../x', 'a/../b', 'a//b', 'a/', './a', 'a/.',
           'a b', 'a\nb', 'a;b', 'a$b', 'a*b', '~', 'a`b`', '', 'a\\b',
           'a' * 256, 'a' * 513, '/'.join(['a'] * 33), '-x/..']
    for text in bad:
      with self.assertRaises(sandbox.SandboxError, msg = repr(text)):
        sandbox.check_path(text)
    self.assertEqual(sandbox.check_path('.'), [])
    self.assertEqual(sandbox.check_path('a/b.c/d-e=f:g_h'),
                     ['a', 'b.c', 'd-e=f:g_h'])
    self.assertEqual(len(sandbox.check_path('/'.join(['a'] * 32))), 32)

  def test_bad_timeouts_are_refused(self):
    for bad in ('', '0', '00', '3601', '99999', '100000', '-1', '1e3', 'abc',
                '1.5', ' 5', '5\n'):
      with self.assertRaises(sandbox.SandboxError, msg = repr(bad)):
        sandbox.check_timeout(bad)
    self.assertEqual(sandbox.check_timeout('1'), 1)
    self.assertEqual(sandbox.check_timeout('3600'), 3600)

  def test_the_command_line_takes_no_docker_options(self):
    for args in (['run', 'sec1', '1', '--privileged'],
                 ['run', 'sec1', '1', '--network=host'],
                 ['run', 'sec1', '1', '-v', '/:/x'],
                 ['run', 'sec1', '1', '--timeout', '60'],
                 ['run', 'sec1', '1', '--timeout=60', '--timeout=70'],
                 ['run', 'sec1', '1', '--timeout='],
                 ['run', 'sec1', '1', '--image=x'],
                 ['run', 'sec1'],
                 ['run', 'sec1', '1', '2'],
                 ['ls', 'sec1', '1'],
                 ['ls', 'sec1', '1', '.', '--dry-run'],
                 ['cat', 'sec1', '1', 'a', 'b'],
                 ['cat', 'sec1', '1', '--x'],
                 ['status', 'sec1'],
                 ['status', '--dry-run'],
                 ['exec', 'sec1', '1'], ['rm', 'sec1', '1', 'a'], []):
      with self.assertRaises(sandbox.SandboxError, msg = args):
        sandbox.parse(args)
    verb, positional, options = sandbox.parse(
      ['run', 'sec1', '3', '--dry-run', '--timeout=5'])
    self.assertEqual((verb, positional, options),
                     ('run', ['sec1', '3'],
                      {'dry_run': True, 'timeout': 5}))

  def test_the_refusals_exit_with_2_through_the_tool(self):
    for args in (['run', 'sec5', '1', '--dry-run'],
                 ['run', 'sec1', 'x', '--dry-run'],
                 ['run', 'sec1', '1', '--timeout=0', '--dry-run'],
                 ['run', 'sec1', '1', '--privileged', '--dry-run'],
                 ['ls', 'sec1', '1', '../x'], ['cat', 'sec1', '1', '/etc/x'],
                 ['cat', 'sec1', '1', '.'], ['frob']):
      result = self.run_tool(*args)
      self.assertEqual(result.returncode, 2, (args, result.stderr))
      self.assertEqual(result.stdout, '')

  def make_root(self, tmp):
    root = os.path.join(tmp, 'scratch')
    os.makedirs(os.path.join(root, 'sec1', 'snap'))
    return root

  def test_a_run_number_is_used_once_and_the_directory_is_open(self):
    with tempfile.TemporaryDirectory() as tmp:
      root = self.make_root(tmp)
      old = os.umask(0o077)
      try:
        path = sandbox.make_work(root, 'sec1', '3')
      finally:
        os.umask(old)
      self.assertEqual(path, os.path.join(root, 'sec1', 'work', '3'))
      self.assertEqual(os.stat(path).st_mode & 0o777, 0o777)
      with self.assertRaisesRegex(sandbox.SandboxError, 'exists'):
        sandbox.make_work(root, 'sec1', '3')
      sandbox.make_work(root, 'sec1', '4')
      # No snapshot, no run; a symlink as the snapshot does not count.
      with self.assertRaises(sandbox.SandboxError):
        sandbox.make_work(root, 'sec2', '1')
      os.mkdir(os.path.join(root, 'sec3'))
      os.symlink('/etc', os.path.join(root, 'sec3', 'snap'))
      with self.assertRaises(sandbox.SandboxError):
        sandbox.make_work(root, 'sec3', '1')

  def test_the_script_copy_is_exclusive_and_not_followed(self):
    with tempfile.TemporaryDirectory() as tmp:
      root = self.make_root(tmp)
      path = sandbox.save_script(root, 'sec1', '1', b'echo hi\n')
      self.assertEqual(path, os.path.join(root, 'sec1', 'scripts', '1.sh'))
      self.assertEqual(Path(path).read_bytes(), b'echo hi\n')
      self.assertEqual(os.stat(path).st_mode & 0o777, 0o600)
      with self.assertRaises(FileExistsError):
        sandbox.save_script(root, 'sec1', '1', b'x')
      victim = Path(tmp) / 'victim'
      victim.write_text('keep')
      os.symlink(victim, os.path.join(root, 'sec1', 'scripts', '2.sh'))
      with self.assertRaises(FileExistsError):
        sandbox.save_script(root, 'sec1', '2', b'overwrite')
      self.assertEqual(victim.read_text(), 'keep')

  def plant(self, tmp):
    root = self.make_root(tmp)
    work = Path(sandbox.make_work(root, 'sec1', '1'))
    (work / 'f.txt').write_text('hello\n')
    (work / 'sub').mkdir()
    (work / 'sub' / 'g.txt').write_text('deep\n')
    os.symlink('/etc/passwd', work / 'link')
    os.symlink('sub', work / 'dirlink')
    os.symlink('..', work / 'sub' / 'up')
    os.mkfifo(work / 'fifo')
    (work / 'a\nb').write_text('x')
    return root, work

  def test_cat_reads_regular_files_and_refuses_symlinks(self):
    with tempfile.TemporaryDirectory() as tmp:
      root, work = self.plant(tmp)
      base = ['sec1', 'work', '1']
      self.assertEqual(sandbox.read_file(root, base + ['f.txt']),
                       (b'hello\n', 6))
      self.assertEqual(sandbox.read_file(root, base + ['sub', 'g.txt'])[0],
                       b'deep\n')
      # A symlink as the last component, as a middle one, to a file, to a
      # directory, and one that climbs out.
      for parts in (['link'], ['dirlink', 'g.txt'], ['sub', 'up', 'f.txt'],
                    ['sub', 'up']):
        with self.assertRaises(sandbox.SandboxError, msg = parts):
          sandbox.read_file(root, base + parts)
      # A FIFO (opened non-blocking and then refused), a directory, nothing.
      for parts in (['fifo'], ['sub'], ['nothing'], ['f.txt', 'x']):
        with self.assertRaises(sandbox.SandboxError, msg = parts):
          sandbox.read_file(root, base + parts)

  def test_the_work_directory_itself_may_not_be_a_symlink(self):
    with tempfile.TemporaryDirectory() as tmp:
      root, work = self.plant(tmp)
      other = Path(tmp) / 'elsewhere'
      other.mkdir()
      (other / 'f.txt').write_text('secret')
      os.symlink(other, os.path.join(root, 'sec1', 'work', '2'))
      with self.assertRaises(sandbox.SandboxError):
        sandbox.read_file(root, ['sec1', 'work', '2', 'f.txt'])
      with self.assertRaises(sandbox.SandboxError):
        sandbox.list_directory(root, ['sec1', 'work', '2'])
      # The same for a symlinked audit directory.
      os.symlink(os.path.join(root, 'sec1'), os.path.join(root, 'sec2'))
      with self.assertRaises(sandbox.SandboxError):
        sandbox.list_directory(root, ['sec2', 'work', '1'])

  def test_ls_lists_without_following(self):
    with tempfile.TemporaryDirectory() as tmp:
      root, work = self.plant(tmp)
      lines = sandbox.list_directory(root, ['sec1', 'work', '1'])
      kinds = {line.split(' ', 2)[2]: line[0] for line in lines}
      self.assertEqual(kinds, {'a\\nb': '-', 'dirlink': 'l', 'f.txt': '-',
                               'fifo': 'p', 'link': 'l', 'sub': 'd'})
      # The listing never names a symlink's target.
      self.assertFalse([l for l in lines if 'passwd' in l])
      self.assertEqual(
        sorted(l.split(' ', 2)[2] for l in sandbox.list_directory(
          root, ['sec1', 'work', '1', 'sub'])), ['g.txt', 'up'])
      for parts in (['dirlink'], ['f.txt'], ['nothing'], ['sub', 'up']):
        with self.assertRaises(sandbox.SandboxError, msg = parts):
          sandbox.list_directory(root, ['sec1', 'work', '1'] + parts)

  def test_cat_caps_the_size_and_ls_caps_the_entries(self):
    with tempfile.TemporaryDirectory() as tmp:
      root = self.make_root(tmp)
      work = Path(sandbox.make_work(root, 'sec1', '1'))
      (work / 'big').write_bytes(b'x' * (sandbox.CAT_MAX + 5000))
      data, size = sandbox.read_file(root, ['sec1', 'work', '1', 'big'])
      self.assertEqual((len(data), size),
                       (sandbox.CAT_MAX, sandbox.CAT_MAX + 5000))
      saved = sandbox.LS_MAX
      sandbox.LS_MAX = 3
      try:
        for i in range(5):
          (work / f"e{i}").write_text('')
        lines = sandbox.list_directory(root, ['sec1', 'work', '1'])
      finally:
        sandbox.LS_MAX = saved
      self.assertEqual(len(lines), 4)
      self.assertEqual(lines[-1],
                       '... more entries (the listing stops at 3)')

  def test_the_output_is_capped_while_it_is_drained(self):
    read_end, write_end = os.pipe()
    total = sandbox.OUTPUT_MAX * 4 + 123

    def writer():
      block = b'y' * 65536
      sent = 0
      while sent < total:
        piece = block[:min(len(block), total - sent)]
        os.write(write_end, piece)
        sent += len(piece)
      os.close(write_end)

    thread = threading.Thread(target = writer)
    thread.start()
    kept, dropped, reason = sandbox.drain(read_end)
    thread.join()
    os.close(read_end)
    self.assertEqual(len(kept), sandbox.OUTPUT_MAX)
    self.assertEqual(dropped, total - sandbox.OUTPUT_MAX)
    self.assertIsNone(reason)

  def test_the_drain_checks_on_a_tick_while_idle_and_while_flooded(self):
    # Idle: the writer says nothing, the check fires on the tick.
    read_end, write_end = os.pipe()
    calls = []

    def idle_check():
      calls.append(time.monotonic())
      return 'enough' if len(calls) == 3 else None

    start = time.monotonic()
    kept, dropped, reason = sandbox.drain(read_end, idle_check, 0.05)
    self.assertEqual((kept, dropped, reason), (b'', 0, 'enough'))
    self.assertEqual(len(calls), 3)
    self.assertGreaterEqual(time.monotonic() - start, 0.1)
    os.close(read_end)
    os.close(write_end)
    # Flooded: the pipe is never empty, the check still fires.
    read_end, write_end = os.pipe()
    stop = threading.Event()

    def flood():
      block = b'z' * 65536
      while not stop.is_set():
        try:
          os.write(write_end, block)
        except OSError:
          break

    thread = threading.Thread(target = flood)
    thread.start()
    seen = []

    def flood_check():
      seen.append(1)
      return 'flooded' if len(seen) == 2 else None

    kept, dropped, reason = sandbox.drain(read_end, flood_check, 0.05)
    stop.set()
    os.close(read_end)
    thread.join()
    os.close(write_end)
    self.assertEqual(reason, 'flooded')
    self.assertEqual(len(kept), sandbox.OUTPUT_MAX)
    self.assertGreater(dropped, 0)

  class FakeVfs:
    def __init__(self, free, files = 1000000, favail = 1000000,
                 frsize = 4096):
      self.f_frsize = frsize
      self.f_bavail = free // frsize
      self.f_files = files
      self.f_favail = favail

  def test_the_disk_checks_kill_on_space_inodes_and_growth(self):
    gib = 1 << 30
    start = 200 * gib
    problem = lambda free, scan_size = 0, **kw: sandbox.disk_problem(
      '/r', '/w', start, lambda _: self.FakeVfs(free, **kw),
      lambda *_: (scan_size, 0, [], True))
    self.assertIsNone(problem(199 * gib))
    # Free space under the kill floor (10 GiB).
    self.assertIn('MiB free', problem(9 * gib))
    # Inodes under 1 %.
    self.assertIn('inodes', problem(150 * gib, favail = 9000))
    self.assertIsNone(problem(150 * gib, favail = 10001))
    # The shared file system fell by over 20 GiB: WORK/N itself decides.
    self.assertIsNone(problem(170 * gib, 1 * gib))
    self.assertIn('WORK/N holds over', problem(170 * gib, 25 * gib))
    # A fall within the cap is not measured at all.
    def no_scan(*_):
      raise AssertionError('scanned')
    self.assertIsNone(sandbox.disk_problem(
      '/r', '/w', start, lambda _: self.FakeVfs(190 * gib), no_scan))

  def test_the_start_check_matches_the_kill_thresholds(self):
    self.assertEqual(sandbox.MIN_FREE, 20 * (1 << 30))
    self.assertEqual(sandbox.DISK_KILL_FREE, 10 * (1 << 30))
    self.assertEqual(sandbox.GROWTH_MAX, 20 * (1 << 30))
    self.assertGreater(sandbox.MIN_FREE, sandbox.DISK_KILL_FREE)
    with tempfile.TemporaryDirectory() as tmp:
      saved = sandbox.MIN_FREE_INODES
      sandbox.MIN_FREE_INODES = 2.0
      try:
        with self.assertRaises(sandbox.SandboxError) as caught:
          sandbox.check_free(tmp)
      finally:
        sandbox.MIN_FREE_INODES = saved
      self.assertEqual(caught.exception.code, sandbox.EXIT_BUSY)

  def test_scan_tree_counts_without_following_and_reports_setuid(self):
    with tempfile.TemporaryDirectory() as tmp:
      work = Path(tmp) / 'w'
      (work / 'a' / 'b').mkdir(parents = True)
      (work / 'a' / 'b' / 'data').write_bytes(b'x' * 100000)
      suid = work / 'a' / 'suid'
      suid.write_text('x')
      os.chmod(suid, 0o4755)
      sgid = work / 'sgid'
      sgid.write_text('x')
      os.chmod(sgid, 0o2755)
      os.symlink('..', work / 'a' / 'loop')
      os.symlink(tmp, work / 'out')
      size, count, special, done = sandbox.scan_tree(str(work), 5)
      self.assertTrue(done)
      self.assertEqual(sorted(special), ['a/suid', 'sgid'])
      self.assertGreaterEqual(size, 100000)
      self.assertEqual(count, 7)
      # The stop conditions: bytes, entries.
      self.assertFalse(sandbox.scan_tree(str(work), 5, 50000)[3])
      saved = sandbox.SCAN_ENTRIES
      sandbox.SCAN_ENTRIES = 2
      try:
        self.assertFalse(sandbox.scan_tree(str(work), 5)[3])
      finally:
        sandbox.SCAN_ENTRIES = saved
      self.assertEqual(
        sandbox.scan_tree(str(work / 'missing'), 1)[2:], ([], True))

  def test_only_the_first_signal_interrupts(self):
    saved = list(sandbox.SIGNALLED)
    del sandbox.SIGNALLED[:]
    try:
      with self.assertRaises(sandbox.Interrupted):
        sandbox.on_signal(signal.SIGTERM, None)
      # The second and third signals do nothing: the cleanup (docker kill)
      # cannot be interrupted again.
      self.assertIsNone(sandbox.on_signal(signal.SIGHUP, None))
      self.assertIsNone(sandbox.on_signal(signal.SIGINT, None))
    finally:
      sandbox.SIGNALLED[:] = saved

  def test_a_run_is_killed_unless_it_ended_by_itself(self):
    text = self.TOOL.read_text()
    self.assertIn('killed = True    # until the run ends by itself', text)
    self.assertIn('killed = status in (124, 137, -9, -15)', text)

  def test_cleanup_blocks_further_signals(self):
    text = self.TOOL.read_text()
    body = text.split('  finally:\n    # A second signal')[1].split(
      'sys.stdout.buffer.write(output)')[0]
    self.assertIn('signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)', body)
    self.assertLess(body.index('pthread_sigmask'), body.index('docker_kill'))
    self.assertEqual(sandbox.SIGNALS, {signal.SIGHUP, signal.SIGINT,
                                       signal.SIGTERM})

  def test_the_slots_are_exclusive_and_a_full_house_is_busy(self):
    with tempfile.TemporaryDirectory() as tmp:
      root = os.path.join(tmp, 'scratch')
      saved = sandbox.SLOT_WAIT
      sandbox.SLOT_WAIT = 0
      held = []
      try:
        for _ in range(sandbox.SLOTS):
          held.append(sandbox.take_slot(root))
        with self.assertRaises(sandbox.SandboxError) as caught:
          sandbox.take_slot(root)
        self.assertEqual(caught.exception.code, sandbox.EXIT_BUSY)
        os.close(held.pop())
        held.append(sandbox.take_slot(root))
      finally:
        sandbox.SLOT_WAIT = saved
        for fd in held:
          os.close(fd)

  def test_a_short_disk_is_busy(self):
    with tempfile.TemporaryDirectory() as tmp:
      saved = sandbox.MIN_FREE
      sandbox.MIN_FREE = 1 << 62
      try:
        with self.assertRaises(sandbox.SandboxError) as caught:
          sandbox.check_free(tmp)
      finally:
        sandbox.MIN_FREE = saved
      self.assertEqual(caught.exception.code, sandbox.EXIT_BUSY)
      sandbox.MIN_FREE = 0
      try:
        sandbox.check_free(tmp)
      finally:
        sandbox.MIN_FREE = saved

  def test_the_status_filter_is_the_sandbox_label(self):
    self.assertTrue(sandbox.LABEL_RE.fullmatch('cir-sec-sec1'))
    self.assertTrue(sandbox.LABEL_RE.fullmatch('cir-sec-delta-x'))
    for other in ('cir-lib-x', 'cir-sec-', 'cir-sec-sec9', 'xcir-sec-sec1',
                  'cir-sec-sec1 extra'):
      self.assertFalse(sandbox.LABEL_RE.fullmatch(other), other)

  def test_the_script_size_is_limited(self):
    saved = sys.stdin
    try:
      sys.stdin = io.TextIOWrapper(io.BytesIO(b''))
      with self.assertRaises(sandbox.SandboxError):
        sandbox.read_script()
      sys.stdin = io.TextIOWrapper(
        io.BytesIO(b'x' * (sandbox.SCRIPT_MAX + 1)))
      with self.assertRaises(sandbox.SandboxError):
        sandbox.read_script()
      sys.stdin = io.TextIOWrapper(io.BytesIO(b'x' * sandbox.SCRIPT_MAX))
      self.assertEqual(len(sandbox.read_script()), sandbox.SCRIPT_MAX)
    finally:
      sys.stdin = saved


if __name__ == '__main__':
  unittest.main()
