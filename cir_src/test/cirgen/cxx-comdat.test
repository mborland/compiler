; C++ (ECIL v1, slice S1): vague linkage.  linkonce_odr and weak_odr
; definitions with COMDAT are in a comdat group of their own name (the name is
; the final one); a declaration is external and has none.  A linkonce_odr
; variable with COMDAT and a constant initializer.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; CHECK-DAG: cir.func comdat linkonce_odr dso_local @_Z6inlinev() -> {{.*}}!s32i
; CHECK-DAG: cir.func comdat weak_odr dso_local @_Z4tmplIiEiT_(
; CHECK-DAG: cir.func private @_Z8externalv() -> {{.*}}!s32i
; CHECK-DAG: cir.global constant linkonce_odr comdat dso_local @_Z2ivE = #cir.int<7> : !s32i
; CHECK-NOT: comdat @_Z8external

; SYMS-DAG: {{[Ww]}} _Z6inlinev
; SYMS-DAG: {{[Ww]}} _Z4tmplIiEiT_

frame DECLS
  STR 11 "_Z6inlinev"
  STR 12 "_Z4tmplIiEiT_"
  STR 13 "_Z8externalv"
  STR 14 "_Z2ivE"
  STR 15 "main"
  STR 16 "x"
  TY_FUNC 21 1 0 []
  TY_FUNC 22 1 0 [1]
  DECL_FUNC 100 21 3 67 11
  DECL_FUNC 101 22 4 65 12
  DECL_FUNC 102 21 0 0 13
  DECL_FUNC 103 21 0 9 15
  DECL_VAR 104 1 3 131 4 14
  C_INT 1 7
  VAR_INIT 104
frame REGION
  FUNC_BEGIN 100 0
  CONST_INT 1 5
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 101 0
  PARAM 1 1 1 16 0
  LREF 1
  LOAD 0
  CONST_INT 1 1
  ADD 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 103 0
  CALL 100 21 0 0
  CONST_INT 1 5
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 1
  RETURN_STMT true
  IF_END
  CONST_INT 1 41
  CALL 101 22 1 0
  CONST_INT 1 42
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 2
  RETURN_STMT true
  IF_END
  GREF 104
  LOAD 0
  CONST_INT 1 7
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 3
  RETURN_STMT true
  IF_END
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
