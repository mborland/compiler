; C++ (ECIL v1, slice S1): a STRUCTOR pair whose base variant is not defined
; here (a constructor declared in a header, defined in another TU): both stay
; external declarations, there is no alias, and the call keeps naming C1.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %not grep alias %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; CHECK-DAG: cir.func private @_ZN1EC1Ei(!cir.ptr<!rec_E>{{.*}}, !s32i{{.*}})
; CHECK-DAG: cir.func private @_ZN1EC2Ei(!cir.ptr<!rec_E>{{.*}}, !s32i{{.*}})
; CHECK: cir.call @_ZN1EC1Ei({{.*}}) nothrow

; SYMS-DAG: U _ZN1EC1Ei

frame DECLS
  STR 11 "E"
  STR 12 "_ZN1EC2Ei"
  STR 13 "_ZN1EC1Ei"
  STR 14 "main"
  TY_RECORD_DECL 21 0 11
  TY_RECORD_BODY 21 4 4 4 0 1
  REC_FIELD 1 0 nil nil nil 0
  TY_PTR 22 21
  TY_FUNC 23 11 0 [22, 1]
  TY_FUNC 24 1 0 []
  DECL_FUNC 100 23 0 0 12
  DECL_FUNC 101 23 0 0 13
  STRUCTOR 101 100 0
  DECL_FUNC 102 24 0 9 14
frame REGION
  FUNC_BEGIN 102 0
  LOCAL 1 21 nil 4 0
  LREF 1
  ADDR
  CONST_INT 1 3
  CALL 101 23 2 0
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
