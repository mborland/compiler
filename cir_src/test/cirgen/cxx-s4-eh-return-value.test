; C++11 (ECIL 1.2): a function that returns a class by value (RETURN_SLOT)
; while the destructor of a local throws on the normal path.
;   R c_f(int k) { Td a(k); return R(1); }
;   R c_g(int k) { Td a(3); Td b(k); R r(2); return r; }     // NRVO
; The exception leaves the function through the EH cleanups of the other
; locals (c_g: a is destroyed after b throws).  The returned object is not
; destroyed: that is what clang does, classic and with -fclangir (g++ destroys
; it, CWG 2176), and what the pin lowers.
; RUN: cat %S/Inputs/header12_cxx_eh.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -std=c++17 %S/Inputs/s4_eh_return_value_host.cpp %t.o -o %t.exe
; RUN: %t.exe | %FileCheck %s --check-prefix=LOG
; RUN: %edg-cir --emit=obj -O2 -o %t2.o %t.ecil
; RUN: g++ -std=c++17 %S/Inputs/s4_eh_return_value_host.cpp %t2.o -o %t2.exe
; RUN: %t2.exe | %FileCheck %s --check-prefix=LOG

; CHECK-LABEL: cir.func {{.*}}@c_f(
; CHECK: cir.cleanup.scope
; CHECK-LABEL: cir.func {{.*}}@c_g(
; CHECK: cir.cleanup.scope

; LOG: c_f(3)
; LOG-NEXT: Td ctor 3
; LOG-NEXT: R ctor 1
; LOG-NEXT: Td dtor 3
; LOG-NEXT: returned 1
; LOG-NEXT: R dtor 1
; LOG-NEXT: c_f(7)
; LOG-NEXT: Td ctor 7
; LOG-NEXT: R ctor 1
; LOG-NEXT: Td dtor 7
; LOG-NEXT: caught 77
; LOG-NEXT: c_g(3)
; LOG-NEXT: Td ctor 3
; LOG-NEXT: Td ctor 3
; LOG-NEXT: R ctor 2
; LOG-NEXT: Td dtor 3
; LOG-NEXT: Td dtor 3
; LOG-NEXT: returned 2
; LOG-NEXT: R dtor 2
; LOG-NEXT: c_g(7)
; LOG-NEXT: Td ctor 3
; LOG-NEXT: Td ctor 7
; LOG-NEXT: R ctor 2
; LOG-NEXT: Td dtor 7
; LOG-NEXT: Td dtor 3
; LOG-NEXT: caught 77

