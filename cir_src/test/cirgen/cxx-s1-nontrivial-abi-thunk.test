ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S1 review item 5): NONTRIVIAL_ABI by-value parameters
; (a class with a copy constructor, a move constructor and a destructor, heap
; owned) through a this-adjusting thunk (C::fb through B*, _ZThn) and through a
; plain virtual call, and the move out of the parameter.  The program is run
; with AddressSanitizer: a double destruction or a leak is an error.
;   struct S { char *p; S(const char *); S(const S &); S(S &&); ~S(); };
;   struct A { virtual int fa(S s); }; struct B { virtual int fb(S s); };
;   struct C : A, B { int fb(S s) override; int fa(S s) override; };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -fsanitize=address %t.o -o %t.exe
; RUN: %t.exe

; CHECK: cir.func {{.*}}@_ZThn{{[0-9]+}}_N1C2fbE1S
; CHECK: cir.call @_ZN1C2fbE1S(

