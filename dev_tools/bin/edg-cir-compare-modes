#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Check that in-process and two-process CIR compilation agree.

For every test of a filter list (the M2 gate: the whole C corpus), compiles
the test source twice with eccp -S, with the options the test would get from
edgy: once with cpfe-cir (the CIR library in-process) and once through
cpfe-cir-2p (cpfe-cir writing an ECIL file, then edg-cir).  The two runs must
give the same exit status, a byte-identical .int.s (checked first), and the
same diagnostics once the CIR library's two message formats are reduced to
one (see normalize_diagnostics).

Run inside the cir-env image from the repository root:

  edg-exec --img cir-env -- python3 dev_tools/bin/edg-cir-compare-modes \\
      @tests/.edgy/filters/cir-c-smoke.txt
  ... @tests/.edgy/filters/cir-c-corpus.txt --types rp,lp -j 12

With --save-asm <dir> the in-process assembly of every test case is also
written to <dir>/<test path, '/' as '__'>.<case number>.s, and the exit status
of every case to <dir>/manifest.json; with --in-process-only the two-process
run is skipped, so the command only produces that directory (the commit-vs-
commit baseline of edg-cir-gate-evidence's asm-diff step).

A different exit status (other than the front end's error limit: 4 in-process,
2 in two-process mode) or different assembly is a failure (`DIFF`, exit status
1).  Differences only in the diagnostics (text, order, count) or in the
error-limit exit status are listed as `INFO` and do not fail: the two modes
report the library's diagnostics from different programs.
'''

import argparse
import concurrent.futures
import difflib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple

import edgtest
import edgtest.runtest as runtest

STANDARD_OPTIONS = [
  '-DTEST_NUMBER=1', '--gnu_version=999999', '-e', '200', '--no_wrap',
  '--no_wrap_diagnostics', '--gcc'
]
# The options edgy gives the C++ tests of the GNU testsuite: --gcc would
# select C in eccp, so C++ runs use -tused and a GNU version instead.
STANDARD_CXX_OPTIONS = [
  '-DTEST_NUMBER=1', '--gnu_version=999999', '-tused', '-e', '200',
  '--no_wrap', '--no_wrap_diagnostics'
]


def load_exports(env_file: Path) -> Dict[str, str]:
  exports = {}
  if env_file.exists():
    for line in env_file.read_text().splitlines():
      match = re.match(r'export (\w+)="?([^"]*)"?$', line)
      if match:
        exports[match.group(1)] = match.group(2)
  return exports


def read_filters(spec: str) -> Tuple[List[str], List[str]]:
  lines: List[str] = []
  if spec.startswith('@'):
    for line in Path(spec[1:]).read_text().splitlines():
      line = line.strip()
      if line and not line.startswith('#'):
        lines.append(line)
  else:
    lines = spec.split(',')
  positive = [l for l in lines if not l.startswith('!')]
  negative = [l[1:] for l in lines if l.startswith('!')]
  return positive, negative


def find_tests(tests_dir: Path, positive: List[str],
               negative: List[str]) -> List[Path]:
  found = []
  for suite in sorted(p for p in tests_dir.iterdir()
                      if p.is_dir() and not p.name.startswith('.')):
    for path in sorted(edgtest.walk_test_directory(
        suite, edgtest.DEFAULT_TEST_EXTENSIONS)):
      rel = f"{suite.name}/{path.relative_to(suite).as_posix()}"
      if positive and not any(rel.startswith(p) for p in positive):
        continue
      if any(rel.startswith(n) for n in negative):
        continue
      found.append(path)
  return found


_IN_PROCESS_REGEX = re.compile(
  r'^(?:"[^"]*", line \d+: )?(Error|error|Warning|warning|Remark|remark): '
  r'CIR back end: (.*)$'
)
_TWO_PROCESS_REGEX = re.compile(
  r'^edg-cir: (error|warning|remark) \[\d+\]: (.*)$'
)
_SUMMARY_REGEX = re.compile(r'^\d+ (error|warning)s? detected')


def normalize_diagnostics(text: str) -> List[str]:
  '''Make the diagnostics of the two modes comparable.

  The CIR library's diagnostics are written by the front end in-process
  ("Error: CIR back end: <text>", with a position and source lines) and by
  edg-cir in the two-process mode ("edg-cir: error [N]: <text>", without
  them).  Both reduce to "<severity>: <text>"; the front end's own
  diagnostics are kept as they are; source lines, carets, blank lines, the
  error count summary and the generic edg-cir status line are dropped.
  '''
  result = []
  for line in text.splitlines():
    match = _IN_PROCESS_REGEX.match(line) or _TWO_PROCESS_REGEX.match(line)
    if match:
      result.append(f"CIR {match.group(1).lower()}: {match.group(2).strip()}")
    elif (not line.strip() or line.startswith(' ') or
          _SUMMARY_REGEX.match(line) or line.startswith('edg-cir: ')):
      continue
    else:
      result.append(line)
  return result


def compile_once(source: Path, options: List[str], env: Dict[str, str],
                 work: Path) -> Tuple[int, str, Optional[bytes]]:
  work.mkdir(parents = True, exist_ok = True)
  local = work / source.name
  shutil.copy2(source, local)
  for extra in source.parent.glob('*.h'):
    shutil.copy2(extra, work / extra.name)
  try:
    proc = subprocess.run(
      [env['ECCP'], '-S', *options, local.name], cwd = work, env = env,
      stdout = subprocess.PIPE, stderr = subprocess.STDOUT, text = True,
      timeout = 300
    )
    rc, output = proc.returncode, proc.stdout
  except subprocess.TimeoutExpired:
    return 124, 'timeout', None
  produced = next(iter(work.glob('*.int.s')), None)
  return rc, output, produced.read_bytes() if produced else None


def asm_name(test: Path, tests_dir: Path, case_number: int) -> str:
  '''The name of a test case's saved assembly (see --save-asm).'''
  rel = test.relative_to(tests_dir).as_posix().replace('/', '__')
  return f"{rel}.{case_number}.s"


def compare_one(test: Path, tests_dir: Path, env_in: Dict[str, str],
                env_2p: Dict[str, str], keep: Optional[Path],
                save_asm: Optional[Path] = None,
                in_process_only: bool = False,
                standard: Optional[List[str]] = None,
                manifest: Optional[Dict[str, dict]] = None
                ) -> Optional[Tuple[str, str]]:
  '''Return None if the modes agree, else ("FAIL"|"INFO", message).

  With save_asm, the in-process assembly is saved and manifest gets the exit
  status of each case; with in_process_only, only that is done.
  '''
  description = runtest.load_description(test, top_dir = tests_dir /
                                         test.relative_to(tests_dir).parts[0])
  for case_number, (mode, base_options, case_options) in enumerate(
      description.traverse_cases()):
    options = [*(standard or STANDARD_OPTIONS), *base_options,
               *case_options]
    work = Path(tempfile.mkdtemp(prefix = 'cmpmodes.'))
    try:
      rc_a, out_a, asm_a = compile_once(test, options, env_in, work / 'a')
      if save_asm is not None:
        name = asm_name(test, tests_dir, case_number)
        if asm_a is not None:
          (save_asm / name).write_bytes(asm_a)
        if manifest is not None:
          manifest[name] = {'rc': rc_a, 'asm': asm_a is not None}
      if in_process_only:
        continue
      rc_b, out_b, asm_b = compile_once(test, options, env_2p, work / 'b')
    finally:
      if keep is None:
        shutil.rmtree(work, ignore_errors = True)
    if rc_a != rc_b:
      message = f"exit status differs: in-process {rc_a}, two-process {rc_b}"
      if (rc_a, rc_b) == (4, 2):
        # The front end stops at its error limit (-e 200) and exits with a
        # catastrophic error; edg-cir has no such limit.
        return 'INFO', message + ' (error limit)'
      return 'FAIL', message
    if asm_a != asm_b:
      return 'FAIL', 'generated assembly differs'
    diags_a = normalize_diagnostics(out_a)
    diags_b = normalize_diagnostics(out_b)
    if diags_a != diags_b:
      diff = list(difflib.unified_diff(diags_a, diags_b, lineterm = '', n = 0))
      return 'INFO', 'diagnostics differ: ' + ' | '.join(
        line[:110] for line in diff[2:8]
      )
  return None


def main() -> None:
  parser = argparse.ArgumentParser(description = __doc__.split('\n')[0])
  parser.add_argument('filters', help = '"@file" or comma separated '
                                        'prefixes, as for edgy')
  parser.add_argument('--types', default = '',
                      help = 'only tests with a case of these types')
  parser.add_argument('--root', default = '.')
  parser.add_argument('-j', dest = 'jobs', type = int,
                      default = os.cpu_count() or 1)
  parser.add_argument('--keep', default = None)
  parser.add_argument('--save-asm', default = None,
                      help = 'directory for the in-process assembly of every '
                             'test case (and manifest.json)')
  parser.add_argument('--cxx', action = 'store_true',
                      help = 'compile the tests as C++ (the options edgy '
                             'gives the C++ tests, not --gcc)')
  parser.add_argument('--in-process-only', action = 'store_true',
                      help = 'skip the two-process run (needs --save-asm)')
  args = parser.parse_args()

  root = Path(args.root).resolve()
  tests_dir = root / 'tests' / 'tests'
  cir_env = load_exports(root / 'build/gcc-cir/environment.sh')
  base = dict(os.environ)
  base.update(cir_env)
  base['EDG_BASE'] = str(root / 'bases/docker/cir-env/gcc')
  base['ECCP_LIBDIR'] = cir_env.get('EDG_CIR_RT_LIBDIR', '')
  base['ECCP'] = str(root / 'util/eccp.sh')
  env_in = dict(base)
  env_in['CPFE'] = cir_env['CPFE_CIR']
  env_2p = dict(base)
  env_2p['CPFE'] = str(root / 'dev_tools/bin/cpfe-cir-2p')
  env_2p['CPFE_CIR_BIN'] = cir_env['CPFE_CIR']

  positive, negative = read_filters(args.filters)
  tests = find_tests(tests_dir, positive, negative)
  if args.types:
    wanted = set(args.types.split(','))
    selected = []
    for test in tests:
      description = runtest.load_description(
        test, top_dir = tests_dir / test.relative_to(tests_dir).parts[0]
      )
      if any(runtest.test_type_to_string(m) in wanted
             for m, _, _ in description.traverse_cases()):
        selected.append(test)
    tests = selected
  keep = Path(args.keep) if args.keep else None
  standard = STANDARD_CXX_OPTIONS if args.cxx else STANDARD_OPTIONS
  save_asm = Path(args.save_asm).resolve() if args.save_asm else None
  if args.in_process_only and save_asm is None:
    parser.error('--in-process-only needs --save-asm')
  if save_asm is not None:
    save_asm.mkdir(parents = True, exist_ok = True)
  manifest: Dict[str, dict] = {}
  print(f"comparing {len(tests)} tests with {args.jobs} jobs", flush = True)

  failures = []
  infos = []
  with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
    futures = {
      pool.submit(compare_one, t, tests_dir, env_in, env_2p, keep,
                  save_asm, args.in_process_only, standard, manifest): t
      for t in tests
    }
    for future in concurrent.futures.as_completed(futures):
      problem = future.result()
      if problem:
        (failures if problem[0] == 'FAIL' else infos).append(
          (futures[future], problem[1])
        )
  if save_asm is not None:
    (save_asm / 'manifest.json').write_text(
      json.dumps(manifest, indent = 1, sort_keys = True) + '\n'
    )
    print(f"saved {sum(1 for m in manifest.values() if m['asm'])} assembly "
          f"files of {len(manifest)} cases in {save_asm}")
  for test, message in sorted(failures):
    print(f"DIFF {test.relative_to(tests_dir)}: {message}")
  for test, message in sorted(infos):
    print(f"INFO {test.relative_to(tests_dir)}: {message}")
  identical = len(tests) - len(failures) - len(infos)
  print(f"{identical} identical, {len(infos)} with only diagnostic or "
        f"error-limit differences (info), {len(failures)} different")
  sys.exit(1 if failures else 0)


main()
