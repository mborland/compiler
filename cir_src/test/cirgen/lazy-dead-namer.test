ecil 1.2 features=0x0000000a
; Lazy emission: a function body nothing reachable names is dropped, but a
; linkonce vtable of a class nothing uses (here E, whose virtual functions are
; inline) still names it.  Such a dead namer is erased with the function, so the
; output has no declaration of a function it does not define; with
; --no-llvm-passes (no GlobalDCE) an unused vtable would otherwise be an
; undefined reference.  Eager emission keeps both (GlobalDCE removes them).
;   struct E { virtual const char *what() const { return "x"; }
;              virtual ~E() {} };  int main() { return 0; }
; The stream is the ECIL writer's output for the program.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --stats --emit=cir -o %t.lazy.cir %t.ecil 2> %t.err
; RUN: %FileCheck %s --check-prefix=STATS < %t.err
; RUN: %FileCheck %s --check-prefix=LAZY --implicit-check-not=_ZTV1E --implicit-check-not=_ZNK1E4whatEv < %t.lazy.cir
; RUN: %edg-cir --eager-bodies --emit=cir -o %t.eager.cir %t.ecil
; RUN: %FileCheck %s --check-prefix=EAGER < %t.eager.cir
; RUN: %edg-cir --no-llvm-passes --emit=obj -o %t.o %t.ecil
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS --implicit-check-not=_ZTV1E --implicit-check-not=_ZNK1E4whatEv
; RUN: %edg-cir --no-llvm-passes --eager-bodies --emit=obj -o %t.eager.o %t.ecil
; RUN: nm %t.eager.o | %FileCheck %s --check-prefix=EAGER-SYMS
; RUN: %edg-cir --emit=asm -o %t.s %t.ecil
; RUN: %edg-cir --eager-bodies --emit=asm -o %t.e.s %t.ecil
; RUN: cmp %t.s %t.e.s

; STATS: stats: lazy bodies: 2 deferred, 0 replayed, 2 dropped
; STATS: {{[0-9]+}} dropped bodies named by {{[1-9][0-9]*}} dead entities
; LAZY: cir.func {{.*}}@main
; EAGER-DAG: @_ZTV1E
; EAGER-DAG: @_ZNK1E4whatEv
; SYMS: T main
; EAGER-SYMS-DAG: _ZTV1E
; EAGER-SYMS-DAG: _ZNK1E4whatEv

frame HEADER
  STR 1 "x86_64-unknown-linux-gnu"
  STR 2 ""
  STR 3 "EDG C/C++ front end 7.0 (ECIL writer)"
  STR 4 "/tmp/t.cpp"
  TY_INT 1 32 true 4 4
  TY_INT 2 64 false 8 8
  TY_INT 3 64 true 8 8
  HDR_TARGET 1 2 nil 64 64 6
  HDR_LANG 1 201703 14
  HDR_PRODUCER 3 4
  HDR_TYPE_ROLE 3 1
  HDR_TYPE_ROLE 1 2
  HDR_TYPE_ROLE 2 3
frame REGION
  TY_INT 4 8 true 1 1
  TY_PTR 5 4
  STR 5 "E"
  TY_RECORD_DECL 6 0 5
  TY_PTR 7 6
  TY_FUNC 8 5 0 [7]
  TY_VPTR 9
  TY_RECORD_BODY 6 8 8 8 12 1
  REC_FIELD 9 0 nil nil nil 1
  STR 6 "1E"
  CLASS_MANGLE 6 6
  CLASS_INFO 6 8 8 nil 3
  CLASS_BASES 6 []
  STR 7 "_ZNK1E4whatEv"
  DECL_FUNC 10 8 0 2 7
  DECL_FUNC 10 8 3 67 7
  TY_VOID 11
  TY_FUNC 12 11 0 [7]
  STR 8 "_ZN1ED1Ev"
  DECL_FUNC 13 12 0 130 8
  STR 9 "_ZN1ED2Ev"
  DECL_FUNC 14 12 0 130 9
  STRUCTOR 13 14 1
  TY_PTR 15 11
  TY_FUNC 16 11 0 [15, 2]
  STR 10 "_ZdlPvm"
  DECL_FUNC 17 16 0 128 10
  STR 11 "_ZN1ED0Ev"
  DECL_FUNC 18 12 0 130 11
  STRUCTOR_DELETING 18 13 17 1
  CLASS_VFUNCS 6 [10, 0, 0, 1, 13, 1, 0, 0]
  CLASS_OVERRIDES 6 []
  STR 12 "this"
  TY_ARRAY 19 4 2 0
  STR 13 ".str"
  DECL_VAR 20 19 2 11 0 13
  C_STRING 19 "x\x00"
  VAR_INIT 20
  FUNC_BEGIN 10 0
  PARAM 1 7 7 12 1
  BLOCK_BEGIN
  GREF 20
  ADDR
  CAST 12 5
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION
  DECL_FUNC 13 12 3 195 8
  DECL_FUNC 14 12 3 195 9
  DECL_FUNC 18 12 3 195 11
  FUNC_BEGIN 14 0
  PARAM 1 7 7 12 1
  FUNC_EH_SPEC 1 []
  VPTR_INIT
  BLOCK_BEGIN
  RETURN_STMT false
  BLOCK_END
  FUNC_END 0
frame REGION
  TY_FUNC 21 1 0 []
  STR 14 "main"
  DECL_FUNC 22 21 0 8 14
  DECL_FUNC 22 21 0 9 14
  FUNC_BEGIN 22 0
  BLOCK_BEGIN
  CONST_INT 1 0
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame GLOBALS
  DECL_ABI_DATA 23 2 6 3 3 nil
  DECL_ABI_DATA 24 0 6 3 3 nil
frame NAMES
frame END
  END 6 0
