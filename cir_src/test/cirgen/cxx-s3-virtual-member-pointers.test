; C++ (ECIL 1.2, slice S3): pointers to virtual member functions.  V1 { f, g },
; V2 { h }, W : V1, V2 { g, h } and their vtables are the ECIL writer's output;
; the constants and the call are hand-written: &V1::f (the vtable offset form),
; &V1::g, a W pointer to V2::h (this-adjustment 16 and a virtual function: the
; lowered {offset + 1, adjustment} global), an array of one of those and
; &W::g (a normal virtual constant converted into the lowered array), PM_CALL
; through them (get_method: the vtable entry of the adjusted object), and the
; function constants made at run time (a vtable offset method pointer, and
; derived_method for the adjustment).  A g++ and a clang unit
; (Inputs/s3_vmp_host.cpp) check values and calls in both directions.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s3_vmp_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s3_vmp_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe

; CHECK-DAG: cir.global external dso_local @vpf = #cir.method<vtable_offset = 0> : !cir.method<
; CHECK-DAG: cir.global external dso_local @vpg = #cir.method<vtable_offset = 8> : !cir.method<
; CHECK-DAG: cir.global external dso_local @vph = #cir.const_record<{#cir.int<1> : !s64i, #cir.int<16> : !s64i}> : !rec_anon_struct
; CHECK-DAG: cir.global external dso_local @varr = #cir.const_array<[#cir.const_record<{#cir.int<1> : !s64i, #cir.int<16> : !s64i}> : !rec_anon_struct, #cir.const_record<{#cir.int<9> : !s64i, #cir.int<0> : !s64i}> : !rec_anon_struct]>
; CHECK-LABEL: cir.func {{.*}}@mk_vf(
; CHECK: cir.const #cir.method<vtable_offset = 0>
; CHECK-LABEL: cir.func {{.*}}@mk_vh(
; CHECK: cir.const #cir.method<vtable_offset = 0> : !cir.method<{{.*}} in !rec_V2>
; CHECK: cir.derived_method %{{.*}}[16]

