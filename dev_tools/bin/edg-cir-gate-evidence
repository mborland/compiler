SLOW_JOBS = 2


def docker_argv(command: List[str]) -> List[str]:
  '''The command line that runs `command` as a user that can run docker:
  as it is (the user is in the docker group on clang4), or through
  `sg docker -c` if EDG_CIR_SG_DOCKER is set (the old box needed it).'''
  if os.environ.get('EDG_CIR_SG_DOCKER', '') in ('', '0'):
    return list(command)
  return ['sg', 'docker', '-c', ' '.join(shlex.quote(c) for c in command)]


class Context:
  def __init__(self, args: argparse.Namespace) -> None:
    self.tree = Path(args.tree).resolve()
    stamp = datetime.now().strftime('%Y.%m.%d-%H.%M.%S')
    self.out = Path(args.out).resolve() if args.out else (
      self.tree / '.tmp' / 'gate-evidence' / stamp
    )
    self.args = args
    self.env = dict(os.environ)
    # edgdocker forwards EDG_CPFE_DEFAULT_OPTIONS into the containers, so a
    # value in the operator's shell would reach every step: only step
    # opt-corpus sets it (for its own runs).
    if self.env.pop('EDG_CPFE_DEFAULT_OPTIONS', None) is not None:
      print('WARNING: EDG_CPFE_DEFAULT_OPTIONS is set in the environment; '
            'it is ignored (removed) for this gate run', file = sys.stderr)
    self.env['PATH'] = f"{self.tree / 'dev_tools/bin'}:{self.env['PATH']}"
    # edgdocker runs the command of every container under this nice value
    # (the host is shared; nice on the docker client does not reach the
    # container): an operator's own value is kept.
    self.env.setdefault('EDG_DOCKER_NICE', CONTAINER_NICE)
    self.env['PYTHONPATH'] = str(self.tree / 'dev_tools/pylibs')
    # The commands of a step that were stopped at their time limit.
    self.timed_out: Dict[str, List[str]] = {}


# The perf options of a milestone gate for the options that were not given
# (the checkpoint passes the same ones: MILESTONE_OPTIONS in
# edg-cir-checkpoint): the pinned real-world units at -O0 and -O2 and the S1
# targets.  Without --milestone the defaults are none, 0 and none.
MILESTONE_PERF = {'perf_realworld': 'pinned', 'perf_levels': '0,2',
                  'perf_targets': 's1'}
PLAIN_PERF = {'perf_realworld': '', 'perf_levels': '0', 'perf_targets': ''}


def resolve_perf_options(args: argparse.Namespace) -> None:
  '''Fill in the perf options that were not given (None): the milestone
  ones with --milestone, else the plain ones.'''
  defaults = MILESTONE_PERF if args.milestone else PLAIN_PERF
  for name, value in defaults.items():
    if getattr(args, name, None) is None:
      setattr(args, name, value)


# The time limit of one command of a step (seconds): a command that hangs is
# stopped, its container with it, and the step fails.  The normal times are a
# small fraction of these; --command-timeout changes the default.
COMMAND_TIMEOUT = 7200
# The nice value of the commands that run in containers (EDG_DOCKER_NICE).
CONTAINER_NICE = '10'
STEP_TIMEOUTS = {
  'isolation': 900, 'writer-stress': 1800, 'cpp-writer-stress': 1800,
  'cpp-stress': 1800, 'cpp-stress-asan': 3600, 'abi-diff': 1800,
  'symbols': 1800, 'mixed-tu': 1800, 'eh-probes': 1800, 'm4-stress': 3600,
  'opt-corpus': 10800, 'lazy-identity': 3600, 'attr-diff': 5400,
  'codequality': 3600, 'chunk-identity': 5400, 'chunk-rss': 3600,
  'slow-below-threshold': 3600, 'names-check': 5400,
  'support-sweep': 5400, 'poison': 3600, 'release-smoke': 3600,
  'crash-sweep': 5400
}


def command_timeout(ctx: Context, step: str) -> int:
  limits = dict(STEP_TIMEOUTS)
  for item in ctx.args.step_timeout:
    name, _, seconds = item.partition('=')
    limits[name] = int(seconds)
  return limits.get(step, ctx.args.command_timeout)


def job_prefix(ctx: Context, step: str) -> str:
  '''The name prefix and label of the containers of a step of this gate run:
  cir-config-<tree>-<step>-g<pid of this process>, so that the containers of
  another gate run (another process, even of the same tree and step) are
  never matched.'''
  return f"cir-config-{ctx.tree.name}-{step}-g{os.getpid()}"


def container_filter(prefix: str) -> str:
  '''The docker filter that matches exactly the containers with the label
  edg.job=<prefix> (a label filter with a value compares the whole value).'''
  return f"label=edg.job={prefix}"


def stop_containers(ctx: Context, prefix: str) -> List[str]:
  '''Stop the containers that carry the label edg.job=<prefix> (the ones
  this step started; edgdocker names them from EDG_DOCKER_NAME_PREFIX) and
  return their ids.'''
  try:
    listing = subprocess.run(
      docker_argv(['docker', 'ps', '-q', '--filter',
                   container_filter(prefix)]),
      stdout = subprocess.PIPE, stderr = subprocess.DEVNULL, text = True)
  except OSError:
    return []
  ids = listing.stdout.split()
  for identifier in ids:
    subprocess.run(docker_argv(['docker', 'stop', '-t', '10', identifier]),
                   stdout = subprocess.DEVNULL, stderr = subprocess.DEVNULL)
  return ids


def run_logged(ctx: Context, step: str, command: List[str],
               label: str = '', cwd: Optional[Path] = None,
               extra_env: Optional[Dict[str, str]] = None) -> int:
  '''Run a command, appending its output to the step's log.txt.

  The command has a time limit (see command_timeout): after it the process
  group is killed and the containers of the step are stopped; the exit
  status is then 124 and the step fails.  The containers are named
  cir-config-<tree>-<step>-g<gate pid>-<pid>-<n> (edgdocker, from the
  environment) and carry the label edg.job=<prefix>.'''
  step_dir = ctx.out / step
  step_dir.mkdir(parents = True, exist_ok = True)
  env = dict(ctx.env)
  prefix = job_prefix(ctx, step)
  env['EDG_DOCKER_NAME_PREFIX'] = prefix
  env.update(extra_env or {})
  limit = command_timeout(ctx, step)
  with open(step_dir / 'log.txt', 'a') as log:
    log.write(f"\n$ {label or ' '.join(shlex.quote(c) for c in command)}\n")
    log.flush()
    proc = subprocess.Popen(
      command, cwd = cwd or ctx.tree, env = env, stdout = log,
      stderr = subprocess.STDOUT, start_new_session = True)
    try:
      code = proc.wait(timeout = limit)
    except subprocess.TimeoutExpired:
      for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
          os.killpg(proc.pid, sig)
        except ProcessLookupError:
          break
        try:
          proc.wait(timeout = 10)
          break
        except subprocess.TimeoutExpired:
          continue
      stopped = stop_containers(ctx, prefix)
      code = 124
      ctx.timed_out.setdefault(step, []).append(
        (label or ' '.join(command))[:70])
      log.write(f"[TIMEOUT after {limit} s; container(s) stopped: "
                f"{', '.join(stopped) or 'none'}]\n")
    log.write(f"[exit {code}]\n")
  return code


def _edg_exec_command(ctx: Context, image: str, command: str,
                      wdir: str = '') -> List[str]:
  '''The command line that runs `bash -c command` in an edg-exec container.

  edg-exec joins its arguments with spaces, so the shell command is passed
  as one argument that already holds the quoting.
  '''
  edg_exec = [str(ctx.tree / 'dev_tools/bin/edg-exec')]
  if image:
    edg_exec += ['--img', image]
  if wdir:
    edg_exec += ['--wdir', wdir]
  edg_exec += ['--', 'bash -c ' + shlex.quote(command)]
  return docker_argv(edg_exec)


def in_cir_env(ctx: Context, step: str, command: str,
               wdir: str = '', extra_env: Optional[Dict[str, str]] = None
               ) -> int:
  '''Run a shell command in the cir-env image with the tree as workspace.

  extra_env variables are set inside the container.
  '''
  prefix = ''.join(
    f"export {key}={shlex.quote(value)}; "
    for key, value in (extra_env or {}).items()
  )
  full = prefix + command
  return run_logged(ctx, step, _edg_exec_command(ctx, 'cir-env', full, wdir),
                    label = command)


def in_default_env(ctx: Context, step: str, command: str) -> int:
  return run_logged(ctx, step, _edg_exec_command(ctx, '', command),
                    label = command)


def rel(ctx: Context, path: Path) -> str:
  '''Path as seen inside the container (the tree is /edg/workspace).'''
  return f"/edg/workspace/{path.relative_to(ctx.tree)}"


def newest_run(ctx: Context, before: set) -> Optional[Path]:
  runs_dir = ctx.tree / 'tests' / 'runs'
  new = [p for p in runs_dir.iterdir() if p.is_dir() and p.name not in before]
  return max(new, key = lambda p: p.stat().st_mtime) if new else None


def runs_before(ctx: Context) -> set:
  runs_dir = ctx.tree / 'tests' / 'runs'
  return {p.name for p in runs_dir.iterdir()} if runs_dir.exists() else set()


def summarize_run(ctx: Context, step: str, run: Path, config: str,
                  json_name: str, extra: Optional[List[str]] = None,
                  text_tag: str = '') -> Tuple[List[dict], str]:
  '''Run edg-cir-summary on a run directory; return (results, text).'''
  json_file = ctx.out / step / json_name
  proc = subprocess.run(
    [sys.executable, str(ctx.tree / 'dev_tools/bin/edg-cir-summary'),
     str(run), config, '--top', '6', '--json', str(json_file),
     '--reference', str(ctx.tree / 'tests/expectations/edg_x86_64'),
     *(extra or [])],
    cwd = ctx.tree, env = ctx.env, stdout = subprocess.PIPE,
    stderr = subprocess.STDOUT, text = True
  )
  (ctx.out / step / f"summary-{config}{text_tag}.txt").write_text(
    proc.stdout)
  results = json.loads(json_file.read_text()).get(config, [])
  return results, proc.stdout


# The per-test limit (-T) is above the 120 s limit of a compiled program
# (edgtest.exec): a program that hangs is a normal FAIL (status 124) and not a
# test that edgy cancelled (an "X" line), as torture/ssp-1 does in every config.
def edgy_run(ctx: Context, step: str, config: str, filters: str,
             types: str, timeout: int = 180, posture: str = 'cir',
             extra_env: Optional[Dict[str, str]] = None
             ) -> Optional[Path]:
  before = runs_before(ctx)
  command = [
    str(ctx.tree / 'dev_tools/bin/edg-docker-test'), '--non-interactive',
    '--posture', posture, '--only-configs', config, '-T', str(timeout),
    '--jobs', str(BUILD_JOBS)
  ]
  if types:
    command += ['--types', types]
  command.append(filters)
  run_logged(ctx, step, docker_argv(command), extra_env = extra_env)
  return newest_run(ctx, before)


# Each step returns (passed, detail).
def step_build(ctx: Context) -> Tuple[bool, str]:
  base = 'export EDG_BASE=/edg/workspace/bases/docker/cir-env/gcc; '
  commands = [
    'cd cir_src && cmake --preset linux-cir-relwithdebinfo',
    f"cmake --build build/cir -j{BUILD_JOBS}",
    base + 'cmake --preset linux-gcc-debug-cir -DEDG_CIR_LINK_LIBRARY=ON',
    f"cmake --build build/gcc-cir --target cpfe-cir edg_prelink edg_decode "
    f"-j{BUILD_JOBS}",
    base + 'cmake --preset linux-gcc-release-cir '
    '-DEDG_CIR_LINK_LIBRARY=ON',
    f"cmake --build build/gcc-release-cir --target cpfe-cir edg_prelink "
    f"edg_decode -j{BUILD_JOBS}"
  ]
  failed = [c for c in commands if in_cir_env(ctx, 'build', c) != 0]
  return not failed, 'built build/cir, build/gcc-cir, build/gcc-release-cir' \
    if not failed else f"failed: {failed[0]}"


IDENTITY_ALLOW = 'tests/.edgy/filters/cir-identity-allowed.txt'


def read_identity_allowlist(path: str) -> Tuple[List[Tuple[str, str]],
                                                List[str]]:
  '''(the entries, the problems) of the identity allow-list: lines
  `<glob> | <reason>`, the glob over the name of a captured file
  (`cpfe/src/lower_name.c.i.gz`: the preprocessed output of one translation
  unit of one target), the reason at least 8 characters, a comment line
  directly above every entry; no duplicate.  A missing file is an empty
  list.'''
  entries: List[Tuple[str, str]] = []
  problems: List[str] = []
  previous = ''
  if path and Path(path).exists():
    for number, raw in enumerate(Path(path).read_text().splitlines(), 1):
      line = raw.strip()
      if line and not line.startswith('#'):
        pattern, _, reason = (p.strip() for p in line.partition('|'))
        where = f"{path}:{number}"
        if not pattern or len(reason) < 8 or reason.lower() in (
            'none', 'todo', 'tbd'):
          problems.append(f"{where}: not `glob | reason` with a real reason")
        if not previous.startswith('#'):
          problems.append(f"{where}: no comment line directly above the "
                          f"entry")
        if any(pattern == e[0] for e in entries):
          problems.append(f"{where}: listed twice ({pattern})")
        entries.append((pattern, reason))
      previous = line
  return entries, problems


# The lines of `edg-macro-identity-check compare` that name a file.
IDENTITY_PROBLEM_RE = re.compile(
  r'^(?P<preset>\S+): (?P<kind>preprocessed output differs|'
  r'generated header differs|dump differs beyond allowed changes|'
  r'only in before|only in after): (?P<name>\S+)$', re.M)


def judge_identity(output: str, code: int, allowed: List[Tuple[str, str]]
                   ) -> Tuple[bool, str, List[str]]:
  '''(passes, detail, the allow-list globs used) of the identity compare.
  Beyond an exit status of 0, a run passes if every problem is the
  preprocessed output of a file that an allow-list glob names (an approved
  change of a file that every back end compiles): the detail then says which
  files differ and why.  A glob that matches no problem is stale and fails.
  A compare that names no count of files, or compared none, passes nothing
  (an empty capture would otherwise be `identical`).'''
  last = output.strip().splitlines()[-1] if output.strip() else ''
  count = re.search(r'(\d+) files compared', last)
  if code == 0 and (not count or int(count.group(1)) == 0):
    return False, (f"compared nothing: {last or 'no output'}"
                   f"{'' if count else ' (no `N files compared` line)'}"), []
  if code == 0:
    return not allowed, last if not allowed else (
      f"{last}; but the allow-list has {len(allowed)} entr"
      f"{'y' if len(allowed) == 1 else 'ies'} that explain nothing (stale): "
      f"{allowed[0][0]}"), []
  match = re.search(r'(\d+) problem\(s\)$', last)
  total = int(match.group(1)) if match else -1
  hits: Dict[str, List[str]] = {}
  for found in IDENTITY_PROBLEM_RE.finditer(output):
    if found.group('kind') != 'preprocessed output differs':
      continue
    name = found.group('name')
    for pattern, _ in allowed:
      if fnmatch.fnmatchcase(name, pattern):
        hits.setdefault(pattern, []).append(f"{found.group('preset')}:{name}")
        break
  explained = sum(len(v) for v in hits.values())
  if total < 0 or explained != total:
    return False, f"{last} ({explained} of the problems are on the " \
      f"allow-list)", list(hits)
  stale = [e[0] for e in allowed if e[0] not in hits]
  reasons = {e[0]: e[1] for e in allowed}
  detail = (f"{last} -- all {total} on the allow-list: " + '; '.join(
    f"{', '.join(v)} ({reasons[k][:60]})" for k, v in hits.items()))
  if stale:
    return False, f"{detail}; STALE allow-list entry: {stale[0]}", list(hits)
  return True, detail, list(hits)


def step_identity(ctx: Context) -> Tuple[bool, str]:
  baseline = ctx.args.identity_baseline
  if not baseline:
    return False, '--identity-baseline is required'
  # The capture runs in a container, so it must be inside the tree.
  out = ctx.tree / '.tmp' / 'gate-identity' / ctx.out.name
  presets = ' '.join(ctx.args.identity_presets.split(','))
  checker = 'python3 dev_tools/bin/edg-macro-identity-check'
  if in_default_env(ctx, 'identity', f"{checker} configure --src . "
                    f"--presets {presets}") != 0:
    return False, 'configure failed'
  if in_default_env(
      ctx, 'identity', f"{checker} capture --src . --out {rel(ctx, out)} "
      f"--presets {presets} --jobs {BUILD_JOBS} --binaries "
      f"--build-jobs {BUILD_JOBS}") != 0:
    return False, 'capture failed'
  proc = subprocess.run(
    [sys.executable, str(ctx.tree / 'dev_tools/bin/edg-macro-identity-check'),
     'compare', '--normalize-line-numbers', '--allow-cir-diagnostics',
     '--presets', ctx.args.identity_presets,
     str(Path(baseline).resolve()), str(out)],
    env = ctx.env, stdout = subprocess.PIPE, stderr = subprocess.STDOUT,
    text = True
  )
  (ctx.out / 'identity' / 'compare.txt').write_text(proc.stdout)
  allow_path = ctx.args.identity_allow
  allowed, problems = read_identity_allowlist(
    str(ctx.tree / allow_path) if allow_path else '')
  if problems:
    return False, 'the identity allow-list is not valid: ' + problems[0]
  passed, detail, _ = judge_identity(proc.stdout, proc.returncode, allowed)
  return passed, detail


def step_isolation(ctx: Context) -> Tuple[bool, str]:
  code = in_cir_env(ctx, 'isolation',
                    'python3 dev_tools/bin/edg-cir-check-isolation')
  text = (ctx.out / 'isolation' / 'log.txt').read_text()
  passes = len(re.findall(r'^PASS:', text, re.M))
  fails = len(re.findall(r'^FAIL:', text, re.M))
  return code == 0, f"{passes} checks passed, {fails} failed"


LAZY_TRIAGE = 'tests/.edgy/filters/cir-lazy-triage.txt'
ATTR_KNOWN = 'tests/.edgy/filters/cir-attr-known.txt'
ATTR_PROBE_FILTERS = ('@tests/.edgy/filters/cir-c-smoke.txt',
                      '@tests/.edgy/filters/cir-cpp-smoke.txt')


def judge_attr_diff(runs: Dict[str, Tuple[int, Optional[dict]]],
                    entries: List[Tuple[str, str, str, str]]
                    ) -> Tuple[bool, str]:
  '''The rule of the step attr-diff: `runs` has, for the probe set and the
  pinned units, the exit status of edg-cir-attr-diff and its JSON.  Every run
  must exit 0 (no unexplained difference, symbols compared at every level, no
  pinned unit missing, nounwind coverage at clangir's share on the pinned
  units), ours must have run without the LLVM passes, and every entry of the
  known-differences file must have explained something in one of the runs (a
  stale entry fails).'''
  problems: List[str] = []
  parts: List[str] = []
  used: set = set()
  explained = unexplained = residue = 0
  residue_kinds: Dict[str, int] = {}
  for name, (code, data) in runs.items():
    if data is None:
      problems.append(f"{name}: no result (exit status {code})")
      continue
    compared = data['compared']
    parts.append(f"{name}: " + ', '.join(
      f"-O{l} {c} symbols" for l, c in sorted(compared.items())))
    explained += data['explained']
    unexplained += len(data['unexplained'])
    used.update(data['known_used'])
    for key, count in data.get('residue', {}).items():
      residue += count
      kind = key.split('|', 1)[1]
      residue_kinds[kind] = residue_kinds.get(kind, 0) + count
    if code != 0:
      detail = []
      if data['unexplained']:
        detail.append(f"{len(data['unexplained'])} unexplained")
      if data['uncompared']:
        detail.append(f"{data['uncompared'][0]}")
      if data['nounwind_below']:
        detail.append('nounwind: ' + data['nounwind_below'][0])
      if any(c == 0 for c in compared.values()):
        detail.append('nothing compared')
      problems.append(f"{name}: exit status {code}"
                      f"{' (' + '; '.join(detail) + ')' if detail else ''}")
    if not data.get('no_llvm_passes'):
      problems.append(f"{name}: edg-cir ran with its LLVM passes")
  stale = [' | '.join(e) for e in entries if ' | '.join(e) not in used]
  if stale:
    problems.append(f"{len(stale)} stale known-difference entr"
                    f"{'y' if len(stale) == 1 else 'ies'} (it explains "
                    f"nothing): {stale[0]}")
  pinned = (runs.get('pinned') or (0, None))[1]
  coverage = ''
  if pinned:
    nounwind = pinned['nounwind'].get('0', {})
    cells = []
    for kind in ('define', 'declare', 'call'):
      n, mine, theirs = nounwind.get(kind, [0, 0, 0])
      if n:
        cells.append(f"{kind} {100.0 * mine / n:.0f}% vs "
                     f"{100.0 * theirs / n:.0f}%")
    coverage = '; nounwind (ours vs clangir, -O0): ' + ', '.join(cells)
  top = ', '.join(f"{k} {v}" for k, v in sorted(
    residue_kinds.items(), key = lambda item: -item[1])[:4])
  detail = ('; '.join(parts) + f"; {explained} explained by {len(used)} of "
            f"{len(entries)} known entries, {unexplained} unexplained in the "
            f"gated attributes; residue (not gated) {residue}"
            f"{' (' + top + ' ...)' if top else ''}" + coverage)
  if problems:
    return False, 'PROBLEMS: ' + ' | '.join(problems[:5]) + ' | ' + detail
  return True, detail


def step_attr_diff(ctx: Context) -> Tuple[bool, str]:
  directory = ctx.out / 'attr-diff'
  directory.mkdir(parents = True, exist_ok = True)
  out = rel(ctx, directory)
  known = shlex.quote(ATTR_KNOWN)
  common = (f"python3 dev_tools/bin/edg-cir-attr-diff --levels 0,2 "
            f"--known {known} --require-no-llvm-passes")
  filters = ' '.join(f"--filter {shlex.quote(f)}"
                     for f in ATTR_PROBE_FILTERS)
  boost = shlex.quote(ctx.args.boost_include)
  in_cir_env(ctx, 'attr-diff',
             f"{common} {filters} --json {out}/probe.json "
             f"--residue {out}/probe-residue.txt "
             f"> {out}/probe.txt 2>&1; echo probe exit $?")
  in_cir_env(ctx, 'attr-diff',
             f"{common} --units pinned --system-headers "
             f"--boost-include {boost} --require-compared "
             f"--nounwind-target --json {out}/pinned.json "
             f"--residue {out}/pinned-residue.txt "
             f"> {out}/pinned.txt 2>&1; echo pinned exit $?")
  # The residue (the differences that are not gated) of both runs, for the
  # handoff.
  with open(directory / 'residue.txt', 'w') as merged:
    for name in ('probe', 'pinned'):
      path = directory / f"{name}-residue.txt"
      merged.write(f"== {name}\n" + (path.read_text() if path.exists()
                                      else '(no residue file)\n'))
  runs: Dict[str, Tuple[int, Optional[dict]]] = {}
  for name in ('probe', 'pinned'):
    text = _read_step_output(ctx, 'attr-diff', f"{name}.txt")
    code = 2
    path = directory / f"{name}.json"
    data = json.loads(path.read_text()) if path.exists() else None
    if data is not None:
      code = data['exit']
    elif 'not valid' in text or 'no such source' in text:
      return False, f"{name}: " + text.strip().splitlines()[0][:200]
    runs[name] = (code, data)
  tool = _load_tool('edg-cir-attr-diff')
  known_path = ctx.tree / ATTR_KNOWN
  entries: List[Tuple[str, str, str, str]] = []
  if known_path.exists():
    entries, problems = tool.validate_known(str(known_path))
    if problems:
      return False, 'the known-differences file is not valid: ' + problems[0]
  return judge_attr_diff(runs, entries)


def judge_codequality(text: str, code: int, results: Optional[dict]
                      ) -> Tuple[bool, str]:
  '''The rule of the step codequality (a report: only the setup is gated):
  edg-cir-codequality exits 0 (it exits 1 if CIR built no kernel, 2 for a
  setup problem).  The detail has the geometric mean of ours against clang
  over the kernels that both built.'''
  match = re.search(r'^(\d+) kernel\(s\); CIR built (\d+)', text, re.M)
  if code != 0 or not match or results is None:
    return False, f"exit status {code}; " + (
      match.group(0) if match else 'no kernel table')
  cells: Dict[str, List[float]] = {'ir': [], 'text': []}
  differs: List[str] = []
  for kernel, rows in sorted(results.items()):
    ours, clang = rows.get('ours', {}), rows.get('clang', {})
    if 'error' in ours or 'error' in clang:
      continue
    for field in cells:
      if ours.get(field) and clang.get(field):
        cells[field].append(ours[field] / clang[field])
    if clang.get('output') and ours.get('output') != clang.get('output'):
      differs.append(kernel)

  def geomean(values: List[float]) -> str:
    if not values:
      return 'n/a'
    product = 1.0
    for value in values:
      product *= value
    return f"x{product ** (1.0 / len(values)):.2f}"

  detail = (f"{match.group(1)} kernels, CIR built {match.group(2)}; ours "
            f"against clang (geometric mean): instructions "
            f"{geomean(cells['ir'])}, .text {geomean(cells['text'])}"
            f"{'; output DIFFERS: ' + ', '.join(differs) if differs else ''}"
            f" (a report, not gated)")
  return True, detail


def step_codequality(ctx: Context) -> Tuple[bool, str]:
  directory = ctx.out / 'codequality'
  directory.mkdir(parents = True, exist_ok = True)
  out = rel(ctx, directory)
  code = in_cir_env(ctx, 'codequality',
                    f"python3 dev_tools/bin/edg-cir-codequality "
                    f"--json {out}/codequality.json > {out}/report.txt 2>&1")
  text = _read_step_output(ctx, 'codequality', 'report.txt')
  path = directory / 'codequality.json'
  return judge_codequality(text, code, json.loads(path.read_text())
                           if path.exists() else None)


