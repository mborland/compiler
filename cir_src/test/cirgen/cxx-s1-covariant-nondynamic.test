ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S1 review): a covariant result whose class is not dynamic:
; D::get returns D2* (D2 : R1, R2, R2 at offset 4) for B1::get's R2*, so the
; vtable entry of get in D is a return-adjusting thunk (_ZTch0_h4_N1D3getEv:
; +4, null preserved).  Only the overrider is defined here; the other unit
; has the key function and the vtable.
;   struct D2 : R1, R2 { int c; };  struct B1 { virtual R2 *get(); };
;   struct D : B1 { D2 *get() override; };
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s1_cov1_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s1_cov1_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; SYMS-DAG: T _ZTch0_h4_N1D3getEv

