# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# ecil-dump then ecil-asm reproduces the stream bit for bit.
# RUN: %ecil-asm %S/Inputs/empty.txt -o %t.a
# RUN: %ecil-dump %t.a > %t.txt
# RUN: %ecil-asm %t.txt -o %t.b
# RUN: cmp %t.a %t.b
# RUN: %ecil-dump %t.a | %FileCheck %s

# CHECK: ecil 0.6 features=0x00000000
# CHECK: frame HEADER
# CHECK: HDR_TARGET 1 2 nil 64 64 6
# CHECK: frame GLOBALS
# CHECK: frame END
# CHECK-NEXT: END 2 0
