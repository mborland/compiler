; Strict contract: CAST bitcast between a pointer and a non-pointer is a
; format error (the writer must use ptr_to_int / int_to_ptr).
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; CHECK: error [1001]: CAST bitcast between a pointer and a non-pointer type

frame DECLS
  STR 10 "f"
  TY_FUNC 20 1 0 []
  DECL_FUNC 30 20 0 1 10
frame REGION
  FUNC_BEGIN 30 0
  CONST_NULL 14
  CAST 11 3
  DROP
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
