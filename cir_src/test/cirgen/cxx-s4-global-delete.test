; C++ (ECIL 1.2, slice S1): polymorphism without virtual bases.  A class with
; C++ (ECIL 1.2): ::delete of a polymorphic object, DELETE flags SIZED|VIRTUAL|GLOBAL.
;   struct A { virtual int f(int); virtual ~A(); int x; };  struct B : A {...};
;   A *q = new B; ::delete q;      (the stream of cxx-s1-virtual with the flag added)
; The complete object is computed through the offset-to-top slot, D1 is called
; through the vtable, and operator delete(void *, size_t) frees the complete
; object, also when D1 throws (clang's emitVirtualObjectDelete).  The program of
; cxx-s1-virtual checks the destruction count and the dispatch.
; RUN: cat %S/Inputs/header12_cxx_eh.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe



; CHECK-LABEL: cir.func {{.*}}@main
; CHECK: cir.ptr_stride {{.*}}!s64i
; CHECK: cir.cleanup.scope {
; CHECK: cir.vtable.get_virtual_fn_addr {{.*}}[1]
; CHECK: } cleanup {{.*}} {
; CHECK: cir.call @_ZdlPvm

