; C++ (ECIL v1, slice S1): PARAM THIS, BASE_CAST and DERIVED_CAST of direct
; bases at non-zero offsets (cir.base_class_addr / cir.derived_class_addr,
; nonnull or null-preserving), members reached through a base.
;   struct A1 { int x; };  struct A2 { int y; };
;   struct D : A1, A2 { int z; };       // A2 at offset 4
;   int sum(D *this) { return x + y + z; }
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1D3sumEv
; CHECK: cir.alloca "this"
; CHECK: cir.base_class_addr nonnull {{.*}} [4] : !cir.ptr<!rec_D> -> !cir.ptr<!rec_A2>
; CHECK-LABEL: cir.func {{.*}}@main
; CHECK: cir.base_class_addr nonnull {{.*}} [4] : !cir.ptr<!rec_D> -> !cir.ptr<!rec_A2>
; CHECK: cir.derived_class_addr nonnull {{.*}} [4] : !cir.ptr<!rec_A2> -> !cir.ptr<!rec_D>
; CHECK: cir.base_class_addr {{%[0-9a-z_]+}} [4] : !cir.ptr<!rec_D> -> !cir.ptr<!rec_A2>
; CHECK: cir.derived_class_addr {{%[0-9a-z_]+}} [4] : !cir.ptr<!rec_A2> -> !cir.ptr<!rec_D>

frame DECLS
  STR 11 "A1"
  STR 12 "A2"
  STR 13 "D"
  STR 14 "_ZN1D3sumEv"
  STR 15 "main"
  STR 16 "this"
  TY_RECORD_DECL 21 0 11
  TY_RECORD_BODY 21 4 4 4 0 1
  REC_FIELD 1 0 nil nil nil 0
  TY_RECORD_DECL 22 0 12
  TY_RECORD_BODY 22 4 4 4 0 1
  REC_FIELD 1 0 nil nil nil 0
  TY_RECORD_DECL 23 0 13
  TY_RECORD_BODY 23 12 12 4 0 3
  REC_FIELD 21 0 nil nil nil 16
  REC_FIELD 22 4 nil nil nil 16
  REC_FIELD 1 8 nil nil nil 0
  TY_PTR 24 23
  TY_PTR 25 22
  TY_FUNC 26 1 0 [24]
  TY_FUNC 27 1 0 []
  DECL_FUNC 100 26 3 65 14
  DECL_FUNC 101 27 0 9 15
frame REGION
  FUNC_BEGIN 100 0
  PARAM 1 24 24 16 1
  LREF 1
  LOAD 0
  DEREF
  FIELD 23 0
  FIELD 21 0
  LOAD 0
  LREF 1
  LOAD 0
  BASE_CAST 23 22 4 1
  DEREF
  FIELD 22 0
  LOAD 0
  ADD 1
  LREF 1
  LOAD 0
  DEREF
  FIELD 23 2
  LOAD 0
  ADD 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 101 0
  LOCAL 1 23 nil 4 0
  LREF 1
  FIELD 23 0
  FIELD 21 0
  CONST_INT 1 1
  STORE 0 0
  LREF 1
  FIELD 23 1
  FIELD 22 0
  CONST_INT 1 20
  STORE 0 0
  LREF 1
  FIELD 23 2
  CONST_INT 1 300
  STORE 0 0
  LREF 1
  ADDR
  CALL 100 26 1 0
  CONST_INT 1 321
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 1
  RETURN_STMT true
  IF_END
  ; &d.A2 == base cast of &d (4 bytes in) and the derived cast undoes it
  LREF 1
  ADDR
  BASE_CAST 23 22 4 1
  CAST 11 13
  LREF 1
  ADDR
  CAST 11 13
  PTR_DIFF 3
  CONST_INT 3 4
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 2
  RETURN_STMT true
  IF_END
  LREF 1
  ADDR
  BASE_CAST 23 22 4 1
  DERIVED_CAST 22 23 4 1
  LREF 1
  ADDR
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 3
  RETURN_STMT true
  IF_END
  ; null stays null through the casts that are not nonnull
  CONST_NULL 24
  BASE_CAST 23 22 4 0
  CONST_NULL 25
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 4
  RETURN_STMT true
  IF_END
  CONST_NULL 25
  DERIVED_CAST 22 23 4 0
  CONST_NULL 24
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 5
  RETURN_STMT true
  IF_END
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
