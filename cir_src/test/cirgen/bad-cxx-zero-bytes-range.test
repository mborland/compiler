; ZERO_BYTES zeroes a range inside the object its glvalue designates, or a
; whole number of elements from the first one (new T[n]()); 6 bytes through an
; int is neither.
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s

; CHECK: error [1001]: ZERO_BYTES of 6 bytes through a glvalue of a 4-byte type: neither inside it nor a whole number of elements

frame DECLS
  STR 102 "f"
  TY_FUNC 204 11 0 []
  DECL_FUNC 300 204 0 1 102
frame REGION
  FUNC_BEGIN 300 0
  LOCAL 1 1 nil 4 0
  LREF 1
  ZERO_BYTES 6
  FUNC_END 1
frame END
  END auto 0
