ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): a virtual base that is polymorphic itself (V : B),
; reached through two levels (A : virtual V, C : A, E : C, D with D : virtual V),
; overriding g() at several levels: construction vtables of a base inside a
; base (_ZTC1E0_1C, _ZTC1E0_1A, _ZTC1E16_1D), virtual thunks of a function
; (_ZTv0_n24_N1C1gEv) and of the destructors (n32), and a VTT per class.
;   struct B { virtual int g(); virtual ~B(); };  struct V : B { int v; int g(); };
;   struct A : virtual V { int a; };  struct C : A { int c; int g(); };
;   struct D : virtual V { int d; };  struct E : C, D { int e; int g(); };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1EC2Ev(%arg0: !cir.ptr<!rec_E>, %arg1: !cir.ptr<!cir.ptr<!void>>)
; CHECK: cir.call @_ZN1CC2Ev({{.*}}) nothrow : (!cir.ptr<!rec_C>, !cir.ptr<!cir.ptr<!void>>) -> ()
; CHECK: cir.call @_ZN1DC2Ev({{.*}}) nothrow : (!cir.ptr<!rec_D>, !cir.ptr<!cir.ptr<!void>>) -> ()
; CHECK-DAG: cir.global {{.*}}@_ZTT1E =
; CHECK-DAG: cir.global {{.*}}@_ZTC1E0_1C = #cir.vtable<
; CHECK-DAG: cir.global {{.*}}@_ZTC1E0_1A = #cir.vtable<
; CHECK-DAG: cir.global {{.*}}@_ZTC1E16_1D = #cir.vtable<
; CHECK-DAG: cir.func {{.*}}@_ZTv0_n24_N1C1gEv
; CHECK-DAG: cir.func {{.*}}@_ZTv0_n32_N1CD1Ev

