; C++ (ECIL 1.2, slice S1): multiple inheritance, this-adjusting thunks, a pure
; virtual function and a class typeinfo with two bases (__vmi_class_type_info).
; C has A as its primary base (shared vptr at 0) and P at 16; C::g overrides
; P::g, so the vtable group of C has a secondary vtable whose entry is the thunk
; _ZThn16_N1C1gEi (this - 16, then C::g), emitted with C::g's definition.  A is
; abstract: its vtable holds __cxa_pure_virtual.  The program calls through
; both bases and checks the values (C::g reads a member of C through the
; adjusted this).
;   struct P { virtual int g(int); int p; P(); };
;   struct A { virtual int f(int); virtual int pv() = 0; int a; A(); };
;   struct C : A, P { int c; C(); int f(int) override; int pv() override;
;                     int g(int) override; };
;   int callg(P *p) { return p->g(5); }  int callf(A *a) { return a->f(1); }
;   int callpv(A *a) { return a->pv(); }
;   int main() { C c; return (callg(&c) - 12) + (callf(&c) - 10) +
;                           (callpv(&c) - 100); }
; RUN: cat %S/Inputs/header12_cxx_rtti.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS
; RUN: %ecil-dump --vtable-layouts %t.ecil | %FileCheck %s --check-prefix=LAYOUT

; CHECK-LABEL: cir.func {{.*}}@_ZN1CC2Ev
; CHECK: cir.vtable.address_point(@_ZTV1C, address_point = <index = 0, offset = 2>) : !cir.vptr
; CHECK: cir.base_class_addr nonnull {{.*}} [16] : !cir.ptr<!rec_C> -> !cir.ptr<!rec_P>
; CHECK: cir.vtable.address_point(@_ZTV1C, address_point = <index = 1, offset = 2>) : !cir.vptr
; CHECK-LABEL: cir.global {{.*}}@_ZTV1A = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1A> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1A1fEi> : !cir.ptr<!u8i>, #cir.global_view<@__cxa_pure_virtual> : !cir.ptr<!u8i>]>
; CHECK: cir.global {{.*}}@_ZTI1C = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv121__vmi_class_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTS1C> : !cir.ptr<!u8i>, #cir.int<0> : !u32i, #cir.int<2> : !u32i, #cir.global_view<@_ZTI1A> : !cir.ptr<!u8i>, #cir.int<2> : !s64i, #cir.global_view<@_ZTI1P> : !cir.ptr<!u8i>, #cir.int<4098> : !s64i}>
; CHECK: cir.global {{.*}}@_ZTV1C = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1C> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1C1fEi> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1C2pvEv> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1C1gEi> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 5>, #cir.const_array<[#cir.ptr<-16 : i64> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1C> : !cir.ptr<!u8i>, #cir.global_view<@_ZThn16_N1C1gEi> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 3>}>

; CHECK-LABEL: cir.func {{.*}}@_ZThn16_N1C1gEi
; CHECK: cir.const #cir.int<-16> : !s64i
; CHECK: cir.ptr_stride
; CHECK: cir.call @_ZN1C1gEi

; SYMS-DAG: T _ZThn16_N1C1gEi
; SYMS-DAG: U __cxa_pure_virtual
; SYMS-DAG: D _ZTI1C
; SYMS-DAG: U _ZTVN10__cxxabiv121__vmi_class_type_infoE

; LAYOUT: Vtable for 'C' (8 entries).
; LAYOUT-NEXT: 0 | offset_to_top (0)
; LAYOUT-NEXT: 1 | C RTTI
; LAYOUT-NEXT: -- (A, 0) vtable address --
; LAYOUT-NEXT: -- (C, 0) vtable address --
; LAYOUT-NEXT: 2 | int C::f(int)
; LAYOUT-NEXT: 3 | int C::pv()
; LAYOUT-NEXT: 4 | int C::g(int)
; LAYOUT-NEXT: 5 | offset_to_top (-16)
; LAYOUT-NEXT: 6 | C RTTI
; LAYOUT-NEXT: -- (P, 16) vtable address --
; LAYOUT-NEXT: 7 | int C::g(int)
; LAYOUT-NEXT: [this adjustment: -16 non-virtual]

