# Fail if libedg_cir.so defines any dynamic symbol not named edg_cir_*.
execute_process(COMMAND nm -D --defined-only "${LIB}" OUTPUT_VARIABLE out
  RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nm failed")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(bad "")
set(good "")
foreach(l ${lines})
  if(l STREQUAL "")
    continue()
  endif()
  if(l MATCHES "^[0-9a-fA-F]+ A ")
    continue()
  endif()
  string(REGEX REPLACE "^[0-9a-fA-F]+ [A-Za-z] " "" sym "${l}")
  if(sym MATCHES "^edg_cir_")
    list(APPEND good "${sym}")
  else()
    list(APPEND bad "${sym}")
  endif()
endforeach()
list(LENGTH good ngood)
message(STATUS "exported: ${good}")
if(NOT ngood EQUAL 8)
  message(FATAL_ERROR "expected 8 edg_cir_* exports, got ${ngood}")
endif()
if(bad)
  message(FATAL_ERROR "unexpected exported symbols: ${bad}")
endif()
