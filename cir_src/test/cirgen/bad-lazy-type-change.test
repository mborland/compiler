; The stream's own checks treat a deferred body as arrived: the type of a
; function may not change after its body (lazy emission defers the body of this
; linkonce_odr function; eager emission emits it).  The same diagnostic in
; both modes.
; RUN: cat %S/Inputs/header11_supp.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: %not %edg-cir --eager-bodies --emit=cir %t.ecil 2>&1 | %FileCheck %s

; CHECK: the type of function 'f' changed after its body was emitted

frame DECLS
  STR 100 "f"
  TY_FUNC 21 1 0 []
  TY_FUNC 22 1 0 [1]
  DECL_FUNC 40 21 3 65 100
frame REGION
  FUNC_BEGIN 40 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
frame GLOBALS
  DECL_FUNC 40 22 3 65 100
frame END
  END auto 0
