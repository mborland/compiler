; C++ (ECIL 1.2): C_METHOD with a this-adjustment inside records, a nested array
; and a union of a VAR_INIT (gap G2, K6b): the whole variable is emitted in the
; lowered form, the pointers to member functions as { i64, i64 }, in a
; "<name>.lowered" record or array of the same layout; the members that hold
; an adjustment-free pointer or none are lowered or copied along, and uses of
; the variable cast back to its declared type.  The host compares the values
; with g++'s.
;   struct B1 { int x; int f(int); };  struct B2 { int y; int g(int); };
;   struct D : B1, B2 { int d; };  typedef int (D::*DM)(int);
;   struct H { int k; DM pm; int tail; };  struct G { H a[2]; };
;   union W { DM pm; long x; };
;   H gh = {1, &B2::g, 3};
;   G gg = {{ {7, &B1::f, 8}, {9, &B2::g} }};
;   H garr[2] = { {4, &B2::g, 5}, {5, &B1::f, 6} };
;   W gu = { &B2::g };
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -std=c++17 -w %S/Inputs/s4_mp_lowered_agg_host.cpp %t.o -o %t.exe
; RUN: %t.exe
; RUN: %edg-cir --emit=obj -O2 -o %t2.o %t.ecil
; RUN: g++ -std=c++17 -w %S/Inputs/s4_mp_lowered_agg_host.cpp %t2.o -o %t2.exe
; RUN: %t2.exe

; CHECK-DAG: cir.global external {{.*}}@gh = #cir.const_record<{#cir.int<1> : !s32i, #cir.const_record<{#cir.global_view<@_ZN2B21gEi> : !s64i, #cir.int<4> : !s64i}>
; CHECK-DAG: !rec_H2Elowered = !cir.struct<"H.lowered"
; CHECK-DAG: !rec_W2Elowered = !cir.union<"W.lowered"

