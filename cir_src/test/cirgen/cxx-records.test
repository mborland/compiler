; C++ records (ECIL v1, slice S1): direct bases, an empty base that has no
; storage, [[no_unique_address]] members, base-subobject (".base") records
; sized to the data size, FIELD yielding the complete type, STORE(DSIZE) and
; ZERO_BYTES leaving the tail padding that other members reuse alone.  The
; program checks the offsets the front end gave against what CIR computes.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; B and D are classes (the base-subobject record of a class is a plain struct).
; B is {int a; char b;} with a constructor: size 8, data size 5, so a derived
; class or a [[no_unique_address]] member may use its tail padding.
; CHECK-DAG: !rec_B2Ebase = !cir.struct<"B.base" packed {data !s32i, data !s8i}>
; CHECK-DAG: !rec_B = !cir.struct<class "B" packed {data !s32i, data !s8i, pad !cir.array<!u8i x 3>}>
; D : B { char c; }
; CHECK-DAG: !rec_D = !cir.struct<class "D" {data !rec_B2Ebase, data !s8i, pad !cir.array<!u8i x 2>}>
; G : E, B { short s; }: the empty base has no member
; CHECK-DAG: !rec_G = !cir.struct<"G" {data !rec_B2Ebase, data !s16i}>
; X { [[no_unique_address]] B b; char c; }
; CHECK-DAG: !rec_X = !cir.struct<"X" {data !rec_B2Ebase, data !s8i, pad !cir.array<!u8i x 2>}>
; Y { [[no_unique_address]] E e; int i; }: the empty member has no storage
; CHECK-DAG: !rec_Y = !cir.struct<"Y" {data !s32i}>
; CHECK-DAG: !rec_E = !cir.struct<"E" {pad !u8i}>
; CHECK-DAG: cir.libc.memcpy {{.*}} bytes
; CHECK-DAG: cir.libc.memset
; CHECK-DAG: B = #cir.record_layout<arg_passing_kind = can_pass_in_regs, has_trivial_dtor = true, record_align = 4>
; R has a destructor (NONTRIVIAL_ABI | NONTRIVIAL_DTOR)
; CHECK-DAG: R = #cir.record_layout<arg_passing_kind = cannot_pass_in_regs, has_trivial_dtor = false, record_align = 4>

