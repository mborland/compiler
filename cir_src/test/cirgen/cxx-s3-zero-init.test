ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S3, 12.7): zero- and value-initialization of types that
; contain pointers to data members, whose null is -1: globals with and without
; initializer, S s{}, S s = {}, S(), arrays, bases, nested aggregates, new S(),
; new S[3](), placement new, return values, static locals, member initializer
; lists, assignment from a value-initialized temporary.  The stream is the
; writer's output for Inputs/s3_zero_cir.cpp (spike K6c without the run-time
; new[]).  Every case copies the bytes of its object to a buffer that the host
; prints: the result of the mixed build must equal the all-g++ build's.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s3_zero_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.mixed
; RUN: %t.mixed > %t.mixed.out
; RUN: g++ -std=c++17 -w -I%S/Inputs %S/Inputs/s3_zero_cir.cpp %S/Inputs/s3_zero_host.cpp -o %t.ref
; RUN: %t.ref > %t.ref.out
; RUN: diff %t.mixed.out %t.ref.out
; RUN: %edg-cir --emit=obj -O2 -o %t.o2.o %t.ecil
; RUN: g++ %t.host.o %t.o2.o -o %t.mixed2
; RUN: %t.mixed2 > %t.mixed2.out
; RUN: diff %t.mixed2.out %t.ref.out
frame HEADER
