ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): overriders in classes that share a virtual base, called
; through the virtual base (vcall offsets, virtual this-adjusting thunks
; _ZTv0_n24_N1A1fEv, _ZTv0_n32_N1B1gEv, _ZTv0_n24_N1C1fEv) and the construction
; vtables of C : A, B.  The program checks the dispatch on C, A and B objects
; through V*, A* and B*.
;   struct V { virtual int f(); virtual int g(); int v; virtual ~V(); };
;   struct A : virtual V { int f(); };  struct B : virtual V { int g(); };
;   struct C : A, B { int f(); int g(); };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK: cir.func {{.*}}@_ZTv0_n24_N1A1fEv
; CHECK: cir.vtable.get_vptr
; CHECK: cir.const #cir.int<-24> : !s64i
; CHECK: cir.ptr_stride
; CHECK: cir.cast bitcast {{.*}} : !cir.ptr<!u8i> -> !cir.ptr<!s64i>
; CHECK: cir.func {{.*}}@_ZTv0_n32_N1B1gEv
; CHECK: cir.func {{.*}}@_ZTv0_n24_N1C1fEv
; CHECK: cir.global {{.*}}@_ZTC1C0_1A = #cir.vtable<
; CHECK: cir.global {{.*}}@_ZTC1C16_1B = #cir.vtable<

