ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2): PR 9629.  The base initializer B(this) converts `this` to the
;   virtual base A, reading its offset from the vptr, which nothing has set yet in C2.
;   struct C : virtual A, B { C(); };  C::C() : B(this) {}  struct D : virtual C {};
; Clang stores VTT[0] into the vptr at the entry of C2 and again at VPTR_INIT; so
; does the library, when a base initializer needs the vbase offset.  The stream is
; the ECIL writer's output.  The host's own derived classes (g++, clang) construct
; through our C2 too.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: objcopy --redefine-sym main=cir_main %t.o %t.m.o
; RUN: g++ -std=c++17 -w %S/Inputs/s4_ctor2_host.cpp %t.m.o -o %t.gxx.exe
; RUN: %t.gxx.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s4_ctor2_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.m.o -o %t.clang.exe
; RUN: %t.clang.exe
; RUN: %edg-cir --emit=obj -O2 -o %t2.o %t.ecil
; RUN: g++ %t2.o -o %t2.exe
; RUN: %t2.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1CC2Ev
; CHECK: cir.vtt.address_point
; CHECK: cir.vtable.get_vptr
; CHECK: cir.store
; CHECK: cir.vtable.get_vptr
; CHECK: cir.call @_ZN1BC2EP1A

