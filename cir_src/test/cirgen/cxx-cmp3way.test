  CONST_INT 8 1
  CMP3WAY 4 -1 0 1 nil
  CONST_INT 4 1
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 6
  RETURN_STMT true
  IF_END
  CONST_FLOAT 10 f64:0x3ff0000000000000
  CONST_FLOAT 10 f64:0x4000000000000000
