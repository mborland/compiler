; C++ (ECIL v1, slice S1): constant initializers of classes.  A base or
; [[no_unique_address]] member is stored as its ".base" record, so its
; constant (the complete class's) is converted to the ".base" member list; an
; empty base has no member and its C_SEL is simply not there.  The program
; reads the values back.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: cir.global external dso_local @g_d = #cir.const_record<{#cir.const_record<{#cir.int<1> : !s32i, #cir.int<2> : !s8i}> : !rec_B2Ebase, #cir.int<3> : !s8i, #cir.zero : !cir.array<!u8i x 2>}> : !rec_D
; CHECK-DAG: cir.global external dso_local @g_x = #cir.const_record<{#cir.const_record<{#cir.int<4> : !s32i, #cir.int<5> : !s8i}> : !rec_B2Ebase, #cir.int<6> : !s8i, #cir.zero : !cir.array<!u8i x 2>}> : !rec_X
; CHECK-DAG: cir.global external dso_local @g_g = #cir.const_record<{#cir.const_record<{#cir.int<7> : !s32i, #cir.int<8> : !s8i}> : !rec_B2Ebase, #cir.int<9> : !s16i}> : !rec_G

