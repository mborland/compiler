#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Compare the LLVM IR attributes of the CIR back end with clang -fclangir.

For every translation unit and every optimization level, this tool makes the
LLVM IR of

  ours     cpfe-cir and `edg-cir -O<N> --emit=llvm` (the options of the test
           configurations: the front end gets --cir_opt_level=N too)
  clangir  `clang -fclangir -S -emit-llvm -Xclang -disable-llvm-passes -O<N>`

and compares, per symbol that both have:

  fn         function attributes (the attribute group; target strings such as
             "target-cpu" are ignored, see IGNORED_STRING_ATTRS)
  ret        return attributes (noundef, nonnull, noalias, align, ...)
  param<i>   parameter attributes
  call       the attributes of the call sites of each callee (the union per
             callee: function, return and argument attributes)
  md         the kinds of metadata on instructions (tbaa, prof, llvm.loop,
             ...; !dbg is ignored)

Symbols that only one side has are counted, not compared.  A difference is
`explained` if the known-differences file (--known) has a line for it:

  <category> | <level or *> | <detail> | <reason>

or, for the category `pair`, the name of a pair matcher (PAIR_MATCHERS): the
two differences of a pair of callees that only a pairing can tell apart,
within one function (`structor-variants`: we call the complete-object C1 or
D1 of a class where clangir calls its base variant C2 or D2, with the same
number of parameters; `builtin-mem-calls`: we call memcpy, memmove or memset
where clangir has the llvm.mem* intrinsic, explaining only the intrinsic's
fixed attributes and our argument noundef and nounwind).  The detail of an
ordinary entry is exactly what the report prints after the category
(`only-ours:noundef`, `only-clangir:nonnull`, ...), or a glob with `*` that
matches it (`only-ours:_ZSt7forward*`: every attribute of the calls of any
instantiation of std::forward that only ours has).  Exit status: 0 if every
difference is explained and at least one symbol was compared (a run that
compared nothing fails), 1 otherwise, 2 for a setup problem.  The report ends
with the number of translation units that clang -fclangir could not compile.

At -O1 and above the comparison is only meaningful if our IR is taken before
the LLVM passes, as clang's is: the tool passes `--no-llvm-passes`
(EDG_CIR_FLAG_NO_LLVM_PASSES) to edg-cir when `edg-cir --help` lists it.  A
library without it would compare our optimized IR with clang's unoptimized IR;
the report says so, and --require-no-llvm-passes makes that a setup problem
(exit status 2) for a gate.

The known-differences file (tests/.edgy/filters/cir-attr-known.txt is the one
of the gate) is checked when it is read (a bad one is a setup problem): every
entry has a comment line directly above it (what the difference is) and a
reason in its last field (why it is accepted: at least 8 characters, not
`none`, `todo`, `-` or `?`), and no entry is listed twice.  --json writes the
entries that explained something (`known_used`), so that a stale entry can be
found.

Only the high-value attributes are gated (HIGH_VALUE_RE): nounwind, noundef,
nonnull, dereferenceable, align, memory(...), mustprogress, noreturn, builtin,
nobuiltin, inlinehint and alwaysinline.  An unexplained difference in one of
them fails the run, unless it is only about a callee that one side does not
call (the call-set difference).  Everything else, the call-set differences,
norecurse, cold, uwtable, sret, the metadata and the rest, is the residue: it
is counted by category, printed, written with --residue and kept in the
--json, and does not affect the exit status.  Known entries explain
differences of any attribute.

Gate use (step attr-diff of edg-cir-gate-evidence), over the probe set
(`--filter` twice, the C and C++ smoke lists) and the pinned real-world units
(`--units pinned --system-headers --boost-include DIR`, with
--require-compared: a pinned unit that clang -fclangir or we cannot compile,
or that compares no symbol at a level, fails the run).

nounwind coverage (--nounwind-target): over the symbols that both sides have,
the share of definitions and of declarations with the function attribute
`nounwind` (and, for information, of the callees whose call sites carry it),
ours against clang -fclangir; the target of slice S2 is that ours is at least
clangir's share for definitions and for declarations.  The report always
prints the counts; with the option the exit status is 1 if a share is below.

Run it inside the cir-env image from the repository root:

  edg-exec --img cir-env -- python3 dev_tools/bin/edg-cir-attr-diff \\
      --filter @tests/.edgy/filters/cir-c-smoke.txt --levels 0,2
  ... --filter @tests/.edgy/filters/cir-cpp-smoke.txt --cxx
  ... path/to/file.cpp ...          # plain sources (C++ unless *.c)
  ... --units pinned --system-headers --boost-include .tmp/boost-inc
  ... --self-test
'''

import argparse
import fnmatch
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple

# String attributes of the function groups that depend on the target and the
# compiler's defaults, not on the program.
IGNORED_STRING_ATTRS = {
  'target-cpu', 'target-features', 'tune-cpu', 'min-legal-vector-width',
  'stack-protector-buffer-size', 'no-trapping-math', 'frame-pointer',
  'no-builtins'
}
# Attributes that the clang -O0 pipeline adds and that mean "no optimization
# was done", not a property of the code.
IGNORED_FUNCTION_ATTRS = {'noinline', 'optnone'}

PARAM_ATTR = re.compile(
  r'\b(noundef|nonnull|noalias|nocapture|readonly|writeonly|readnone|'
  r'returned|zeroext|signext|inreg|nofree|nest|'
  r'captures\([^)]*\)|initializes\([^)]*\)|range\([^)]*\)|'
  r'byval\([^)]*\)|sret\([^)]*\)|byref\([^)]*\)|elementtype\([^)]*\)|'
  r'align \d+|dereferenceable\(\d+\)|dereferenceable_or_null\(\d+\))')
GROUP_TOKEN = re.compile(r'"[^"]*"(?:="[^"]*")?|[A-Za-z_][\w-]*(?:\([^)]*\))?')


class Function:
  def __init__(self) -> None:
    self.defined = False
    self.attributes: Set[str] = set()
    self.ret: Set[str] = set()
    self.params: List[Set[str]] = []
    # callee -> the union of the attributes at its call sites
    self.calls: Dict[str, Set[str]] = {}
    self.metadata: Set[str] = set()


def parse_groups(text: str) -> Dict[str, Set[str]]:
  '''The attribute groups: "#0" -> {"uwtable", "nounwind", ...}.'''
  groups: Dict[str, Set[str]] = {}
  for match in re.finditer(r'(?m)^attributes (#\d+) = \{(.*)\}\s*$', text):
    tokens = set()
    for token in GROUP_TOKEN.findall(match.group(2)):
      key = token.split('=')[0].strip('"')
      if token.startswith('"') and key in IGNORED_STRING_ATTRS:
        continue
      if token in IGNORED_FUNCTION_ATTRS:
        continue
      tokens.add(token)
    groups[match.group(1)] = tokens
  return groups


def split_top_level(text: str) -> List[str]:
  '''Split at the commas that are not inside (), {}, [] or <>.'''
  parts: List[str] = []
  depth = 0
  current = ''
  for char in text:
    if char in '({[<':
      depth += 1
    elif char in ')}]>':
      depth -= 1
    if char == ',' and depth == 0:
      parts.append(current.strip())
      current = ''
    else:
      current += char
  if current.strip():
    parts.append(current.strip())
  return parts


def matching_paren(text: str, start: int) -> int:
  '''The index of the ")" that closes the "(" at `start`.'''
  depth = 0
  for index in range(start, len(text)):
    if text[index] == '(':
      depth += 1
    elif text[index] == ')':
      depth -= 1
      if depth == 0:
        return index
  return -1


def parse_header(line: str, groups: Dict[str, Set[str]]
                 ) -> Optional[Tuple[str, Function]]:
  '''(name, Function) of a `define` or `declare` line.'''
  match = re.match(r'^(define|declare)\b(.*?)@("[^"]+"|[^\s(]+)\(', line)
  if not match:
    return None
  function = Function()
  function.defined = match.group(1) == 'define'
  name = match.group(3).strip('"')
  function.ret = set(PARAM_ATTR.findall(match.group(2)))
  open_paren = match.end() - 1
  close = matching_paren(line, open_paren)
  if close < 0:
    return None
  for parameter in split_top_level(line[open_paren + 1:close]):
    function.params.append(set(PARAM_ATTR.findall(parameter)))
  rest = line[close + 1:]
  for group in re.findall(r'#\d+', rest):
    function.attributes |= groups.get(group, set())
  return name, function


def parse_ir(text: str) -> Dict[str, Function]:
  '''The functions of a module of LLVM IR text, by name.'''
  groups = parse_groups(text)
  functions: Dict[str, Function] = {}
  current: Optional[Function] = None
  for line in text.splitlines():
    header = parse_header(line, groups)
    if header:
      name, function = header
      # A definition replaces an earlier declaration of the same name.
      if name not in functions or function.defined:
        functions[name] = function
      current = function if function.defined else None
      continue
    if current is None:
      continue
    if line.startswith('}'):
      current = None
      continue
    call = re.search(r'\b(?:call|invoke)\b(.*?)@("[^"]+"|[^\s(]+)\(', line)
    if call:
      open_paren = call.end() - 1
      close = matching_paren(line, open_paren)
      if close > 0:
        attributes = set(f"ret:{a}" for a in PARAM_ATTR.findall(call.group(1)))
        for index, argument in enumerate(
            split_top_level(line[open_paren + 1:close])):
          attributes |= set(f"arg{index}:{a}"
                            for a in PARAM_ATTR.findall(argument))
        for group in re.findall(r'#\d+', line[close + 1:]):
          attributes |= set(f"fn:{a}" for a in groups.get(group, set()))
        current.calls.setdefault(call.group(2).strip('"'),
                                 set()).update(attributes)
    for kind in re.findall(r', !([A-Za-z_][\w.]*) !', line):
      if kind != 'dbg':
        current.metadata.add(kind)
  return functions


def compare(ours: Dict[str, Function], theirs: Dict[str, Function]
            ) -> Tuple[int, int, int, List[Tuple[str, str, str]]]:
  '''(compared, only ours, only theirs, differences): a difference is
  (symbol, category, detail).'''
  differences: List[Tuple[str, str, str]] = []
  common = sorted(set(ours) & set(theirs))

  def sets(symbol: str, category: str, mine: Set[str], other: Set[str]):
    for item in sorted(mine - other):
      differences.append((symbol, category, f"only-ours:{item}"))
    for item in sorted(other - mine):
      differences.append((symbol, category, f"only-clangir:{item}"))

  for symbol in common:
    a, b = ours[symbol], theirs[symbol]
    sets(symbol, 'fn', a.attributes, b.attributes)
    sets(symbol, 'ret', a.ret, b.ret)
    for index in range(max(len(a.params), len(b.params))):
      mine = a.params[index] if index < len(a.params) else set()
      other = b.params[index] if index < len(b.params) else set()
      sets(symbol, f"param{index}", mine, other)
    for callee in sorted(set(a.calls) | set(b.calls)):
      sets(symbol, 'call', {f"{callee}:{x}" for x in a.calls.get(callee, ())},
           {f"{callee}:{x}" for x in b.calls.get(callee, ())})
    sets(symbol, 'md', a.metadata, b.metadata)
  return (len(common), len(set(ours) - set(theirs)),
          len(set(theirs) - set(ours)), differences)


BAD_REASONS = {'', 'none', 'todo', '-', '?', 'tbd'}


def validate_known(path: str) -> Tuple[List[Tuple[str, str, str, str]],
                                       List[str]]:
  '''(the entries, the problems) of a known-differences file: an entry is
  `<category> | <level or *> | <detail> | <reason>`, with a comment line
  directly above it, a reason of at least 8 characters that is not a
  placeholder, and no duplicate.'''
  entries: List[Tuple[str, str, str, str]] = []
  problems: List[str] = []
  previous = ''
  seen: Set[Tuple[str, str, str]] = set()
  for number, raw in enumerate(Path(path).read_text().splitlines(), 1):
    line = raw.strip()
    if line and not line.startswith('#'):
      parts = [p.strip() for p in line.split('|', 3)]
      where = f"{path}:{number}"
      if len(parts) != 4:
        problems.append(f"{where}: not `category | level | detail | reason`")
      else:
        if parts[3].lower() in BAD_REASONS or len(parts[3]) < 8:
          problems.append(f"{where}: no real reason ({parts[3]!r})")
        if not previous.startswith('#'):
          problems.append(f"{where}: no comment line directly above the "
                          f"entry")
        if parts[0] == 'pair' and parts[2] not in PAIR_MATCHERS:
          problems.append(f"{where}: no pair matcher {parts[2]!r} (the "
                          f"matchers are {', '.join(PAIR_MATCHERS)})")
        key = (parts[0], parts[1], parts[2])
        if key in seen:
          problems.append(f"{where}: listed twice ({' | '.join(key)})")
        seen.add(key)
        entries.append((parts[0], parts[1], parts[2], parts[3]))
    previous = line
  return entries, problems


def read_known(path: str) -> List[Tuple[str, str, str, str]]:
  return validate_known(path)[0] if path else []


def explained(known: List[Tuple[str, str, str, str]], level: int,
              category: str, detail: str) -> bool:
  for known_category, known_level, known_detail, _ in known:
    if known_category == category and known_level in ('*', str(level)) and \
        known_detail == detail:
      return True
  return False


def known_entry(known: List[Tuple[str, str, str, str]], level: int,
                category: str, detail: str
                ) -> Optional[Tuple[str, str, str, str]]:
  '''The entry of the known-differences list that explains a difference.'''
  for entry in known:
    if entry[0] == category and entry[1] in ('*', str(level)) and \
        (fnmatch.fnmatchcase(detail, entry[2]) if '*' in entry[2]
         else entry[2] == detail):
      return entry
  return None


def nounwind_counts(ours: Dict[str, Function], theirs: Dict[str, Function]
                    ) -> Dict[str, List[int]]:
  '''Over the symbols that both have: kind -> [total, ours with nounwind,
  clangir with nounwind], kinds `define`, `declare` (the function attribute)
  and `call` (callees whose call sites carry nounwind, per caller).'''
  counts = {'define': [0, 0, 0], 'declare': [0, 0, 0], 'call': [0, 0, 0]}
  for symbol in set(ours) & set(theirs):
    a, b = ours[symbol], theirs[symbol]
    kind = 'define' if a.defined and b.defined else \
      'declare' if not a.defined and not b.defined else ''
    if kind:
      counts[kind][0] += 1
      counts[kind][1] += 'nounwind' in a.attributes
      counts[kind][2] += 'nounwind' in b.attributes
    if a.defined and b.defined:
      for callee in set(a.calls) | set(b.calls):
        counts['call'][0] += 1
        counts['call'][1] += 'fn:nounwind' in a.calls.get(callee, ())
        counts['call'][2] += 'fn:nounwind' in b.calls.get(callee, ())
  return counts


PAIR_MATCHERS = ('structor-variants', 'builtin-mem-calls')
MEM_NAMES = ('memcpy', 'memmove', 'memset')
STRUCTOR_RE = re.compile(r'(C1E|D1E)')
# The attributes of the llvm.mem* intrinsics that only clangir's calls and
# declarations have (the intrinsic's fixed attributes), and the ones that only
# our call of the library function has.  Any other attribute of the two
# callees (align, dereferenceable, nonnull, noalias or memory on our call, ...)
# is a real difference and stays.
MEM_ONLY_CLANGIR = re.compile(
  r'^(?:fn:(?:nocallback|nofree|nosync|nounwind|willreturn)|'
  r'fn:memory\(argmem:.*\)|'
  r'arg\d+:(?:noalias|nocapture|captures\(none\)|writeonly|readonly|immarg|'
  r'align \d+))$')
MEM_ONLY_OURS = re.compile(r'^(?:arg\d+:noundef|fn:nounwind)$')


def split_call_detail(detail: str) -> Optional[Tuple[str, str, str]]:
  '''(only-ours or only-clangir, callee, attribute) of the detail of a
  `call` difference.'''
  match = re.match(r'^(only-ours|only-clangir):(.+?):((?:fn|ret|arg\d+):.*)$',
                   detail)
  return (match.group(1), match.group(2), match.group(3)) if match else None


def structor_partner(callee: str) -> List[str]:
  '''The names that `callee` has with one complete-object structor (C1E or
  D1E) of its mangling turned into the base variant (C2E or D2E): the form
  clangir calls where we call the complete-object one.  One occurrence is
  changed at a time, so only the same class and the same parameters pair.'''
  names = []
  for match in STRUCTOR_RE.finditer(callee):
    names.append(callee[:match.start() + 1] + '2' + callee[match.end() - 1:])
  return names


def explain_pairs(diffs: List[Tuple[str, str, str]], enabled: Set[str],
                  ours: Optional[Dict[str, Function]] = None,
                  theirs: Optional[Dict[str, Function]] = None
                  ) -> Dict[int, str]:
  '''The differences of one function (indexes into `diffs`, each (symbol,
  category, detail) of compare()) that the named pair matchers explain:
  index -> matcher.  `ours` and `theirs` are the parsed modules, for the
  declarations of the callees.

  structor-variants: ours calls the complete-object structor C1 or D1 of a
  class where clangir calls its base variant C2 or D2: the attributes that
  both calls have are explained, one pair of callees at a time; an attribute
  that only one of the two has stays.  The two callees must have the same
  number of parameters on their declare or define lines, so a C2 or D2 that
  takes a VTT (a class with virtual bases) never pairs.  Without the modules
  nothing pairs.

  builtin-mem-calls: ours calls memcpy, memmove or memset (the library
  functions that __builtin_memcpy and the like are sent as) where clangir has
  the llvm.memcpy, llvm.memmove or llvm.memset intrinsic (llvm.memcpy.inline
  is matched on purpose): only the fixed attributes of the intrinsic that
  only clangir has (MEM_ONLY_CLANGIR) and the argument noundef and nounwind
  that only ours has (MEM_ONLY_OURS) are explained; any other attribute, such
  as an align, dereferenceable, nonnull, noalias or memory of ours, stays.'''
  calls: Dict[Tuple[str, str], Dict[str, int]] = {}
  for index, (_, category, detail) in enumerate(diffs):
    parts = split_call_detail(detail) if category == 'call' else None
    if parts:
      calls.setdefault((parts[0], parts[1]), {})[parts[2]] = index
  explained: Dict[int, str] = {}
  if 'structor-variants' in enabled and ours is not None and \
      theirs is not None:
    for (side, callee), attributes in list(calls.items()):
      if side != 'only-ours' or callee not in ours:
        continue
      for partner in structor_partner(callee):
        other = calls.get(('only-clangir', partner))
        if not other or partner not in theirs or \
            len(ours[callee].params) != len(theirs[partner].params):
          continue
        for attribute in set(attributes) & set(other):
          explained[attributes[attribute]] = 'structor-variants'
          explained[other[attribute]] = 'structor-variants'
  if 'builtin-mem-calls' in enabled:
    for (side, callee), attributes in list(calls.items()):
      if side != 'only-ours' or callee not in MEM_NAMES:
        continue
      for (other_side, other_callee), other in calls.items():
        if other_side == 'only-clangir' and \
            other_callee.startswith(f"llvm.{callee}."):
          for attribute, index in attributes.items():
            if MEM_ONLY_OURS.match(attribute):
              explained[index] = 'builtin-mem-calls'
          for attribute, index in other.items():
            if MEM_ONLY_CLANGIR.match(attribute):
              explained[index] = 'builtin-mem-calls'
  return explained


# The attributes that the step gates (m5_design.md section 9): an unexplained
# difference in one of them fails the run.  Every other difference (the set of
# callees that only one side calls, norecurse, cold, uwtable, sret, metadata,
# ...) is the residue: it is counted by category and reported, not gated.
HIGH_VALUE_RE = re.compile(
  r'^(?:nounwind|noundef|nonnull|dereferenceable(?:_or_null)?\(.*\)|align \d+|'
  r'memory\(.*\)|mustprogress|noreturn|builtin|nobuiltin|inlinehint|'
  r'alwaysinline)$')


def difference_attribute(category: str, detail: str) -> str:
  '''The attribute (or metadata kind) that a difference is about: for the
  detail `only-ours:noundef` it is `noundef`, for a call difference
  `only-ours:callee:arg0:noundef` it is `noundef`, for `md` the kind.'''
  if category == 'call':
    parts = split_call_detail(detail)
    if parts:
      return parts[2].split(':', 1)[1]
  elif category == 'md':
    return 'md:' + detail.split(':', 1)[-1]
  return detail.split(':', 1)[-1]


def classify_difference(category: str, detail: str, callset: bool
                        ) -> Tuple[bool, str]:
  '''(gated, residue key) of a difference: gated if it is about a
  high-value attribute and not the presence of a callee on one side only
  (`callset`, which is residue whatever its attribute).  The key names the
  residue: `callset`, `md:tbaa`, `fn norecurse`, `param sret`, ...'''
  attribute = difference_attribute(category, detail)
  if callset:
    return False, 'callset'
  if category != 'md' and HIGH_VALUE_RE.match(attribute):
    return True, ''
  kind = 'param' if category.startswith('param') else category
  name = re.match(r'[\w:.-]*', attribute).group(0) or attribute
  return False, f"{kind} {name}" if kind != 'md' else name


def load_tool(name: str):
  path = str(Path(__file__).resolve().with_name(name))
  loader = importlib.machinery.SourceFileLoader(name.replace('-', '_'), path)
  spec = importlib.util.spec_from_loader(loader.name, loader)
  module = importlib.util.module_from_spec(spec)
  loader.exec_module(module)
  return module


STANDARD_C = ['--gnu_version=999999', '-e', '200', '--no_wrap',
              '--no_wrap_diagnostics', '--gcc']
STANDARD_CXX = ['--gnu_version=999999', '-tused', '-e', '200', '--no_wrap',
                '--no_wrap_diagnostics']


def clang_flags(options: List[str]) -> List[str]:
  '''The clang options for the EDG options of a case.'''
  flags: List[str] = []
  for token in options:
    match = re.match(r'--c\+\+(\w+)$', token)
    if match:
      flags.append(f"-std=c++{match.group(1)}")
    elif token.startswith(('-D', '-U', '-I')):
      flags.append(token)
  return flags


def find_cases(root: Path, spec: str, cxx: bool
               ) -> List[Tuple[str, Path, List[str]]]:
  '''(name, source, eccp options) of the cases of an edgy filter list.'''
  import edgtest.runtest as runtest
  tests_dir = root / 'tests' / 'tests'
  positive: List[str] = []
  for line in (Path(spec[1:]).read_text().splitlines() if spec.startswith('@')
               else spec.split(',')):
    line = line.strip()
    if line and not line.startswith(('#', '!')):
      positive.append(line)
  cases = []
  for prefix in positive:
    base = tests_dir / prefix
    found = [base] if base.is_file() else sorted(base.rglob('*.sft.*'))
    for test in found:
      if test.is_dir() or test.name.startswith('.'):
        continue
      description = runtest.load_description(
        test, top_dir = tests_dir / test.relative_to(tests_dir).parts[0])
      if description.source_files:
        continue
      for number, (mode, base_options, case_options) in enumerate(
          description.traverse_cases(), 1):
        is_c = test.suffix == '.c'
        options = [f"-DTEST_NUMBER={number}",
                   *(STANDARD_C if is_c else STANDARD_CXX), *base_options,
                   *case_options]
        cases.append((f"{test.relative_to(tests_dir)}#{number}", test,
                      options))
        break
  return cases


class Runner:
  def __init__(self, root: Path, fe_build: str, timeout: int,
               system_headers: bool = False) -> None:
    self.diff = load_tool('edg-cir-run-diff')
    self.base = self.diff.Toolchain(root, fe_build, 'g++')
    self.timeout = timeout
    self.env = dict(self.base.env)
    if not system_headers:
      # (the tests bring their own headers; the real-world units need the
      # system ones, as edg-cir-perf gives them)
      self.env.pop('EDG_USE_SYSTEM_HEADERS', None)
    prefix = self.env.get('EDG_LLVM_CIR_PREFIX', '')
    self.clang = str(Path(prefix) / 'bin' / 'clang') if prefix else 'clang'
    help_text = subprocess.run(
      [self.base.edg_cir, '--help'], stdout = subprocess.PIPE,
      stderr = subprocess.STDOUT, text = True).stdout
    self.no_llvm_passes = '--no-llvm-passes' in help_text

  def ours(self, source: Path, work: Path, options: List[str], level: int,
           is_c: bool) -> Tuple[str, str, Optional[Path]]:
    '''("ok", "", ll) or (state, text, None).'''
    state, text, stream = self.base.make_stream(
      source, work, options, level, c_mode = is_c)
    if state != 'ok':
      return state, text, None
    out = work / 'ours.ll'
    flags = ['--no-llvm-passes'] if level and self.no_llvm_passes else []
    code, output = self.diff.run(
      [self.base.edg_cir, f"-O{level}", *flags, '--emit=llvm', '-o',
       str(out), str(stream)], work, self.env, self.timeout)
    if code != 0 or not out.exists():
      return 'fail', 'edg-cir: ' + output[-300:], None
    return 'ok', '', out

  def clangir(self, source: Path, work: Path, options: List[str], level: int,
              is_c: bool) -> Tuple[str, str, Optional[Path]]:
    out = work / 'clangir.ll'
    compiler = self.clang if is_c else self.clang + '++'
    if not Path(compiler).exists():
      compiler = self.clang
    command = [compiler, '-fclangir', '-S', '-emit-llvm', '-Xclang',
               '-disable-llvm-passes', f"-O{level}", '-w',
               *([] if is_c else ['-x', 'c++']), *clang_flags(options),
               str(source), '-o', str(out)]
    code, output = self.diff.run(command, work, self.env, self.timeout)
    if code != 0 or not out.exists():
      return 'fail', output[-300:], None
    return 'ok', '', out


# (case, level) -> nounwind_counts of the last run_one (read by main)
NOUNWIND: Dict[Tuple[str, int], Dict[str, List[int]]] = {}
# (case, level) -> (our functions, clangir's functions), for the pair matchers
MODULES: Dict[Tuple[str, int], Tuple[Dict[str, Function],
                                     Dict[str, Function]]] = {}


def unit_cases(root: Path, units: str, boost: str
               ) -> List[Tuple[str, Path, List[str]]]:
  '''(name, source, options) of the real-world units (`pinned` or names).'''
  perf = load_tool('edg-cir-perf')
  names = [n for item in units.split(',') if item
           for n in (perf.PINNED_UNITS if item == 'pinned' else (item,))]
  cases = []
  for name in names:
    include = [f"-I{boost}"] if boost and name.startswith('boost/') else []
    cases.append((name, root / 'dev_tools/cir-realworld' / f"{name}.cpp",
                  ['--gnu_version=140000', *perf.REALWORLD_FLAGS, *include]))
  return cases


def run_one(runner: Runner, name: str, source: Path, options: List[str],
            levels: List[int]
            ) -> Tuple[bool, Dict[int, Tuple[int, int, int,
                                             List[Tuple[str, str, str]]]],
                       str]:
  '''(clangir compiled it, per level the result of compare, note).'''
  results: Dict[int, Tuple[int, int, int, List[Tuple[str, str, str]]]] = {}
  is_c = source.suffix == '.c'
  note = ''
  with tempfile.TemporaryDirectory(prefix = 'edg-cir-attr.') as tmp:
    for level in levels:
      work = Path(tmp) / f"o{level}"
      work.mkdir()
      for extra in source.parent.glob('*.h'):
        shutil.copy2(extra, work / extra.name)
      state, text, theirs = runner.clangir(source, work, options, level, is_c)
      if theirs is None:
        return False, results, 'clang -fclangir: ' + ' '.join(text.split())[
          -120:]
      state, text, mine = runner.ours(source, work, options, level, is_c)
      if mine is None:
        note = f"ours {state}: " + ' '.join(text.split())[-120:]
        continue
      ours_ir = parse_ir(mine.read_text())
      theirs_ir = parse_ir(theirs.read_text())
      results[level] = compare(ours_ir, theirs_ir)
      NOUNWIND[(name, level)] = nounwind_counts(ours_ir, theirs_ir)
      MODULES[(name, level)] = (ours_ir, theirs_ir)
  return True, results, note


SAMPLE_OURS = """
@g = global i32 0
define dso_local i32 @f(ptr noundef nonnull align 4 %0, i32 %1) #0 {
  %3 = call i32 @h(ptr %0) #1, !tbaa !1
  ret i32 %3, !dbg !5
}
declare i32 @h(ptr)
attributes #0 = { mustprogress uwtable "target-cpu"="x86-64" noinline optnone }
attributes #1 = { nounwind }
"""

SAMPLE_CLANGIR = """
define dso_local noundef i32 @f(ptr noundef nonnull align 4 dereferenceable(4) %0, i32 noundef %1) #0 {
  %3 = call i32 @h(ptr noundef nonnull %0) #1
  ret i32 %3
}
declare i32 @h(ptr noundef)
attributes #0 = { mustprogress uwtable "target-cpu"="skylake" "frame-pointer"="all" }
attributes #1 = { nounwind }
"""


class SelfTest(unittest.TestCase):
  def test_parse_groups_ignores_target_strings(self) -> None:
    groups = parse_groups(SAMPLE_OURS)
    self.assertEqual(groups['#0'], {'mustprogress', 'uwtable'})

  def test_parse_header(self) -> None:
    functions = parse_ir(SAMPLE_CLANGIR)
    f = functions['f']
    self.assertTrue(f.defined)
    self.assertEqual(f.ret, {'noundef'})
    self.assertEqual(f.params, [{'noundef', 'nonnull', 'align 4',
                                 'dereferenceable(4)'}, {'noundef'}])
    self.assertEqual(f.attributes, {'mustprogress', 'uwtable'})
    self.assertEqual(f.calls['h'], {'arg0:noundef', 'arg0:nonnull',
                                    'fn:nounwind'})
    self.assertFalse(functions['h'].defined)

  def test_split_top_level(self) -> None:
    self.assertEqual(split_top_level('ptr %a, { i64, i64 } %b, i32 align 4 %c'),
                     ['ptr %a', '{ i64, i64 } %b', 'i32 align 4 %c'])

  def test_compare_lists_the_differences(self) -> None:
    compared, only_ours, only_theirs, diffs = compare(
      parse_ir(SAMPLE_OURS), parse_ir(SAMPLE_CLANGIR))
    self.assertEqual((compared, only_ours, only_theirs), (2, 0, 0))
    details = {(s, c, d) for s, c, d in diffs}
    self.assertIn(('f', 'ret', 'only-clangir:noundef'), details)
    self.assertIn(('f', 'param0', 'only-clangir:dereferenceable(4)'), details)
    self.assertIn(('f', 'param1', 'only-clangir:noundef'), details)
    self.assertIn(('f', 'md', 'only-ours:tbaa'), details)
    self.assertIn(('f', 'call', 'only-clangir:h:arg0:nonnull'), details)
    self.assertIn(('h', 'param0', 'only-clangir:noundef'), details)
    # Nothing is reported for the ignored target strings or optnone.
    self.assertFalse([d for d in details if 'target' in d[2] or
                      'optnone' in d[2] or 'noinline' in d[2]])

  def test_compare_of_disjoint_modules_compares_nothing(self) -> None:
    compared, only_ours, only_theirs, diffs = compare(
      parse_ir('define void @a() {\n}\n'), parse_ir('define void @b() {\n}\n'))
    self.assertEqual((compared, only_ours, only_theirs, diffs), (0, 1, 1, []))

  def test_known_differences(self) -> None:
    with tempfile.NamedTemporaryFile('w', suffix = '.txt') as handle:
      handle.write('# why\nret | 2 | only-clangir:noundef | later\n'
                   'md | * | only-ours:tbaa | none\n')
      handle.flush()
      known = read_known(handle.name)
    self.assertTrue(explained(known, 2, 'ret', 'only-clangir:noundef'))
    self.assertFalse(explained(known, 0, 'ret', 'only-clangir:noundef'))
    self.assertTrue(explained(known, 0, 'md', 'only-ours:tbaa'))
    self.assertFalse(explained(known, 0, 'md', 'only-ours:prof'))

  def test_clang_flags(self) -> None:
    self.assertEqual(clang_flags(['--c++17', '-DX=1', '-w', '-tused']),
                     ['-std=c++17', '-DX=1'])


def main() -> None:
  parser = argparse.ArgumentParser(
    description = __doc__.split('\n')[0],
    formatter_class = argparse.RawDescriptionHelpFormatter,
    epilog = __doc__.split('\n', 2)[2])
  parser.add_argument('sources', nargs = '*')
  parser.add_argument('--filter', action = 'append', default = [],
                      help = '"@file" or comma separated prefixes of tests, '
                             'as for edgy (single-file cases only); '
                             'repeatable')
  parser.add_argument('--units', default = '',
                      help = 'real-world units (dev_tools/cir-realworld; '
                             '`pinned` or names like libstdcxx/chrono)')
  parser.add_argument('--system-headers', action = 'store_true',
                      help = 'compile with the system headers (the '
                             'real-world units need them)')
  parser.add_argument('--boost-include', default = '',
                      help = 'the Boost headers for the Boost units')
  parser.add_argument('--levels', default = '0,2')
  parser.add_argument('--known', default = '',
                      help = 'file of explained differences')
  parser.add_argument('--json', default = '',
                      help = 'write the result here (counts, unexplained '
                             'differences, the known entries that were '
                             'used, per case results, nounwind coverage)')
  parser.add_argument('--residue', default = '',
                      help = 'write the differences that are not gated (the '
                             'residue) by category here')
  parser.add_argument('--require-compared', action = 'store_true',
                      help = 'every case must compare symbols at every '
                             'level (clang -fclangir and ours must compile '
                             'it): for the pinned units')
  parser.add_argument('--require-no-llvm-passes', action = 'store_true',
                      help = 'a setup problem if edg-cir lacks '
                             '--no-llvm-passes and a level above 0 is asked')
  parser.add_argument('--nounwind-target', action = 'store_true',
                      help = 'exit status 1 if our share of definitions or '
                             'of declarations with nounwind is below '
                             'clang -fclangir\'s')
  parser.add_argument('--root', default = '.')
  parser.add_argument('--fe-build', default = 'build/gcc-cir')
  parser.add_argument('--timeout', type = int, default = 120)
  parser.add_argument('--show', type = int, default = 30,
                      help = 'unexplained differences to list')
  parser.add_argument('--self-test', action = 'store_true')
  args = parser.parse_args()
  if args.self_test:
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(SelfTest)
    sys.exit(0 if unittest.TextTestRunner(verbosity = 1).run(
      suite).wasSuccessful() else 1)
  root = Path(args.root).resolve()
  levels = [int(x) for x in args.levels.split(',')]
  cases: List[Tuple[str, Path, List[str]]] = []
  for spec in args.filter:
    cases += find_cases(root, spec, False)
  if args.units:
    boost = str((root / args.boost_include).resolve()) \
      if args.boost_include else ''
    cases += unit_cases(root, args.units, boost)
  for item in args.sources:
    path = Path(item).resolve()
    is_c = path.suffix == '.c'
    cases.append((path.name, path,
                  ['--gnu_version=140000', *(['--gcc'] if is_c else
                                             ['--c++17'])]))
  if not cases:
    parser.error('no sources: give files, --filter or --units')
  missing = [name for name, source, _ in cases if not source.exists()]
  if missing:
    print(f"edg-cir-attr-diff: no such source: {', '.join(missing)}",
          file = sys.stderr)
    sys.exit(2)
  known: List[Tuple[str, str, str, str]] = []
  if args.known:
    known, known_problems = validate_known(args.known)
    if known_problems:
      print('edg-cir-attr-diff: the known-differences file is not valid:\n  '
            + '\n  '.join(known_problems), file = sys.stderr)
      sys.exit(2)
  runner = Runner(root, args.fe_build, args.timeout, args.system_headers)
  if not runner.base.ready():
    print(f"edg-cir-attr-diff: no CPFE_CIR and EDG_CIR_TOOL in "
          f"{args.fe_build}/environment.sh", file = sys.stderr)
    sys.exit(2)
  if args.require_no_llvm_passes and levels != [0] and \
     not runner.no_llvm_passes:
    print('edg-cir-attr-diff: edg-cir has no --no-llvm-passes (a library '
          'without EDG_CIR_FLAG_NO_LLVM_PASSES)', file = sys.stderr)
    sys.exit(2)
  total = {level: [0, 0, 0] for level in levels}
  unexplained: List[Tuple[int, str, str, str, str]] = []
  counts: Dict[Tuple[int, str], int] = {}
  used: Set[Tuple[str, str, str, str]] = set()
  explained_count = 0
  residue: Dict[Tuple[int, str], int] = {}
  residue_examples: Dict[Tuple[int, str], List[str]] = {}
  no_clangir: List[str] = []
  ours_failed = 0
  uncompared: List[str] = []
  per_case: Dict[str, Dict[str, object]] = {}
  nounwind = {level: {'define': [0, 0, 0], 'declare': [0, 0, 0],
                      'call': [0, 0, 0]} for level in levels}
  for name, source, options in cases:
    ok, results, note = run_one(runner, name, source, options, levels)
    per_case[name] = {'clangir': ok, 'note': note,
                      'compared': {str(l): r[0] for l, r in results.items()}}
    if not ok:
      no_clangir.append(f"{name}: {note}")
      uncompared.append(f"{name}: clang -fclangir cannot compile it")
      continue
    if note:
      ours_failed += 1
    for level in levels:
      if level not in results or results[level][0] == 0:
        uncompared.append(f"{name} -O{level}: no symbol compared"
                          f"{' (' + note + ')' if note else ''}")
    for level, (compared, only_ours, only_theirs, diffs) in results.items():
      total[level][0] += compared
      total[level][1] += only_ours
      total[level][2] += only_theirs
      for kind, values in NOUNWIND.get((name, level), {}).items():
        for index in range(3):
          nounwind[level][kind][index] += values[index]
      # the pair matchers work on the differences of one function
      by_symbol: Dict[str, List[int]] = {}
      for index, (symbol, _, _) in enumerate(diffs):
        by_symbol.setdefault(symbol, []).append(index)
      pair_entries = {e[2]: e for e in known
                      if e[0] == 'pair' and e[1] in ('*', str(level))}
      paired: Dict[int, str] = {}
      if pair_entries:
        for indexes in by_symbol.values():
          modules = MODULES.get((name, level), (None, None))
          for position, matcher in explain_pairs(
              [diffs[i] for i in indexes], set(pair_entries), *modules
              ).items():
            paired[indexes[position]] = matcher
      for index, (symbol, category, detail) in enumerate(diffs):
        entry = known_entry(known, level, category, detail) \
          if index not in paired else pair_entries[paired[index]]
        if entry:
          used.add(entry)
          explained_count += 1
        else:
          callset = False
          if category == 'call':
            parts = split_call_detail(detail)
            if parts and (name, level) in MODULES:
              mine, theirs = MODULES[(name, level)]
              callset = not (
                parts[1] in getattr(mine.get(symbol), 'calls', {}) and
                parts[1] in getattr(theirs.get(symbol), 'calls', {}))
          gated, key = classify_difference(category, detail, callset)
          if gated:
            unexplained.append((level, name, symbol, category, detail))
          else:
            residue[(level, key)] = residue.get((level, key), 0) + 1
            residue_examples.setdefault((level, key), []).append(
              f"{name} {symbol}: {category} {detail}")
        counts[(level, f"{category} {detail}")] = counts.get(
          (level, f"{category} {detail}"), 0) + 1
  print(f"{len(cases)} translation unit(s); clang -fclangir could not "
        f"compile {len(no_clangir)}; ours failed on {ours_failed}")
  if levels != [0] and not runner.no_llvm_passes:
    print('NOTE: edg-cir has no --no-llvm-passes: levels above 0 compare our '
          'optimized IR with clang -fclangir\'s unoptimized IR')
  for level in levels:
    compared, only_ours, only_theirs = total[level]
    print(f"-O{level}: {compared} symbol(s) compared, {only_ours} only ours, "
          f"{only_theirs} only clangir")
  for (level, kind), count in sorted(counts.items(),
                                     key = lambda item: -item[1])[:25]:
    print(f"  -O{level} {count:6d}  {kind}")
  for line in no_clangir[:5]:
    print(f"  clangir cannot compile: {line}")
  print(f"{explained_count} explained difference(s) by {len(used)} known "
        f"entr{'y' if len(used) == 1 else 'ies'} of {len(known)}; "
        f"{len(unexplained)} unexplained difference(s) in the gated "
        f"attributes; {sum(residue.values())} difference(s) of the residue "
        f"(not gated, {len(residue)} categories)")
  for level, name, symbol, category, detail in unexplained[:args.show]:
    print(f"  -O{level} {name} {symbol}: {category} {detail}")
  if args.residue:
    lines = ['# The differences of the residue: not gated (m5_design.md '
             'section 9), reported by category.',
             '# level  count  category (examples)']
    for (level, key), count in sorted(residue.items(),
                                      key = lambda item: (item[0][0],
                                                          -item[1])):
      example = residue_examples[(level, key)][0]
      lines.append(f"-O{level} {count:6d}  {key}  (e.g. {example[:140]})")
    Path(args.residue).write_text('\n'.join(lines) + '\n')
  exit_code = 1 if unexplained else 0
  nothing = [level for level in levels if total[level][0] == 0]
  if nothing:
    print(f"FAIL: nothing was compared at -O{', -O'.join(map(str, nothing))}")
    exit_code = 1
  if args.require_compared and uncompared:
    print(f"FAIL: {len(uncompared)} case(s) compared nothing:")
    for line in uncompared[:10]:
      print(f"  {line}")
    exit_code = 1
  below = []
  for level in levels:
    for kind in ('define', 'declare', 'call'):
      n, mine, theirs = nounwind[level][kind]
      share = lambda v: f"{100.0 * v / n:.1f}%" if n else 'n/a'
      print(f"nounwind -O{level} {kind}: {n} common; ours {mine} "
            f"({share(mine)}), clangir {theirs} ({share(theirs)})")
      if kind != 'call' and n and mine < theirs:
        below.append(f"-O{level} {kind}s: ours {share(mine)} < clangir "
                     f"{share(theirs)}")
  if args.nounwind_target:
    if below:
      print('FAIL: nounwind coverage below clangir\'s share: ' +
            '; '.join(below))
      exit_code = 1
    elif not any(nounwind[level]['define'][0] for level in levels):
      print('FAIL: nounwind coverage: no definition was compared')
      exit_code = 1
  if args.json:
    Path(args.json).write_text(json.dumps({
      'cases': per_case,
      'compared': {str(l): v[0] for l, v in total.items()},
      'only_ours': {str(l): v[1] for l, v in total.items()},
      'only_clangir': {str(l): v[2] for l, v in total.items()},
      'explained': explained_count,
      'unexplained': [list(u) for u in unexplained],
      'residue': {f"{l}|{k}": c for (l, k), c in sorted(residue.items())},
      'known_used': sorted(' | '.join(e) for e in used),
      'known_entries': len(known),
      'uncompared': uncompared,
      'nounwind': {str(l): v for l, v in nounwind.items()},
      'nounwind_below': below,
      'no_llvm_passes': runner.no_llvm_passes,
      'exit': exit_code}, indent = 1) + '\n')
  sys.exit(exit_code)


if __name__ == '__main__':
  main()
