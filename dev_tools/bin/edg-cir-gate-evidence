#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Produce the gate evidence of the CIR back end in one go.

Run it on the machine that runs the docker images (the x86-64 box), from any
directory, as a user that can run docker (`sg docker -c "..."`):

  edg-cir-gate-evidence --tree ~/edg-cir-config/m1-tree \\
      --identity-baseline ~/edg-cir-config/identity-m0c \\
      --day-baseline-run ~/edg-cir-config/baseline-tree/tests/runs/<ts>

The evidence goes into a dated directory (default
<tree>/.tmp/gate-evidence/<timestamp>), one subdirectory per step with the full
log (`log.txt`) and a `result.json`. Steps whose `result.json` says PASS are
skipped when the command is repeated with --out of an earlier run (resume), and
--only/--skip select steps. At the end a PASS/FAIL table is printed and written
to `summary.md`.

Lean gates: `--lean AREAS` (a comma separated list of the areas that the
change set touches) runs only the steps that those areas can affect, prints
the chosen set first and records every other step as SKIPPED with the reason
in the table; `--steps-for AREAS` only prints the set and exits.  The mapping
(AREA_STEPS; `build` is added to every area but `tooling`):

  writer     the ECIL writer, the FE side of the stream: cir-suite (the
             writer goldens), corpus, cpp-corpus, asm-diff, cpp-asm-diff,
             modes, cpp-modes, poison
  library    cir_src (the library): ctest (with lit), corpus, cpp-corpus,
             asm-diff, cpp-asm-diff
  fe-options CIR-gated front end options and macros: release-smoke
  linkage    symbol names, linkage, comdats: symbols, mixed-tu
  eccp       util/eccp.sh and the eccp configuration of the base (how the
             tests compile): cir-suite, corpus, cpp-corpus
  tests      the CIR tests and their recorded expectations: cir-suite,
             corpus, cpp-corpus
  tooling    dev_tools only: tools-test (the self-tests of the tools)
  toolchain  a new LLVM/MLIR/ClangIR pin (the M5p gate): ctest, smoke,
             cpp-smoke, cir-suite, corpus, cpp-corpus, opt-corpus, asm-diff,
             cpp-asm-diff, mixed-tu, symbols, eh-probes, m4-stress,
             cpp-stress, crash-sweep, perf, rss, stress (deep nesting under
             256 KB: a new pin can bring recursion back) and release-smoke
             (the only end-to-end run of release-only behavior, LLVM
             assertions off); skipped for the reasons of TOOLCHAIN_SKIPS
  shared-src a change in a src/ file that every back end compiles (not
             CIR-gated): identity, isolation, day

The areas are checked against the change set, so that a lean gate cannot
leave out what the change touches: with --lean-base REF (the files of
`git diff --name-only REF` and the untracked files of the tree) or
--changed-files FILE (one path a line, "-" for the standard input; for a tree
without git, like the box's), every file is mapped to an area by AREA_RULES
(cir_src/LLVM_REVISION and the Docker image files: toolchain; other cir_src:
library; src/ecil_* and src/cir_be*: writer; other src/: shared-src;
util/eccp.sh and bases/docker/cir-env: eccp; dev_tools/cir-mixed-tu-cases:
linkage; other dev_tools: tooling; tests: tests; documentation and Changes
files: none), and --lean fails unless the steps of the declared areas
include the steps of every area that the change set needs (toolchain covers
library, for instance, but not shared-src).  A file that no rule maps fails
too (add a rule).  --no-area-check skips the check (the report must say why).
A step that no listed area selects is not run in a lean gate; say in the
gate's report why the change set cannot affect it.

Steps (names for --only/--skip):

  build      build cir_src (build/cir), cpfe-cir (build/gcc-cir) and the
             non-ASan cpfe-cir (build/gcc-release-cir) and the util tools
  identity   cpfe, cpfe-cp, cdisp and util preprocessed output and
             --dump_configuration identical to the M0 capture (4 presets)
  isolation  edg-cir-check-isolation
  smoke      cir-c-smoke is 100% PASS in edg_x86_64_cir and edg_x86_64_cir_2p
  cir-suite  tests/tests/cir (writer goldens, cirgen run tests) in both CIR
             configs: all pass, no difference from the recorded expectations
  corpus     the C corpus in edg_x86_64_cir: summary, CIR-specific failures
             against edg_x86_64's expectations; no CIR-specific FE_CRASH or
             LIB_CRASH (a front end crash of the same class, ABORT or
             CATASTROPHE, that edg_x86_64 records for the case is excused and
             listed as INFO in excused-crashes.txt only if its backtrace has
             no ecil_/cir_be frame or, without one, it is the same assertion
             at the same file:line and source position (crash_excuse in
             edg-cir-summary); a LIB_CRASH never is), no KILLED/TIMEOUT test,
             and
             no difference from the recorded edg_x86_64_cir expectations
             (unless --allow-status-changes)
  modes      in-process and two-process output identical over the corpus
  stress     edg-cir-stress (deep nesting through the two-process path)
  abi-diff   (--with-m4 or --only) edg-cir-abi-diff batch --vbases over
             dev_tools/cir-abi-cases/{s1,s2} and the clang vtable-layout and
             thunk tests (copied from --llvm-project): passes iff no block
             differs ("ours" or "fe"), none is missing except those of the
             known tool limits (template classes: clang prints the template
             name without its arguments), and every file was compared
  symbols    edg-cir-symbols over the same cases against clang, with g++
             listed: passes iff every difference is on the allowlist of
             KNOWN_SYMBOL_DIFFERENCES (with reasons) and nothing was skipped
  mixed-tu   edg-cir-mixed-tu over every case, both directions, with g++ and
             with clang as the other translation unit: passes iff there is
             exactly one row per case x direction x host (cases x 2 x 2) and
             each is PASS, or XFAIL for a direction that the case lists in
             its xfail file; an XPASS (a stale xfail line) fails
  eh-probes  edg-cir-run-diff over the writer's exception probes (probes/m4
             e*, s4_*, s5_*): programs built by g++ and by the CIR back end
             run alike; the probes of --eh-probes-skip may be diagnosed as
             unsupported; at least one probe must exist and one must pass
  opt-corpus (--with-m4 or --only) both corpora at -O2 (--cir_opt_level=2
             through EDG_CPFE_DEFAULT_OPTIONS, set for its runs only) in
             edg_x86_64_cir, and both smoke lists at -O2 in
             edg_x86_64_cir_2p.  Passes iff the corpora have the cases of the
             -O0 run (the corpus steps of this evidence directory, else
             --opt-baseline-status), every PASS->FAIL case and every new crash,
             kill or timeout has a line in
             tests/.edgy/filters/cir-opt-triage.txt (category: ub,
             dg-option, ref-fails, our-ir, upstream; the our-ir ones are
             listed in our-ir.txt), and the assembly of every smoke test
             differs between -O0 and -O2 (edg-cir-compare-modes
             --opt-level, which also checks that both modes agree at each
             level)
  m4-stress  cir_src/scripts/box_m4_stress.sh under `ulimit -s 256` over the
             cases of M4_STRESS_CASES (the sizes of research/m4_stress.md):
             passes iff every run succeeds within its time and memory limit
  tools-test the self-tests of the tools (dev_tools/bin/edg-cir-tools-test)
  cpp-smoke  (--with-cpp or --only) cir-cpp-smoke through --cpp-configs
             (--types rp): buckets, pass rate per --c++NN mode, failures by
             C++ feature; fails on a crash, and (--cpp-smoke-all-pass) on any
             test that does not pass
  cpp-corpus the cir-cpp-corpus list (--types rp,lp), the same tables
  cpp-modes  edg-cir-compare-modes --cxx over the C++ corpus
  cpp-writer-stress  edg-cir-writer-stress --cxx
  release-smoke  the C smoke and C++ smoke lists through the release cpfe-cir
             (--posture cir-release, build/gcc-release-cir, the shipping macro
             configuration), both configs: the C list must pass completely,
             no C++ test may pass in the debug front end and not in the
             release one, no crash
  poison     edg-cir-poison-check: region-lifetime safety.  The debug front
             end (freed IL blocks overwritten with 0xdb, expensive checking),
             the same without the overwriting (build/gcc-cir-nopoison, made
             by the step) and the release front end must show no crash or
             assertion and write byte-identical streams (poison vs. none) for
             the C corpus, the C and C++ smoke lists, tests/tests/cir
             (writer and cirgen) and the C++ corpus; the release front end
             must write the same streams as the debug one (the build-type
             dependent macros are pinned in default/cpfe-cir.cmakedef)
  cpp-stress  cir_src/scripts/box_stress.sh over the synthetic C++ streams
             (cxx_locals ... cxx_funcs) through edg-cir under a 256 KiB
             stack: every case rc=0 and run=0 (the streams are self-checking
             programs), within --cpp-stress-seconds (30) and
             --cpp-stress-rss-mb (400)
  cpp-stress-asan  the same with the ASan library build (build/cir-asan,
             built by the step), smaller sizes and --cpp-stress-asan-rss-mb
             (1200)
  writer-stress  edg-cir-writer-stress: the ASan debug front end with
             ECIL_GID_STRESS=1 over the C smoke list and tests/tests/cir/
             writer: same exit status and byte-identical streams as without
             the variable, no sanitizer report or assertion, ecil-dump clean
  rss        peak memory and time of the front end and the library on a
             generated C file, a generated C++ file and a template-heavy
             C++ file, with ASan (quarantine off) and without: every row has
             a ceiling (RSS_CEILINGS_MB) that it may not exceed
  day        the default full day suite (edg_x86_64, edg_x86_64_cp) has the same
             test statuses as the M0 baseline run
  ctest      the cir_src tests in every cir_src preset, each built from
             scratch (its build directory is wiped first, unless
             --keep-ctest-builds): ninja decides what to rebuild by file
             times, and a tree synced with `rsync -a` keeps the sources'
             old times, so an older build directory would not be rebuilt
  asm-diff   the in-process assembly of every corpus test case of this tree
             against that of an earlier commit (--asm-baseline, a directory
             that `edg-cir-compare-modes --save-asm D --in-process-only`
             wrote, e.g. at the previous gate): identical files, files that
             differ only in the order of their symbols, only in the numbering
             of the labels inside a function, in the symbols they define,
             or in a function's code, and cases whose exit status or
             assembly existence changed; a source hint (for-init, alloca)
             is printed with every difference.  Passes
             only if all are identical (or, with --asm-allow-order, only
             reordered); report.txt has the details
  cpp-asm-diff  asm-diff for the C++ corpus (--cpp-corpus-filter, compiled as
             C++) against --cpp-asm-baseline, made in an old tree with
             `edg-cir-compare-modes --cxx
             @tests/.edgy/filters/cir-cpp-corpus.txt --types rp,lp -j 12
             --save-asm D --in-process-only`
  crash-sweep  every test type of the C corpus, of
             the C++ corpus (its filters) and of imported/gnu/cpp/eh/, rtti/
             and cir/ through edg_x86_64_cir, run by run (--sweep-timeout per
             test): every FE_CRASH, LIB_CRASH, kill and timeout that
             edg_x86_64 does not have too (the same crash_excuse rules) fails
             the step and is listed with a reproducer command in
             crashes.txt; the statuses of the tests themselves (fp, fn, ...
             have no CIR expectations) are not gated
  perf       edg-cir-perf (instruction counts, CPU time and RSS of a big
             generated file and of the whole corpus) and, with --perf-baseline
             (the JSON of an earlier run, default the M5p gate's; a step
             without one fails unless --perf-measure-only), the before/after
             table;
             --perf-max-regression PERCENT (default
             DEFAULT_PERF_MAX_REGRESSION) makes an increase of an
             instruction count beyond it a failure; a baseline row that the
             new run lacks (or has as 0) fails too

For the step asm-diff, the baseline of a commit is made with this tree's
scripts on a tree of that commit (a `git archive` of it will do):

  edg-exec --img cir-env -- python3 <this tree>/dev_tools/bin/edg-cir-compare-modes \\
      @tests/.edgy/filters/cir-c-corpus.txt --types rp,lp -j 12 \\
      --save-asm .tmp/asm --in-process-only      (in the old tree, built)

Use --smoke-filter, --corpus-filter and --types to test the script on a small
selection first.

Syncing a tree to the box: use `rsync -a --checksum` (or wipe build/cir*,
build/gcc-cir and build/gcc-release-cir) when the tree has been built before.
`rsync -a` keeps the modification times of the sources, which can be older than
the objects of an earlier build of the same directory from a previous sync, so
ninja then rebuilds nothing and the evidence is for the old code.
'''

import argparse
import difflib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tarfile
import time

from datetime import datetime
from pathlib import Path
from typing import Callable, Dict, List, Optional, Tuple

STEPS = ('build', 'identity', 'isolation', 'smoke', 'cir-suite', 'corpus',
         'modes',
         'stress', 'writer-stress', 'rss', 'day', 'ctest', 'asm-diff', 'perf',
         'cpp-smoke', 'cpp-corpus', 'cpp-modes', 'cpp-writer-stress',
         'cpp-stress', 'cpp-stress-asan', 'poison', 'release-smoke',
         'cpp-asm-diff', 'crash-sweep', 'abi-diff', 'symbols', 'mixed-tu',
         'eh-probes', 'm4-stress', 'opt-corpus', 'tools-test')
# The steps of gate M4 (the ABI and EH harnesses); they run only with
# --with-m4 or --only.
M4_STEPS = ('abi-diff', 'symbols', 'mixed-tu', 'eh-probes', 'm4-stress',
            'opt-corpus')
# The steps of the C++ milestones; they run only with --with-cpp or --only.
CPP_STEPS = ('cpp-smoke', 'cpp-corpus', 'cpp-modes', 'cpp-writer-stress',
             'cpp-stress', 'cpp-stress-asan', 'poison', 'release-smoke',
             'cpp-asm-diff')
# Steps that take long and run only with --only (none at present).
LONG_STEPS: Tuple[str, ...] = ()
# The steps of a lean gate (--lean, --steps-for) by the area of the change.
AREA_STEPS = {
  'writer': ('cir-suite', 'corpus', 'cpp-corpus', 'asm-diff',
             'cpp-asm-diff', 'modes', 'cpp-modes', 'poison'),
  'library': ('ctest', 'corpus', 'cpp-corpus', 'asm-diff', 'cpp-asm-diff'),
  'fe-options': ('release-smoke',),
  'linkage': ('symbols', 'mixed-tu'),
  'eccp': ('cir-suite', 'corpus', 'cpp-corpus'),
  'tests': ('cir-suite', 'corpus', 'cpp-corpus'),
  'tooling': ('tools-test',),
  'toolchain': ('ctest', 'smoke', 'cpp-smoke', 'cir-suite', 'corpus',
                'cpp-corpus', 'opt-corpus', 'asm-diff', 'cpp-asm-diff',
                'mixed-tu', 'symbols', 'eh-probes', 'm4-stress',
                'cpp-stress', 'crash-sweep', 'perf', 'rss', 'stress',
                'release-smoke'),
  'shared-src': ('identity', 'isolation', 'day'),
}
# Why the steps that a new toolchain pin does not need are skipped (used
# when `toolchain` is the only area of a lean gate).
TOOLCHAIN_SKIPS = {
  'identity': 'no front end change', 'isolation': 'no front end change',
  'day': 'no front end change', 'poison': 'no front end or writer change',
  'writer-stress': 'no writer change',
  'cpp-writer-stress': 'no writer change',
  'modes': "covered by opt-corpus's compare-modes over both smoke lists at "
           '-O0 and -O2',
  'cpp-modes': "covered by opt-corpus's compare-modes over both smoke lists "
               'at -O0 and -O2',
  'abi-diff': 'lib/abi unchanged',
  'cpp-stress-asan': "covered by ctest's ASan preset",
  'tools-test': 'no tooling change',
}
# The area of a changed file: the first rule whose prefix the path starts
# with (or, for a name starting with '*', whose suffix it ends with) decides;
# None means that the file needs no gate step (documentation).  A path that
# no rule matches is an error of the area check.
AREA_RULES: Tuple[Tuple[str, Optional[str]], ...] = (
  ('cir_src/LLVM_REVISION', 'toolchain'),
  ('dev_tools/docker/llvm-cir/', 'toolchain'),
  ('dev_tools/docker/cir-env/', 'toolchain'),
  ('dev_tools/bin/edg-build-llvm-cir', 'toolchain'),
  ('cir_src/doc/', None),
  ('cir_src/', 'library'),
  ('src/Changes', None),
  ('src/ecil_', 'writer'),
  ('src/cir_be', 'writer'),
  ('src/', 'shared-src'),
  ('util/eccp.sh', 'eccp'),
  ('bases/docker/cir-env/', 'eccp'),
  ('dev_tools/cir-mixed-tu-cases/', 'linkage'),
  ('dev_tools/', 'tooling'),
  ('tests/', 'tests'),
  ('doc/', None),
  ('dev_annex/', None),
  ('*.md', None),
  ('*Changes', None),
)
# The synthetic C++ stress streams (cir_src/scripts/ecil-stress-gen.py) of
# the cpp-stress steps: normal sizes, and the smaller ASan sizes.
CPP_STRESS_CASES = ('cxx_locals:2000 cxx_temps:5000 cxx_meminit:2000 '
                    'cxx_cond_chain:1000 cxx_cond_seq:500 cxx_blocks:500 '
                    'cxx_array:1000 cxx_array_nest:100 cxx_funcs:6000')
CPP_STRESS_ASAN_CASES = ('cxx_locals:500 cxx_temps:1000 cxx_meminit:500 '
                         'cxx_cond_chain:300 cxx_cond_seq:300 '
                         'cxx_blocks:300 cxx_array:1000 cxx_array_nest:50 '
                         'cxx_funcs:1000')
PRESETS = ('linux-gcc-debug', 'linux-gcc-release', 'linux-clang-debug',
           'linux-i686-gcc-debug')
BUILD_JOBS = 12  # overridden by --jobs


class Context:
  def __init__(self, args: argparse.Namespace) -> None:
    self.tree = Path(args.tree).resolve()
    stamp = datetime.now().strftime('%Y.%m.%d-%H.%M.%S')
    self.out = Path(args.out).resolve() if args.out else (
      self.tree / '.tmp' / 'gate-evidence' / stamp
    )
    self.args = args
    self.env = dict(os.environ)
    # edgdocker forwards EDG_CPFE_DEFAULT_OPTIONS into the containers, so a
    # value in the operator's shell would reach every step: only step
    # opt-corpus sets it (for its own runs).
    if self.env.pop('EDG_CPFE_DEFAULT_OPTIONS', None) is not None:
      print('WARNING: EDG_CPFE_DEFAULT_OPTIONS is set in the environment; '
            'it is ignored (removed) for this gate run', file = sys.stderr)
    self.env['PATH'] = f"{self.tree / 'dev_tools/bin'}:{self.env['PATH']}"
    self.env['PYTHONPATH'] = str(self.tree / 'dev_tools/pylibs')
    # The commands of a step that were stopped at their time limit.
    self.timed_out: Dict[str, List[str]] = {}


# The time limit of one command of a step (seconds): a command that hangs is
# stopped, its container with it, and the step fails.  The normal times are a
# small fraction of these; --command-timeout changes the default.
COMMAND_TIMEOUT = 7200
STEP_TIMEOUTS = {
  'isolation': 900, 'writer-stress': 1800, 'cpp-writer-stress': 1800,
  'cpp-stress': 1800, 'cpp-stress-asan': 3600, 'abi-diff': 1800,
  'symbols': 1800, 'mixed-tu': 1800, 'eh-probes': 1800, 'm4-stress': 3600,
  'opt-corpus': 10800,
  'poison': 3600, 'release-smoke': 3600, 'crash-sweep': 5400
}


def command_timeout(ctx: Context, step: str) -> int:
  limits = dict(STEP_TIMEOUTS)
  for item in ctx.args.step_timeout:
    name, _, seconds = item.partition('=')
    limits[name] = int(seconds)
  return limits.get(step, ctx.args.command_timeout)


def job_prefix(ctx: Context, step: str) -> str:
  '''The name prefix and label of the containers of a step of this gate run:
  cir-config-<tree>-<step>-g<pid of this process>, so that the containers of
  another gate run (another process, even of the same tree and step) are
  never matched.'''
  return f"cir-config-{ctx.tree.name}-{step}-g{os.getpid()}"


def container_filter(prefix: str) -> str:
  '''The docker filter that matches exactly the containers with the label
  edg.job=<prefix> (a label filter with a value compares the whole value).'''
  return f"label=edg.job={prefix}"


def stop_containers(ctx: Context, prefix: str) -> List[str]:
  '''Stop the containers that carry the label edg.job=<prefix> (the ones
  this step started; edgdocker names them from EDG_DOCKER_NAME_PREFIX) and
  return their ids.'''
  try:
    listing = subprocess.run(
      ['sg', 'docker', '-c',
       f"docker ps -q --filter {container_filter(prefix)}"],
      stdout = subprocess.PIPE, stderr = subprocess.DEVNULL, text = True)
  except OSError:
    return []
  ids = listing.stdout.split()
  for identifier in ids:
    subprocess.run(['sg', 'docker', '-c', f"docker stop -t 10 {identifier}"],
                   stdout = subprocess.DEVNULL, stderr = subprocess.DEVNULL)
  return ids


def run_logged(ctx: Context, step: str, command: List[str],
               label: str = '', cwd: Optional[Path] = None,
               extra_env: Optional[Dict[str, str]] = None) -> int:
  '''Run a command, appending its output to the step's log.txt.

  The command has a time limit (see command_timeout): after it the process
  group is killed and the containers of the step are stopped; the exit
  status is then 124 and the step fails.  The containers are named
  cir-config-<tree>-<step>-g<gate pid>-<pid>-<n> (edgdocker, from the
  environment) and carry the label edg.job=<prefix>.'''
  step_dir = ctx.out / step
  step_dir.mkdir(parents = True, exist_ok = True)
  env = dict(ctx.env)
  prefix = job_prefix(ctx, step)
  env['EDG_DOCKER_NAME_PREFIX'] = prefix
  env.update(extra_env or {})
  limit = command_timeout(ctx, step)
  with open(step_dir / 'log.txt', 'a') as log:
    log.write(f"\n$ {label or ' '.join(shlex.quote(c) for c in command)}\n")
    log.flush()
    proc = subprocess.Popen(
      command, cwd = cwd or ctx.tree, env = env, stdout = log,
      stderr = subprocess.STDOUT, start_new_session = True)
    try:
      code = proc.wait(timeout = limit)
    except subprocess.TimeoutExpired:
      for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
          os.killpg(proc.pid, sig)
        except ProcessLookupError:
          break
        try:
          proc.wait(timeout = 10)
          break
        except subprocess.TimeoutExpired:
          continue
      stopped = stop_containers(ctx, prefix)
      code = 124
      ctx.timed_out.setdefault(step, []).append(
        (label or ' '.join(command))[:70])
      log.write(f"[TIMEOUT after {limit} s; container(s) stopped: "
                f"{', '.join(stopped) or 'none'}]\n")
    log.write(f"[exit {code}]\n")
  return code


def _edg_exec_command(ctx: Context, image: str, command: str,
                      wdir: str = '') -> List[str]:
  '''The command line that runs `bash -c command` in an edg-exec container.

  edg-exec joins its arguments with spaces, so the shell command is passed
  as one argument that already holds the quoting.
  '''
  edg_exec = [str(ctx.tree / 'dev_tools/bin/edg-exec')]
  if image:
    edg_exec += ['--img', image]
  if wdir:
    edg_exec += ['--wdir', wdir]
  edg_exec += ['--', 'bash -c ' + shlex.quote(command)]
  return ['sg', 'docker', '-c', ' '.join(shlex.quote(a) for a in edg_exec)]


def in_cir_env(ctx: Context, step: str, command: str,
               wdir: str = '', extra_env: Optional[Dict[str, str]] = None
               ) -> int:
  '''Run a shell command in the cir-env image with the tree as workspace.

  extra_env variables are set inside the container.
  '''
  prefix = ''.join(
    f"export {key}={shlex.quote(value)}; "
    for key, value in (extra_env or {}).items()
  )
  full = prefix + command
  return run_logged(ctx, step, _edg_exec_command(ctx, 'cir-env', full, wdir),
                    label = command)


def in_default_env(ctx: Context, step: str, command: str) -> int:
  return run_logged(ctx, step, _edg_exec_command(ctx, '', command),
                    label = command)


def rel(ctx: Context, path: Path) -> str:
  '''Path as seen inside the container (the tree is /edg/workspace).'''
  return f"/edg/workspace/{path.relative_to(ctx.tree)}"


def newest_run(ctx: Context, before: set) -> Optional[Path]:
  runs_dir = ctx.tree / 'tests' / 'runs'
  new = [p for p in runs_dir.iterdir() if p.is_dir() and p.name not in before]
  return max(new, key = lambda p: p.stat().st_mtime) if new else None


def runs_before(ctx: Context) -> set:
  runs_dir = ctx.tree / 'tests' / 'runs'
  return {p.name for p in runs_dir.iterdir()} if runs_dir.exists() else set()


def summarize_run(ctx: Context, step: str, run: Path, config: str,
                  json_name: str, extra: Optional[List[str]] = None,
                  text_tag: str = '') -> Tuple[List[dict], str]:
  '''Run edg-cir-summary on a run directory; return (results, text).'''
  json_file = ctx.out / step / json_name
  proc = subprocess.run(
    [sys.executable, str(ctx.tree / 'dev_tools/bin/edg-cir-summary'),
     str(run), config, '--top', '6', '--json', str(json_file),
     '--reference', str(ctx.tree / 'tests/expectations/edg_x86_64'),
     *(extra or [])],
    cwd = ctx.tree, env = ctx.env, stdout = subprocess.PIPE,
    stderr = subprocess.STDOUT, text = True
  )
  (ctx.out / step / f"summary-{config}{text_tag}.txt").write_text(
    proc.stdout)
  results = json.loads(json_file.read_text()).get(config, [])
  return results, proc.stdout


# The per-test limit (-T) is above the 120 s limit of a compiled program
# (edgtest.exec): a program that hangs is a normal FAIL (status 124) and not a
# test that edgy cancelled (an "X" line), as torture/ssp-1 does in every config.
def edgy_run(ctx: Context, step: str, config: str, filters: str,
             types: str, timeout: int = 180, posture: str = 'cir',
             extra_env: Optional[Dict[str, str]] = None
             ) -> Optional[Path]:
  before = runs_before(ctx)
  command = [
    str(ctx.tree / 'dev_tools/bin/edg-docker-test'), '--non-interactive',
    '--posture', posture, '--only-configs', config, '-T', str(timeout)
  ]
  if types:
    command += ['--types', types]
  command.append(filters)
  run_logged(ctx, step, ['sg', 'docker', '-c', ' '.join(
    shlex.quote(c) for c in command)], extra_env = extra_env)
  return newest_run(ctx, before)


# Each step returns (passed, detail).
def step_build(ctx: Context) -> Tuple[bool, str]:
  base = 'export EDG_BASE=/edg/workspace/bases/docker/cir-env/gcc; '
  commands = [
    'cd cir_src && cmake --preset linux-cir-relwithdebinfo',
    f"cmake --build build/cir -j{BUILD_JOBS}",
    base + 'cmake --preset linux-gcc-debug-cir -DEDG_CIR_LINK_LIBRARY=ON',
    f"cmake --build build/gcc-cir --target cpfe-cir edg_prelink edg_decode "
    f"-j{BUILD_JOBS}",
    base + 'cmake --preset linux-gcc-release-cir '
    '-DEDG_CIR_LINK_LIBRARY=ON',
    f"cmake --build build/gcc-release-cir --target cpfe-cir edg_prelink "
    f"edg_decode -j{BUILD_JOBS}"
  ]
  failed = [c for c in commands if in_cir_env(ctx, 'build', c) != 0]
  return not failed, 'built build/cir, build/gcc-cir, build/gcc-release-cir' \
    if not failed else f"failed: {failed[0]}"


def step_identity(ctx: Context) -> Tuple[bool, str]:
  baseline = ctx.args.identity_baseline
  if not baseline:
    return False, '--identity-baseline is required'
  # The capture runs in a container, so it must be inside the tree.
  out = ctx.tree / '.tmp' / 'gate-identity' / ctx.out.name
  presets = ' '.join(ctx.args.identity_presets.split(','))
  checker = 'python3 dev_tools/bin/edg-macro-identity-check'
  if in_default_env(ctx, 'identity', f"{checker} configure --src . "
                    f"--presets {presets}") != 0:
    return False, 'configure failed'
  if in_default_env(
      ctx, 'identity', f"{checker} capture --src . --out {rel(ctx, out)} "
      f"--presets {presets} --jobs {BUILD_JOBS} --binaries "
      f"--build-jobs {BUILD_JOBS}") != 0:
    return False, 'capture failed'
  proc = subprocess.run(
    [sys.executable, str(ctx.tree / 'dev_tools/bin/edg-macro-identity-check'),
     'compare', '--normalize-line-numbers', '--allow-cir-diagnostics',
     '--presets', ctx.args.identity_presets,
     str(Path(baseline).resolve()), str(out)],
    env = ctx.env, stdout = subprocess.PIPE, stderr = subprocess.STDOUT,
    text = True
  )
  (ctx.out / 'identity' / 'compare.txt').write_text(proc.stdout)
  last = proc.stdout.strip().splitlines()[-1] if proc.stdout.strip() else ''
  return proc.returncode == 0, last


def step_isolation(ctx: Context) -> Tuple[bool, str]:
  code = in_cir_env(ctx, 'isolation',
                    'python3 dev_tools/bin/edg-cir-check-isolation')
  text = (ctx.out / 'isolation' / 'log.txt').read_text()
  passes = len(re.findall(r'^PASS:', text, re.M))
  fails = len(re.findall(r'^FAIL:', text, re.M))
  return code == 0, f"{passes} checks passed, {fails} failed"


def step_tools_test(ctx: Context) -> Tuple[bool, str]:
  code = in_cir_env(ctx, 'tools-test',
                    'python3 dev_tools/bin/edg-cir-tools-test')
  text = (ctx.out / 'tools-test' / 'log.txt').read_text()
  match = re.search(r'^Ran (\d+) tests?', text, re.M)
  return (code == 0 and bool(match),
          f"{match.group(1) if match else 'no'} self-tests ran")


def lean_steps(areas: List[str]) -> Tuple[List[str], Dict[str, str]]:
  '''The steps of a lean gate for the areas of a change (the mapping of
  AREA_STEPS, in the order of STEPS; `build` for every area but tooling) and
  the reason of every step that is left out.'''
  chosen = set()
  for area in areas:
    chosen.update(AREA_STEPS[area])
  if [a for a in areas if a != 'tooling']:
    chosen.add('build')
  steps = [s for s in STEPS if s in chosen]
  generic = f"not reached by the area(s) {','.join(areas)}"
  reasons = {s: (TOOLCHAIN_SKIPS.get(s, generic) if areas == ['toolchain']
                 else generic) for s in STEPS if s not in chosen}
  return steps, reasons


def area_of(path: str) -> Optional[str]:
  '''The area of a changed file by AREA_RULES: None for a file that needs no
  step (documentation), 'unmapped' for a path that no rule matches.'''
  for pattern, area in AREA_RULES:
    if (path.endswith(pattern[1:]) if pattern.startswith('*')
        else path.startswith(pattern)):
      return area
  return 'unmapped'


def required_areas(paths: List[str]) -> Dict[str, List[str]]:
  '''The areas that a change set needs (area -> its files), by area_of.'''
  needed: Dict[str, List[str]] = {}
  for path in paths:
    area = area_of(path)
    if area:
      needed.setdefault(area, []).append(path)
  return needed


def uncovered_areas(paths: List[str], areas: List[str]) -> List[str]:
  '''The problems of the declared areas against a change set (empty if it
  is covered): a file that no rule maps, and every needed area whose steps
  are not among the steps that the declared areas chose.'''
  chosen = set(lean_steps(areas)[0])
  problems: List[str] = []
  for area, files in sorted(required_areas(paths).items()):
    shown = ', '.join(files[:3]) + (' ...' if len(files) > 3 else '')
    if area == 'unmapped':
      problems.append(f"no area for {shown} (add a rule to AREA_RULES)")
      continue
    missing = [s for s in lean_steps([area])[0] if s not in chosen]
    if missing:
      problems.append(f"the change set needs area {area} ({shown}), whose "
                      f"steps {', '.join(missing)} the declared areas "
                      f"{','.join(areas)} do not run")
  return problems


def changed_paths(tree: Path, base: str, listing: str) -> List[str]:
  '''The changed files for the area check: the lines of the file `listing`
  ("-": the standard input), else `git diff --name-only <base>` and the
  untracked files of the tree.'''
  if listing:
    text = sys.stdin.read() if listing == '-' else Path(listing).read_text()
    return [line.strip() for line in text.splitlines() if line.strip()]
  paths: List[str] = []
  for command in (['git', 'diff', '--name-only', base],
                  ['git', 'ls-files', '--others', '--exclude-standard']):
    proc = subprocess.run(command, cwd = tree, text = True,
                          stdout = subprocess.PIPE, stderr = subprocess.PIPE)
    if proc.returncode != 0:
      raise RuntimeError(f"{' '.join(command)}: {proc.stderr.strip()}")
    paths += proc.stdout.split('\n')
  return sorted(set(p for p in paths if p))


def _load_tool(name: str):
  '''Load the module of a sibling tool of dev_tools/bin (a file without
  .py), so that its functions are shared and not copied.'''
  path = str(Path(__file__).resolve().with_name(name))
  loader = importlib.machinery.SourceFileLoader(name.replace('-', '_'), path)
  spec = importlib.util.spec_from_loader(loader.name, loader)
  module = importlib.util.module_from_spec(spec)
  loader.exec_module(module)
  return module


_summary = _load_tool('edg-cir-summary')


def reference_message(ctx: Context, test_path: str, variant: str = '') -> str:
  '''The crash line in the reference's recording of a case of a test (the
  first line of its output if it has no crash line).'''
  output = _summary.reference_output(ctx.tree / 'tests' / 'tests', test_path,
                                     variant)
  line, _ = _summary.crash_details(output)
  if not line:
    lines = [l.strip() for l in output.splitlines() if l.strip()]
    line = lines[0] if lines else ''
  return line[:200]


def split_crashes(results: List[dict]) -> Tuple[List[dict], List[dict]]:
  '''The crashes of a summary: (CIR-specific ones, pre-existing ones).

  Only a front end crash (FE_CRASH) that the edg_x86_64 reference has too is
  pre-existing, by the rules of edg-cir-summary's crash_excuse: the same
  class (ABORT or CATASTROPHE), no writer file in the message, and either a
  backtrace without a writer frame or the same assertion (text, file:line,
  source position) as the reference's.  A library crash (LIB_CRASH) is never
  excused: the reference does not run the library.  Kills and timeouts
  (KILLED, TIMEOUT) are not crashes of this kind and are counted by
  killed_tests; they are never excused either.
  '''
  crashes = [r for r in results if r['bucket'] in ('FE_CRASH', 'LIB_CRASH')]
  excused = [r for r in crashes if _summary.crash_excuse(r)[0]]
  return ([r for r in crashes if r not in excused], excused)


def killed_tests(ctx: Context, step: str, results: List[dict]) -> List[str]:
  '''Tests killed by a signal or a timeout: the KILLED and TIMEOUT buckets
  and the tests edgy cancelled (an "X <test>" line of the run's log).'''
  names = [r['path'] for r in results if r['bucket'] in ('KILLED', 'TIMEOUT')]
  log = ctx.out / step / 'log.txt'
  if log.exists():
    names += [l[2:].strip() for l in log.read_text(errors = 'replace'
                                                    ).splitlines()
              if l.startswith('X ')]
  return names


def _config_step(ctx: Context, step: str, filters: str, types: str,
                 configs: Tuple[str, ...]) -> Dict[str, Tuple[Path, List[dict]]]:
  out = {}
  for config in configs:
    run = edgy_run(ctx, step, config, filters, types)
    if run is None:
      out[config] = (Path(), [])
      continue
    results, _ = summarize_run(ctx, step, run, config, f"{config}.json")
    out[config] = (run, results)
  return out


def step_smoke(ctx: Context) -> Tuple[bool, str]:
  data = _config_step(ctx, 'smoke', ctx.args.smoke_filter, ctx.args.types,
                      ('edg_x86_64_cir', 'edg_x86_64_cir_2p'))
  parts = []
  ok = True
  for config, (run, results) in data.items():
    passed = sum(1 for r in results if r['bucket'] == 'PASS')
    parts.append(f"{config} {passed}/{len(results)}")
    ok = ok and bool(results) and passed == len(results)
  return ok, ', '.join(parts)


def step_cir_suite(ctx: Context) -> Tuple[bool, str]:
  '''The cir suite (tests/tests/cir: the writer goldens and the cirgen run
  tests) in both configs: every case passes and nothing differs from the
  recorded expectations.'''
  parts = []
  ok = True
  for config in ('edg_x86_64_cir', 'edg_x86_64_cir_2p'):
    run = edgy_run(ctx, 'cir-suite', config, 'cir', '')
    if run is None:
      return False, f"no run for {config}"
    results, _ = summarize_run(ctx, 'cir-suite', run, config,
                               f"{config}.json")
    failing = [r for r in results if r['bucket'] != 'PASS']
    log = (ctx.out / 'cir-suite' / 'log.txt').read_text(errors = 'replace')
    parts.append(f"{config} {len(results) - len(failing)}/{len(results)} pass")
    ok = ok and bool(results) and not failing
  changes = [l for l in log.splitlines() if re.match(r'^[+-] \S', l)]
  (ctx.out / 'cir-suite' / 'status-changes.txt').write_text(
    '\n'.join(changes) + ('\n' if changes else ''))
  return ok and not changes, '; '.join(parts) + (
    f"; {len(changes)} lines differ from the recorded expectations"
    if changes else '')


def step_corpus(ctx: Context) -> Tuple[bool, str]:
  data = _config_step(ctx, 'corpus', ctx.args.corpus_filter, ctx.args.types,
                      ('edg_x86_64_cir',))
  run, results = data['edg_x86_64_cir']
  if not results:
    return False, 'no results'
  counts: Dict[str, int] = {}
  for result in results:
    counts[result['bucket']] = counts.get(result['bucket'], 0) + 1
  crashes, preexisting = split_crashes(results)
  killed = killed_tests(ctx, 'corpus', results)
  specific = [r for r in results if not r['ref_fail'] and
              r['bucket'] != 'PASS']
  total = len(results)
  # edgy prints a "+"/"-" line for every test whose status or output differs
  # from the recorded expectations (tests/expectations/<config>).
  log_text = (ctx.out / 'corpus' / 'log.txt').read_text(errors = 'replace')
  changes = [l for l in log_text.splitlines() if re.match(r'^[+-] \S', l)]
  (ctx.out / 'corpus' / 'status-changes.txt').write_text(
    '\n'.join(changes) + ('\n' if changes else ''))
  info = ''
  if preexisting:
    with open(ctx.out / 'corpus' / 'excused-crashes.txt', 'w') as excused_log:
      for r in preexisting:
        excused_log.write(
          f"{r['path']} [{r['status']}] {r.get('message', '')} | reference "
          f"{r.get('ref_status', '')}: "
          f"{reference_message(ctx, r['path'], r['variant'])} | excused: "
          f"{_summary.crash_excuse(r)[1]}\n")
    names = '; '.join(
      f"{r['path']} [{r['status']}] {r.get('message', '')[:60]} | reference "
      f"{r.get('ref_status', '')} "
      f"{reference_message(ctx, r['path'], r['variant'])[:60]}"
      for r in preexisting[:5])
    info = (f" INFO: {len(preexisting)} front end crash(es) of the same class "
            f"in the reference: {names};")
  detail = (f"{counts.get('PASS', 0)}/{total} pass; FE_CRASH "
            f"{counts.get('FE_CRASH', 0)}, LIB_CRASH "
            f"{counts.get('LIB_CRASH', 0)} ({len(crashes)} CIR-specific);"
            f"{info} CIR-specific failures "
            f"{len(specific)} (the rest also fail in edg_x86_64); "
            f"{len(changes)} lines differ from the recorded expectations "
            f"(status-changes.txt)")
  if killed:
    detail += f"; KILLED/TIMEOUT {len(killed)}: {', '.join(killed[:3])}"
  return not crashes and not killed and (
    not changes or ctx.args.allow_status_changes), detail


def step_modes(ctx: Context) -> Tuple[bool, str]:
  command = (f"python3 dev_tools/bin/edg-cir-compare-modes "
             f"{shlex.quote(ctx.args.corpus_filter)} -j {BUILD_JOBS}")
  if ctx.args.types:
    command += f" --types {ctx.args.types}"
  code = in_cir_env(ctx, 'modes', command)
  text = (ctx.out / 'modes' / 'log.txt').read_text()
  match = re.search(r'\d+ identical, .* different', text)
  return code == 0, match.group(0) if match else 'no result line'


def _cpp_run_step(ctx: Context, step: str, filters: str, types: str,
                  require_all: bool) -> Tuple[bool, str]:
  '''Run a C++ filter list through the CIR configs and summarize it.

  The summaries (summary-<config>.txt) have the buckets, the pass rate per
  --c++NN mode and the failures by C++ feature.  The step fails on a front
  end or library crash, and, with require_all, if a test does not pass.
  '''
  parts = []
  ok = True
  for config in ctx.args.cpp_configs.split(','):
    run = edgy_run(ctx, step, config, filters, types)
    if run is None:
      return False, f"no run for {config}"
    results, _ = summarize_run(ctx, step, run, config, f"{config}.json",
                               ['--language', 'cxx', '--types', types])
    counts: Dict[str, int] = {}
    for result in results:
      counts[result['bucket']] = counts.get(result['bucket'], 0) + 1
    crashes, preexisting = split_crashes(results)
    killed = killed_tests(ctx, step, results)
    with open(ctx.out / step / 'excused-crashes.txt', 'a') as excused_log:
      for r in preexisting:
        excused_log.write(
          f"{config} {r['path']} [{r['status']}] {r.get('message', '')} | "
          f"reference {r.get('ref_status', '')}: "
          f"{reference_message(ctx, r['path'], r['variant'])} | excused: "
          f"{_summary.crash_excuse(r)[1]}\n")
    passed = counts.get('PASS', 0)
    parts.append(f"{config} {passed}/{len(results)} pass, {len(crashes)} "
                 f"crashes" + (f" (+{len(preexisting)} same FE crash in the "
                               f"reference)" if preexisting else '') +
                 (f", {len(killed)} killed/timeout" if killed else ''))
    ok = ok and bool(results) and not crashes and not killed and (
      not require_all or passed == len(results))
  return ok, '; '.join(parts) + ' (summary-<config>.txt)'


def step_cpp_smoke(ctx: Context) -> Tuple[bool, str]:
  return _cpp_run_step(ctx, 'cpp-smoke', ctx.args.cpp_smoke_filter,
                       'rp,lp', ctx.args.cpp_smoke_all_pass)


def step_cpp_corpus(ctx: Context) -> Tuple[bool, str]:
  return _cpp_run_step(ctx, 'cpp-corpus', ctx.args.cpp_corpus_filter,
                       'rp,lp', False)


def step_cpp_modes(ctx: Context) -> Tuple[bool, str]:
  command = (f"python3 dev_tools/bin/edg-cir-compare-modes --cxx "
             f"{shlex.quote(ctx.args.cpp_corpus_filter)} -j {BUILD_JOBS} "
             f"--types rp,lp")
  code = in_cir_env(ctx, 'cpp-modes', command)
  text = (ctx.out / 'cpp-modes' / 'log.txt').read_text()
  match = re.search(r'\d+ identical, .* different', text)
  return code == 0, match.group(0) if match else 'no result line'


def _run_cpp_stress(ctx: Context, step: str, cases: str,
                    build: str) -> Tuple[bool, str]:
  '''box_stress.sh over synthetic C++ streams, under a 256 KiB stack.

  Every case must have rc=0 and (the streams are self-checking programs that
  the script runs) run=0, in at most --cpp-stress-seconds and
  --cpp-stress-rss-mb of peak memory.
  '''
  # Each case has a hard time limit (box_stress.sh: timeout -k 10 ...): 10
  # times --cpp-stress-seconds (20 times for the sanitizer build, which is
  # slower), and a main-thread stack of 256 KiB (8 MiB for the sanitizer
  # build: its symbolizer recurses deeply when it reports at exit).
  asan = build != 'build/cir'
  hard = ctx.args.cpp_stress_seconds * (20 if asan else 10)
  command = (f"EDG_CIR_STRESS_TIMEOUT={hard} "
             f"EDG_CIR_STRESS_STACK_KB={8192 if asan else 256} "
             f"EDG_CIR_BUILD={build} bash cir_src/scripts/box_stress.sh "
             f"{cases}")
  # The tools and the library must be those of this tree (the sanitizer build
  # is not made by the build step).
  preset = ('linux-cir-relwithdebinfo' if build == 'build/cir' else
            Path(build).name.replace('cir-', 'linux-cir-'))
  in_cir_env(ctx, step, f"cd cir_src && cmake --preset {preset} && "
             f"cmake --build ../{build} -j{BUILD_JOBS}")
  limit_mb = (ctx.args.cpp_stress_asan_rss_mb if build != 'build/cir'
              else ctx.args.cpp_stress_rss_mb)
  in_cir_env(ctx, step, command)
  text = (ctx.out / step / 'log.txt').read_text()
  rows = re.findall(r'^(\S+:\d+)\s+(.*)$', text, re.M)
  expected = len(cases.split())
  problems = []
  for name, rest in rows:
    rc = re.search(r'rc=(\d+)', rest)
    millis = re.search(r'(\d+) ms', rest)
    peak = re.search(r'(\d+) KB', rest)
    run = re.search(r'run=(\d+)', rest)
    if rest.split() and rest.split()[-1] == 'TIMEOUT':
      problems.append(f"{name}: TIMEOUT")
    elif rc is None or rc.group(1) != '0' or (run and run.group(1) != '0'):
      problems.append(f"{name}: {rest.strip()[:80]}")
    elif 'run=link-failed' in rest:
      problems.append(f"{name}: the program did not link")
    elif millis and int(millis.group(1)) > ctx.args.cpp_stress_seconds * 1000:
      problems.append(f"{name}: {millis.group(1)} ms")
    elif peak and int(peak.group(1)) > limit_mb * 1024:
      problems.append(f"{name}: {int(peak.group(1)) // 1024} MB")
  if len(rows) != expected:
    problems.append(f"{len(rows)} result lines for {expected} cases")
  return not problems, (f"{len(rows)} cases within "
                        f"{ctx.args.cpp_stress_seconds} s / "
                        f"{limit_mb} MB" if not problems
                        else '; '.join(problems[:4]))


def step_release_smoke(ctx: Context) -> Tuple[bool, str]:
  '''The C and C++ smoke lists through the release cpfe-cir.

  The CIR test configurations use the debug front end (macro configuration
  linux-gcc); the shipping one is linux-gcc-release, whose macros differ
  (NEW_CAN_BE_FOLDED_INTO_CTOR, PRAGMA_WEAK_ALLOWED, ...), so release-only IL
  shapes are exercised here (--posture cir-release: build/gcc-release-cir).
  The C smoke list must pass completely; no C++ smoke test may pass in the
  debug front end and fail in the release one, and none may crash.
  '''
  problems: List[str] = []
  parts: List[str] = []
  for config in ctx.args.cpp_configs.split(','):
    results: Dict[str, Dict[str, str]] = {}
    preexisting_keys: set = set()
    for kind, filters, types in (
        ('c', ctx.args.smoke_filter, 'rp,lp'),
        ('c++', ctx.args.cpp_smoke_filter, 'rp,lp')):
      for flavor, posture in (('release', 'cir-release'), ('debug', 'cir')):
        if kind == 'c' and flavor == 'debug':
          continue
        run = edgy_run(ctx, 'release-smoke', config, filters, types,
                       posture = posture)
        if run is None:
          return False, f"no run for {config} {kind} {flavor}"
        json_name = f"{config}-{kind}-{flavor}.json".replace('+', 'x')
        extra = ['--language', 'cxx', '--types', types] if kind == 'c++' \
          else []
        rows, _ = summarize_run(ctx, 'release-smoke', run, config, json_name,
                                extra)
        results[f"{kind}-{flavor}"] = {
          f"{r['path']} {r['variant']}": r['bucket'] for r in rows}
        if kind == 'c++' and flavor == 'release':
          # A front end crash that the reference has too does not count.
          _, excused = split_crashes(rows)
          preexisting_keys.update(
            f"{r['path']} {r['variant']}" for r in excused)
          with open(ctx.out / 'release-smoke' / 'excused-crashes.txt',
                    'a') as excused_log:
            for r in excused:
              excused_log.write(
                f"{config} {r['path']} [{r['status']}] "
                f"{r.get('message', '')} | excused: "
                f"{_summary.crash_excuse(r)[1]}\n")
    c_rel = results['c-release']
    c_bad = [t for t, b in c_rel.items() if b != 'PASS']
    cx_rel, cx_dbg = results['c++-release'], results['c++-debug']
    regress = [t for t, b in cx_dbg.items()
               if b == 'PASS' and cx_rel.get(t) != 'PASS']
    crashes = [t for t, b in cx_rel.items()
               if b in ('FE_CRASH', 'LIB_CRASH') and
               t not in preexisting_keys]
    gained = sum(1 for t, b in cx_rel.items()
                 if b == 'PASS' and cx_dbg.get(t) != 'PASS')
    problems += [f"{config} C smoke: {t}" for t in c_bad[:3]]
    problems += [f"{config} C++ debug PASS, release not: {t}"
                 for t in regress[:3]]
    problems += [f"{config} C++ crash: {t}" for t in crashes[:3]]
    parts.append(
      f"{config}: C {len(c_rel) - len(c_bad)}/{len(c_rel)}, C++ release "
      f"{sum(1 for b in cx_rel.values() if b == 'PASS')}/{len(cx_rel)} "
      f"(debug {sum(1 for b in cx_dbg.values() if b == 'PASS')}, "
      f"{gained} only in release)")
  return not problems, '; '.join(parts) + (
    f"; PROBLEMS {problems[:4]}" if problems else '')


def step_poison(ctx: Context) -> Tuple[bool, str]:
  '''The writer must not depend on freed front-end memory (region lifetime).

  edg-cir-poison-check compiles with the debug front end (freed IL blocks
  overwritten with 0xdb, expensive checking), the same front end without the
  overwriting (preset linux-gcc-debug-cir-nopoison, built here) and the release
  front end, and requires no crash or assertion and identical streams (the
  release front end must write the same stream as the debug one: the macros
  that change what the front end builds are pinned in cmake/macro-conf/
  default/cpfe-cir.cmakedef): first the C corpus, then the C and C++ smoke
  lists and tests/tests/cir (writer and cirgen), and the C++ corpus.
  '''
  build = (f"export EDG_BASE=/edg/workspace/bases/docker/cir-env/gcc; cmake "
           f"--preset linux-gcc-debug-cir-nopoison -DEDG_CIR_LINK_LIBRARY=ON "
           f"&& cmake --build build/gcc-cir-nopoison --target cpfe-cir "
           f"edg_prelink edg_decode -j{BUILD_JOBS}")
  if in_cir_env(ctx, 'poison', build) != 0:
    return False, 'could not build build/gcc-cir-nopoison'
  commands = [
    f"python3 dev_tools/bin/edg-cir-poison-check -j {BUILD_JOBS} --filters "
    f"{shlex.quote(ctx.args.corpus_filter)} "
    f"--types {ctx.args.types or 'rp,lp'}",
    f"python3 dev_tools/bin/edg-cir-poison-check -j {BUILD_JOBS} --filters "
    f"{shlex.quote(ctx.args.smoke_filter)},"
    f"{shlex.quote(ctx.args.cpp_smoke_filter)},cir/",
    f"python3 dev_tools/bin/edg-cir-poison-check -j {BUILD_JOBS} --filters "
    f"{shlex.quote(ctx.args.cpp_corpus_filter)} --types rp,lp"
  ]
  codes = [in_cir_env(ctx, 'poison', c) for c in commands]
  text = (ctx.out / 'poison' / 'log.txt').read_text()
  results = re.findall(r'RESULT: .*', text)
  counts = re.findall(r'checking (\d+) tests', text)
  detail = ' + '.join(counts) + ' tests; ' + '; '.join(results)
  return not any(codes) and len(results) == 3, detail


def step_cpp_stress(ctx: Context) -> Tuple[bool, str]:
  return _run_cpp_stress(ctx, 'cpp-stress', CPP_STRESS_CASES, 'build/cir')


def step_cpp_stress_asan(ctx: Context) -> Tuple[bool, str]:
