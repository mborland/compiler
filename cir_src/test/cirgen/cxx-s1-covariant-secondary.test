; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s1_cov2_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

