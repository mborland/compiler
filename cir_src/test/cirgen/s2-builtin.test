; S2: `builtin` and allocsize on the allocation functions.  A call that carries
; the CALL flag ALLOC_EXPR (the allocation call of a new-expression, 0x40) to a
; replaceable global operator new is `builtin` (allocation elision) and so is
; the operator delete call the library makes for a scalar DELETE; an explicit
; call of the same function, a call of another function, and the call of a
; placement operator new are not.  The replaceable operator new carries
; allocsize(0) on its declaration and its calls, and a noalias (and, but for
; the nothrow form, nonnull) result.  As clangir at the pin: `builtin
; allocsize(0)` for the new-expression, `builtin nounwind` for the delete.
; RUN: sed 's/^ecil 1.2/ecil 1.3/' %S/Inputs/header12_cxx_eh.txt > %t.h
; RUN: cat %t.h %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --no-llvm-passes --emit=llvm %t.ecil | %FileCheck %s

; CHECK-DAG: declare noalias noundef nonnull ptr @_Znwm(i64 noundef) #[[NEW:[0-9]+]]
; CHECK-DAG: declare noalias noundef ptr @_ZnwmRKSt9nothrow_t(i64 noundef) #[[NT:[0-9]+]]
; CHECK-DAG: declare void @_ZdlPv(ptr noundef) #[[DEL:[0-9]+]]
; CHECK-DAG: declare noundef ptr @_Znwy(i64 noundef)
; CHECK-LABEL: define {{.*}}@main
; CHECK: call noalias noundef nonnull ptr @_Znwm(i64 noundef 8) #[[EXPR:[0-9]+]]
; CHECK: call noalias noundef nonnull ptr @_Znwm(i64 noundef 16) #[[EXPLICIT:[0-9]+]]
; CHECK: call noundef ptr @_Znwy(i64 noundef 8)
; CHECK: call void @_ZdlPv(ptr noundef %{{.*}}) #[[DELCALL:[0-9]+]]
; CHECK-DAG: attributes #[[NEW]] = {{{.*}}nobuiltin{{.*}}allocsize(0)
; CHECK-DAG: attributes #[[EXPR]] = { builtin allocsize(0) }
; CHECK-DAG: attributes #[[EXPLICIT]] = { allocsize(0) }
; CHECK-DAG: attributes #[[DELCALL]] = { builtin nounwind }

frame DECLS
  STR 100 "_Znwm"
  STR 101 "_ZnwmRKSt9nothrow_t"
  STR 102 "_ZdlPv"
  STR 103 "_Znwy"
  STR 104 "main"
  TY_PTR 30 11
  TY_FUNC 40 30 0 [2]
  TY_FUNC 41 11 0 [30]
  TY_FUNC 42 1 0 []
  DECL_FUNC 50 40 0 0 100
  DECL_FUNC 51 40 0 0 101
  DECL_FUNC 52 41 0 128 102
  DECL_FUNC 53 40 0 0 103
  DECL_FUNC 54 42 0 9 104
frame REGION
  FUNC_BEGIN 54 0
  LOCAL 1 30 nil 8 0
  LREF 1
  CONST_INT 2 8
  CALL 50 40 1 64
  STORE 0 0
  CONST_INT 2 16
  CALL 50 40 1 0
  DROP
  CONST_INT 2 8
  CALL 53 40 1 0
  DROP
  LREF 1
  LOAD 0
  DELETE 52 nil 11 0
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
