; C++ (ECIL 1.2, slice S1): a covariant return that needs a result adjustment
; (the Y subobject of Z is at offset 16, so Z::me through Y's vtable is the
; thunk _ZTchn16_h16_N1Z2meEv: this - 16, call, result + 16 with a null check)
; and a variadic function through a secondary vtable (_ZThn16_N1Z2vfEiz, a
; musttail forward with this - 16).
;   struct P2 { virtual int q(); int w; P2(); };
;   struct Y { virtual Y *me(); virtual int vf(int, ...); int y; Y(); };
;   struct Z : P2, Y { Z *me() override; int vf(int n, ...) override; int z;
;                      Z(); };      // Z::me returns this, Z::vf: n + z (z = 3)
;   int main() { Z z; Y *py = &z; return (py->me() != py) + (py->vf(5, 1, 2) - 8); }
; RUN: cat %S/Inputs/header12_cxx_rtti.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; CHECK-LABEL: cir.global {{.*}}@_ZTV1Z = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1Z> : !cir.ptr<!u8i>, #cir.global_view<@_ZN2P21qEv> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1Z2meEv> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1Z2vfEiz> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 5>, #cir.const_array<[#cir.ptr<-16 : i64> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1Z> : !cir.ptr<!u8i>, #cir.global_view<@_ZTchn16_h16_N1Z2meEv> : !cir.ptr<!u8i>, #cir.global_view<@_ZThn16_N1Z2vfEiz> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 4>}>
; CHECK-LABEL: cir.func {{.*}}@_ZTchn16_h16_N1Z2meEv
; CHECK: cir.const #cir.int<-16> : !s64i
; CHECK: cir.call @_ZN1Z2meEv
; CHECK: cir.ternary(
; CHECK: cir.const #cir.int<16> : !s64i
; CHECK-LABEL: cir.func {{.*}}@_ZThn16_N1Z2vfEiz
; CHECK: cir.call @_ZN1Z2vfEiz({{.*}}) musttail nothrow

; SYMS-DAG: T _ZTchn16_h16_N1Z2meEv
; SYMS-DAG: T _ZThn16_N1Z2vfEiz

