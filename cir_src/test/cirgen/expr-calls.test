; Calls: direct, K&R/no_proto call-site types, re-issued declarations (F3),
; indirect, record arguments/results through CallConvLowering, mixed fp.
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe -lm
; RUN: %t.exe

; CHECK-DAG: cir.call @add2({{.*}}) nothrow : (!s32i, !s32i) -> !s32i
; CHECK-DAG: cir.cast bitcast {{.*}} !cir.ptr<!cir.func<(...) -> !s32i>>
; CHECK-DAG: cir.call {{%[0-9]+}}(
; CHECK-DAG: cir.func {{.*}}@knr

