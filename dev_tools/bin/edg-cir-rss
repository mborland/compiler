#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Measure peak memory (RSS) and wall time of the CIR front end on a big TU.

For one input file, runs (each under GNU time, through eccp so that the
options are the ones the tests use):

  inproc      cpfe-cir streaming into the library, regions freed per function
  keep        the same with --ecil_keep_regions (nothing freed)
  2p-fe       cpfe-cir --ecil_output=<file> (the front end of the two-process
              path)
  2p-edg-cir  edg-cir --emit=asm on that file (the back end of the two-process
              path)
  cpfe        plain cpfe (the C-generating back end), for reference

Run it inside the cir-env image from the repository root, after building
build/gcc-cir (cpfe-cir; --fe-build selects another build, e.g.
build/gcc-release-cir: the linux-gcc-release-cir preset, no ASan) and build/cir (edg-cir), and, for the cpfe row,
build/gcc (cpfe):

  edg-exec --img cir-env -- python3 dev_tools/bin/edg-cir-rss big.c
  edg-cir-rss --generate-functions 50000 -o big.c    # make an input first
  edg-cir-rss --generate-cxx-templates 300 -o tmpl.cpp     # template/lambda TU
  edg-cir-rss --cxx --stats tmpl.cpp   # also the region statistics

--stats sets ECIL_STATS=1: the debug front end (build/gcc-cir) then prints
"ecil: function regions N, resident at finish M" for each front end row, the
number of memory regions that survive the streaming (the region keeps of
prototype instantiations, expression trees and lambdas).  Compare the rows
inproc (regions freed per function) and keep (--ecil_keep_regions) and the
peak RSS before and after a change of the keeps.

Output is a table of wall seconds and peak RSS in MB.
'''

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

from pathlib import Path
from typing import Dict, List, Optional, Tuple

TIME_FORMAT = '%e %M'


def load_exports(env_file: Path) -> Dict[str, str]:
  '''Parse the `export NAME="value"` lines of a CMake environment.sh.'''
  exports = {}
  if not env_file.exists():
    return exports
  for line in env_file.read_text().splitlines():
    match = re.match(r'export (\w+)="?([^"]*)"?$', line)
    if match:
      exports[match.group(1)] = match.group(2)
  return exports


def generate_functions(count: int, out_path: Path) -> None:
  '''Write a C file of count functions, with types and global data.'''
  lines = [
    'struct pt { int x; int y; };',
    'struct box { struct pt lo, hi; int tag; };',
    'int total;',
    'int table[64] = { 1, 2, 3, 4, 5, 6, 7, 8 };'
  ]
  for index in range(count):
    lines.append(
      f"static struct box box_{index} = {{ {{ {index}, 1 }}, {{ 2, 3 }}, 7 }};"
    )
    lines.append(f"int f_{index}(int a, int b) {{")
    lines.append(f"  int x = a * {index % 97 + 1} + b;")
    lines.append(f"  struct box local = box_{index};")
    lines.append('  int i;')
    lines.append('  for (i = 0; i < 4; i++) {')
    lines.append('    if (x > 100) x -= 7; else x += 3;')
    lines.append('    x += table[(x + i) & 63] + local.lo.x;')
    lines.append('  }')
    if index > 0:
      lines.append(f"  if (x == -1) x += f_{index - 1}(x, 1);")
    lines.append('  total += x;')
    lines.append('  return x;')
    lines.append('}')
  lines.append('int main(void) { return f_%d(1, 2) < 0; }' % (count - 1))
  out_path.write_text('\n'.join(lines) + '\n')


# The functions a unit of generate_cxx_functions defines (constructors,
# destructor, members, template instances, lambda call operators and the
# initialization function of the namespace-scope variable included).
CXX_FUNCTIONS_PER_UNIT = 20


def generate_cxx_functions(count: int, out_path: Path) -> None:
  '''Write a C++ file of about count functions, M3 features only.

  Every unit has a namespace with a base and a derived class (constructors,
  copy constructor, destructor, member functions), a function template used
  with three types, an inline function, a function with a static local, a
  namespace-scope variable with a dynamic initializer, a lambda, and new and
  delete (single objects and arrays).  No virtual functions, no exceptions.
  main() prints a checksum that does not depend on the compiler.
  '''
  units = max(1, count // CXX_FUNCTIONS_PER_UNIT)
  lines = [
    'extern "C" int printf(const char *, ...);',
    'long g_live = 0;',
    'long g_sum = 0;'
  ]
  for index in range(units):
    lines += [
      f"namespace ns{index} {{",
      '  struct B {',
      '    int a;',
      '    B(int x) : a(x) { ++g_live; }',
      '    B(const B &o) : a(o.a) { ++g_live; }',
      '    ~B() { --g_live; g_sum += a; }',
      '    int get() const { return a; }',
      '  };',
      '  struct D : B {',
      '    int b;',
      '    D(int x) : B(x), b(x + 1) { }',
      '    int sum() const { return get() + b; }',
      '  };',
      '  template <class T> T twice(T v) { return v + v; }',
      f"  inline int inl(int x) {{ return x * 3 + {index % 101}; }}",
      f"  int stat(int x) {{ static int n = {index % 97}; n += x; return n; }}",
      '  int make(int x) {',
      '    D d(x);',
      '    B e(d);',
      '    return d.sum() + e.get() + twice(x) + (int)twice(2L) + '
      '(int)twice((short)3);',
      '  }',
      f"  int dyn_init() {{ return {index % 89} * 2; }}",
      '  int gdyn = dyn_init();',
      '  int lam(int x) {',
      f"    auto f = [x](int y) {{ return x + y + {index % 83}; }};",
      '    return f(2) + f(3);',
      '  }',
      '  int heap(int x) {',
      '    D *p = new D(x);',
      '    int r = p->sum();',
      '    delete p;',
      '    int *a = new int[4];',
      '    for (int k = 0; k < 4; k++) a[k] = x + k;',
      '    r += a[3];',
      '    delete[] a;',
      '    return r;',
      '  }',
      '  int run(int x) { return make(x) + inl(x) + stat(x) + lam(x) + '
      'heap(x) + gdyn; }',
      '}'
    ]
  lines.append('int main() {')
  lines.append('  long total = 0;')
  for index in range(units):
    lines.append(f"  total += ns{index}::run({index % 7});")
  lines += [
    '  printf("%ld %ld %ld\\n", total, g_live, g_sum);',
    '  return 0;',
    '}'
  ]
  out_path.write_text('\n'.join(lines) + '\n')


def generate_cxx_templates(count: int, out_path: Path) -> None:
  '''Write a template- and lambda-heavy C++17 file of `count` units.

  The file stresses what makes the front end keep memory regions: prototype
  instantiations, expression trees that later instantiations refer to, and
  lambda call operators.  Every unit (namespace t<N>) has

    - a class template with member templates, one of them a member class
      template with its own member template (Box::Inner::mix), used with
      several types and non-type arguments (including constexpr results);
    - constexpr functions (a loop in a constexpr function, the result used
      as a non-type template argument and in a static_assert);
    - variadic function templates with pack expansions (an initializer list
      expansion, a fold expression, sizeof...), and a variadic class
      template with a non-type parameter pack;
    - a function template whose body has lambdas: a lambda with a
      capture list, a generic lambda called with three types, an
      init-capture, a lambda in a lambda, and a lambda in a member
      function template;
    - instantiations of all of those with several types.

  No virtual functions, no exceptions.  main() prints a checksum that does
  not depend on the compiler.  Compile it with --c++17 (edg-cir-rss --cxx).
  '''
  lines = [
    'extern "C" int printf(const char *, ...);',
    'unsigned long g_total = 0;'
  ]
  for index in range(max(1, count)):
    lines += [
      f"namespace t{index} {{",
      '  constexpr int cfib(int n) {',
      '    int a = 0, b = 1;',
      '    for (int i = 0; i < n; i++) { int t = a + b; a = b; b = t; }',
      '    return a;',
      '  }',
      f"  constexpr int kc = cfib({5 + index % 7}) + {index % 11};",
      '  static_assert(cfib(10) == 55, "cfib");',
      '  template <class T, int K> struct Box {',
      '    T v;',
      '    Box(T x) : v(x) { }',
      '    template <class U> U conv(U u) const { return u + (U)v + K; }',
      '    template <class U, int M> struct Inner {',
      '      U w;',
      '      Inner(U x) : w(x) { }',
      '      template <class V> V mix(V a) const { return a + (V)w + M + K; }',
      '    };',
      '    template <class U> Inner<U, K + 1> inner(U u) const {',
      '      return Inner<U, K + 1>(u + (U)v);',
      '    }',
      '    template <class U> U apply(U u) const {',
      '      auto g = [this, u](auto a) { return a + (U)v + u; };',
      '      return g(u) + (U)g(1) + (U)g(2L);',
      '    }',
      '  };',
      '  template <int... Ns> struct Sum {',
      '    static constexpr int value = (Ns + ... + 0);',
      '    static constexpr int count = sizeof...(Ns);',
      '  };',
      '  template <class... Ts> long fsum(Ts... ts) {',
      '    long r = 0;',
      '    int dummy[] = { 0, (r += (long)ts, 0)... };',
      '    (void)dummy;',
      '    return r + (long)sizeof...(Ts);',
      '  }',
      '  template <class... Ts> long ffold(Ts... ts) {',
      '    return (0L + ... + (long)ts);',
      '  }',
      '  template <class T> T run_t(T x) {',
      f"    Box<T, kc % 5 + {index % 3}> b(x);",
      '    int base = 3;',
      '    auto add = [&](auto a) { return a + b.v; };',
      '    auto mul = [x](T y) { return (T)(x * y); };',
      '    auto init = [k = x + 1](int d) { return k + d; };',
      '    auto nest = [&](auto a) {',
      '      auto inner = [a, base](auto c) { return a + c + base; };',
      '      return inner(a) + inner((T)1);',
      '    };',
      '    return add(x) + mul(x) + b.conv(x) + b.inner(x).mix(x) +',
      '           b.apply(x) + (T)init(2) + nest(x) + (T)fsum(x, 1, 2L) +',
      '           (T)ffold(x, (short)3);',
      '  }',
      '  unsigned long run(int x) {',
      '    unsigned long r = 0;',
      '    r += (unsigned long)run_t<int>(x);',
      '    r += (unsigned long)run_t<long>(x + 1);',
      '    r += (unsigned long)run_t<short>((short)x);',
      '    r += (unsigned long)Sum<1, 2, 3, kc % 4>::value;',
      '    r += (unsigned long)Sum<1, 2>::count;',
      '    r += (unsigned long)fsum(x, 2L, (short)3, 4u);',
      '    r += (unsigned long)ffold(x, 5L, 6);',
      '    return r;',
      '  }',
      '}'
    ]
  lines.append('int main() {')
  for index in range(max(1, count)):
    lines.append(f"  g_total += t{index}::run({index % 7});")
  lines += [
    '  printf("%lu\\n", g_total);',
    '  return 0;',
    '}'
  ]
  out_path.write_text('\n'.join(lines) + '\n')


def run_timed(command: List[str], env: Dict[str, str], cwd: Path,
              label: str) -> Tuple[Optional[float], Optional[float], int,
                                   str]:
  '''Run command under /usr/bin/time; return (seconds, MB, rc, stderr).'''
  with tempfile.NamedTemporaryFile('r', suffix = '.time') as stats:
    proc = subprocess.run(
      ['/usr/bin/time', '-f', TIME_FORMAT, '-o', stats.name, *command],
      cwd = cwd,
      env = env,
      stdout = subprocess.PIPE,
      stderr = subprocess.STDOUT,
      text = True
    )
    text = stats.read().strip().splitlines()
  seconds: Optional[float] = None
  megabytes: Optional[float] = None
  if text:
    parts = text[-1].split()
    if len(parts) == 2:
      seconds = float(parts[0])
      megabytes = float(parts[1]) / 1024.0
  return seconds, megabytes, proc.returncode, proc.stdout


def make_wrapper(path: Path, body: str) -> Path:
  path.write_text('#!/bin/sh\n' + body + '\n')
  path.chmod(0o755)
  return path


def main() -> None:
  parser = argparse.ArgumentParser(description = __doc__.split('\n')[0])
  parser.add_argument('input', nargs = '?', help = 'the C file to compile')
  parser.add_argument('--generate-functions', type = int, default = 0,
                      help = 'write a generated input with this many '
                             'functions to -o and exit')
  parser.add_argument('--generate-cxx-functions', type = int, default = 0,
                      help = 'write a generated C++ input (M3 features: '
                             'classes with constructors, bases, templates, '
                             'statics, dynamic initialization, lambdas, '
                             'new/delete) with about this many functions '
                             'to -o and exit')
  parser.add_argument('--generate-cxx-templates', type = int, default = 0,
                      metavar = 'N',
                      help = 'write a generated template- and lambda-heavy '
                             'C++17 input of N units (class templates with '
                             'member templates, generic and non-generic '
                             'lambdas, constexpr functions, non-type '
                             'arguments, pack expansions; about 40 '
                             'functions and instances per unit) to -o and '
                             'exit; measure it with --cxx and --stats')
  parser.add_argument('--stats', action = 'store_true',
                      help = 'set ECIL_STATS=1 and print the writer\'s '
                             'region statistics ("ecil: function regions N, '
                             'resident at finish M", debug front end '
                             'only) of the front end rows')
  parser.add_argument('-o', dest = 'output', default = 'big.c')
  parser.add_argument('--cxx', action = 'store_true',
                      help = 'the input is C++ (compile it with --c++17)')
  parser.add_argument('--root', default = '.', help = 'repository root')
  parser.add_argument('--fe-build', default = 'build/gcc-cir',
                      help = 'build directory of the cpfe-cir to measure '
                             '(build/gcc-release-cir: no ASan, '
                             'OVERWRITE_FREED_MEM_BLOCKS off)')
  parser.add_argument('--only', default = '',
                      help = 'comma separated rows to run')
  parser.add_argument('--level', type = int, default = 0, choices = range(4),
                      help = 'optimization level: --cir_opt_level of the '
                             'front end rows and -O of edg-cir (default 0)')
  args = parser.parse_args()

  if args.generate_cxx_functions:
    generate_cxx_functions(args.generate_cxx_functions, Path(args.output))
    print(f"wrote {args.output}")
    return
  if args.generate_cxx_templates:
    generate_cxx_templates(args.generate_cxx_templates, Path(args.output))
    print(f"wrote {args.output}")
    return
  if args.generate_functions:
    generate_functions(args.generate_functions, Path(args.output))
    print(f"wrote {args.output}")
    return
  if not args.input:
    parser.error('an input file is required')

  root = Path(args.root).resolve()
  source = Path(args.input).resolve()
  cir_env = load_exports(root / args.fe_build / 'environment.sh')
  plain_env = load_exports(root / 'build/gcc/environment.sh')
  cpfe_cir = cir_env.get('CPFE_CIR')
  edg_cir = cir_env.get('EDG_CIR_TOOL')
  rows = args.only.split(',') if args.only else [
    'inproc', 'keep', '2p-fe', '2p-edg-cir', 'cpfe'
  ]

  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-rss.'))
  stats_lines: List[str] = []
  results: List[Tuple[str, Optional[float], Optional[float], int]] = []
  try:
    base_env = dict(os.environ)
    base_env.update(cir_env)
    base_env['EDG_BASE'] = str(root / 'bases/docker/cir-env/gcc')
    if args.stats:
      base_env['ECIL_STATS'] = '1'
    base_env['ECCP_LIBDIR'] = str(Path(cir_env.get('EDG_CIR_RT_LIBDIR', '')))
    eccp = str(root / 'util/eccp.sh')
    timed_fe = make_wrapper(
      work / 'cpfe-cir-timed',
      f"exec /usr/bin/time -f '{TIME_FORMAT}' -a -o {work}/fe.time "
      f"{cpfe_cir} \"$@\""
    )

    def eccp_fe_only(env: Dict[str, str], extra: str = '') -> List[str]:
      # C mode (C++ with --cxx: use a file of --generate-cxx-functions).
      return [eccp, '-S', '--c++17' if args.cxx else '--c11',
              *extra.split(), str(source)]


    def note_stats(row: str, proc: 'subprocess.CompletedProcess') -> None:
      stats_lines.extend(f"{row}: {line}" for line in proc.stdout.splitlines()
                         if line.startswith('ecil:'))

    level_option = f" --cir_opt_level={args.level}" if args.level else ''
    for row in rows:
      env = dict(base_env)
      if level_option:
        # (eccp does not take the option itself: it goes in the defaults.)
        env['EDG_CPFE_DEFAULT_OPTIONS'] = level_option.strip()
      (work / 'fe.time').write_text('')
      if row in ('inproc', 'keep'):
        env['CPFE'] = str(timed_fe)
        if row == 'keep':
          env['EDG_CPFE_DEFAULT_OPTIONS'] = '--ecil_keep_regions' + \
            level_option
        proc = subprocess.run(eccp_fe_only(env), cwd = work, env = env,
                              stdout = subprocess.PIPE,
                              stderr = subprocess.STDOUT, text = True)
        note_stats(row, proc)
        stats = (work / 'fe.time').read_text().strip().splitlines()
        parts = stats[-1].split() if stats else []
        results.append((row,
                        float(parts[0]) if len(parts) == 2 else None,
                        float(parts[1]) / 1024 if len(parts) == 2 else None,
                        proc.returncode))
      elif row == '2p-fe':
        env['CPFE'] = str(timed_fe)
        env['EDG_CPFE_DEFAULT_OPTIONS'] = (f"--ecil_output={work}/x.ecil" +
                                           level_option)
        proc = subprocess.run(eccp_fe_only(env), cwd = work, env = env,
                              stdout = subprocess.PIPE,
                              stderr = subprocess.STDOUT, text = True)
        note_stats(row, proc)
        stats = (work / 'fe.time').read_text().strip().splitlines()
        parts = stats[-1].split() if stats else []
        results.append((row,
                        float(parts[0]) if len(parts) == 2 else None,
                        float(parts[1]) / 1024 if len(parts) == 2 else None,
                        proc.returncode))
      elif row == '2p-edg-cir':
        seconds, megabytes, rc, output = run_timed(
          [edg_cir or 'edg-cir', f"-O{args.level}", '--emit=asm', '-o',
           str(work / 'x.s'),
           str(work / 'x.ecil')], env, work, row
        )
        results.append((row, seconds, megabytes, rc))
      elif row == 'cpfe':
        cpfe = plain_env.get('CPFE')
        if not cpfe or not Path(cpfe).exists():
          print('cpfe row skipped: build/gcc/bin/cpfe is missing')
          continue
        env = dict(os.environ)
        env.update(plain_env)
        env['EDG_BASE'] = str(root / 'bases/docker/dev-env/gcc')
        plain = make_wrapper(
          work / 'cpfe-timed',
          f"exec /usr/bin/time -f '{TIME_FORMAT}' -a -o {work}/fe.time "
          f"{cpfe} \"$@\""
        )
        env['CPFE'] = str(plain)
        proc = subprocess.run(eccp_fe_only(env), cwd = work, env = env,
                              stdout = subprocess.PIPE,
                              stderr = subprocess.STDOUT, text = True)
        stats = (work / 'fe.time').read_text().strip().splitlines()
        parts = stats[-1].split() if stats else []
        results.append((row,
                        float(parts[0]) if len(parts) == 2 else None,
                        float(parts[1]) / 1024 if len(parts) == 2 else None,
                        proc.returncode))
  finally:
    shutil.rmtree(work, ignore_errors = True)

  lines = source.read_text().count('\n')
  print(f"input: {source} ({lines} lines, "
        f"{source.stat().st_size // 1024} KB)")
  if args.level:
    print(f"optimization level -O{args.level}")
  print(f"{'mode':<12} {'wall s':>8} {'peak RSS MB':>12} {'rc':>4}")
  for row, seconds, megabytes, rc in results:
    wall = f"{seconds:.2f}" if seconds is not None else 'n/a'
    rss = f"{megabytes:.0f}" if megabytes is not None else 'n/a'
    print(f"{row:<12} {wall:>8} {rss:>12} {rc:>4}")
  for line in stats_lines:
    print(line)


if __name__ == '__main__':
  main()
