; C++ (ECIL 1.2, slice S1): virtual destructors and their thunks.  C derives
; from A (primary) and P (at 16) and has a virtual destructor, so the vtable
; group of C has, for the P subobject, the thunks _ZThn16_N1CD1Ev and
; _ZThn16_N1CD0Ev (this - 16, then the complete or the deleting destructor of C),
; emitted with C's destructors.  Deleting a C through a P* runs D0 through the
; secondary vtable (slot 1 of P's table, the one after D1's): ~C (100), ~P (10),
; ~A (1), then operator delete with the size of C.
;   struct A { virtual ~A(); int a; A(); };  struct P { virtual ~P(); int p; P(); };
;   struct C : A, P { ~C(); int c; C(); };
;   int main() { C *c = new C; P *p = c; delete p; return g_d - 111; }
; RUN: cat %S/Inputs/header12_cxx_rtti.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS
; The attributes (S2 round 2): D0 is mustprogress (a C++11 function) and its
; operator delete call has noundef arguments and `builtin nounwind`; a thunk
; has noundef on its parameter and the nounwind of its target; main of C++ is
; norecurse.
; RUN: %edg-cir --no-llvm-passes --emit=llvm %t.ecil | %FileCheck %s --check-prefix=ATTRS

; CHECK-LABEL: cir.global {{.*}}@_ZTV1C = #cir.vtable<{#cir.const_array<[#cir.ptr<null> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1C> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1CD1Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZN1CD0Ev> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 4>, #cir.const_array<[#cir.ptr<-16 : i64> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1C> : !cir.ptr<!u8i>, #cir.global_view<@_ZThn16_N1CD1Ev> : !cir.ptr<!u8i>, #cir.global_view<@_ZThn16_N1CD0Ev> : !cir.ptr<!u8i>]> : !cir.array<!cir.ptr<!u8i> x 4>}>
; CHECK-LABEL: cir.func {{.*}}@main
; CHECK: cir.vtable.get_virtual_fn_addr {{.*}}[1]
; CHECK-DAG: cir.func {{.*}}@_ZThn16_N1CD1Ev(
; CHECK-DAG: cir.func {{.*}}@_ZThn16_N1CD0Ev(

; SYMS-DAG: T _ZThn16_N1CD1Ev
; SYMS-DAG: T _ZThn16_N1CD0Ev
; SYMS-DAG: T _ZN1CD0Ev

; ATTRS: define dso_local void @_ZN1CD0Ev(ptr noundef %{{[0-9]+}}) #[[D0:[0-9]+]]
; ATTRS: call void @_ZdlPvm(ptr noundef %{{.*}}, i64 noundef 32) #[[DEL:[0-9]+]]
; ATTRS: define dso_local noundef i32 @main() #[[MAIN:[0-9]+]]
; ATTRS: define dso_local void @_ZThn16_N1CD1Ev(ptr noundef %{{[0-9]+}}) #[[THUNK:[0-9]+]]
; ATTRS-DAG: attributes #[[D0]] = { mustprogress nounwind uwtable }
; ATTRS-DAG: attributes #[[DEL]] = { builtin nounwind }
; ATTRS-DAG: attributes #[[MAIN]] = { mustprogress norecurse nounwind uwtable }
; ATTRS-DAG: attributes #[[THUNK]] = { nounwind uwtable }

