; S2: argument attributes (key 15 noundef/nonnull/dereferenceable/align, noundef
; on the other parameters) stay with their parameters when CallConvLowering
; changes the signature.  The stream is the ECIL writer's output for
;
;   struct Big { long a, b, c; };  struct Pair { long a, b; };
;   struct A { int x; Big m(int &r); };  struct V : virtual A { V(int &r); };
;   Big A::m(int &r);  long takes(Big b, int &r);  long takesp(Pair p, int &r);
;
; (the masks of key 15 added: bit 1 the object parameter, bit 2 the reference
; after it).  Checked on definitions and on calls:
;  - an sret result is inserted before `this` (A::m): the object parameter and
;    the reference keep their attributes, the sret pointer has its own;
;  - a record passed in memory (Big, byval) before a reference: noundef byval
;    on the copy, the reference is unchanged;
;  - a record expanded into two scalars (Pair) before a reference: the
;    scalars have no attribute, the reference is still the third parameter;
;  - the hidden VTT parameter of a base constructor (V::C2) sits between
;    `this` and the reference: noundef only.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --no-llvm-passes --emit=llvm %t.ecil | %FileCheck %s

; CHECK: define dso_local void @_ZN1A1mERi(ptr dead_on_unwind noalias writable sret(%struct.Big) align 8 %0, ptr noundef nonnull align 4 dereferenceable(4) %1, ptr noundef nonnull align 4 dereferenceable(4) %2)
; CHECK: define dso_local noundef i64 @_Z5takes3BigRi(ptr noundef byval(%struct.Big) align 8 %0, ptr noundef nonnull align 4 dereferenceable(4) %1)
; CHECK: define dso_local noundef i64 @_Z6takesp4PairRi(i64 %0, i64 %1, ptr noundef nonnull align 4 dereferenceable(4) %2)
; CHECK: define dso_local void @_ZN1VC1ERi(ptr noundef nonnull align 8 dereferenceable(8) %0, ptr noundef nonnull align 4 dereferenceable(4) %1)
; CHECK: define dso_local void @_ZN1VC2ERi(ptr noundef nonnull align 8 dereferenceable(8) %0, ptr noundef %1, ptr noundef nonnull align 4 dereferenceable(4) %2)
; CHECK: define dso_local noundef i32 @main()
; CHECK: call void @_ZN1A1mERi(ptr dead_on_unwind writable sret(%struct.Big) align 8 %{{.*}}, ptr noundef nonnull align 4 dereferenceable(4) %{{.*}}, ptr noundef nonnull align 4 dereferenceable(4) %{{.*}})
; CHECK: call void @_ZN1VC1ERi(ptr noundef nonnull align 8 dereferenceable(8) %{{.*}}, ptr noundef nonnull align 4 dereferenceable(4) %{{.*}})
; CHECK: call noundef i64 @_Z5takes3BigRi(ptr noundef byval(%struct.Big) align 8 %{{.*}}, ptr noundef nonnull align 4 dereferenceable(4) %{{.*}})
; CHECK: call noundef i64 @_Z6takesp4PairRi(i64 %{{.*}}, i64 %{{.*}}, ptr noundef nonnull align 4 dereferenceable(4) %{{.*}})

ecil 1.2 features=0x0000000a
frame HEADER
  STR 1 "x86_64-unknown-linux-gnu"
  STR 2 ""
  STR 3 "EDG C/C++ front end 7.0 (ECIL writer)"
  STR 4 "aas_t.cc"
  TY_INT 1 32 true 4 4
  TY_INT 2 64 false 8 8
  TY_INT 3 64 true 8 8
  HDR_TARGET 1 2 nil 64 64 6
  HDR_LANG 1 201703 14
  HDR_PRODUCER 3 4
  HDR_TYPE_ROLE 3 1
  HDR_TYPE_ROLE 1 2
  HDR_TYPE_ROLE 2 3
frame REGION supp
  STR 5 "Big"
  TY_RECORD_DECL 4 0 5
  STR 6 "A"
  TY_RECORD_DECL 5 0 6
  TY_PTR 6 5
  TY_PTR 7 1
  TY_FUNC 8 4 0 [6, 7] supp{15: 6}
  STR 7 "a"
  STR 8 "b"
  STR 9 "c"
  TY_RECORD_BODY 4 24 24 8 0 3
  REC_FIELD 3 0 nil nil 7 0
  REC_FIELD 3 8 nil nil 8 0
  REC_FIELD 3 16 nil nil 9 0
  STR 10 "x"
  TY_RECORD_BODY 5 4 4 4 0 1
  REC_FIELD 1 0 nil nil 10 0
  STR 11 "_ZN1A1mERi"
  DECL_FUNC 9 8 0 0 11
  DECL_FUNC 9 8 0 1 11
  STR 12 "this"
  STR 13 "r"
  FUNC_BEGIN 9 0
  PARAM 1 6 6 12 1
  PARAM 2 7 7 13 0
  BLOCK_BEGIN
  LOCAL 3 4 8 0 0
  LREF 3
  AGG_INIT_BEGIN 4 0
  AGG_SEL 0
  LREF 2
