; Integer operators, narrowing/widening casts and comparisons, run on the
; box.  Expected values were computed by hand.
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe -lm
; RUN: %t.exe

; CHECK-DAG: cir.add nsw {{.*}} : !s32i
; CHECK-DAG: cir.mul nsw
; CHECK-DAG: cir.div
; CHECK-DAG: cir.rem
; CHECK-DAG: cir.shift(left
; CHECK-DAG: cir.shift(right
; CHECK-DAG: cir.or
; CHECK-DAG: cir.xor
; CHECK-DAG: cir.minus nsw
; CHECK-DAG: cir.add {{%[0-9]+}}, {{%[0-9]+}} : !u32i
; CHECK-DAG: cir.cmp lt
; CHECK-DAG: cir.cast integral

