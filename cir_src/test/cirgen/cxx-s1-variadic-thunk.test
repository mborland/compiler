ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S1 review item 6): a variadic virtual function called through
; a non-primary base (a musttail this-adjusting thunk) with int and double
; arguments in the variable part; the result is compared with the expected
; sum.  clang sets the LLVM "thunk" attribute only on unprototyped thunks, which
; this thunk is not.
;   struct B { virtual double vb(int n, ...); };
;   struct C : A, B { double vb(int n, ...) override; };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK: cir.func {{.*}}@_ZThn{{[0-9]+}}_N1C2vbEiz
; CHECK: cir.call @_ZN1C2vbEiz({{.*}}) {{.*}}musttail

