ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): two translation units with virtual bases.  The
; classes V, L : virtual V, R : virtual V and X : L, R, their constructors,
; destructors, vtables, VTTs, construction vtables and typeinfo are compiled
; here; a g++ translation unit and a clang one (Inputs/s2_host.cpp) construct
; X objects, derive H : L, R (their own VTT and construction vtables calling
; this unit's base-variant constructors), K : X and a class that shares V
; virtually with L, and dispatch virtual calls both ways, through this unit's
; virtual thunks and theirs.
;   (the library source is the writer's input: scratchpad t1_lib.cpp)
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s2_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s2_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe
