#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Reproducible performance measurement of the CIR front end and library.

The primary metric is the number of user-mode instructions executed (valgrind
cachegrind `Ir`, because perf is not usable in the containers and the x86-64
box is shared, so times vary with the load; instruction counts do not).  CPU
time (user + system) and peak RSS are measured in separate native runs.

Two measurements, both with the non-ASan release front end
(build/gcc-release-cir) and the library tools of build/cir:

  big     one generated C file of many functions (edg-cir-rss's generator,
          6000 functions by default) in four configurations: `2p-fe` (the
          front end writing an ECIL file), `2p-edg-cir` (edg-cir on that
          file), `inproc` (front end with the library in-process) and `keep`
          (`inproc` with --ecil_keep_regions)
  cxx     a generated C++ file (--cxx-functions, about 6000 functions of M3
          features: classes with constructors and bases, templates, statics,
          dynamic initialization, lambdas, new/delete) in the same four
          configurations, plus the C generating path (`cgen-fe`: the default
          cpfe, `cgen-total`: cpfe and gcc on the generated C; --cgen-build)
  streams (--stream) edg-cir alone on stream files or generated streams (the
          C++ shapes the front end cannot write yet): instructions, CPU time,
          peak RSS
  corpus  the sum over every test case of a filter list (the C corpus):
          `fe` (the front end writing the ECIL stream, the work of the writer)
          and `cir` (edg-cir on the saved stream, the work of the library)

  big -O2 / cxx -O2 (--levels 0,2)  the same two measurements with
          --cir_opt_level=2 in the front end and `edg-cir -O2`, stored as
          `big_O2` and `big_cxx_O2`
  realworld  header-heavy translation units of dev_tools/cir-realworld
          (libstdc++: containers, algorithms, iostream, regex, chrono,
          functional, memory; Boost, with --boost-include: container,
          algorithm, lexical_cast, multiprecision, format, range,
          circular_buffer, mp11) at -O0 and -O2 (--levels): ours (the
          front end under cachegrind, then edg-cir: instructions and
          the minimum wall time), `clang` and `clang -fclangir` (the minimum
          wall and CPU time of the whole compiler; with
          --clang-instructions also its instructions, under valgrind, which
          is slow), for information.  A unit that CIR cannot compile is listed with its
          error and not measured; the clang rows are made anyway

Run it inside the cir-env image from the repository root, after building
cir_src (build/cir) and the release front end:

  edg-exec --img cir-env -- python3 dev_tools/bin/edg-cir-perf \\
      --json perf.json -j 12
  edg-exec --img cir-env -- python3 dev_tools/bin/edg-cir-perf \\
      --json perf-after.json --baseline perf.json

The targets of a slice (m5_design.md section 9) are checked with --targets
NAME (S1: `s1`) against --baseline: the library instructions (cir_ir) of
every pinned real-world unit (PINNED_UNITS, measured with --only realworld
--units pinned --levels 0,2 --boost-include DIR) at most 70% of the baseline's
and those of the generated 6000-function C++ unit (--only cxx, edg-cir alone)
at most 90% at -O0 (at -O2 it is reported, not gated); a pinned unit that
stops compiling, or was not measured, fails.
The exit status is 1 if a target is missed.  The baseline needs the same
sections (the real-world one included).

With --baseline the before/after table is printed too (`--table-only` prints
it for two existing JSON files without measuring: --baseline and --json).
Instruction counts of the same commit repeat exactly, so a difference of the
corpus or big-file counts between commits is real.  The corpus numbers
are the sums over the cases that compile in both runs.  Use --sample N to
measure every Nth test only (for trying the script).
'''

import argparse
import concurrent.futures
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

from pathlib import Path
from typing import Dict, List, Optional, Tuple

VALGRIND = ['valgrind', '--tool=cachegrind', '--cache-sim=no', '-q']
STANDARD_OPTIONS = [
  '-DTEST_NUMBER=1', '--gnu_version=999999', '-e', '200', '--no_wrap',
  '--no_wrap_diagnostics', '--gcc'
]
BIG_ROWS = ('2p-fe', '2p-edg-cir', 'inproc', 'keep')


def load_exports(env_file: Path) -> Dict[str, str]:
  '''Parse the `export NAME="value"` lines of a CMake environment.sh.'''
  exports = {}
  if env_file.exists():
    for line in env_file.read_text().splitlines():
      match = re.match(r'export (\w+)="?([^"]*)"?$', line)
      if match:
        exports[match.group(1)] = match.group(2)
  return exports


def cachegrind_total(path: Path) -> int:
  '''The `summary:` instruction count of a cachegrind output file.'''
  total = 0
  for line in path.read_text().splitlines():
    if line.startswith('summary:'):
      total = int(line.split()[1])
  return total


# Runs a command and appends `wall user system maxrss_kb` of it to a file:
# GNU time reports CPU time only in 10 ms steps, too coarse for these runs.
TIMER_SOURCE = '''
import os, subprocess, sys, time
start = time.time()
child = subprocess.Popen(sys.argv[2:])
_, status, usage = os.wait4(child.pid, 0)
with open(sys.argv[1], 'a') as out:
  out.write(f"{time.time() - start:.6f} {usage.ru_utime:.6f} "
            f"{usage.ru_stime:.6f} {usage.ru_maxrss}\\n")
sys.exit(os.waitstatus_to_exitcode(status))
'''


def make_wrapper(path: Path, body: str) -> Path:
  path.write_text('#!/bin/sh\n' + body + '\n')
  path.chmod(0o755)
  return path


class Tools:
  '''The wrappers around the front end that count instructions or time it.

  The wrappers append to files in the directory named by the environment
  variable EDG_PERF_DIR, which differs per measured run.
  '''

  def __init__(self, root: Path, fe_build: str, work: Path) -> None:
    self.root = root
    exports = load_exports(root / fe_build / 'environment.sh')
    self.exports = exports
    self.cpfe_cir = exports['CPFE_CIR']
    self.edg_cir = exports['EDG_CIR_TOOL']
    self.eccp = str(root / 'util/eccp.sh')
    self.env = dict(os.environ)
    self.env.update(exports)
    self.env['EDG_BASE'] = str(root / 'bases/docker/cir-env/gcc')
    self.env['ECCP_LIBDIR'] = exports.get('EDG_CIR_RT_LIBDIR', '')
    # valgrind spends seconds on the debug info and symbols of the 400 MB
    # library per run; the instruction counts do not depend on them.
    stripped = work / 'stripped'
    stripped.mkdir()
    library = Path(exports['EDG_CIR_LIB'])
    subprocess.run(['strip', '--strip-all', '-o',
                    str(stripped / library.name), str(library)], check = True)
    self.counted_env = dict(self.env)
    self.counted_env['LD_LIBRARY_PATH'] = str(stripped)
    self.timer = work / 'timer.py'
    self.timer.write_text(TIMER_SOURCE)
    valgrind = ' '.join(VALGRIND)
    self.fe_counted = make_wrapper(
      work / 'fe-counted',
      f"LD_LIBRARY_PATH={stripped} exec {valgrind} "
      f"--cachegrind-out-file=\"$EDG_PERF_DIR/fe.$$.cg\" "
      f"{self.cpfe_cir} \"$@\""
    )
    self.fe_timed = make_wrapper(
      work / 'fe-timed',
      f"exec {sys.executable} {self.timer} \"$EDG_PERF_DIR/fe.time\" "
      f"{self.cpfe_cir} \"$@\""
    )


def read_times(path: Path) -> Tuple[float, float, float]:
  '''(wall s, CPU s, peak RSS MB) summed over the lines of a time file.

  Lines are `wall user system maxrss_kb`; the peak RSS is the maximum.
  '''
  wall = cpu = rss = 0.0
  if path.exists():
    for line in path.read_text().splitlines():
      parts = line.split()
      if len(parts) == 4:
        try:
          values = [float(p) for p in parts]
        except ValueError:
          continue
        wall += values[0]
        cpu += values[1] + values[2]
        rss = max(rss, values[3] / 1024.0)
  return wall, cpu, rss


def run_eccp(tools: Tools, wrapper: Path, source: Path, options: List[str],
             work: Path, extra_env: Dict[str, str]) -> int:
  '''Compile source through eccp -S with the front end replaced by wrapper.'''
  env = dict(tools.env)
  env['CPFE'] = str(wrapper)
  env['EDG_PERF_DIR'] = str(work)
  env.update(extra_env)
  proc = subprocess.run(
    [tools.eccp, '-S', *options, source.name], cwd = work, env = env,
    stdout = subprocess.PIPE, stderr = subprocess.STDOUT, text = True
  )
  return proc.returncode


def count_edg_cir(tools: Tools, stream: Path, work: Path, level: int = 0
                  ) -> Tuple[int, int]:
  '''(instructions, rc) of edg-cir --emit=asm on a stream, under cachegrind.'''
  out = work / 'cir.cg'
  proc = subprocess.run(
    [*VALGRIND, f"--cachegrind-out-file={out}", tools.edg_cir, f"-O{level}",
     '--emit=asm', '-o', str(work / 'cir.s'), str(stream)],
    cwd = work, env = tools.counted_env, stdout = subprocess.PIPE,
    stderr = subprocess.STDOUT, text = True
  )
  return (cachegrind_total(out) if out.exists() else 0), proc.returncode


_STATS_REGEX = re.compile(
  r'stats: (\d+) G-ids .*?, (\d+) symbol renames, (\d+) substitution walks')


def read_edg_cir_stats(tools: Tools, stream: Path, work: Path
                       ) -> Dict[str, int]:
  '''The G-id, rename and walk counts of `edg-cir --stats` on a stream.'''
  proc = subprocess.run(
    [tools.edg_cir, '--emit=asm', '--stats', '-o', str(work / 'stats.s'),
     str(stream)],
    cwd = work, env = tools.env, stdout = subprocess.PIPE,
    stderr = subprocess.STDOUT, text = True
  )
  match = _STATS_REGEX.search(proc.stdout)
  if not match:
    return {}
  return {'cir_gids': int(match.group(1)), 'cir_renames': int(match.group(2)),
          'cir_walks': int(match.group(3))}


def time_edg_cir(tools: Tools, stream: Path, work: Path, level: int = 0
                 ) -> None:
  subprocess.run(
    [sys.executable, str(tools.timer), str(work / 'cir.time'),
     tools.edg_cir, f"-O{level}", '--emit=asm', '-o',
     str(work / 'cir.s'), str(stream)],
    cwd = work, env = tools.env, stdout = subprocess.DEVNULL,
    stderr = subprocess.DEVNULL
  )


def measure_big(tools: Tools, source: Path, repeat: int,
                flags: Optional[List[str]] = None, level: int = 0
                ) -> Dict[str, dict]:
  '''Measure the four configurations of the big file (flags: C or C++), at
  an optimization level (the front end's --cir_opt_level and edg-cir's -O).'''
  flags = flags or ['--c11']
  results: Dict[str, dict] = {}
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf-big.'))
  try:
    stream = work / 'big.ecil'
    for row in BIG_ROWS:
      times = []
      if row == '2p-edg-cir':
        if not stream.exists():
          continue
        ir, rc = count_edg_cir(tools, stream, work, level)
        for _ in range(repeat):
          (work / 'cir.time').unlink(missing_ok = True)
          time_edg_cir(tools, stream, work, level)
          times.append(read_times(work / 'cir.time'))
      else:
        extra = {}
        if row == '2p-fe':
          extra['EDG_CPFE_DEFAULT_OPTIONS'] = f"--ecil_output={stream}"
        elif row == 'keep':
          extra['EDG_CPFE_DEFAULT_OPTIONS'] = '--ecil_keep_regions'
        if level:
          extra['EDG_CPFE_DEFAULT_OPTIONS'] = (
            extra.get('EDG_CPFE_DEFAULT_OPTIONS', '') +
            f" --cir_opt_level={level}").strip()
        # Run 0 counts instructions; the others time the same command.
        for index in range(repeat + 1):
          run_dir = work / f"{row}-{index}"
          run_dir.mkdir()
          shutil.copy2(source, run_dir / source.name)
          wrapper = tools.fe_counted if index == 0 else tools.fe_timed
          rc = run_eccp(tools, wrapper, run_dir / source.name, flags,
                        run_dir, extra)
          if index == 0:
            ir = sum(cachegrind_total(p) for p in run_dir.glob('fe.*.cg'))
            first_rc = rc
          else:
            times.append(read_times(run_dir / 'fe.time'))
        rc = first_rc
      # Wall and CPU time: the minimum over the repeats; RSS: the maximum.
      results[row] = {
        'ir': ir, 'rc': rc, 'wall_s': round(min(t[0] for t in times), 3),
        'cpu_s': round(min(t[1] for t in times), 3),
        'rss_mb': round(max(t[2] for t in times), 1)
      }
  finally:
    shutil.rmtree(work, ignore_errors = True)
  return results


def measure_cgen(tools: Tools, cgen_build: str, source: Path, repeat: int,
                 flags: List[str]) -> Dict[str, dict]:
  '''The C-generating path: the default cpfe (C code generation) on the
  source, then gcc on the generated C (eccp -c with the dev-env base).

  `cgen-fe` is the front end alone (instructions, CPU time and peak RSS of
  cpfe), `cgen-total` the whole eccp run including the gcc compilation of
  the generated C (CPU time of all processes; peak RSS of the largest).
  '''
  root = tools.root
  exports = load_exports(root / cgen_build / 'environment.sh')
  if not exports.get('CPFE') or not Path(exports['CPFE']).exists():
    return {}
  env = dict(os.environ)
  env.update(exports)
  env['EDG_BASE'] = str(root / 'bases/docker/dev-env/gcc')
  env['ECCP_LIBDIR'] = exports.get('ECCP_LIBDIR', '')
  results: Dict[str, dict] = {}
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf-cgen.'))
  try:
    valgrind = ' '.join(VALGRIND)
    counted = make_wrapper(
      work / 'cgen-counted',
      f"exec {valgrind} --cachegrind-out-file=\"$EDG_PERF_DIR/fe.$$.cg\" "
      f"{exports['CPFE']} \"$@\"")
    timed = make_wrapper(
      work / 'cgen-timed',
      f"exec {sys.executable} {tools.timer} \"$EDG_PERF_DIR/fe.time\" "
      f"{exports['CPFE']} \"$@\"")
    plain = make_wrapper(work / 'cgen-plain',
                         f"exec {exports['CPFE']} \"$@\"")

    def run(wrapper: Path, run_dir: Path, outer_timer: bool) -> int:
      run_env = dict(env)
      run_env['CPFE'] = str(wrapper)
      run_env['EDG_PERF_DIR'] = str(run_dir)
      command = [tools.eccp, '-c', *flags, source.name]
      if outer_timer:
        command = [sys.executable, str(tools.timer),
                   str(run_dir / 'total.time'), *command]
      return subprocess.run(command, cwd = run_dir, env = run_env,
                            stdout = subprocess.DEVNULL,
                            stderr = subprocess.DEVNULL).returncode

    def fresh(name: str) -> Path:
      run_dir = work / name
      run_dir.mkdir()
      shutil.copy2(source, run_dir / source.name)
      return run_dir

    run_dir = fresh('count')
    rc = run(counted, run_dir, False)
    ir = sum(cachegrind_total(p) for p in run_dir.glob('fe.*.cg'))
    fe_times, total_times = [], []
    for index in range(repeat):
      run_dir = fresh(f"fe{index}")
      run(timed, run_dir, False)
      fe_times.append(read_times(run_dir / 'fe.time'))
      run_dir = fresh(f"total{index}")
      run(plain, run_dir, True)
      total_times.append(read_times(run_dir / 'total.time'))
    for name, times in (('cgen-fe', fe_times), ('cgen-total', total_times)):
      results[name] = {
        'ir': ir if name == 'cgen-fe' else 0, 'rc': rc,
        'wall_s': round(min(t[0] for t in times), 3),
        'cpu_s': round(min(t[1] for t in times), 3),
        'rss_mb': round(max(t[2] for t in times), 1)
      }
  finally:
    shutil.rmtree(work, ignore_errors = True)
  return results


def generate_stream(tools: Tools, root: Path, spec: str, work: Path) -> Path:
  '''Write the synthetic stream KIND:N (ecil-stress-gen.py piped to ecil-asm).'''
  kind, _, count = spec.partition(':')
  asm = Path(tools.edg_cir).parent.parent / 'tools' / 'ecil-asm' / 'ecil-asm'
  text = subprocess.run(
    [sys.executable, str(root / 'cir_src/scripts/ecil-stress-gen.py'), kind,
     count], check = True, stdout = subprocess.PIPE, text = True
  ).stdout
  source = work / f"{kind}{count}.txt"
  source.write_text(text)
  stream = work / f"{kind}{count}.ecil"
  subprocess.run([str(asm), str(source), '-o', str(stream)], check = True)
  return stream


def measure_streams(tools: Tools, root: Path, specs: List[str], repeat: int
                    ) -> Dict[str, dict]:
  '''Measure edg-cir --emit=asm on stream files or generated streams.

  A spec is a file name, or KIND:N for ecil-stress-gen.py (a kind such as
  cxx_funcs).  The streams do not come from the front end, so this measures
  the library alone on shapes the front end cannot write yet.
  '''
  results: Dict[str, dict] = {}
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf-streams.'))
  try:
    for spec in specs:
      if ':' in spec and not Path(spec).exists():
        stream = generate_stream(tools, root, spec, work)
        name = spec.replace(':', '')
      else:
        stream = Path(spec).resolve()
        name = stream.stem
      ir, rc = count_edg_cir(tools, stream, work)
      times = []
      for _ in range(repeat):
        (work / 'cir.time').unlink(missing_ok = True)
        time_edg_cir(tools, stream, work)
        times.append(read_times(work / 'cir.time'))
      results[name] = {
        'ir': ir, 'rc': rc, 'wall_s': round(min(t[0] for t in times), 3),
        'cpu_s': round(min(t[1] for t in times), 3),
        'rss_mb': round(max(t[2] for t in times), 1),
        'bytes': stream.stat().st_size
      }
  finally:
    shutil.rmtree(work, ignore_errors = True)
  return results


def measure_case(tools: Tools, test: Path, options: List[str],
                 native: bool) -> dict:
  '''Measure one corpus case: the writer (fe) and the library (cir).'''
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf-case.'))
  entry: Dict[str, object] = {}
  try:
    shutil.copy2(test, work / test.name)
    for extra in test.parent.glob('*.h'):
      shutil.copy2(extra, work / extra.name)
    stream = work / 'case.ecil'
    extra_env = {'EDG_CPFE_DEFAULT_OPTIONS': f"--ecil_output={stream}"}
    rc = run_eccp(tools, tools.fe_counted, work / test.name, options, work,
                  extra_env)
    entry['fe_ir'] = sum(cachegrind_total(p) for p in work.glob('fe.*.cg'))
    entry['fe_rc'] = rc
    ok = rc == 0 and stream.exists() and stream.stat().st_size > 0
    if native:
      run_eccp(tools, tools.fe_timed, work / test.name, options, work,
               extra_env)
      _, entry['fe_cpu_s'], entry['fe_rss_mb'] = read_times(work / 'fe.time')
    if ok:
      entry['cir_ir'], entry['cir_rc'] = count_edg_cir(tools, stream, work)
      entry.update(read_edg_cir_stats(tools, stream, work))
      if native:
        time_edg_cir(tools, stream, work)
        _, entry['cir_cpu_s'], entry['cir_rss_mb'] = read_times(
          work / 'cir.time')
  finally:
    shutil.rmtree(work, ignore_errors = True)
  return entry


def find_cases(root: Path, spec: str, types: str, sample: int
               ) -> List[Tuple[str, Path, List[str]]]:
  '''The (name, source, eccp options) of every case of the filter list.'''
  import edgtest
  import edgtest.runtest as runtest
  tests_dir = root / 'tests' / 'tests'
  lines: List[str] = []
  if spec.startswith('@'):
    for line in (root / spec[1:]).read_text().splitlines():
      line = line.strip()
      if line and not line.startswith('#'):
        lines.append(line)
  else:
    lines = spec.split(',')
  positive = [l for l in lines if not l.startswith('!')]
  negative = [l[1:] for l in lines if l.startswith('!')]
  wanted = set(types.split(',')) if types else set()
  cases = []
  for suite in sorted(p for p in tests_dir.iterdir()
                      if p.is_dir() and not p.name.startswith('.')):
    for path in sorted(edgtest.walk_test_directory(
        suite, edgtest.DEFAULT_TEST_EXTENSIONS)):
      rel = f"{suite.name}/{path.relative_to(suite).as_posix()}"
      if positive and not any(rel.startswith(p) for p in positive):
        continue
      if any(rel.startswith(n) for n in negative):
        continue
      description = runtest.load_description(path, top_dir = suite)
      for number, (mode, base, case) in enumerate(
          description.traverse_cases()):
        if wanted and runtest.test_type_to_string(mode) not in wanted:
          continue
        cases.append((f"{rel}#{number}", path,
                      [*STANDARD_OPTIONS, *base, *case]))
  return cases[::sample] if sample > 1 else cases


def measure_corpus(tools: Tools, root: Path, args: argparse.Namespace
                   ) -> dict:
  cases = find_cases(root, args.corpus, args.types, args.sample)
  print(f"corpus: {len(cases)} cases, {args.jobs} jobs", flush = True)
  per_case: Dict[str, dict] = {}
  with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
    futures = {
      pool.submit(measure_case, tools, path, options, not args.no_native):
        name for name, path, options in cases
    }
    done = 0
    for future in concurrent.futures.as_completed(futures):
      per_case[futures[future]] = future.result()
      done += 1
      if done % 250 == 0:
        print(f"  {done}/{len(cases)}", flush = True)
  return per_case


def summarize_corpus(per_case: Dict[str, dict]) -> dict:
  fe_ok = [e for e in per_case.values() if e.get('fe_rc') == 0]
  cir_ok = [e for e in per_case.values() if e.get('cir_rc') == 0]
  def total(entries: List[dict], key: str) -> float:
    return sum(e.get(key, 0) for e in entries)
  def peak(entries: List[dict], key: str) -> float:
    return max((e.get(key, 0) for e in entries), default = 0)
  return {
    'cases': len(per_case), 'fe_ok': len(fe_ok), 'cir_ok': len(cir_ok),
    'fe_ir': total(list(per_case.values()), 'fe_ir'),
    'fe_ir_ok': total(fe_ok, 'fe_ir'),
    'fe_cpu_s': round(total(list(per_case.values()), 'fe_cpu_s'), 2),
    'fe_peak_rss_mb': round(peak(list(per_case.values()), 'fe_rss_mb'), 1),
    'cir_ir': total(cir_ok, 'cir_ir'),
    'cir_cpu_s': round(total(cir_ok, 'cir_cpu_s'), 2),
    'cir_peak_rss_mb': round(peak(cir_ok, 'cir_rss_mb'), 1),
    'cir_gids': total(cir_ok, 'cir_gids'),
    'cir_renames': total(cir_ok, 'cir_renames'),
    'cir_walks': total(cir_ok, 'cir_walks'),
    'rename_cases': sorted(n for n, e in per_case.items()
                           if e.get('cir_renames', 0) > 0)
  }


REALWORLD_FLAGS = ['--c++17', '-w']
# The pinned real-world units: the ones that compile under CIR at -O0 and -O2
# (m5_design.md section 9).  Every one must be measured, and a unit that
# stops compiling fails the targets; a unit that starts compiling joins the
# list at the next baseline.
PINNED_UNITS = ('libstdcxx/chrono', 'libstdcxx/functional',
                'libstdcxx/iostream', 'boost/mp11', 'boost/circular_buffer',
                'boost/lexical_cast')


class Compilers:
  '''clang and clang -fclangir under cachegrind (a stripped copy of the
  compiler, so that valgrind does not read its debug info).'''

  def __init__(self, tools: Tools, work: Path) -> None:
    prefix = tools.env.get('EDG_LLVM_CIR_PREFIX', '')
    self.clang = Path(prefix) / 'bin' / 'clang'
    self.resource = subprocess.run(
      [str(self.clang), '-print-resource-dir'], stdout = subprocess.PIPE,
      text = True).stdout.strip()
    copy = work / 'clang-stripped'
    subprocess.run(['strip', '--strip-all', '-o', str(copy),
                    str(self.clang.resolve())], check = True)
    copy.chmod(0o755)
    self.counted = copy

  def command(self, source: Path, flags: List[str], level: int, clangir: bool
              ) -> List[str]:
    return [f"-O{level}", '-c', '-std=c++17', '-w', '-x', 'c++',
            *(['-fclangir'] if clangir else []), '-resource-dir',
            self.resource, *flags, str(source), '-o', '/dev/null']


def realworld_units(directory: Path, only: Optional[List[str]] = None
                    ) -> List[Path]:
  '''The units of the directory (libstdcxx/*.cpp, boost/*.cpp), or the named
  ones (`libstdcxx/chrono`; `pinned` is PINNED_UNITS).'''
  units = sorted(directory.glob('libstdcxx/*.cpp')) + \
    sorted(directory.glob('boost/*.cpp'))
  if only:
    names = [n for item in only for n in
             (PINNED_UNITS if item == 'pinned' else (item,))]
    units = [u for u in units if f"{u.parent.name}/{u.stem}" in names]
  return units


def measure_unit(tools: Tools, compilers: Compilers, source: Path,
                 boost: str, level: int, repeat: int, count_clang: bool,
                 with_clang: bool = True) -> Dict[str, object]:
  '''One unit at one level: ours (front end + edg-cir), clang, clang
  -fclangir: instructions and the minimum wall time.'''
  result: Dict[str, object] = {}
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf-rw.'))
  try:
    shutil.copy2(source, work / source.name)
    include = [f"-I{boost}"] if boost and 'boost' in source.parts else []
    stream = work / 'unit.ecil'
    extra = {'EDG_USE_SYSTEM_HEADERS': '1',
             'EDG_CPFE_DEFAULT_OPTIONS':
             f"--ecil_output={stream} --cir_opt_level={level}"
             if level else f"--ecil_output={stream}"}
    run_dir = work / 'fe'
    run_dir.mkdir()
    shutil.copy2(source, run_dir / source.name)
    rc = run_eccp(tools, tools.fe_counted, run_dir / source.name,
                  [*REALWORLD_FLAGS, *include], run_dir, extra)
    fe_ir = sum(cachegrind_total(p) for p in run_dir.glob('fe.*.cg'))
    if rc != 0 or not stream.exists() or not stream.stat().st_size:
      result['error'] = f"front end exit status {rc}"
    else:
      ir, rc = count_edg_cir(tools, stream, work, level)
      if rc != 0 or not ir:
        result['error'] = f"edg-cir exit status {rc}"
      else:
        walls = []
        for _ in range(repeat):
          (work / 'cir.time').unlink(missing_ok = True)
          timed = work / 'timed'
          timed.mkdir(exist_ok = True)
          shutil.copy2(source, timed / source.name)
          (timed / 'fe.time').unlink(missing_ok = True)
          run_eccp(tools, tools.fe_timed, timed / source.name,
                   [*REALWORLD_FLAGS, *include], timed, dict(extra))
          time_edg_cir(tools, stream, work, level)
          walls.append(read_times(timed / 'fe.time')[0] +
                       read_times(work / 'cir.time')[0])
        result.update({'fe_ir': fe_ir, 'cir_ir': ir, 'ir': fe_ir + ir,
                       'wall_s': round(min(walls), 3)})
    for name, clangir in ((('clang', False), ('clangir', True))
                          if with_clang else ()):
      command = compilers.command(source, include, level, clangir)
      if count_clang:
        # (valgrind makes a compiler about 50 times slower: opt-in)
        out = work / f"{name}.cg"
        proc = subprocess.run(
          [*VALGRIND, f"--cachegrind-out-file={out}", str(compilers.counted),
           *command], cwd = work, env = tools.env, stdout = subprocess.PIPE,
          stderr = subprocess.STDOUT, text = True)
        if proc.returncode == 0 and out.exists():
          result[f"{name}_ir"] = cachegrind_total(out)
      timefile = work / f"{name}.time"
      failed = ''
      for _ in range(repeat):
        proc = subprocess.run(
          [sys.executable, str(tools.timer), str(timefile),
           str(compilers.clang), *command], cwd = work, env = tools.env,
          stdout = subprocess.PIPE, stderr = subprocess.STDOUT, text = True)
        if proc.returncode != 0:
          lines = [l for l in proc.stdout.splitlines() if 'error' in l]
          failed = (lines[0] if lines else
                    f"exit status {proc.returncode}")[:160]
          break
      if failed:
        result[f"{name}_error"] = failed
        continue
      lines = timefile.read_text().splitlines() if timefile.exists() else []
      walls = [float(l.split()[0]) for l in lines if l.strip()]
      cpus = [float(l.split()[1]) + float(l.split()[2])
              for l in lines if l.strip()]
      result[f"{name}_wall_s"] = round(min(walls), 3) if walls else 0.0
      result[f"{name}_cpu_s"] = round(min(cpus), 3) if cpus else 0.0
  finally:
    shutil.rmtree(work, ignore_errors = True)
  return result


def measure_realworld(tools: Tools, root: Path, args: argparse.Namespace,
                      levels: List[int]) -> Dict[str, dict]:
  '''The real-world units at each level: unit -> "O<level>" -> result.'''
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf-clang.'))
  try:
    compilers = Compilers(tools, work)
    results: Dict[str, dict] = {}
    only = [u for u in args.units.split(',') if u]
    for source in realworld_units(root / args.realworld_dir, only):
      name = f"{source.parent.name}/{source.stem}"
      results[name] = {}
      for level in levels:
        print(f"realworld: {name} -O{level}", flush = True)
        results[name][f"O{level}"] = measure_unit(
          tools, compilers, source, args.boost_include, level, args.repeat,
          args.clang_instructions, not args.no_clang)
        if args.json:
          # partial result: a long run is not lost if it is interrupted
          Path(args.json + '.partial').write_text(json.dumps(
            {'realworld': results}, indent = 1, sort_keys = True) + '\n')
    return results
  finally:
    shutil.rmtree(work, ignore_errors = True)


# The instruction targets of the slices of gate M5 (m5_design.md section 9),
# as the largest ratio after / before: S1 (lazy emission) wants the library
# instructions (cir_ir) of every pinned real-world unit at most 70% of the
# baseline's, and those of the generated 6000-function C++ unit (edg-cir on
# its stream, few dead bodies) at most 90% at -O0 (reported at -O2).
TARGETS: Dict[str, Dict[str, float]] = {
  's1': {'realworld_cir_ir': 0.70, 'big_cxx_cir_ir': 0.90}
}


def check_targets(before: dict, after: dict, name: str
                  ) -> Tuple[bool, List[str]]:
  '''(passes, report lines) of the targets `name` between two measurements.
  Every pinned unit that the baseline measured must be measured again and
  compile (a unit that stops compiling fails); a unit that the baseline could
  not compile is skipped (it joins at the next baseline).  A section or row
  that is missing fails: the target is not met by not measuring.'''
  limits = TARGETS[name]
  lines: List[str] = []
  passes = True
  old_units = before.get('realworld', {})
  new_units = after.get('realworld', {})
  limit = limits['realworld_cir_ir']
  measured = 0
  for unit in PINNED_UNITS:
    for level_name, old in sorted(old_units.get(unit, {}).items()):
      if 'error' in old or not old.get('cir_ir'):
        lines.append(f"{unit} {level_name}: the baseline has no library "
                     f"count (not compiled): skipped")
        continue
      new = new_units.get(unit, {}).get(level_name)
      if new is None:
        passes = False
        lines.append(f"FAIL {unit} {level_name}: not measured")
      elif 'error' in new or not new.get('cir_ir'):
        passes = False
        lines.append(f"FAIL {unit} {level_name}: stopped compiling "
                     f"({new.get('error', 'no library count')})")
      else:
        ratio = new['cir_ir'] / old['cir_ir']
        measured += 1
        ok = ratio <= limit
        passes = passes and ok
        lines.append(f"{'ok  ' if ok else 'FAIL'} {unit} {level_name}: "
                     f"library instructions {100 * ratio:.1f}% of the "
                     f"baseline (limit {100 * limit:.0f}%)")
  if not measured:
    passes = False
    lines.append('FAIL no pinned unit could be compared (the baseline needs '
                 'a realworld section: --only realworld --units pinned)')
  limit = limits['big_cxx_cir_ir']
  # The generated C++ unit is gated at -O0 only; at -O2 it is reported.
  for section, gated in (('big_cxx', True), ('big_cxx_O2', False)):
    old = before.get(section, {}).get('2p-edg-cir', {}).get('ir')
    if not old:
      if gated:
        passes = False
        lines.append('FAIL no generated C++ unit (big_cxx) in the baseline')
      continue
    new = after.get(section, {}).get('2p-edg-cir', {}).get('ir')
    if not new:
      if gated:
        passes = False
        lines.append(f"FAIL {section}: not measured")
      continue
    ratio = new / old
    ok = ratio <= limit
    if gated:
      passes = passes and ok
    lines.append(f"{('ok  ' if ok else 'FAIL') if gated else 'info'} "
                 f"generated C++ unit ({section}): library instructions "
                 f"{100 * ratio:.1f}% of the baseline (limit "
                 f"{100 * limit:.0f}%{'' if gated else ', reported only'})")
  return passes, lines


def delta(before: float, after: float) -> str:
  if not before:
    return 'n/a'
  return f"{(after - before) / before * 100:+.2f}%"


def common_totals(base: dict, new: dict) -> Optional[Dict[str, float]]:
  '''Instruction sums over the cases that succeeded in both measurements.'''
  base_cases = base.get('per_case')
  new_cases = new.get('per_case')
  if not base_cases or not new_cases:
    return None
  names = [n for n in new_cases if n in base_cases]
  sums = {'cases': len(names), 'fe_before': 0, 'fe_after': 0,
          'cir_before': 0, 'cir_after': 0, 'cir_cases': 0}
  for name in names:
    old, cur = base_cases[name], new_cases[name]
    if old.get('fe_rc') == 0 and cur.get('fe_rc') == 0:
      sums['fe_before'] += old.get('fe_ir', 0)
      sums['fe_after'] += cur.get('fe_ir', 0)
    if old.get('cir_rc') == 0 and cur.get('cir_rc') == 0:
      sums['cir_before'] += old.get('cir_ir', 0)
      sums['cir_after'] += cur.get('cir_ir', 0)
      sums['cir_cases'] += 1
  return sums


def format_table(new: dict, base: Optional[dict]) -> str:
  '''The measurement as a table, with before/after columns if base is given.'''
  lines = []
  def millions(value: float) -> str:
    return f"{value / 1e6:,.1f}"
  head = '| measurement | before | after | change |' if base else \
    '| measurement | value |'
  rule = '| --- | ---: | ---: | ---: |' if base else '| --- | ---: |'
  def row(label: str, before: Optional[float], after: float,
          fmt = millions) -> None:
    if base:
      lines.append(
        f"| {label} | {fmt(before) if before is not None else 'n/a'} | "
        f"{fmt(after)} | {delta(before or 0, after)} |")
    else:
      lines.append(f"| {label} | {fmt(after)} |")
  lines += [head, rule]
  big = new.get('big', {})
  base_big = (base or {}).get('big', {})
  functions = new.get('meta', {}).get('big_functions', '?')
  for name in BIG_ROWS:
    if name not in big:
      continue
    prefix = f"big TU ({functions} functions) {name}"
    old = base_big.get(name, {})
    row(f"{prefix}: instructions (M)", old.get('ir'), big[name]['ir'])
    row(f"{prefix}: CPU s", old.get('cpu_s'), big[name]['cpu_s'],
        lambda v: f"{v:.2f}")
    row(f"{prefix}: peak RSS MB", old.get('rss_mb'), big[name]['rss_mb'],
        lambda v: f"{v:.0f}")
  base_cxx = (base or {}).get('big_cxx', {})
  cxx_functions = new.get('meta', {}).get('cxx_functions', '?')
  for name in BIG_ROWS + ('cgen-fe', 'cgen-total'):
    entry = new.get('big_cxx', {}).get(name)
    if not entry:
      continue
    prefix = f"C++ TU ({cxx_functions} functions) {name}"
    old = base_cxx.get(name, {})
    if entry['ir']:
      row(f"{prefix}: instructions (M)", old.get('ir'), entry['ir'])
    row(f"{prefix}: CPU s", old.get('cpu_s'), entry['cpu_s'],
        lambda v: f"{v:.2f}")
    row(f"{prefix}: wall s", old.get('wall_s'), entry['wall_s'],
        lambda v: f"{v:.2f}")
    row(f"{prefix}: peak RSS MB", old.get('rss_mb'), entry['rss_mb'],
        lambda v: f"{v:.0f}")
  for level in (2,):
    for section, label in ((f"big_O{level}", 'big TU'),
                           (f"big_cxx_O{level}", 'C++ TU')):
      old_section = (base or {}).get(section, {})
      for name in BIG_ROWS:
        entry = new.get(section, {}).get(name)
        if not entry or not entry['ir']:
          continue
        prefix = f"{label} -O{level} {name}"
        old = old_section.get(name, {})
        row(f"{prefix}: instructions (M)", old.get('ir'), entry['ir'])
        row(f"{prefix}: peak RSS MB", old.get('rss_mb'), entry['rss_mb'],
            lambda v: f"{v:.0f}")
  realworld = new.get('realworld', {})
  base_realworld = (base or {}).get('realworld', {})
  for unit, by_level in sorted(realworld.items()):
    for level_name, entry in sorted(by_level.items()):
      prefix = f"real-world {unit} {level_name}"
      old = base_realworld.get(unit, {}).get(level_name, {})
      if 'error' in entry:
        lines.append(f"| {prefix}: CIR cannot compile it ({entry['error']}) "
                     f"| n/a |" + (' n/a |  |' if base else ''))
      else:
        row(f"{prefix}: ours instructions (M)", old.get('ir'), entry['ir'])
        row(f"{prefix}: ours wall s", old.get('wall_s'), entry['wall_s'],
            lambda v: f"{v:.2f}")
      for name in ('clang', 'clangir'):
        if f"{name}_ir" in entry:
          row(f"{prefix}: {name} instructions (M)", old.get(f"{name}_ir"),
              entry[f"{name}_ir"])
        if f"{name}_wall_s" in entry:
          row(f"{prefix}: {name} wall s", old.get(f"{name}_wall_s"),
              entry[f"{name}_wall_s"], lambda v: f"{v:.2f}")
        if f"{name}_error" in entry:
          lines.append(f"| {prefix}: {name} cannot compile it "
                       f"({entry[f'{name}_error']}) | n/a |" +
                       (' n/a |  |' if base else ''))
  base_streams = (base or {}).get('streams', {})
  for name, entry in new.get('streams', {}).items():
    prefix = f"stream {name} ({entry['bytes'] // 1024} KB) edg-cir"
    old = base_streams.get(name, {})
    row(f"{prefix}: instructions (M)", old.get('ir'), entry['ir'])
    row(f"{prefix}: CPU s", old.get('cpu_s'), entry['cpu_s'],
        lambda v: f"{v:.2f}")
    row(f"{prefix}: peak RSS MB", old.get('rss_mb'), entry['rss_mb'],
        lambda v: f"{v:.0f}")
  corpus = new.get('corpus')
  if corpus:
    old_corpus = (base or {}).get('corpus', {})
    cases = corpus['cases']
    sums = common_totals(base, new) if base else None
    if sums:
      cases_note = f"{int(sums['cases'])} common cases"
      lines.append(
        f"| corpus {cases_note}: front end (writer) instructions (M) | "
        f"{millions(sums['fe_before'])} | {millions(sums['fe_after'])} | "
        f"{delta(sums['fe_before'], sums['fe_after'])} |")
      lines.append(
        f"| corpus {int(sums['cir_cases'])} common cases: edg-cir (library) "
        f"instructions (M) | {millions(sums['cir_before'])} | "
        f"{millions(sums['cir_after'])} | "
        f"{delta(sums['cir_before'], sums['cir_after'])} |")
    else:
      row(f"corpus ({cases} cases): front end instructions (M)",
          old_corpus.get('fe_ir'), corpus['fe_ir'])
      row(f"corpus ({corpus['cir_ok']} streams): edg-cir instructions (M)",
          old_corpus.get('cir_ir'), corpus['cir_ir'])
    for key, label, fmt in (
        ('fe_cpu_s', 'front end CPU s (sum)', lambda v: f"{v:.1f}"),
        ('cir_cpu_s', 'edg-cir CPU s (sum)', lambda v: f"{v:.1f}"),
        ('fe_peak_rss_mb', 'front end peak RSS MB (max)',
         lambda v: f"{v:.0f}"),
        ('cir_peak_rss_mb', 'edg-cir peak RSS MB (max)',
         lambda v: f"{v:.0f}")):
      if key in corpus:
        row(f"corpus {label}", old_corpus.get(key), corpus[key], fmt)
    for key, label in (('cir_gids', 'G-ids (edg-cir --stats)'),
                       ('cir_renames', 'symbol renames (edg-cir --stats)'),
                       ('cir_walks', 'substitution walks (edg-cir --stats)')):
      if key in corpus:
        row(f"corpus {label}", old_corpus.get(key), corpus[key],
            lambda v: f"{v:,.0f}")
    if 'rename_cases' in corpus:
      lines.append(f"| corpus cases with a symbol rename | "
                   f"{len(corpus['rename_cases'])} |" +
                   (' |  |' if base else ''))
  return '\n'.join(lines)


def main() -> None:
  parser = argparse.ArgumentParser(
    description = __doc__.split('\n')[0],
    formatter_class = argparse.RawDescriptionHelpFormatter,
    epilog = __doc__.split('\n', 2)[2]
  )
  parser.add_argument('--root', default = '.', help = 'repository root')
  parser.add_argument('--fe-build', default = 'build/gcc-release-cir',
                      help = 'build directory of the (non-ASan) cpfe-cir')
  parser.add_argument('--only', default = 'big,corpus',
                      help = 'comma separated: big, cxx, corpus, streams, '
                             'realworld')
  parser.add_argument('--levels', default = '0',
                      help = 'optimization levels of big, cxx and realworld '
                             '(for example 0,2); level N above 0 is stored '
                             'as big_ON, big_cxx_ON')
  parser.add_argument('--clang-instructions', action = 'store_true',
                      help = 'also count the instructions of clang and '
                             'clang -fclangir on the real-world units '
                             '(under valgrind: about 50 times slower)')
  parser.add_argument('--realworld-dir', default = 'dev_tools/cir-realworld',
                      help = 'directory of the real-world units '
                             '(libstdcxx/*.cpp, boost/*.cpp)')
  parser.add_argument('--units', default = '',
                      help = 'measure only these real-world units (comma '
                             'separated, like libstdcxx/chrono; `pinned` is '
                             'the pinned list, PINNED_UNITS)')
  parser.add_argument('--no-clang', action = 'store_true',
                      help = 'do not time clang and clang -fclangir on the '
                             'real-world units (the slice targets need '
                             'only ours)')
  parser.add_argument('--targets', default = '', choices = ['', *TARGETS],
                      help = 'check the targets of a slice against '
                             '--baseline after the table (exit status 1 if '
                             'one is missed)')
  parser.add_argument('--boost-include', default = '',
                      help = 'a directory with the Boost headers (merged '
                             'into one tree): the Boost units are measured '
                             'only with it; it must be inside the workspace')
  parser.add_argument('--stream', action = 'append', default = [],
                      help = 'also measure edg-cir on this ECIL stream file, '
                             'or on the generated stream KIND:N (ecil-stress-'
                             'gen.py, e.g. cxx_funcs:6000); repeatable.  '
                             '--only streams alone measures cxx_funcs:6000')
  parser.add_argument('--big-functions', type = int, default = 6000)
  parser.add_argument('--cxx-functions', type = int, default = 6000,
                      help = 'size of the generated C++ file of --only cxx '
                             '(edg-cir-rss --generate-cxx-functions)')
  parser.add_argument('--cgen-build', default = 'build/gcc-release',
                      help = 'build directory of the default (C generating) '
                             'cpfe for the C++ baseline of --only cxx')
  parser.add_argument('--big', default = '',
                      help = 'measure this C file instead of a generated '
                             'one')
  parser.add_argument('--repeat', type = int, default = 3,
                      help = 'native timing repeats of the big file (the '
                             'minimum time is kept)')
  parser.add_argument('--corpus',
                      default = '@tests/.edgy/filters/cir-c-corpus.txt')
  parser.add_argument('--types', default = 'rp,lp')
  parser.add_argument('--sample', type = int, default = 1,
                      help = 'measure every Nth corpus case only')
  parser.add_argument('--no-native', action = 'store_true',
                      help = 'skip the native CPU time and RSS runs of the '
                             'corpus')
  parser.add_argument('-j', dest = 'jobs', type = int,
                      default = os.cpu_count() or 1)
  parser.add_argument('--json', default = '',
                      help = 'write the measurement here (with --table-only: '
                             'the file to read)')
  parser.add_argument('--baseline', default = '',
                      help = 'an earlier --json file: print before/after')
  parser.add_argument('--table-only', action = 'store_true',
                      help = 'only print the table of --json (and '
                             '--baseline)')
  args = parser.parse_args()

  base = json.loads(Path(args.baseline).read_text()) if args.baseline \
    else None
  if args.table_only:
    if not args.json:
      parser.error('--table-only needs --json')
    new_data = json.loads(Path(args.json).read_text())
    print(format_table(new_data, base))
    if args.targets:
      if not base:
        parser.error('--targets needs --baseline')
      ok, report = check_targets(base, new_data, args.targets)
      print('\n'.join(['', f"targets {args.targets}:", *report]))
      sys.exit(0 if ok else 1)
    return

  root = Path(args.root).resolve()
  sys.path.insert(0, str(root / 'dev_tools/pylibs'))
  if args.boost_include:
    # the front end runs in a scratch directory: the path must be absolute
    args.boost_include = str((root / args.boost_include).resolve())
  only = [s for s in args.only.split(',') if s]
  levels = [int(x) for x in args.levels.split(',')]
  work = Path(tempfile.mkdtemp(prefix = 'edg-cir-perf.'))
  result: Dict[str, object] = {
    'meta': {'fe_build': args.fe_build, 'big_functions': args.big_functions,
             'sample': args.sample, 'corpus': args.corpus,
             'types': args.types, 'metric': 'cachegrind Ir (user mode)'}
  }
  try:
    tools = Tools(root, args.fe_build, work)
    if 'big' in only:
      big = Path(args.big) if args.big else work / 'big.c'
      if not args.big:
        subprocess.run(
          [sys.executable, str(root / 'dev_tools/bin/edg-cir-rss'),
           '--generate-functions', str(args.big_functions), '-o', str(big)],
          check = True, stdout = subprocess.DEVNULL
        )
      print(f"big: {big}", flush = True)
      for level in levels:
        result['big' + (f"_O{level}" if level else '')] = measure_big(
          tools, big.resolve(), args.repeat, None, level)
    if 'cxx' in only:
      source = work / 'big.cpp'
      subprocess.run(
        [sys.executable, str(root / 'dev_tools/bin/edg-cir-rss'),
         '--generate-cxx-functions', str(args.cxx_functions), '-o',
         str(source)], check = True, stdout = subprocess.DEVNULL
      )
      print(f"cxx: {source}", flush = True)
      for level in levels:
        cxx = measure_big(tools, source, args.repeat, ['--c++17'], level)
        if not level:
          cxx.update(measure_cgen(tools, args.cgen_build, source,
                                  args.repeat, ['--c++17']))
        result['big_cxx' + (f"_O{level}" if level else '')] = cxx
      result['meta']['cxx_functions'] = args.cxx_functions
    if 'realworld' in only:
      result['realworld'] = measure_realworld(tools, root, args, levels)
    if 'streams' in only or args.stream:
      specs = args.stream or ['cxx_funcs:6000']
      result['streams'] = measure_streams(tools, root, specs, args.repeat)
    if 'corpus' in only:
      per_case = measure_corpus(tools, root, args)
      result['corpus'] = summarize_corpus(per_case)
      result['per_case'] = per_case
  finally:
    shutil.rmtree(work, ignore_errors = True)

  if args.json:
    Path(args.json).write_text(json.dumps(result, indent = 1,
                                          sort_keys = True) + '\n')
    print(f"wrote {args.json}")
  print(format_table(result, base))
  if args.targets:
    if not base:
      parser.error('--targets needs --baseline')
    ok, report = check_targets(base, result, args.targets)
    print('\n'.join(['', f"targets {args.targets}:", *report]))
    sys.exit(0 if ok else 1)


if __name__ == '__main__':
  main()
