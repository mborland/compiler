ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S3): member pointers as the writer streams them: globals
; (data members of a class and of its bases, non-virtual and virtual member
; functions, a function of a base converted to the derived class), .* and ->*
; calls, the base-to-derived conversion of a data member pointer, the
; comparison and bool conversion of member pointers, null.
;   int B1::*pa = &B1::a; int (D::*pg)(int) = static_cast<int (D::*)(int)>(&B2::g);
;   (d.*pf)(10), (p->*pv)(0) through a virtual function, int D::*cvt = pb, np != nullptr
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: %edg-cir --emit=obj -O2 -o %t.o2.o %t.ecil
; RUN: g++ %t.o2.o -o %t.o2.exe
; RUN: %t.o2.exe

; CHECK-DAG: cir.get_runtime_member
; CHECK-DAG: cir.get_method
; CHECK-DAG: cir.cmp ne

