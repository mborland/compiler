; C++ (ECIL v1, slice S2): cleanups.  T logs its construction (id) and
; destruction (id + 100) in a global array; every scenario runs and main
; compares the log with the expected order.
;   scope exit order, continue/break out of a loop body, return and goto
;   through cleanups, a conditional temporary and && with a carried value in a
;   full expression (flag-guarded cleanup scope, tmp.exprcleanup), fixed,
;   multi-dimensional and counted array constructor/destructor loops.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: cir.cleanup.scope {
; CHECK-DAG: } cleanup normal {
; CHECK-DAG: cir.alloca "cleanup.cond"
; CHECK-DAG: cir.alloca "tmp.exprcleanup"
; CHECK-DAG: cir.array.ctor
; CHECK-DAG: cir.array.dtor

