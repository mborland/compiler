; C++ (ECIL v1): a noreturn call as the last thing in a cleanup scope body.
; FlattenCFG (an assertion build) rejects a cir.cleanup.scope body with no exit,
; which is what a cir.unreachable after the call produced; CIRGen marks the call
; noreturn and the body ends in its yield.
;   struct A { ~A(); };  void f() { A a; exit(0); }   // from std::nested_exception
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-LABEL: cir.func {{.*}}@_Z1fv
; CHECK: cir.cleanup.scope {
; CHECK: cir.call @exit({{.*}}) nothrow {noreturn}
; CHECK-NEXT: cir.yield
; CHECK: } cleanup normal {

frame DECLS
  STR 11 "A"
  STR 12 "_ZN1AD1Ev"
  STR 13 "_Z1fv"
  STR 14 "main"
  STR 15 "exit"
  TY_RECORD_DECL 31 0 11
  TY_RECORD_BODY 31 1 1 1 12 0
  TY_PTR 32 31
  TY_FUNC 33 11 0 [32]
  TY_FUNC 34 11 0 []
  TY_FUNC 35 1 0 []
  TY_FUNC 36 11 0 [1]
  DECL_FUNC 100 33 0 1 12
  DECL_FUNC 101 34 0 1 13
  DECL_FUNC 102 35 0 9 14
  DECL_FUNC 103 36 0 4 15
frame REGION
  FUNC_BEGIN 100 0
  PARAM 1 32 32 nil 1
  FUNC_END 1
  FUNC_BEGIN 101 0
  BLOCK_BEGIN
  LOCAL 1 31 nil 0 0
  CLEANUP_BEGIN 3 nil 0
  LREF 1
  ADDR
  CALL 100 33 1 0
  CLEANUP_BODY
  CONST_INT 1 0
  CALL 103 36 1 2
  BLOCK_END
  FUNC_END 0
  FUNC_BEGIN 102 0
  CALL 101 34 0 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
