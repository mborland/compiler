  AGG_SEL 2
  C_INT 3 0
  INIT_CONST
  AGG_INIT_END
  LREF 3
  LOAD 0
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION supp
  TY_FUNC 10 3 0 [4, 7] supp{15: 4}
  STR 14 "_Z5takes3BigRi"
  DECL_FUNC 11 10 0 0 14
  DECL_FUNC 11 10 0 1 14
  FUNC_BEGIN 11 0
  PARAM 1 4 4 8 0
  PARAM 2 7 7 13 0
  BLOCK_BEGIN
  LREF 1
  FIELD 4 0
  LOAD 0
  LREF 2
  LOAD 0
