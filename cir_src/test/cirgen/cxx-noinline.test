; ECIL 1.3: the supp key noinline (14) on a DECL_FUNC sets the function's inline
; kind to "never" (LLVM noinline).  It is honored in a stream of minor 1 (the
; key is checked and used whatever the preamble says), it is sticky (a
; re-issue without the key keeps it) and it may share a blob with other keys.
; At -O2 the call of an ordinary small function (that bumps a counter) is
; inlined and the calls of the noinline ones stay.
; RUN: cat %S/Inputs/header11_supp.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=llvm %t.ecil | %FileCheck %s --check-prefix=O0
; RUN: %edg-cir -O2 --emit=llvm %t.ecil | %FileCheck %s --check-prefix=O2
; RUN: %edg-cir -O2 --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; O0: define {{.*}} @keep() #[[NI:[0-9]+]]
; O0: define {{.*}} @gone() #[[PLAIN:[0-9]+]]
; O0: define {{.*}} @sticky() #[[NI]]
; O0: define {{.*}} @multi() #{{[0-9]+}}
; O0: attributes #[[NI]] = {{{.*}}noinline
; O0-NOT: attributes #[[PLAIN]] = {{{.*}}noinline
; O2: define {{.*}} @main()
; O2-NOT: call {{.*}} @gone()
; O2-DAG: call {{.*}} @keep()
; O2-DAG: call {{.*}} @sticky()
; O2-DAG: call {{.*}} @multi()

frame DECLS supp
  STR 100 "keep"
  STR 101 "gone"
  STR 102 "main"
  STR 103 "sticky"
  STR 104 "multi"
  STR 105 "cnt"
  TY_FUNC 21 1 0 []
  DECL_VAR 301 1 0 1 4 105
  DECL_FUNC 40 21 0 1 100 supp{14: true}
  DECL_FUNC 41 21 0 1 101
  DECL_FUNC 42 21 0 9 102
  DECL_FUNC 43 21 0 1 103 supp{14: true}
  DECL_FUNC 43 21 0 1 103
  DECL_FUNC 44 21 0 1 104 supp{14: true, 1: true}
frame REGION
  FUNC_BEGIN 40 0
  GREF 301
  GREF 301
  LOAD 0
  CONST_INT 1 1
  ADD 1
  STORE 0 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 41 0
  GREF 301
  GREF 301
  LOAD 0
  CONST_INT 1 1
  ADD 1
  STORE 0 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 43 0
  GREF 301
  GREF 301
  LOAD 0
  CONST_INT 1 1
  ADD 1
  STORE 0 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 44 0
  GREF 301
  GREF 301
  LOAD 0
  CONST_INT 1 1
  ADD 1
  STORE 0 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 42 0
  CALL 40 21 0 0
  CALL 41 21 0 0
  ADD 1
  CALL 43 21 0 0
  ADD 1
  CALL 44 21 0 0
  ADD 1
  CONST_INT 1 4
  SUB 1
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
