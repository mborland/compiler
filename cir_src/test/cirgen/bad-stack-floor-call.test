; Stack floor: CALL takes its arguments from its own construct.  The one
; argument of f is on the stack, but it belongs to the enclosing function body,
; not to the full expression that holds the CALL.
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 2'

; CHECK: CALL needs 1 argument values but the value stack holds 0

frame DECLS
  STR 10 "f"
  STR 11 "g"
  TY_FUNC 21 11 0 [1]
  TY_FUNC 22 11 0 []
  DECL_FUNC 40 21 0 1 10
  DECL_FUNC 41 22 0 1 11
frame REGION
  FUNC_BEGIN 41 0
  CONST_INT 1 1
  FULLEXPR_BEGIN
  CALL 40 21 1 0
  FULLEXPR_END
  FUNC_END 1
frame END
  END auto 0
