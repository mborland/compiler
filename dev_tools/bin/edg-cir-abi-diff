#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Compare the vtable and record layouts of clang's and the CIR back end's ABI.

Status: skeleton for M4 (not wired into the gate).  It has the clang side and
the normalize and diff machinery; the library's `ecil-dump --vtable-layouts`
(M4a) will print the same canonical text, and then

  edg-cir-abi-diff compare FILE.cpp --ours OURS.txt

compares the two.  Run it inside the cir-env image (the pin's clang is
$EDG_LLVM_CIR_PREFIX/bin/clang):

  edg-exec --img cir-env -- python3 dev_tools/bin/edg-cir-abi-diff dump t.cpp
  ... normalize DUMP.txt           # a raw clang dump (file or - for stdin)
  ... diff A.txt B.txt             # raw or canonical text, either side
  ... compare t.cpp --ours O.txt   # clang's layouts of t.cpp against O.txt
  ... gather DIR                   # copy the clang tests of CLANG_TESTS
  ... --self-test                  # no clang needed (uses it if present)

`dump` runs

  clang -cc1 -triple x86_64-linux-gnu -std=c++17 -fcxx-exceptions
        -fexceptions -fdump-vtable-layouts -fdump-record-layouts
        -emit-llvm-only FILE

(it also prints the IRgen layout of clang's code generator, which no other
implementation can reproduce; `normalize` ignores it; the "-simple" variant
prints no names).

The canonical form is a list of blocks sorted by (kind, name), each

  ## record struct B                 (the AST record layout, "offset | text")
  ## vtable B (13 entries)           (the Itanium vtable with thunk notes)
  ## construction-vtable (B, 16) in D (7 entries)
  ## vtable-indices B (3 entries)
  ## vbase-offset-offsets B (1 entry)
  ## thunks B::f() (1 entry)

followed by its lines with the offset column reduced to "N |" (the nesting
inside a record layout is kept, runs of spaces elsewhere are collapsed, blank
lines and trailing blanks are dropped).  The "Original map" lines clang prints
before a vtable (an implementation detail of the thunk builder) are dropped
unless --keep-original-map is given.  clang does not dump VTTs or typeinfo
with these options: those are compared by edg-cir-symbols and, as IR, by the
two-TU tests.

`batch` runs the comparison over many files, for the classes without virtual
bases (S1; with --vbases for all classes, S2): for each source it takes
clang's layouts, drops every class that has a virtual base (and the
construction vtables and vbase offsets, which only classes with virtual bases
have; not with --vbases), compiles the file with cpfe-cir to an
ECIL stream (`--ecil_output`), reads the library's side with
`ecil-dump --vtable-layouts` and compares block by block.  A block that
differs is attributed:

  FE      the front end's layout facts of its class disagree with clang's
          (edg-cir-fe-facts, run on the same file: size, offsets, primary
          base, slot numbers, overriders), or ecil-dump's record layout of
          the class differs from clang's if it prints one;
  ours    the front end agrees with clang: the vtable (entries, thunks,
          offsets) was computed by the writer or the library;
  ?       edg-cir-fe-facts could not be run.

The record layouts (-fdump-record-layouts blocks) are not compared unless
ecil-dump prints them: a record block that ours lacks is not a difference
(they are checked by edg-cir-fe-facts instead).  ecil-dump's spelling of a
function's return type is approximate (an ECIL type does not tell long from
long long, signed char from char, or a reference from a pointer), so the
return types of the vtable entries and thunk headings are normalized on both
sides before the comparison (long long -> long, signed char -> char, & and &&
-> *); the number of blocks that were equal only after that is reported.

  edg-cir-abi-diff batch FILES... [--vbases] [--ecil-dump BIN]
  edg-cir-abi-diff batch dev_tools/cir-abi-cases/s1
  edg-cir-abi-diff batch --clang-tests DIR   # vtable-layout*.cpp, thunks.cpp

`compare` takes the library's side either as text (--ours) or as a stream
(--ecil FILE.ecil [--ecil-dump BINARY]: it runs `ecil-dump --vtable-layouts`).
It never reports a layout as equal that was not compared: an ecil-dump whose
`--help` text does not list --vtable-layouts (it does not have the option
yet), and a file for which neither side has a layout block, give "SKIP"
(status 3); once the option exists, a failing invocation is an error (status
2), and a library side that lacks blocks that clang has gives "differs"
(status 1).

Exit status: 0 if the layouts are equal (or for dump, normalize and gather), 1
if they differ, 2 for a setup problem, 3 for SKIP (nothing was compared).
'''

import argparse
import difflib
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

from pathlib import Path
from typing import Dict, List, Optional, Tuple

DEFAULT_TRIPLE = 'x86_64-linux-gnu'
EXIT_SKIP = 3
# The time limit of a compiler run (seconds); a run that hangs is a failure.
COMPILE_TIMEOUT = 600

# clang's test/CodeGenCXX files that are about the Itanium vtable layout,
# thunks, virtual bases and RTTI (the M4 inputs); `gather` copies them.  Files
# of the LLVM project are under the Apache License v2.0 with LLVM Exceptions,
# like this repository (the files have no header of their own).
CLANG_TESTS = (
  'vtable-layout.cpp', 'vtable-layout-abi-examples.cpp',
  'vtable-layout-extreme.cpp', 'vtt-layout.cpp', 'thunks.cpp',
  '2003-11-27-MultipleInheritanceThunk.cpp',
  '2005-02-19-UnnamedVirtualThunkArgument.cpp', 'virt-thunk-reference.cpp',
  'thunk-returning-memptr.cpp', 'thunk-linkonce-odr.cpp',
  'virtual-bases.cpp', 'virtual-base-ctor.cpp', 'virtual-base-cast.cpp',
  'virtual-base-destructor-call.cpp', 'virtual-destructor-calls.cpp',
  'virtual-destructor-synthesis.cpp', 'virtual-function-calls.cpp',
  'virtual-inherited-destructor.cpp', 'vtable-key-function.cpp',
  'key-function-vtable.cpp', 'cxx11-vtable-key-function.cpp',
  'vtable-linkage.cpp', 'vtable-pointer-initialization.cpp',
  'rtti-layout.cpp', 'rtti-linkage.cpp', 'rtti-fundamental.cpp',
  'typeid.cpp', 'dynamic-cast.cpp', 'construction-vtable-unnamed-addr.cpp',
  'zero-init-empty-virtual.cpp', 'virt-template-vtable.cpp'
)

# The kinds of block, in the order of the canonical form.
KINDS = ('record', 'vtable', 'construction-vtable', 'vtable-indices',
         'vbase-offset-offsets', 'thunks')

_HEADINGS = (
  ('vtable', re.compile(r"^Vtable for '(?P<name>.*)' \((?P<n>.*)\)\.$")),
  ('construction-vtable', re.compile(
    r"^Construction vtable for \((?P<name>'.*', \d+)\) in '(?P<in>.*)' "
    r"\((?P<n>.*)\)\.$")),
  ('vtable-indices', re.compile(
    r"^VTable indices for '(?P<name>.*)' \((?P<n>.*)\)\.$")),
  ('vbase-offset-offsets', re.compile(
    r"^Virtual base offset offsets for '(?P<name>.*)' \((?P<n>.*)\)\.$")),
  ('thunks', re.compile(r"^Thunks for '(?P<name>.*)' \((?P<n>.*)\)\.$")),
)
_RECORD_HEADING = re.compile(r'^\*\*\* Dumping AST Record Layout\s*$')
_OTHER_HEADING = re.compile(r'^\*\*\* ')
_OFFSET_LINE = re.compile(
  r'^\s*(?P<off>\d+(?::\d+(?:-\d+)?)?)\s*\|(?P<rest>.*)$')
_CONTINUATION = re.compile(r'^\s+\|(?P<rest>.*)$')
_ORIGINAL_MAP = re.compile(r'^Original map\s*$')
_MAP_LINE = re.compile(r'^ .* -> .*$')


class Block:
  '''One block of a dump: a kind, a name and its normalized lines.'''
  def __init__(self, kind: str, name: str, header: str) -> None:
    self.kind = kind
    self.name = name
    self.header = header
    self.lines: List[str] = []

  def key(self) -> Tuple[int, str]:
    return KINDS.index(self.kind), self.name

  def text(self) -> str:
    return '\n'.join([f"## {self.header}", *self.lines])


def normalize_line(line: str) -> str:
  '''One line of a block: the offset column "N |", spaces collapsed.

  The text after the bar keeps its nesting (the spaces after the one that
  follows the bar, in a record layout); runs of spaces inside the text become
  one.  Another indented line (the "-- (B, 0) vtable address --" and
  "[this adjustment ...]" notes, "A | -24") gets a fixed indentation.
  '''
  line = line.rstrip()
  for regex, head in ((_OFFSET_LINE, None), (_CONTINUATION, '')):
    match = regex.match(line)
    if match:
      rest = match.group('rest')[1:] if match.group('rest').startswith(' ') \
        else match.group('rest')
      indent = len(rest) - len(rest.lstrip(' '))
      text = f"{' ' * indent}{re.sub(r' {2,}', ' ', rest.lstrip(' '))}"
      column = match.group('off') if head is None else head
      return f"{column} |{' ' if text else ''}{text}"
  if line.startswith(' '):
    return '    ' + re.sub(r' {2,}', ' ', line.lstrip(' '))
  return re.sub(r' {2,}', ' ', line)


def record_name(lines: List[str]) -> str:
  '''The "struct X" of the first "0 | struct X" line of a record layout.'''
  for line in lines:
    match = _OFFSET_LINE.match(line)
    if match:
      return match.group('rest').strip()
  return '?'


def parse_dump(text: str, keep_original_map: bool = False) -> List[Block]:
  '''Split a raw clang dump into blocks (not sorted).

  Lines of the other dumps clang prints with -fdump-record-layouts (the
  IRgen layout and the AST) are ignored.
  '''
  blocks: List[Block] = []
  current: Optional[Block] = None
  in_record = False
  in_map = False
  pending: List[str] = []
  for raw in text.splitlines():
    if _RECORD_HEADING.match(raw):
      current, in_record, in_map = None, True, False
      pending = []
      continue
    if _OTHER_HEADING.match(raw):
      current, in_record, in_map = None, False, False
      continue
    if _ORIGINAL_MAP.match(raw):
      current, in_record, in_map = None, False, True
      continue
    if in_map and _MAP_LINE.match(raw):
      if keep_original_map:
        pending.append(normalize_line(raw))
      continue
    in_map = False
    for kind, regex in _HEADINGS:
      match = regex.match(raw)
      if match:
        name = match.group('name')
        header = f"{kind} {name}"
        if kind == 'construction-vtable':
          header = f"{kind} {name} in {match.group('in')}"
          name = f"{name} in {match.group('in')}"
        header += f" ({match.group('n')})"
        current = Block(kind, name, header)
        current.lines = list(pending) if kind == 'vtable' else []
        pending = []
        blocks.append(current)
        in_record = False
        break
    else:
      if in_record:
        if not raw.strip():
          current = None
          continue
        if current is None:
          current = Block('record', '', '')
          blocks.append(current)
        current.lines.append(normalize_line(raw))
        continue
      if current is not None:
        if raw.strip():
          current.lines.append(normalize_line(raw))
  for block in blocks:
    if block.kind == 'record':
      block.name = record_name(block.lines)
      block.header = f"record {block.name}"
      block.lines = block.lines[1:] if block.lines else block.lines
  return blocks


def canonical(text: str, keep_original_map: bool = False) -> str:
  '''The canonical text of a raw dump, or of canonical text (idempotent).

  Blocks with the same kind and name are kept once if their lines are equal
  (clang can dump a layout more than once).
  '''
  if text.lstrip().startswith('## '):
    return text if text.endswith('\n') else text + '\n'
  seen: Dict[Tuple[str, str], Block] = {}
  order: List[Block] = []
  for block in parse_dump(text, keep_original_map):
    key = (block.header, '\n'.join(block.lines))
    if key in seen:
      continue
    seen[key] = block
    order.append(block)
  order.sort(key = lambda b: (b.key(), b.header, b.lines))
  return '\n'.join(b.text() for b in order) + ('\n' if order else '')


def diff_text(old: str, new: str, old_name: str = 'clang',
              new_name: str = 'ours') -> List[str]:
  '''The differences of two canonical texts, block by block.

  Returns [] if equal.  A block in only one of them is reported as such; a
  block in both with other lines gets a unified diff of its lines.
  '''
  def split(text: str) -> Dict[str, List[str]]:
    blocks: Dict[str, List[str]] = {}
    name = ''
    for line in text.splitlines():
      if line.startswith('## '):
        name = line[3:]
        blocks[name] = []
      elif name:
        blocks[name].append(line)
    return blocks
  # Compare by "kind name": the entry count in the header is part of it, so
  # a different vtable size is a different heading and also shows as a block
  # present on one side only; pair such headings by their kind and name.
  def base(heading: str) -> str:
    return re.sub(r' \(\d+ entr(?:y|ies)\)$', '', heading)
  a, b = split(old), split(new)
  by_a = {base(h): h for h in a}
  by_b = {base(h): h for h in b}
  report: List[str] = []
  for key in sorted(set(by_a) | set(by_b)):
    if key not in by_b:
      report.append(f"only in {old_name}: {by_a[key]}")
    elif key not in by_a:
      report.append(f"only in {new_name}: {by_b[key]}")
    else:
      ha, hb = by_a[key], by_b[key]
      if ha != hb or a[ha] != b[hb]:
        report.append(f"differs: {key}")
        report.extend(difflib.unified_diff(
          [ha, *a[ha]], [hb, *b[hb]], old_name, new_name, lineterm = '',
          n = 1))
  return report


def clang_binary(option: str = '') -> str:
  '''The clang to run: --clang, else $EDG_LLVM_CIR_PREFIX/bin/clang, else
  `clang` on PATH.'''
  if option:
    return option
  prefix = os.environ.get('EDG_LLVM_CIR_PREFIX', '')
  if prefix and (Path(prefix) / 'bin' / 'clang').exists():
    return str(Path(prefix) / 'bin' / 'clang')
  return shutil.which('clang') or 'clang'


def include_options(clang: str) -> List[str]:
  '''-internal-isystem options for `clang -cc1` (which, unlike the driver,
  knows no include path): the C++ library directories of
  $EDG_CLANG_INCL_SCRAPE (set in the cir-env image: libstdc++ and the C
  headers, without the system's own clang resource directory) and the
  resource directory of the clang that runs.'''
  options: List[str] = []
  for path in os.environ.get('EDG_CLANG_INCL_SCRAPE', '').split(':'):
    if path and not path.startswith('/usr/lib/clang'):
      options += ['-internal-isystem', path]
  resource = Path(clang).resolve().parent.parent / 'lib' / 'clang'
  for include in sorted(resource.glob('*/include')):
    options += ['-internal-isystem', str(include)]
  return options


def run_clang_dump(source: Path, clang: str, triple: str, std: str,
                   extra: List[str], records: bool = True,
                   vtables: bool = True) -> Tuple[int, str]:
  '''Run clang -cc1 on a source and return (exit status, its dump).'''
  command = [clang, '-cc1', '-triple', triple, f"-std={std}",
             '-fcxx-exceptions', '-fexceptions', *include_options(clang)]
  if vtables:
    command.append('-fdump-vtable-layouts')
  if records:
    command.append('-fdump-record-layouts')
  command += ['-w', *extra, '-emit-llvm-only', str(source)]
  # The vtable dump is on stdout and the record layouts are on stderr (with
  # the diagnostics): read both, one after the other, so that a diagnostic
  # never falls inside a layout (the canonical form sorts the blocks).
  try:
    proc = subprocess.run(command, stdout = subprocess.PIPE,
                          stderr = subprocess.PIPE, text = True,
                          timeout = COMPILE_TIMEOUT)
  except subprocess.TimeoutExpired:
    return 124, f"clang did not finish in {COMPILE_TIMEOUT} s"
  return proc.returncode, proc.stdout + proc.stderr


def ecil_dump_has_option(binary: str, option: str) -> Optional[bool]:
  '''Does `binary --help` mention the option?  None if it cannot be run.

  An ecil-dump without a --help option reports a usage error that lists its
  options; one that has the option lists it.'''
  try:
    proc = subprocess.run([binary, '--help'], stdout = subprocess.PIPE,
                          stderr = subprocess.PIPE, text = True)
  except OSError:
    return None
  return option in proc.stdout + proc.stderr


def ecil_dump_layouts(binary: str, ecil: str) -> Tuple[str, str]:
  '''Run `ecil-dump --vtable-layouts` on a stream.

  Returns ("ok", the text), ("skip", why) only if the ecil-dump does not
  have the option (its --help text does not list it), or ("error", why): once
  the option exists, a failing invocation is an error and never a SKIP.'''
  has_option = ecil_dump_has_option(binary, '--vtable-layouts')
  if has_option is None:
    return 'error', f"cannot run {binary}"
  if not has_option:
    return 'skip', f"{binary} has no --vtable-layouts option yet"
  try:
    proc = subprocess.run([binary, '--vtable-layouts', ecil],
                          stdout = subprocess.PIPE, stderr = subprocess.PIPE,
                          text = True)
  except OSError as error:
    return 'error', f"cannot run {binary}: {error}"
  if proc.returncode != 0:
    return 'error', (f"{binary} --vtable-layouts failed with status "
                     f"{proc.returncode}: {proc.stderr.strip()[:200]}")
  return 'ok', proc.stdout


def compare_result(clang_text: str, ours_text: str,
                   ours_name: str = 'ours') -> Tuple[int, List[str]]:
  '''The outcome of `compare` on two canonical texts: (exit status, report
  lines).  Two texts without any block compare nothing: SKIP, not equal.'''
  if not clang_text.strip() and not ours_text.strip():
    return EXIT_SKIP, ['SKIP: neither side has a layout block (nothing '
                       'was compared)']
  report = diff_text(clang_text, ours_text, 'clang', ours_name)
  return (1 if report else 0), (report or ['layouts identical'])


# The clang tests whose layouts `batch --clang-tests` compares (the vtable
# layout, thunk and covariant return tests; a name that is not in the
# directory is skipped, the list says which).
BATCH_TESTS = ('vtable-layout.cpp', 'vtable-layout-abi-examples.cpp',
               'vtable-layout-extreme.cpp', 'thunks.cpp', 'vtt-layout.cpp')


_FUNCTION_LINE = re.compile(r'^(?P<head>(?:## thunks |\d+ \| ))(?P<rest>.*)$')


def normalize_return_type(line: str) -> str:
  '''A vtable entry or thunk heading with the spelling of the return type
  that ecil-dump cannot know normalized: long long -> long, signed char ->
  char, a reference -> a pointer (the parameters are left alone).'''
  match = _FUNCTION_LINE.match(line)
  if not match or '(' not in match.group('rest'):
    return line
  rest = match.group('rest')
  head = rest.split('(')[0]
  depth = 0
  cut = -1
  for index, char in enumerate(head):
    depth += char == '<'
    depth -= char == '>'
    if char == ' ' and depth == 0:
      cut = index
  if cut < 0:
    return line
  # The "*" or "&" that clang prints against the function name belongs to
  # the return type.
  start = cut + len(re.match(r'^[\s*&]*', rest[cut:]).group(0))
  returns, name = rest[:start], rest[start:]
  returns = re.sub(r'\blong long\b', 'long', returns)
  returns = re.sub(r'\bsigned char\b', 'char', returns)
  returns = re.sub(r'&&|&', '*', returns)
  return match.group('head') + returns + name


_DEMANGLED: Dict[str, str] = {}


def demangle(name: str) -> str:
  '''c++filt of a mangled name (the name itself if there is no c++filt).'''
  if name not in _DEMANGLED:
    try:
      proc = subprocess.run(['c++filt', name], stdout = subprocess.PIPE,
                            text = True)
      _DEMANGLED[name] = proc.stdout.strip() or name
    except OSError:
      _DEMANGLED[name] = name
  return _DEMANGLED[name]


def _loose_function(rest: str) -> str:
  '''The function part of a vtable entry in the loose form: mangled names
  demangled, the return type and the namespace qualifiers dropped.'''
  rest = re.sub(r'_Z\w+', lambda m: demangle(m.group(0)), rest)
  paren = rest.find('(')
  if paren >= 0:
    head, tail = rest[:paren], rest[paren:]
    cut = -1
    depth = 0
    for index, char in enumerate(head):
      depth += char == '<'
      depth -= char == '>'
      if char == ' ' and depth == 0:
        cut = index
    rest = head[cut + 1:].lstrip('*& ') + tail
  return rest


def _loose_text(rest: str) -> str:
  rest = re.sub(r'\b(?:[A-Za-z_]\w*::)+(?=[A-Za-z_~])', '', rest)
  # clang prints the template name without its arguments.
  while re.search(r'<[^<>]*>', rest):
    rest = re.sub(r'<[^<>]*>', '', rest)
  rest = re.sub(r'(\w+) _Complex', r'_Complex \1', rest)
  rest = re.sub(r'(\w+) const\b', r'const \1', rest)
  return re.sub(r'\s+([&*])', r'\1', rest)


def _demangled_type(text: str) -> str:
  '''A class name that ecil-dump prints mangled (3BoxIiE) as c++filt
  spells it (Box<int>).'''
  def fix(match: 're.Match[str]') -> str:
    name = demangle('_ZTS' + match.group(0))
    return name[len('typeinfo name for '):] \
      if name.startswith('typeinfo name for ') else match.group(0)
  return re.sub(r'(?<![\w:])(?:N?\d+\w+E?)(?![\w:(])', fix, text)


def loose_line(line: str) -> str:
  '''A vtable entry or thunk heading in a form that ecil-dump's approximate
  spelling and clang's agree on: mangled names demangled, the return type
  left out (it is not part of the layout; the return adjustment line stays),
  namespace qualifiers and template arguments dropped, spaces around * and
  &, and the position of const unified.'''
  match = _FUNCTION_LINE.match(line)
  if match and match.group('rest').endswith(' RTTI'):
    return match.group('head') + _loose_text(_demangled_type(
      match.group('rest')[:-5])) + ' RTTI'
  if match and match.group('head') == '## thunks ':
    # The function is the key of the block: keep its class, drop the return
    # type and the template arguments.
    text = _loose_function(match.group('rest'))
    while re.search(r'<[^<>]*>', text):
      text = re.sub(r'<[^<>]*>', '', text)
    paren = text.find('(')
    if paren >= 0:
      # The parameter types are spelled with and without their namespaces.
      text = text[:paren] + re.sub(
        r'\b(?:[A-Za-z_]\w*::)+(?=[A-Za-z_~])', '', text[paren:])
    text = re.sub(r'(\w+) _Complex', r'_Complex \1', text)
    text = re.sub(r'(\w+) const\b', r'const \1', text)
    return match.group('head') + re.sub(r'\s+([&*])', r'\1', text)
  if match:
    return match.group('head') + _loose_text(_loose_function(
      match.group('rest')))
  continuation = re.match(r'^(\s+\[.*\] method: )(.*)$', line)
  if continuation:
    return continuation.group(1) + _loose_text(_loose_function(
      continuation.group(2)))
  address = re.match(r'^(\s+-- \()(.*?)(, \d+\) vtable address --)$', line)
  if address:
    return address.group(1) + _loose_text(_demangled_type(
      address.group(2))) + address.group(3)
  heading = re.match(
    r'^(## (?:vtable|vtable-indices|vbase-offset-offsets) )(.*?)'
    r'( \(\d+ entr(?:y|ies)\))$', line)
  if heading:
    # The class name is the key of the block: keep its namespaces, drop the
    # template arguments that clang does not print.
    name = _demangled_type(heading.group(2))
    while re.search(r'<[^<>]*>', name):
      name = re.sub(r'<[^<>]*>', '', name)
    return heading.group(1) + name + heading.group(3)
  return line


def split_blocks(text: str, normalize: bool = False,
                 raw: Optional[Dict[Tuple[str, str], List[str]]] = None,
                 loose: bool = False
                 ) -> Dict[Tuple[str, str], Tuple[str, List[str]]]:
  '''The blocks of a canonical text by (kind, name): (heading, lines).  With
  normalize the return types are normalized (see normalize_return_type); with
  loose the lines are put in the form of loose_line; raw, if given, receives
  the lines as they were, by the same keys.'''
  blocks: Dict[Tuple[str, str], Tuple[str, List[str]]] = {}
  key: Optional[Tuple[str, str]] = None
  for original in text.splitlines():
    line = normalize_return_type(original) if normalize else original
    if loose:
      line = loose_line(line)
    if line.startswith('## '):
      heading = line[3:]
      kind, _, rest = heading.partition(' ')
      name = re.sub(r' \(\d+ entr(?:y|ies)\)$', '', rest)
      key = (kind, name)
      blocks[key] = (heading, [])
      if raw is not None:
        raw[key] = [original]
    elif key is not None:
      blocks[key][1].append(line)
      if raw is not None:
        raw[key].append(original)
  return blocks


def class_name(kind: str, name: str) -> str:
  '''The class a block is about: the record's class (without struct/class),
  the vtable's, the one a thunk block's function belongs to.'''
  if kind == 'record':
    return re.sub(r'^(struct|class|union) ', '', name)
  if kind == 'construction-vtable':
    return name.rsplit(' in ', 1)[-1]
  if kind == 'thunks':
    head = name.split('(')[0]
    qualified = head.rsplit('::', 1)[0] if '::' in head else head
    depth = 0
    start = 0
    for index, char in enumerate(qualified):
      depth += char == '<'
      depth -= char == '>'
      if char == ' ' and depth == 0:
        start = index + 1
    return qualified[start:].lstrip('*& ')
  return name


def vbase_classes(blocks: Dict[Tuple[str, str], Tuple[str, List[str]]]
                  ) -> set:
  '''The classes whose record layout shows a virtual base (their own or an
  inherited one).'''
  return {class_name(kind, name) for (kind, name), (_, lines)
          in blocks.items()
          if kind == 'record' and any('(virtual base)' in l for l in lines)}


def batch_compare(clang_text: str, ours_text: str,
                  fe_classes: Optional[set] = None, vbases: bool = False
                  ) -> Tuple[Dict[str, int], List[str]]:
  '''Compare the layouts of the classes without virtual bases.

  fe_classes is the set of classes whose front end facts disagree with
  clang's (edg-cir-fe-facts), or None if that is not known.  With vbases the
  classes with virtual bases are compared too (S2: construction vtables and
  virtual base offset blocks included).  Returns
  (counts, report): the counts of blocks that are "identical" (of which
  "normalized" were equal only after the return types were normalized),
  blocks equal only in the loose form ("spelling": mangled names demangled,
  return types and namespace qualifiers dropped),
  differ because of the front end ("fe"), because of the library ("ours"),
  for unknown reasons ("unknown"), are "missing" from ours, clang blocks left
  out for virtual bases ("vbase") and clang record blocks that ours does not
  print ("norecord": not a difference); and the report lines.'''
  clang_raw: Dict[Tuple[str, str], List[str]] = {}
  ours_raw: Dict[Tuple[str, str], List[str]] = {}
  clang = split_blocks(clang_text, True, clang_raw)
  ours = split_blocks(ours_text, True, ours_raw)
  skip = set() if vbases else vbase_classes(clang)
  has_records = any(kind == 'record' for kind, _ in ours)
  # The second look: the same blocks in the loose form (see loose_line).
  def loose_block(block: Tuple[str, List[str]]
                  ) -> Tuple[Tuple[str, str], Tuple[str, List[str]]]:
    heading = loose_line('## ' + block[0])[3:]
    kind, _, rest = heading.partition(' ')
    name = re.sub(r' \(\d+ entr(?:y|ies)\)$', '', rest)
    lines = [loose_line(l) for l in block[1]]
    # The vtable address lines of the classes that share an address are
    # listed in another order (not part of the layout).
    ordered: List[str] = []
    run: List[str] = []
    for line in lines + ['']:
      if line.lstrip().startswith('-- (') and \
          line.endswith('vtable address --'):
        run.append(line)
      else:
        ordered.extend(sorted(run))
        run = []
        ordered.append(line)
    return (kind, name), (heading, ordered[:-1])
  ours_by_loose = dict(loose_block(b) for b in ours.values())
  counts = {'identical': 0, 'normalized': 0, 'spelling': 0, 'fe': 0,
            'ours': 0, 'unknown': 0, 'missing': 0, 'vbase': 0,
            'norecord': 0}
  report: List[str] = []
  def differs(key: Tuple[str, str]) -> bool:
    return key not in ours or clang[key] != ours[key]
  for key in sorted(clang):
    kind, name = key
    klass = class_name(kind, name)
    if not vbases and (kind in ('construction-vtable',
                               'vbase-offset-offsets') or klass in skip):
      counts['vbase'] += 1
      continue
    if key not in ours or differs(key):
      loose_key, loose_content = loose_block(clang[key])
      if kind != 'record' and ours_by_loose.get(loose_key) == loose_content:
        # Equal but for the spelling of names that ecil-dump cannot know.
        counts['spelling'] += 1
        continue
    if key not in ours:
      if kind == 'record' and not has_records:
        counts['norecord'] += 1
        continue
      counts['missing'] += 1
      report.append(f"MISSING {clang[key][0]}")
      continue
    if not differs(key):
      counts['identical'] += 1
      if clang_raw[key] != ours_raw.get(key):
        counts['normalized'] += 1
      continue
    record = ('record', next((n for k, n in clang
                              if k == 'record' and class_name(k, n) == klass),
                             ''))
    if kind == 'record':
      who = 'fe'
    elif has_records and record in clang and record in ours:
      who = 'fe' if differs(record) else 'ours'
    elif fe_classes is not None:
      who = 'fe' if klass in fe_classes else 'ours'
    else:
      who = 'unknown'
    counts[who] += 1
    diff = list(difflib.unified_diff(
      [clang[key][0], *clang[key][1]], [ours[key][0], *ours[key][1]],
      'clang', 'ours', lineterm = '', n = 0))
    report.append(f"DIFFERS ({who.upper()}) {clang[key][0]}")
    report.extend('    ' + line for line in diff[:14])
  return counts, report


def fe_disagreeing_classes(source: Path, root: Path, fe_build: str,
                           std: str) -> Optional[set]:
  '''The classes whose layout facts of the front end disagree with clang's
  (edg-cir-fe-facts check), or None if it cannot be run.'''
  tool = Path(__file__).resolve().parent / 'edg-cir-fe-facts'
  try:
    proc = subprocess.run(
      [sys.executable, str(tool), 'check', '--std', std, str(source)],
      cwd = root, stdout = subprocess.PIPE, stderr = subprocess.STDOUT,
      text = True, timeout = 2 * COMPILE_TIMEOUT)
  except (OSError, subprocess.TimeoutExpired):
    return None
  if 'agreements' not in proc.stdout:
    return None
  return {m.group(1)
          for m in re.finditer(r'^DISAGREE \S+ (.+?): ', proc.stdout, re.M)}


def compile_ecil(source: Path, work: Path, root: Path, fe_build: str,
                 std: str, extra: List[str]) -> Tuple[Optional[Path], str]:
  '''Compile a file with cpfe-cir like the edg_x86_64_cir configuration
  and keep the ECIL stream: (the stream or None, the compiler's output).
  A wrapper for CPFE adds --ecil_output; the stream is there even if the
  writer diagnosed constructs.'''
  exports: Dict[str, str] = {}
  env_file = root / fe_build / 'environment.sh'
  if env_file.exists():
    for line in env_file.read_text().splitlines():
      match = re.match(r'export (\w+)="?([^"]*)"?$', line)
      if match:
        exports[match.group(1)] = match.group(2)
  if 'CPFE_CIR' not in exports:
    raise RuntimeError(f"{env_file} has no CPFE_CIR (build cpfe-cir)")
  stream = work / (source.stem + '.ecil')
  wrapper = work / 'cpfe-wrapper.sh'
  wrapper.write_text(f"#!/bin/sh\nexec {exports['CPFE_CIR']} "
                     f"--ecil_output={stream} \"$@\"\n")
  wrapper.chmod(0o755)
  env = dict(os.environ)
  env.update(exports)
  env['EDG_BASE'] = str(root / 'bases/docker/cir-env/gcc')
  env['ECCP_LIBDIR'] = exports.get('EDG_CIR_RT_LIBDIR', '')
  env['CPFE'] = str(wrapper)
  env['EDG_USE_SYSTEM_HEADERS'] = '1'
  local = work / source.name
  shutil.copy2(source, local)
  try:
    proc = subprocess.run(
      [str(root / 'util/eccp.sh'), '-c', '-tused', f"--{std}", *extra,
       local.name], cwd = work, env = env, stdout = subprocess.PIPE,
      stderr = subprocess.STDOUT, text = True, timeout = COMPILE_TIMEOUT)
  except subprocess.TimeoutExpired:
    return None, f"cpfe-cir did not finish in {COMPILE_TIMEOUT} s"
  return (stream if stream.exists() and stream.stat().st_size else None,
          proc.stdout)


def find_ecil_dump(option: str, root: Path) -> str:
  '''The ecil-dump to run: the option if it is not the plain name, else the
  one on PATH, else the one of the build/cir tree.'''
  if option != 'ecil-dump':
    return option
  found = shutil.which('ecil-dump')
  if found:
    return found
  for build in ('cir', 'cir-release', 'cir-asan'):
    candidate = root / 'build' / build / 'tools/ecil-dump/ecil-dump'
    if candidate.exists():
      return str(candidate)
  return option


def run_batch(sources: List[Path], args: argparse.Namespace) -> int:
  '''The `batch` command; returns the exit status.'''
  clang = clang_binary(args.clang)
  root = Path(args.root).resolve()
  args.ecil_dump = find_ecil_dump(args.ecil_dump, root)
  has_option = ecil_dump_has_option(args.ecil_dump, '--vtable-layouts')
  if has_option is None:
    print(f"edg-cir-abi-diff: cannot run {args.ecil_dump}", file = sys.stderr)
    return 2
  if not has_option:
    print(f"SKIP: {args.ecil_dump} has no --vtable-layouts option yet")
    return EXIT_SKIP
  totals = {'identical': 0, 'normalized': 0, 'spelling': 0, 'fe': 0,
            'ours': 0, 'unknown': 0, 'missing': 0, 'vbase': 0,
            'norecord': 0}
  results: List[Tuple[str, str]] = []
  for source in sources:
    with tempfile.TemporaryDirectory(prefix = 'edg-cir-abi.') as tmp:
      work = Path(tmp)
      rc, dump = run_clang_dump(source, clang, args.triple, args.std,
                                args.extra)
      if rc != 0:
        results.append((source.name, 'CLANG-FAIL'))
        print(f"==== {source}\nclang failed with status {rc}\n", flush = True)
        continue
      try:
        stream, output = compile_ecil(source, work, root, args.fe_build,
                                      args.std, [])
      except RuntimeError as error:
        print(f"edg-cir-abi-diff: {error}", file = sys.stderr)
        return 2
      if stream is None:
        kind = 'SKIP' if re.search(
          r'CIR back end:.*(cannot express|not supported yet)', output,
          re.S) else 'FE-REJECT'
        results.append((source.name, kind))
        print(f"==== {source}\n{kind}: no stream: "
              f"{output.strip().splitlines()[-1:]}\n", flush = True)
        continue
      state, ours_raw = ecil_dump_layouts(args.ecil_dump, str(stream))
      if state == 'skip':
        print(f"SKIP: {ours_raw}")
        return EXIT_SKIP
      if state == 'error':
        results.append((source.name, 'DUMP-FAIL'))
        print(f"==== {source}\n{ours_raw}\n", flush = True)
        continue
      fe_classes = fe_disagreeing_classes(source, root, args.fe_build,
                                          args.std)
      counts, report = batch_compare(canonical(dump), canonical(ours_raw),
                                     fe_classes, args.vbases)
      for key in totals:
        totals[key] += counts[key]
      status = 'PASS' if not (counts['fe'] or counts['ours'] or
                              counts['unknown'] or counts['missing']) \
        else 'DIFF'
      results.append((source.name, status))
      print(f"==== {source}: {status} " + ', '.join(
        f"{k} {v}" for k, v in counts.items()), flush = True)
      print('\n'.join(report) + ('\n' if report else ''), flush = True)
  print(f"{'file':<44}result")
  for name, result in results:
    print(f"{name:<44}{result}")
  print('blocks: ' + ', '.join(f"{k} {v}" for k, v in totals.items()))
  print(f"({totals['normalized']} of the identical blocks needed the "
        f"return type spelling normalized; {totals['spelling']} more blocks "
        f"are equal only in the loose form: demangled names, no return "
        f"types, no namespace qualifiers)")
  bad = any(r not in ('PASS', 'SKIP', 'FE-REJECT') for _, r in results) or \
    totals['fe'] or totals['ours'] or totals['unknown'] or totals['missing']
  return 1 if bad else 0


def gather(source_dir: Path, out_dir: Path) -> List[str]:
  '''Copy the CLANG_TESTS that exist in source_dir (clang/test/CodeGenCXX)
  to out_dir; returns the names copied.'''
  out_dir.mkdir(parents = True, exist_ok = True)
  copied = []
  for name in CLANG_TESTS:
    if (source_dir / name).exists():
      shutil.copy2(source_dir / name, out_dir / name)
      copied.append(name)
  return copied


def read_text(path: str) -> str:
  return sys.stdin.read() if path == '-' else Path(path).read_text(
    errors = 'replace')


# A sample of clang's output (struct A { virtual int f(); virtual ~A(); };
# struct B : virtual A { int f() override; }), for the self-test.
SAMPLE = '''
*** Dumping AST Record Layout
         0 | struct B
         0 |   (B vtable pointer)
         8 |   int b
        16 |   struct A (virtual base)
        16 |     (A vtable pointer)
        24 |     int a
           | [sizeof=32, dsize=28, align=8,
           |  nvsize=12, nvalign=8]

Original map
 C::~C() -> B::~B()
Vtable for 'B' (6 entries).
   0 | vbase_offset (16)
   1 | offset_to_top (0)
   2 | B RTTI
       -- (B, 0) vtable address --
   3 | int B::f()
   4 | vcall_offset (-16)
   5 | offset_to_top (-16)

Virtual base offset offsets for 'B' (1 entry).
   A | -24

Thunks for 'int B::f()' (1 entry).
   0 | this adjustment: 0 non-virtual, -24 vcall offset offset

VTable indices for 'B' (1 entry).
   0 | int B::f()

*** Dumping IRgen Record Layout
Record: CXXRecordDecl 0x1 <t.cpp:2:1> struct B definition
Layout: <CGRecordLayout
]>
'''


class SelfTest(unittest.TestCase):
  def test_canonical_form(self) -> None:
    text = canonical(SAMPLE)
    self.assertIn('## record struct B\n0 |   (B vtable pointer)', text)
    self.assertIn('## vtable B (6 entries)\n0 | vbase_offset (16)', text)
    self.assertNotIn('Original map', text)
    self.assertNotIn('IRgen', text)
    self.assertNotIn('CGRecordLayout', text)
    # The blocks are sorted by kind, then name.
    heads = [l for l in text.splitlines() if l.startswith('## ')]
    self.assertEqual([h.split()[1] for h in heads],
                     ['record', 'vtable', 'vtable-indices',
                      'vbase-offset-offsets', 'thunks'])
    # Idempotent, and the canonical text is accepted as input.
    self.assertEqual(canonical(text), text)

  def test_order_and_spacing_do_not_matter(self) -> None:
    reordered = SAMPLE.replace('   3 | int B::f()', '3 | int B::f()')
    self.assertEqual(canonical(reordered), canonical(SAMPLE))
    blocks = SAMPLE.split('\n\n')
    shuffled = '\n\n'.join(reversed(blocks[:5]))
    self.assertEqual(canonical(shuffled), canonical('\n\n'.join(blocks[:5])))

  def test_keep_original_map(self) -> None:
    self.assertIn('C::~C() -> B::~B()', canonical(SAMPLE, True))

  def test_diff(self) -> None:
    ours = canonical(SAMPLE.replace('(B, 0) vtable address',
                                    '(B, 8) vtable address'))
    clang = canonical(SAMPLE)
    self.assertEqual(diff_text(clang, clang), [])
    report = diff_text(clang, ours)
    self.assertEqual(report[0], 'differs: vtable B')
    self.assertTrue(any(l.startswith('-') and '(B, 0)' in l for l in report))
    self.assertTrue(any(l.startswith('+') and '(B, 8)' in l for l in report))
    # A vtable with another number of entries pairs with the same name.
    other = canonical(SAMPLE.replace('(6 entries)', '(7 entries)'))
    self.assertEqual(diff_text(clang, other)[0], 'differs: vtable B')
    # A block that one side lacks.
    missing = canonical(SAMPLE.split('Thunks for')[0])
    self.assertEqual(diff_text(clang, missing)[0],
                     'only in clang: thunks int B::f() (1 entry)')

  def test_compare_result_never_passes_nothing(self) -> None:
    clang = canonical(SAMPLE)
    self.assertEqual(compare_result(clang, clang)[0], 0)
    # Nothing on either side is SKIP, not "identical".
    self.assertEqual(compare_result('', '')[0], EXIT_SKIP)
    # Clang has layouts and the library side has none: they differ.
    status, report = compare_result(clang, '')
    self.assertEqual(status, 1)
    self.assertTrue(report[0].startswith('only in clang'))

  def test_ecil_dump_without_the_option_is_skip(self) -> None:
    with tempfile.TemporaryDirectory() as tmp:
      def tool(name: str, body: str) -> str:
        path = Path(tmp) / name
        path.write_text('#!/bin/sh\n' + body)
        path.chmod(0o755)
        return str(path)
      # Today's ecil-dump: every unknown option is a usage error that does
      # not list --vtable-layouts.
      old = tool('old', 'echo "usage: ecil-dump [--no-check] [--offsets] '
                 'file.ecil|-" >&2\nexit 2\n')
      self.assertEqual(ecil_dump_layouts(old, 'x.ecil')[0], 'skip')
      # An ecil-dump that has the option: --help lists it, and an
      # invocation error (here a usage error, status 2) is an error.
      new = tool('new', 'if [ "$1" = --help ]; then echo "usage: ecil-dump '
                 '[--vtable-layouts] file.ecil|-" >&2; exit 2; fi\n'
                 'echo "## vtable A (3 entries)"\n')
      self.assertEqual(ecil_dump_layouts(new, 'x.ecil'),
                       ('ok', '## vtable A (3 entries)\n'))
      bad = tool('bad', 'if [ "$1" = --help ]; then echo "usage: ecil-dump '
                 '[--vtable-layouts] file.ecil|-" >&2; exit 2; fi\n'
                 'echo "usage: ecil-dump [--vtable-layouts] file.ecil|-" '
                 '>&2\nexit 2\n')
      self.assertEqual(ecil_dump_layouts(bad, 'x.ecil')[0], 'error')
      broken = tool('broken', 'if [ "$1" = --help ]; then echo '
                    '"--vtable-layouts"; exit 0; fi\n'
                    'echo "format error" >&2\nexit 1\n')
      self.assertEqual(ecil_dump_layouts(broken, 'x.ecil')[0], 'error')
      self.assertEqual(ecil_dump_layouts(str(Path(tmp) / 'none'),
                                         'x.ecil')[0], 'error')

  def test_batch_filters_virtual_bases_and_attributes(self) -> None:
    text = canonical(SAMPLE)    # B has a virtual base A
    counts, report = batch_compare(text, text)
    # Everything about B (record, vtable, indices, thunks, vbase offsets) is
    # skipped as a class with a virtual base.
    self.assertEqual(counts['identical'], 0)
    self.assertEqual(counts['vbase'], 5)
    # A class without virtual bases: compared block by block.
    plain = canonical('''
*** Dumping AST Record Layout
         0 | struct P
         0 |   (P vtable pointer)
         8 |   int p
           | [sizeof=16, dsize=12, align=8,
           |  nvsize=12, nvalign=8]

Vtable for 'P' (3 entries).
   0 | offset_to_top (0)
   1 | P RTTI
       -- (P, 0) vtable address --
   2 | void P::f()

Thunks for 'void Q::f()' (1 entry).
   0 | this adjustment: -16 non-virtual
''')
    counts, report = batch_compare(plain, plain)
    self.assertEqual(counts['identical'], 3)
    self.assertEqual(report, [])
    # The record agrees and the vtable differs: ours.
    changed = plain.replace('void P::f()', 'void P::g()')
    counts, report = batch_compare(plain, changed)
    self.assertEqual((counts['ours'], counts['fe']), (1, 0))
    self.assertTrue(report[0].startswith('DIFFERS (OURS) vtable P'))
    # The record differs too: the front end's layout.
    other = plain.replace('8 |   int p', '4 |   int p').replace(
      'void P::f()', 'void P::g()')
    counts, report = batch_compare(plain, other)
    self.assertEqual(counts['fe'], 2)
    # No record layout on our side: unknown.
    counts, report = batch_compare(plain, '## ' + '## '.join(
      b for b in plain.split('## ')[1:] if not b.startswith('record')
    ).replace('void P::f()', 'void P::g()'))
    self.assertEqual(counts['unknown'], 1)
    # Our side has no record block: not a difference.
    self.assertEqual((counts['missing'], counts['norecord']), (0, 1))

  def test_return_type_normalization_and_missing_records(self) -> None:
    clang = canonical('''
*** Dumping AST Record Layout
         0 | struct P
         0 |   (P vtable pointer)
         8 |   int p
           | [sizeof=16, dsize=12, align=8,
           |  nvsize=12, nvalign=8]

Vtable for 'P' (4 entries).
   0 | offset_to_top (0)
   1 | P RTTI
       -- (P, 0) vtable address --
   2 | long long P::f()
   3 | signed char P::g(int)
   4 | Q &P::h()

Thunks for 'long long P::f()' (1 entry).
   0 | this adjustment: -16 non-virtual
''')
    ours = canonical('''
Vtable for 'P' (4 entries).
   0 | offset_to_top (0)
   1 | P RTTI
       -- (P, 0) vtable address --
   2 | long P::f()
   3 | char P::g(int)
   4 | Q *P::h()

Thunks for 'long P::f()' (1 entry).
   0 | this adjustment: -16 non-virtual
''')
    # No record block on our side is not a difference; the vtable and the
    # thunk heading are equal after normalization (2 blocks needed it).
    counts, report = batch_compare(clang, ours)
    self.assertEqual(report, [])
    self.assertEqual((counts['identical'], counts['normalized'],
                      counts['norecord']), (2, 2, 1))
    # A parameter is not normalized: that is a difference, attributed to
    # ours when the front end facts of the class agree, to the FE if not.
    other = ours.replace('P::g(int)', 'P::g(long)')
    counts, report = batch_compare(clang, other, set())
    self.assertEqual((counts['ours'], counts['fe']), (1, 0))
    counts, report = batch_compare(clang, other, {'P'})
    self.assertEqual((counts['ours'], counts['fe']), (0, 1))
    counts, report = batch_compare(clang, other)
    self.assertEqual(counts['unknown'], 1)
    self.assertEqual(normalize_return_type('3 | unsigned char X::f()'),
                     '3 | unsigned char X::f()')
    self.assertEqual(normalize_return_type('2 | unsigned long long X::f()'),
                     '2 | unsigned long X::f()')

  def test_batch_with_vbases(self) -> None:
    text = canonical(SAMPLE)    # B has a virtual base A
    counts, report = batch_compare(text, text, None, True)
    self.assertEqual(counts['vbase'], 0)
    self.assertEqual(counts['identical'], 5 - counts['norecord'])
    changed = text.replace('(B, 0) vtable address', '(B, 8) vtable address')
    counts, report = batch_compare(text, changed, set(), True)
    self.assertEqual(counts['ours'], 1)
    self.assertEqual(class_name('construction-vtable', "'B', 16 in D"), 'D')

  def test_loose_spelling(self) -> None:
    clang = canonical('''
Vtable for 'Test2::A' (4 entries).
   0 | offset_to_top (0)
   1 | Test2::A RTTI
       -- (Test2::A, 0) vtable address --
   2 | A *Test2::A::g(int)
   3 | A *Test2::A::operator=(const A &)

VTable indices for 'Test2::A' (2 entries).
   0 | A *Test2::A::g(int)
   1 | A *Test2::A::operator=(const A &)
''')
    ours = canonical('''
Vtable for 'Test2::A' (4 entries).
   0 | offset_to_top (0)
   1 | Test2::A RTTI
       -- (Test2::A, 0) vtable address --
   2 | Test2::A *Test2::A::g(int)
   3 | ? *_ZN5Test21AaSERKS0_

VTable indices for 'Test2::A' (2 entries).
   0 | Test2::A *Test2::A::g(int)
   1 | ? *_ZN5Test21AaSERKS0_
''')
    counts, report = batch_compare(clang, ours, set())
    self.assertEqual(report, [])
    self.assertEqual(counts['spelling'] + counts['normalized'], 2)
    # A different entry is still a difference.
    other = ours.replace('Test2::A::g(int)', 'Test2::A::h(int)')
    counts, report = batch_compare(clang, other, set())
    self.assertEqual(counts['ours'], 2)

  def test_class_name(self) -> None:
    self.assertEqual(class_name('record', 'struct A'), 'A')
    self.assertEqual(class_name('vtable', 'N::A<int>'), 'N::A<int>')
    self.assertEqual(class_name('thunks', 'int B::f()'), 'B')
    self.assertEqual(class_name('thunks', 'A<int> *N::D::g(int)'), 'N::D')

  def test_clang_if_present(self) -> None:
    clang = clang_binary()
    if not shutil.which(clang) and not Path(clang).exists():
      self.skipTest('no clang')
    with tempfile.TemporaryDirectory() as tmp:
      source = Path(tmp) / 't.cpp'
      source.write_text('struct A { virtual int f(); int a; };\n'
                        'struct B : A { int f(); };\n'
                        'int A::f() { return 1; }\n'
                        'int B::f() { return 2; }\n')
      rc, out = run_clang_dump(source, clang, DEFAULT_TRIPLE, 'c++17', [])
      if rc != 0:
        self.skipTest(f"{clang} cannot dump: {out[:100]}")
      text = canonical(out)
      self.assertIn('## vtable A (3 entries)', text)
      self.assertIn('## vtable B (3 entries)', text)
      self.assertIn('## record struct B', text)
      self.assertIn('2 | int B::f()', text)


def main() -> None:
  parser = argparse.ArgumentParser(
    description = __doc__.split('\n')[0],
    formatter_class = argparse.RawDescriptionHelpFormatter,
    epilog = __doc__.split('\n', 2)[2]
  )
  parser.add_argument('command', nargs = '?',
                      choices = ('dump', 'normalize', 'diff', 'compare',
                                 'gather', 'batch'))
  parser.add_argument('args', nargs = '*')
  parser.add_argument('--clang', default = '')
  parser.add_argument('--triple', default = DEFAULT_TRIPLE)
  parser.add_argument('--std', default = 'c++17')
  parser.add_argument('--ours', default = '',
                      help = 'compare: the library side (raw or canonical)')
  parser.add_argument('--ecil', default = '',
                      help = 'compare: a stream; the library side is the '
                             'output of ecil-dump --vtable-layouts')
  parser.add_argument('--ecil-dump', default = 'ecil-dump',
                      help = 'the ecil-dump to run for --ecil')
  parser.add_argument('--root', default = '.', help = 'repository root')
  parser.add_argument('--fe-build', default = 'build/gcc-cir')
  parser.add_argument('--vbases', action = 'store_true',
                      help = 'batch: compare the classes with virtual bases '
                             'too (S2)')
  parser.add_argument('--clang-tests', default = '',
                      help = 'batch: the clang test directory '
                             '(CodeGenCXX); runs its BATCH_TESTS')
  parser.add_argument('--no-records', action = 'store_true')
  parser.add_argument('--no-vtables', action = 'store_true')
  parser.add_argument('--keep-original-map', action = 'store_true')
  parser.add_argument('--self-test', action = 'store_true')
  parser.add_argument('-o', dest = 'output', default = '')
  parser.add_argument('-X', dest = 'extra', action = 'append', default = [],
                      help = 'an extra clang -cc1 option (repeatable)')
  args = parser.parse_args()

  if args.self_test:
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(SelfTest)
    result = unittest.TextTestRunner(verbosity = 1).run(suite)
    sys.exit(0 if result.wasSuccessful() else 1)
  if not args.command:
    parser.error('a command or --self-test is required')

  def emit(text: str) -> None:
    if args.output:
      Path(args.output).write_text(text)
    else:
      sys.stdout.write(text)

  if args.command == 'batch':
    sources: List[Path] = []
    for item in args.args:
      path = Path(item)
      sources.extend(sorted(path.glob('*.cpp')) if path.is_dir() else [path])
    if args.clang_tests:
      sources += [Path(args.clang_tests) / n for n in BATCH_TESTS
                  if (Path(args.clang_tests) / n).exists()]
    if not sources:
      parser.error('batch needs files, directories or --clang-tests')
    sys.exit(run_batch(sources, args))
  if args.command == 'gather':
    if len(args.args) != 1:
      parser.error('gather DIR: the directory to copy to')
    default = Path(os.environ.get('LLVM_PROJECT', Path.home() /
                                  'edg-cir-config/llvm-project'))
    source_dir = default / 'clang/test/CodeGenCXX'
    copied = gather(source_dir, Path(args.args[0]))
    print(f"copied {len(copied)} of {len(CLANG_TESTS)} files from "
          f"{source_dir} to {args.args[0]}")
    return
  if args.command in ('dump', 'compare'):
    if len(args.args) != 1:
      parser.error(f"{args.command} FILE.cpp")
    rc, out = run_clang_dump(Path(args.args[0]), clang_binary(args.clang),
                             args.triple, args.std, args.extra,
                             not args.no_records, not args.no_vtables)
    if rc != 0:
      print(out, file = sys.stderr)
      print(f"clang failed with status {rc}", file = sys.stderr)
      sys.exit(2)
    clang_text = canonical(out, args.keep_original_map)
    if args.command == 'dump':
      emit(clang_text)
      return
    if bool(args.ours) == bool(args.ecil):
      parser.error('compare needs one of --ours and --ecil')
    if args.ecil:
      state, ours_raw = ecil_dump_layouts(args.ecil_dump, args.ecil)
      if state == 'skip':
        print(f"SKIP: {ours_raw}")
        sys.exit(EXIT_SKIP)
      if state == 'error':
        print(f"edg-cir-abi-diff: {ours_raw}", file = sys.stderr)
        sys.exit(2)
    else:
      ours_raw = read_text(args.ours)
    status, report = compare_result(
      clang_text, canonical(ours_raw, args.keep_original_map))
    print('\n'.join(report))
    sys.exit(status)
  if args.command == 'normalize':
    if len(args.args) != 1:
      parser.error('normalize DUMP.txt (or -)')
    emit(canonical(read_text(args.args[0]), args.keep_original_map))
    return
  if args.command == 'diff':
    if len(args.args) != 2:
      parser.error('diff A B')
    report = diff_text(canonical(read_text(args.args[0]),
                                 args.keep_original_map),
                       canonical(read_text(args.args[1]),
                                 args.keep_original_map),
                       args.args[0], args.args[1])
    print('\n'.join(report) if report else 'identical')
    sys.exit(1 if report else 0)


if __name__ == '__main__':
  main()
