; C++ (ECIL 1.2, slice S3): RTTI.  The classes A, B : A, C : virtual A, M1 : A,
; M2 : A, Both : M1, M2 and Priv : private A, their vtables and typeinfo are the
; ECIL writer's output for the source (the writer does not emit TYPEID or
; DYNAMIC_CAST yet: the functions below are added to its stream by hand).  New:
; typeinfo of the types that are not classes (TYPEINFO_DEF: int and int* are
; the runtime's, int**, void(int), void(*)(int), int[3], an enum and int A::*
; are defined here with the runtime's __pointer_type_info,
; __function_type_info, __array_type_info, __enum_type_info and
; __pointer_to_member_type_info), the static form of TYPEID, the dynamic form
; with and without the null check (__cxa_bad_typeid), DYNAMIC_CAST to a derived
; class, to a class that has a virtual base, across (M1 to M2 in Both), to a
; class that has the source as a private base, to the complete object
; (void *) and to a reference (bad_cast).  A g++ and a clang unit
; (Inputs/s3_rtti_host.cpp) compare the typeinfo objects and the results.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s3_rtti_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -c %S/Inputs/s3_rtti_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe
; RUN: %edg-cir --emit=obj -O2 -o %t.o2.o %t.ecil
; RUN: g++ %t.host.o %t.o2.o -o %t.o2.exe
; RUN: %t.o2.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; CHECK-DAG: cir.global constant linkonce_odr comdat dso_local @_ZTIPPi = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv119__pointer_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTSPPi> : !cir.ptr<!u8i>, #cir.int<0> : !u32i, #cir.global_view<@_ZTIPi> : !cir.ptr<!u8i>}>
; CHECK-DAG: cir.global constant linkonce_odr comdat dso_local @_ZTIFviE = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv120__function_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTSFviE> : !cir.ptr<!u8i>}>
; CHECK-DAG: cir.global constant linkonce_odr comdat dso_local @_ZTIA3_i = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv117__array_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTSA3_i> : !cir.ptr<!u8i>}>
; CHECK-DAG: cir.global constant linkonce_odr comdat dso_local @_ZTI1E = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv116__enum_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTS1E> : !cir.ptr<!u8i>}>
; CHECK-DAG: cir.global constant linkonce_odr comdat dso_local @_ZTIM1Ai = #cir.typeinfo<{#cir.global_view<@_ZTVN10__cxxabiv129__pointer_to_member_type_infoE, [2 : i32]> : !cir.ptr<!u8i>, #cir.global_view<@_ZTSM1Ai> : !cir.ptr<!u8i>, #cir.int<0> : !u32i, #cir.global_view<@_ZTIi> : !cir.ptr<!u8i>, #cir.global_view<@_ZTI1A> : !cir.ptr<!u8i>}>
; CHECK-DAG: cir.global "private" constant external @_ZTIi : !cir.ptr<!u8i>
; CHECK-DAG: #dyn_cast_info__ZTI1A__ZTI1B = #cir.dyn_cast_info<src_rtti = #cir.global_view<@_ZTI1A> : !cir.ptr<!u8i>, dest_rtti = #cir.global_view<@_ZTI1B> : !cir.ptr<!u8i>, runtime_func = @__dynamic_cast, bad_cast_func = @__cxa_bad_cast, offset_hint = #cir.int<0> : !s64i>
; CHECK-DAG: #dyn_cast_info__ZTI1A__ZTI1C = #cir.dyn_cast_info<{{.*}}offset_hint = #cir.int<-1> : !s64i>
; CHECK-DAG: #dyn_cast_info__ZTI2M1__ZTI2M2 = #cir.dyn_cast_info<{{.*}}offset_hint = #cir.int<-2> : !s64i>
; CHECK-DAG: #dyn_cast_info__ZTI1A__ZTI4Priv = #cir.dyn_cast_info<{{.*}}offset_hint = #cir.int<-2> : !s64i>
; CHECK-LABEL: cir.func {{.*}}@dyn_b(
; CHECK: cir.dyn_cast ptr %{{.*}} : !cir.ptr<!rec_A> -> !cir.ptr<!rec_B> #dyn_cast_info__ZTI1A__ZTI1B
; CHECK-LABEL: cir.func {{.*}}@dyn_c(
; CHECK: cir.dyn_cast ptr {{.*}} #dyn_cast_info__ZTI1A__ZTI1C
; CHECK-LABEL: cir.func {{.*}}@cross(
; CHECK: cir.dyn_cast ptr {{.*}} #dyn_cast_info__ZTI2M1__ZTI2M2
; CHECK-LABEL: cir.func {{.*}}@dyn_priv(
; CHECK: cir.dyn_cast ptr {{.*}} #dyn_cast_info__ZTI1A__ZTI4Priv
; CHECK-LABEL: cir.func {{.*}}@dyn_void(
; CHECK: cir.dyn_cast ptr %{{.*}} : !cir.ptr<!rec_A> -> !cir.ptr<!void>
; CHECK-LABEL: cir.func {{.*}}@dyn_ref(
; CHECK: cir.dyn_cast ref
; CHECK-LABEL: cir.func {{.*}}@tid_dyn(
; CHECK: cir.cmp eq
; CHECK: cir.call @__cxa_bad_typeid() {{.*}}
; CHECK: cir.unreachable
; CHECK: cir.vtable.get_vptr
; CHECK: cir.vtable.get_type_info
; CHECK-LABEL: cir.func {{.*}}@tid_dyn_ref(
; CHECK-NOT: __cxa_bad_typeid
; CHECK: cir.vtable.get_type_info
; CHECK-LABEL: cir.func {{.*}}@tid_b(

; SYMS-DAG: V _ZTIPPi
; SYMS-DAG: V _ZTI1E
; SYMS-DAG: U __cxa_bad_typeid
; SYMS-DAG: U __dynamic_cast

ecil 1.2 features=0x0000000a
