; An ECIL 1.2 flag on a 1.0 record is not a silent no-op: DEACTIVATABLE.
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 4'

; CHECK: ECIL 1.2 record CLEANUP_BEGIN with the DEACTIVATABLE flag is not supported yet

frame DECLS
  STR 10 "f"
  TY_FUNC 21 11 0 []
  DECL_FUNC 30 21 0 1 10
frame REGION
  FUNC_BEGIN 30 0
  FULLEXPR_BEGIN
  CLEANUP_BEGIN 3 nil 1
  CLEANUP_BODY
  FULLEXPR_END
  FUNC_END 1
frame END
  END auto 0
