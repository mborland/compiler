#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

'''Summarize an edgy run of a CIR configuration: the M2 progress metric.

Every executed test is put in one bucket, using the test's recorded status and
the output of its commands (the .rt.tar.gz files of the run):

  PASS         the test passed
  FE_CRASH     the front end crashed or failed an assertion (signal exit,
               ABORT, CATASTROPHE, "Assertion failed", "internal error", ...)
  LIB_CRASH    the CIR library crashed or hit an internal error ("CIR back
               end: ... internal", EDG_CIR_ERROR_INTERNAL, stack overflow)
  LIB_ERROR    the CIR back end reported an error that is not "unsupported"
               (a malformed stream, the MLIR verifier, a failed pass, ...)
  UNSUPPORTED  the CIR back end diagnosed an unsupported construct
  FE_DIAG      the front end itself reported an error (not from the CIR back
               end) in a test that should compile
  ASM_ERROR    the assembler (or compiler driver) rejected the generated code
  LINK_ERROR   the link failed (undefined reference, ...)
  RUN_FAIL     it compiled and linked, but the program failed (wrong exit
               status or output, or a signal)
  TIMEOUT      the test was killed after a timeout
  KILLED       the compiler was killed by a signal without any message (a
               timeout kill, the OOM killer): never excused, like LIB_CRASH
  OTHER        none of the above (look at --list OTHER)

The M2 gate needs the smoke list to be 100% PASS and FE_CRASH and LIB_CRASH to
be 0 over the corpus; a front end crash that is the reference configuration's
(--reference) is counted separately as pre-existing.  It is the reference's
only if the reference crashes the same way and either the backtrace has no
writer frame (ecil_*, cir_be*) or, without a backtrace, the assertion (text,
file, line, function and source position) is the reference's (crash_excuse).

C++ tests (the M3 corpus, .cpp/.cc/... sources) are bucketed the same way, and
a run that has any also prints:

  - the pass rate per C++ language mode (the --c++NN option of the case);
  - the failing tests by C++ feature (exceptions, virtual functions and
    vtables, RTTI, member pointers, coroutines, static initialization,
    operator new/delete, libstdc++ symbols, ...), from the diagnostic or the
    undefined symbol (linker messages carry the kind of the mangled name:
    `_ZTV...` is a vtable, `_ZTI...` typeinfo, ...).

The reference configuration (--reference, default tests/expectations/
edg_x86_64, whose imported.log also lists the gnu/cpp tests) is matched per
test case (path and options), as a C++ test has one case per language mode.
A run with only C tests prints what it always did.

Usage:
  edg-cir-summary [RUN_DIR [CONFIG]] [--top N] [--list BUCKET]
                  [--compare OTHER_RUN_DIR] [--json FILE]
                  [--language {all,c,cxx}] [--types rp,lp]

RUN_DIR is tests/runs/<timestamp> (default: the newest one); CONFIG is a
directory in it (default: every config whose name contains "cir").
'''

import argparse
import hashlib
import json
import re
import signal
import sys
import tarfile

from collections import Counter, defaultdict
from pathlib import Path
from typing import Dict, List, Optional, Tuple

BUCKETS = (
  'PASS', 'FE_CRASH', 'LIB_CRASH', 'LIB_ERROR', 'UNSUPPORTED', 'FE_DIAG',
  'ASM_ERROR', 'LINK_ERROR', 'RUN_FAIL', 'TIMEOUT', 'KILLED', 'OTHER'
)

_CRASH_REGEX = re.compile(
  r'Assertion failed|assertion failed at|[Ii]nternal error|Segmentation fault|'
  r'core dumped|Aborted|AddressSanitizer|LeakSanitizer|SIGSEGV|SIGABRT|'
  r'terminate called|[Ss]tack overflow'
)
_LIB_INTERNAL_REGEX = re.compile(
  r'CIR back end:.*(internal (error|crash)|EDG_CIR_ERROR_INTERNAL|'
  r'stack (overflow|exhaust))|'
  r'edg-cir: .*internal|PLEASE submit a bug report|LLVM ERROR|'
  r'UNREACHABLE executed',
  re.IGNORECASE
)
_UNSUPPORTED_REGEX = re.compile(
  r'unsupported|not supported|does not support|not yet implemented|NYI|'
  r'not implemented|cannot express|cannot be (represented|translated)',
  re.IGNORECASE
)
_SECONDARY_REGEX = re.compile(r'F_ABORT')
_LINK_REGEX = re.compile(
  r'undefined reference|linker command failed|ld: |cannot find -l|'
  r'multiple definition',
)
_LINK_DETAIL_REGEX = re.compile(
  r'undefined reference|multiple definition|cannot find -l'
)
_ASM_REGEX = re.compile(
  r'Assembler messages|unknown pseudo-op|junk at end of line|'
  r'error: unknown (directive|instruction)|invalid instruction mnemonic|'
  r'invalid operand for instruction|returned an exit status'
)
_CIR_LINE_REGEX = re.compile(r'(CIR back end|edg-cir|ecil-dump)\b')
_ERROR_LINE_REGEX = re.compile(r'(?i)\b(error|catastrophic error)\b')

# Source extensions of the C++ tests (the C ones are .c).
_CXX_EXTENSIONS = ('.cpp', '.cc', '.cxx', '.c++', '.cp', '.C')
_LANGUAGE_OPTION_REGEX = re.compile(r'--c\+\+(\d\d|\w+)\b')

# An Itanium mangled name in a message, and the names of the entities that
# the C++ run time and the code generator need (not mangled in the usual
# way): they decide which kind of symbol a link error is about.
_MANGLED_REGEX = re.compile(r'\b_Z[A-Za-z0-9_$.]*')
_MANGLED_KINDS = (
  (re.compile(r'^_ZTV'), 'vtable'),
  (re.compile(r'^_ZTT'), 'vtt'),
  (re.compile(r'^_ZTI'), 'typeinfo'),
  (re.compile(r'^_ZTS'), 'typeinfo-name'),
  (re.compile(r'^_ZGV'), 'guard'),
  (re.compile(r'^_Z(nw|na|dl|da)[A-Za-z]'), 'new-delete'),
  (re.compile(r'^_Z(N|S)t'), 'libstdc++'),
  (re.compile(r'^_ZN.*[CD][0-5]E'), 'structor'),
  (re.compile(r'^_ZTh|^_ZTv|^_ZTc'), 'thunk')
)

# C++ features, for the "by feature" table: the first regex that matches the
# normalized message decides.  The M4 features (exceptions, RTTI, virtual
# functions and vtables, member pointers) come in families: the name
# "family: kind" is a kind of the family, and the table rolls the families
# up.  The writer's names for the member pointer operators ".*" and "->*"
# (src/ecil_kind_names.h) are matched by their spelling.
_FEATURE_REGEXES = (
  ('exceptions: throw', re.compile(
    r'\bthrow\b|__cxa_(throw|rethrow|allocate_exception)',
    re.IGNORECASE)),
  ('exceptions: try/catch/function-try', re.compile(
    r'\btry\b|\bcatch\b|__cxa_(begin|end)_catch', re.IGNORECASE)),
  ('exceptions: other', re.compile(
    r'exception|landing ?pad|unwind|__gxx_personality|\bnoexcept\b',
    re.IGNORECASE)),
  ('rtti: typeid', re.compile(r'typeid', re.IGNORECASE)),
  ('rtti: dynamic_cast', re.compile(
    r'dynamic_cast|__dynamic_cast', re.IGNORECASE)),
  ('rtti: typeinfo', re.compile(
    r'typeinfo|\bRTTI\b|<mangled:typeinfo(-name)?>', re.IGNORECASE)),
  ('vtables/virtual: constructors and destructors of polymorphic classes',
   re.compile(
     r'(constructor|destructor) of a class with virtual|polymorphic',
     re.IGNORECASE)),
  ('vtables/virtual: virtual bases', re.compile(
    r'virtual base', re.IGNORECASE)),
  ('vtables/virtual: virtual functions and calls', re.compile(
    r'virtual (call|function|destructor|member)|delete of an object with a '
    r'virtual', re.IGNORECASE)),
  ('vtables/virtual: vtable, VTT and thunk symbols', re.compile(
    r'vtable|vptr|\bvtt\b|<mangled:(vtable|vtt|thunk)>', re.IGNORECASE)),
  ('vtables/virtual: other', re.compile(r'virtual', re.IGNORECASE)),
  ('member pointers', re.compile(
    r'member pointer|pointer[- ]to[- ](data[- ])?member|ptrmem|'
    r'\(\.\*\)|\(->\*\)|\bpm (base|derived) class cast',
    re.IGNORECASE)),
  ('coroutines', re.compile(r'coroutine|co_await|co_yield|co_return',
                            re.IGNORECASE)),
  ('static initialization', re.compile(
    r'static (init|local)|guard|dynamic init|__cxa_(atexit|guard)|'
    r'global (constructor|destructor)|<mangled:guard>', re.IGNORECASE)),
  ('constructors/destructors', re.compile(
    r'constructor|destructor|<mangled:structor>', re.IGNORECASE)),
  ('operator new/delete', re.compile(
    r'operator (new|delete)|new-expression|delete-expression|'
    r'<mangled:new-delete>', re.IGNORECASE)),
  ('libstdc++ symbols', re.compile(r'<mangled:libstdc\+\+>')),
  ('modules', re.compile(r'\bmodule|header unit', re.IGNORECASE)),
  ('lambdas', re.compile(r'lambda|closure', re.IGNORECASE)),
  ('templates', re.compile(r'template|instantiat', re.IGNORECASE)),
  ('atomics', re.compile(r'atomic', re.IGNORECASE)),
  # The wording of the writer's "unsupported" notes (M3 slices turn these off).
  ('class parameters and results', re.compile(
    r'parameter of an unsupported type|return type that is unsupported',
    re.IGNORECASE)),
  ('object initialization (ctors)', re.compile(
    r'this kind of initialization|aggregate member initializer',
    re.IGNORECASE)),
  ('dynamic initialization of statics', re.compile(
    r'non-constant initializer of a static object', re.IGNORECASE)),
  ('locals and temporaries', re.compile(
    r'undeclared local variable', re.IGNORECASE)),
  ('expressions and operators', re.compile(
    r'expression kind|the operator \d|unsupported scalar type|'
    r'this kind of statement', re.IGNORECASE))
)


# The feature families of the M4 milestone (see _FEATURE_REGEXES).
M4_FAMILIES = ('vtables/virtual', 'rtti', 'exceptions', 'member pointers')


class TestResult:
  def __init__(self, path: str, status: str, bucket: str,
               message: str, variant: str = '',
               test_type: str = '') -> None:
    self.ref_fail = False
    self.ref_status = ''
    # For a front end crash: its first line and backtrace frames (see
    # crash_details), and the reference's line and frames of the same case.
    self.crash_line = ''
    self.frames: List[str] = []
    self.ref_crash_line = ''
    self.ref_frames: List[str] = []
    # A digest of the compile output without the CIR back end's notes, and
    # whether it equals the reference's recording (information: the crash
    # is then the reference's own, whatever it says).
    self.output_key = ''
    self.ref_output_same = False
    self.signal = ''
    self.path = path
    self.status = status
    self.bucket = bucket
    self.message = message
    self.variant = variant
    self.test_type = test_type
    self.language = 'cxx' if path.endswith(_CXX_EXTENSIONS) else 'c'


def _mangled_token(match: 're.Match[str]') -> str:
  '''Replace a mangled name by a token that keeps what kind of symbol it is.'''
  name = match.group(0)
  for regex, kind in _MANGLED_KINDS:
    if regex.search(name):
      return f"<mangled:{kind}>"
  return '<mangled>'


def _normalize_message(line: str) -> str:
  '''Make an error line comparable across tests.'''
  line = line.strip()
  line = re.sub(r'"[^"]*\.(c|cpp|C|i|s)", line \d+: ', '', line)
  line = re.sub(r'(Test_name|test)\.\w+(:\d+)*:?', '', line)
  line = re.sub(r'"[A-Za-z_][A-Za-z_0-9:]*"', '"<id>"', line)
  line = re.sub(r"'[A-Za-z_][A-Za-z_0-9:]*'", "'<id>'", line)
  line = re.sub(r'0x[0-9a-fA-F]+', '0xN', line)
  line = _MANGLED_REGEX.sub(_mangled_token, line)
  line = re.sub(r'\b\d+\b', 'N', line)
  line = re.sub(r'\s+', ' ', line)
  return line[:160]


def _first_matching_line(text: str,
                         regex: 're.Pattern[str]') -> Optional[str]:
  for line in text.splitlines():
    if regex.search(line):
      return line
  return None


def _read_case_outputs(tar_file: tarfile.TarFile
                       ) -> Dict[int, Dict[int, str]]:
  '''Return {case number: {command index: output text}} of every case.'''
  outputs: Dict[int, Dict[int, str]] = defaultdict(dict)
  for member in tar_file.getmembers():
    match = re.match(r'cases/(\d+)/(\d+)/output\.txt$', member.name)
    if match:
      extracted = tar_file.extractfile(member)
      assert extracted is not None
      outputs[int(match.group(1))][int(match.group(2))] = \
        extracted.read().decode('utf-8', errors = 'replace')
  return outputs


def classify(status: str, compile_output: str,
             run_output: str) -> Tuple[str, str]:
  '''Return (bucket, representative message) for a non-passing test.'''
  base = status.split('--')[0]
  # The "front end aborted the stream" report only follows a front-end error,
  # which is what matters.
  compile_output = '\n'.join(
    line for line in compile_output.splitlines()
    if not _SECONDARY_REGEX.search(line)
  )
  all_text = compile_output + '\n' + run_output

  def message_of(text: str, regex: 're.Pattern[str]') -> str:
    line = _first_matching_line(text, regex)
    return _normalize_message(line) if line else base

  if base == 'PASS':
    return 'PASS', ''
  if 'TIMEOUT' in base or 'KILLED' in base:
    return 'TIMEOUT', base
  if base == 'ABORT' and not compile_output.strip():
    # No diagnostic at all: the process was killed, it did not fail.
    return 'KILLED', 'killed by a signal without a message'
  if _LIB_INTERNAL_REGEX.search(all_text):
    return 'LIB_CRASH', message_of(all_text, _LIB_INTERNAL_REGEX)
  if base in ('ABORT', 'CATASTROPHE') or _CRASH_REGEX.search(compile_output):
    crash_line = _first_matching_line(compile_output, _CRASH_REGEX)
    if _CIR_LINE_REGEX.search(compile_output):
      # The process died (or aborted) while the CIR library was running.
      detail = _normalize_message(crash_line) if crash_line else \
        f"{base} after: " + message_of(compile_output, _CIR_LINE_REGEX)
      return 'LIB_CRASH', detail
    return 'FE_CRASH', message_of(compile_output, _CRASH_REGEX)
  if 'CIR back end' in compile_output and _UNSUPPORTED_REGEX.search(
      compile_output):
    cir_lines = [l for l in compile_output.splitlines()
                 if 'CIR back end' in l and _UNSUPPORTED_REGEX.search(l)]
    return 'UNSUPPORTED', _normalize_message(cir_lines[0]) if cir_lines \
      else base
  if _LINK_REGEX.search(compile_output):
    return 'LINK_ERROR', message_of(compile_output, _LINK_DETAIL_REGEX)
  if base == 'BADC' or _ASM_REGEX.search(compile_output):
    return 'ASM_ERROR', message_of(compile_output, _ASM_REGEX)
  if 'CIR back end' in compile_output:
    line = _first_matching_line(compile_output, _CIR_LINE_REGEX) or ''
    return 'LIB_ERROR', _normalize_message(line)
  if 'COMPILE' in base or _ERROR_LINE_REGEX.search(compile_output):
    return 'FE_DIAG', message_of(compile_output, _ERROR_LINE_REGEX)
  if base.startswith('RUNTIME') or base == 'FAIL':
    return 'RUN_FAIL', message_of(run_output, _ERROR_LINE_REGEX)
  return 'OTHER', base


def load_config_results(config_dir: Path) -> List[TestResult]:
  results = []
  for tar_path in sorted(config_dir.rglob('*.rt.tar.gz')):
    with tarfile.open(tar_path, 'r:gz') as tar_file:
      extracted = tar_file.extractfile('metadata.json')
      assert extracted is not None
      metadata = json.load(extracted)
      case_outputs = _read_case_outputs(tar_file)
    test_path = metadata.get('path', str(tar_path))
    # A test has one case per option set (for C++ tests, one per language
    # mode); case N of the metadata is cases/N/ in the archive.
    for number, case in enumerate(metadata.get('cases', []), start = 1):
      status = case['status']['result']
      outputs = case_outputs.get(number, {})
      compile_output = outputs.get(1, '')
      run_output = outputs.get(2, '')
      bucket, message = classify(status, compile_output, run_output)
      result = TestResult(test_path, status, bucket, message,
                          case['status'].get('variant', ''),
                          case['status'].get('type', ''))
      if bucket in ('FE_CRASH', 'LIB_CRASH'):
        result.crash_line, result.frames = crash_details(compile_output)
        result.output_key = output_digest(compile_output)
        result.signal = crash_signal(compile_output)
      results.append(result)
  return results


def crash_class(status: str) -> str:
  '''ABORT or CATASTROPHE: the kind of crash a status records ("" if none).'''
  base = status.split('--')[0].split('(')[0]
  return base if base in ('ABORT', 'CATASTROPHE') else ''


# A crash or assertion in the CIR writer (ecil_*), the back end shim (cir_be*)
# or the library (the namespaces edg_cir::, edg_cir::compat::, ecil::,
# edg_abi::, and mlir::, cir::, llvm:: frames, and its shared objects) is never
# pre-existing: the reference does not run that code.  (In edg_x86_64_cir the
# library runs in the front end's process, so its crash is an FE_CRASH.)
CIR_CODE_REGEX = re.compile(
  r'\b(?:ecil_\w+|cir_be\w*)\b|'
  r'\b(?:edg_cir|ecil|edg_abi|mlir|cir|llvm)::|'
  r'libedg_cir|libMLIR|libLLVM|/cir_src/')
_CRASH_LINE_REGEX = re.compile(_CRASH_REGEX.pattern +
                               r'|catastrophic error')
# A frame of a backtrace: a sanitizer or gdb frame ("#3 0x... in f file:1"),
# or one of glibc's backtrace_symbols ("./cpfe(f+0x12) [0x...]").
_FRAME_REGEX = re.compile(
  r'^\s*#\d+\s+0x[0-9a-f]+|^\S+\([\w:.$@]*\+0x[0-9a-f]+\)')
# A crash whose identity (what and where) can be compared: an assertion of
# the front end with its file, line (or "<suppressed>", which the test
# configuration prints) and function (in either of the two forms the front
# end prints: "assertion failed: text (file, line N in f)" and "assertion
# failed at: \"file\", line N in f"), or a catastrophic error.
_INTERNAL_ERROR_REGEX = re.compile(r'[Ii]nternal error')
_IDENTITY_REGEX = re.compile(
  r'assertion failed: .*\([\w./-]+, line (\d+|<suppressed>) in \w+\)|'
  r'assertion failed at: "[\w./-]+", line (\d+|<suppressed>) in \w+|'
  r'catastrophic error: ')


def output_digest(text: str) -> str:
  '''A digest of a compile output with the paragraphs about the CIR back
  end and edg-cir removed and the spaces collapsed.'''
  normalized = re.sub(r'\s+', ' ', non_cir_text(text)).strip()
  return hashlib.md5(normalized.encode('utf-8', 'replace')).hexdigest()


def frame_symbolized(frame: str) -> bool:
  '''Whether a backtrace frame names a function: a sanitizer or gdb frame
  "#3 0x... in f file:1", or a glibc frame "./cpfe(f+0x12)".  "#3 0x...
  (/path/cpfe+0x1234)" and "./cpfe(+0x1234)" are not symbolized.'''
  if re.match(r'^\s*#\d+\s+0x[0-9a-f]+\s+in\s+\S', frame):
    return True
  return re.match(r'^\S+\([A-Za-z_][\w:.$@]*\+0x[0-9a-f]+\)', frame) \
    is not None


def crash_signal(output: str) -> str:
  '''The signal that killed the front end ("SIGSEGV", "SIGABRT", ...; "" if
  none): from eccp's "front end returned an exit status of N" (128 + the
  signal), else from the shell's "Segmentation fault" or "Aborted".'''
  match = re.search(r'front end returned an exit status of (\d+)', output)
  if match and int(match.group(1)) > 128:
    try:
      return signal.Signals(int(match.group(1)) - 128).name
    except ValueError:
      return ''
  if re.search(r'^Segmentation fault', output, re.M):
    return 'SIGSEGV'
  if re.search(r'^Aborted', output, re.M):
    return 'SIGABRT'
  return ''


def non_cir_text(output: str) -> str:
  '''The output without the paragraphs about the CIR back end and edg-cir:
  the text that is compared with the reference's.'''
  paragraphs = re.split(r'(\n\s*\n)', output)
  return ''.join(p for p in paragraphs
                 if 'CIR back end' not in p and 'edg-cir' not in p)


def crash_details(compile_output: str) -> Tuple[str, List[str]]:
  '''The first crash line of a compile output ("" if none, with the source
  position it starts with) and all its backtrace frames (every stack of a
  sanitizer report: there can be up to three).  The crash line is taken from
  the text that is compared with the reference's, not from a paragraph about
  the CIR back end (which can say "internal error" about a dropped
  function).'''
  line = _first_matching_line(non_cir_text(compile_output),
                              _CRASH_LINE_REGEX) or ''
  frames = [l.strip()[:500] for l in compile_output.splitlines()
            if _FRAME_REGEX.match(l)]
  return ' '.join(line.split())[:400], frames


def reference_output(tests_dir: Path, test_path: str, variant: str) -> str:
  '''The compile output the reference recorded for a case of a test.

  The recording is a file of the test's .<name>.rto directory:
  <config>.<case>.<command>.txt, the compile command being 1, with the
  command line as its first line (the options of the case are on it).  The
  edg_x86_64 recording is preferred to the default one; "" if none matches.
  '''
  path = tests_dir / test_path
  rto = path.parent / f".{path.name.split('.')[0]}.rto"
  wanted = set(variant.split())
  for prefix in ('edg_x86_64', 'default'):
    for file in sorted(rto.glob(f"{prefix}.*.1.txt")):
      text = file.read_text(errors = 'replace')
      lines = text.splitlines()
      if lines and wanted <= set(lines[0].split()):
        return '\n'.join(lines[1:])
  return ''


def crash_excuse(result: Dict[str, object]) -> Tuple[bool, str]:
  '''Whether a front end crash is one the reference has too, and why.

  `result` is a TestResult as a dict (the JSON of this tool).  The crash is
  excused only if the reference crashes the same way (ABORT or
  CATASTROPHE) and the message names no writer file (ecil_*, cir_be*), and
  then:

    - if a backtrace is available (at least one of its frames is
      symbolized: a stack of bare addresses is no evidence), only when
      none of its frames, in any stack, names ecil_ or cir_be code; and if
      the reference's crash is an assertion, the crash must also be the
      same assertion (a clean stack does not excuse another assertion);
    - if the output of the compile equals the reference's recording once
      the paragraphs about the CIR back end are removed (ref_output_same)
      and the crash has an identity (an assertion with its file and line, an
      "Internal error" line, or a symbolized frame): the same crash (checked
      before the two rules below, after the writer-code checks).  A bare
      signal ("Segmentation fault", "Aborted") is never excused this way;
    - else, only when the assertion text, its file, line and function and
      the source position it was reported at equal those of the
      reference's crash.  A crash without such an identity (a signal,
      no message) is not excused: the writer could have caused it.

  An FE assertion in shared code (copy_expr_tree in il.c, say) that the
  writer triggers with other IL than the reference has is not the
  reference's crash: its text or its file:line differs, or the stack shows
  the writer.  Returns (excused, reason).
  '''
  status, ref_status = str(result['status']), str(result.get('ref_status', ''))
  line = str(result.get('crash_line', ''))
  ref_line = str(result.get('ref_crash_line', ''))
  frames = list(result.get('frames', []))
  if result['bucket'] != 'FE_CRASH':
    return False, 'not a front end crash'
  if not crash_class(status) or crash_class(status) != crash_class(ref_status):
    return False, 'the reference does not crash the same way'
  if CIR_CODE_REGEX.search(str(result.get('message', '')) + ' ' + line):
    return False, 'the message names writer code'
  if any(CIR_CODE_REGEX.search(f) for f in frames):
    return False, 'the backtrace has an ecil_ or cir_be frame'
  if result.get('ref_output_same') and (
      _IDENTITY_REGEX.search(line) or _INTERNAL_ERROR_REGEX.search(line) or
      any(frame_symbolized(f) for f in frames)):
    return True, ("the reference crashes the same way and the compile "
                  "output equals its recording (without the CIR back end's "
                  "notes)")
  if any(frame_symbolized(f) for f in frames):
    if _IDENTITY_REGEX.search(ref_line) and line != ref_line:
      return False, (f"the backtrace has no writer frame, but the "
                     f"assertion differs from the reference's "
                     f"({ref_line[:100]})")
    return True, 'the backtrace has no ecil_ or cir_be frame'
  if not _IDENTITY_REGEX.search(line):
    return False, 'no backtrace and no assertion to compare'
  if line == ref_line:
    return True, 'same assertion, file:line and source position as the ' \
                 'reference'
  return False, f"no backtrace; the assertion differs from the reference's " \
                f"({ref_line[:100] or 'none recorded'})"


def excused_crash(result: TestResult) -> bool:
  '''Whether a crash is the reference's (see crash_excuse).'''
  return crash_excuse(vars(result))[0]


def cxx_feature(result: TestResult) -> str:
  '''The C++ feature a failing test's message is about ("other" if none).'''
  for feature, regex in _FEATURE_REGEXES:
    if regex.search(result.message):
      return feature
  return 'other'


def language_mode(result: TestResult) -> str:
  '''The --c++NN option of the case ("default" if it has none).'''
  match = _LANGUAGE_OPTION_REGEX.search(result.variant)
  return f"c++{match.group(1)}" if match else 'default'


def print_cxx_tables(results: List[TestResult], top: int) -> None:
  '''Print the C++ tables: pass rate per language mode, failures by feature.

  Only the C++ tests are counted; C tests of a mixed run are left out.
  '''
  cxx = [r for r in results if r.language == 'cxx']
  by_mode: Dict[str, Counter] = defaultdict(Counter)
  for result in cxx:
    by_mode[language_mode(result)][result.bucket] += 1
  print(f"  C++ tests: {len(cxx)} cases; pass rate per language mode:")
  for mode in sorted(by_mode):
    sub = by_mode[mode]
    print(f"    {mode:<10} {sub['PASS']:>5}/{sum(sub.values()):<5}")

  features: Dict[str, Counter] = defaultdict(Counter)
  for result in cxx:
    if result.bucket != 'PASS':
      features[cxx_feature(result)][result.bucket] += 1
  if features:
    print('  C++ failures by feature (cases; buckets in brackets):')
    for feature in sorted(features, key = lambda f: -sum(features[f].values())):
      sub = features[feature]
      detail = ', '.join(f"{b} {sub[b]}" for b in BUCKETS if sub[b])
      print(f"    {feature:<26} {sum(sub.values()):>5}  [{detail}]")
    families: Dict[str, int] = defaultdict(int)
    for feature, sub in features.items():
      families[feature.split(':')[0]] += sum(sub.values())
    print('  M4 families (cases): ' + ', '.join(
      f"{family} {families[family]}" for family in M4_FAMILIES))


def print_summary(config: str, results: List[TestResult], top: int) -> None:
  total = len(results)
  counts = Counter(r.bucket for r in results)
  print(f"=== {config}: {total} test cases")
  for bucket in BUCKETS:
    if counts[bucket] or bucket in ('PASS', 'FE_CRASH', 'LIB_CRASH'):
      percent = 100.0 * counts[bucket] / total if total else 0.0
      print(f"  {bucket:<12} {counts[bucket]:>6}  {percent:5.1f}%")

  by_dir: Dict[str, Counter] = defaultdict(Counter)
  for result in results:
    parts = result.path.split('/')
    key = '/'.join(parts[:-1][:4]) if len(parts) > 1 else '.'
    by_dir[key][result.bucket] += 1
  if len(by_dir) > 1:
    print('  by directory (pass/total):')
    for key in sorted(by_dir):
      sub = by_dir[key]
      print(f"    {key:<40} {sub['PASS']:>5}/{sum(sub.values()):<5}")

  for bucket in BUCKETS:
    if bucket == 'PASS' or not counts[bucket]:
      continue
    messages = Counter(r.message for r in results if r.bucket == bucket)
    print(f"  top messages, {bucket}:")
    for message, count in messages.most_common(top):
      print(f"    {count:>5}  {message}")

  if any(r.language == 'cxx' for r in results):
    print_cxx_tables(results, top)

  crashes = [r for r in results if r.bucket in ('FE_CRASH', 'LIB_CRASH')]
  gate = sum(1 for r in crashes if not excused_crash(r))
  preexisting = len(crashes) - gate
  killed = sum(1 for r in results if r.bucket in ('KILLED', 'TIMEOUT'))
  print(f"  gate: crashes/assertions = {gate} (must be 0)"
        + (f", {preexisting} more pre-existing in the reference (the same "
           f"front end crash there)" if preexisting else '')
        + (f", {killed} killed or timed out (never excused)" if killed
           else '') +
        f"; pass rate = {counts['PASS']}/{total}")
  ref_fails = [r for r in results if r.ref_fail and r.bucket != 'PASS']
  if any(r.ref_fail for r in results) or ref_fails:
    comparable = total - len(ref_fails)
    print(f"  reference: {len(ref_fails)} of the failing tests also fail in "
          f"the reference configuration; excluding them, "
          f"{counts['PASS']}/{comparable} pass "
          f"({100.0 * counts['PASS'] / comparable if comparable else 0:.1f}%)")
    ref_counts = Counter(r.bucket for r in ref_fails)
    print('  also failing in the reference, by bucket: ' +
          ', '.join(f"{b} {ref_counts[b]}" for b in BUCKETS
                    if ref_counts[b]))


def load_reference_failures(reference_dir: Path) -> Dict[str, Dict[str, str]]:
  '''Return the failing cases of a reference configuration.

  reference_dir is a tests/expectations/<config> directory, whose <suite>.log
  files list the cases whose status is not a plain pass.  The result maps
  "<suite>/<path>", like the run's metadata, to the options of its failing
  cases (the third field of a line, like the case's "variant") with their
  status (the fourth field).
  '''
  failing: Dict[str, Dict[str, str]] = defaultdict(dict)
  for log_file in reference_dir.glob('*.log'):
    suite = log_file.stem
    for line in log_file.read_text(errors = 'replace').splitlines():
      parts = line.split(':')
      if len(parts) >= 4 and not parts[3].startswith('PASS'):
        failing[f"{suite}/{parts[0]}"][parts[2]] = parts[3]
  return failing


def reference_status(result: TestResult,
                     reference: Dict[str, Dict[str, str]]) -> str:
  '''The status the reference recorded for the case of a result ("" if none:
  it passes there).'''
  variants = reference.get(result.path)
  if not variants:
    return ''
  if result.language == 'c':
    return next(iter(variants.values()))
  return variants.get(result.variant, '')


def fails_in_reference(result: TestResult,
                       reference: Dict[str, Dict[str, str]]) -> bool:
  '''Whether the case of a result also fails in the reference.

  A C test (one case) fails if its path is listed.  A C++ test has a case per
  language mode, so its case must be listed with the same options.
  '''
  variants = reference.get(result.path)
  if variants is None:
    return False
  return result.language == 'c' or result.variant in variants


def newest_run(runs_dir: Path) -> Path:
  candidates = [p for p in runs_dir.iterdir() if p.is_dir()]
  if not candidates:
    sys.exit(f"no runs in {runs_dir}")
  return max(candidates, key = lambda p: p.stat().st_mtime)


def main() -> None:
  parser = argparse.ArgumentParser(description = 'Summarize a CIR edgy run.')
  parser.add_argument('run_dir', nargs = '?', default = None)
  parser.add_argument('config', nargs = '?', default = None)
  parser.add_argument('--top', type = int, default = 8,
                      help = 'messages to show per bucket')
  parser.add_argument('--list', dest = 'list_bucket', default = None,
                      help = 'list the tests in this bucket')
  parser.add_argument('--compare', default = None,
                      help = 'another run directory: show tests whose bucket '
                             'changed')
  parser.add_argument('--reference', default = 'tests/expectations/edg_x86_64',
                      help = 'expectations directory of the reference config '
                             '(failures there are expected: they are '
                             'counted separately); "" to disable')
  parser.add_argument('--language', choices = ('all', 'c', 'cxx'),
                      default = 'all',
                      help = 'summarize only the C or only the C++ tests')
  parser.add_argument('--types', default = '',
                      help = 'comma separated test types (rp,lp): count only '
                             'the cases of these types (edgy runs every case '
                             'of a test that has one)')
  parser.add_argument('--json', dest = 'json_file', default = None,
                      help = 'also write the results to this file')
  args = parser.parse_args()

  run_dir = Path(args.run_dir) if args.run_dir else newest_run(
    Path('tests/runs')
  )
  configs = (
    [args.config] if args.config else
    sorted(p.name for p in run_dir.iterdir()
           if p.is_dir() and 'cir' in p.name)
  )
  reference: Dict[str, Dict[str, str]] = {}
  if args.reference and Path(args.reference).is_dir():
    reference = load_reference_failures(Path(args.reference))
  # The reference's recordings of the tests: <test home>/tests, next to its
  # expectations directory.
  tests_dir = Path(args.reference).resolve().parent.parent / 'tests'
  all_results: Dict[str, List[TestResult]] = {}
  for config in configs:
    results = load_config_results(run_dir / config)
    if args.language != 'all':
      results = [r for r in results if r.language == args.language]
    if args.types:
      # A test that has a case of a selected type runs all its cases.
      wanted = set(args.types.split(','))
      results = [r for r in results if r.test_type in wanted]
    for result in results:
      result.ref_fail = fails_in_reference(result, reference)
      result.ref_status = reference_status(result, reference)
      if result.bucket == 'FE_CRASH' and result.ref_status:
        recorded = reference_output(tests_dir, result.path, result.variant)
        result.ref_crash_line, result.ref_frames = crash_details(recorded)
        result.ref_output_same = bool(recorded) and \
          output_digest(recorded) == result.output_key
    all_results[config] = results
    print_summary(config, results, args.top)
    if args.list_bucket:
      print(f"  tests in {args.list_bucket}:")
      for result in results:
        if result.bucket == args.list_bucket:
          print(f"    {result.path}  [{result.status}] {result.message}")
    if args.compare:
      def case_key(result: TestResult) -> str:
        # A C++ test has a case per language mode.
        return result.path if result.language == 'c' else \
          f"{result.path} [{result.variant}]"
      before = {
        case_key(r): r.bucket
        for r in load_config_results(Path(args.compare) / config)
      }
      print(f"  changes since {args.compare}:")
      for result in results:
        old = before.get(case_key(result))
        if old is not None and old != result.bucket:
          print(f"    {case_key(result)}: {old} -> {result.bucket}")

  if args.json_file:
    with open(args.json_file, 'w') as file_handle:
      json.dump(
        {
          config: [vars(r) for r in results]
          for config, results in all_results.items()
        },
        file_handle,
        indent = 1
      )


if __name__ == '__main__':
  main()
