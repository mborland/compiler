; Lazy emission: the deferral rule and the reachability.  Every internal or
; linkonce_odr function of a region frame is deferred; main calls two of them
; (st_used, inl_used) and a third (chain_b) only through a deferred one
; (chain_a, which main calls), so those three are replayed and the two that
; nothing reaches (inl_dead, st_dead) are dropped.  An external function
; (ext_dead) is never deferred, reachable or not.  The eager run emits every
; body; the assembly of the two runs is the same (GlobalDCE removes what
; lazy emission never emitted).
; The region frame carries supp blobs (unknown key 99) inside the bodies, a
; replayed one and a dropped one: replay takes HAS_SUPP from the frame the
; body came from.
; RUN: cat %S/Inputs/header11_supp.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --stats --lazy-symbols --emit=cir -o %t.lazy.cir %t.ecil 2> %t.err
; RUN: %FileCheck %s --check-prefix=STATS < %t.err
; RUN: %FileCheck %s --check-prefix=LAZY --implicit-check-not=inl_dead --implicit-check-not=st_dead < %t.lazy.cir
; RUN: %edg-cir --eager-bodies --stats --lazy-symbols --emit=cir -o %t.eager.cir %t.ecil 2> %t.eager.err
; RUN: %FileCheck %s --check-prefix=EAGER-STATS < %t.eager.err
; RUN: %FileCheck %s --check-prefix=EAGER < %t.eager.cir
; RUN: %edg-cir --emit=asm -o %t.lazy.s %t.ecil
; RUN: %edg-cir --eager-bodies --emit=asm -o %t.eager.s %t.ecil
; RUN: cmp %t.lazy.s %t.eager.s

; STATS: stats: lazy bodies: 7 deferred, 5 replayed, 2 dropped
; STATS-DAG: stats: lazy replayed inl_used
; STATS-DAG: stats: lazy replayed st_used
; STATS-DAG: stats: lazy replayed chain_a
; STATS-DAG: stats: lazy replayed chain_b
; STATS-DAG: stats: lazy replayed st_ptr
; STATS-DAG: stats: lazy dropped inl_dead
; STATS-DAG: stats: lazy dropped st_dead
; EAGER-STATS: stats: lazy bodies: 0 deferred, 0 replayed, 0 dropped
; LAZY-DAG: cir.func {{.*}}@ext_dead
; LAZY-DAG: cir.func {{.*}}@inl_used
; LAZY-DAG: cir.func {{.*}}@st_used
; LAZY-DAG: cir.func {{.*}}@chain_a
; LAZY-DAG: cir.func {{.*}}@chain_b
; LAZY-DAG: cir.func {{.*}}@main
; EAGER-DAG: cir.func {{.*}}@inl_dead
; EAGER-DAG: cir.func {{.*}}@st_dead
; EAGER-DAG: cir.func {{.*}}@chain_b

frame DECLS
  STR 100 "ext_dead"
  STR 101 "inl_used"
  STR 102 "inl_dead"
  STR 103 "st_used"
  STR 104 "st_dead"
  STR 105 "chain_a"
  STR 106 "chain_b"
  STR 107 "main"
  STR 108 "st_ptr"
  STR 109 "gp"
  TY_FUNC 21 1 0 []
  TY_PTR 22 21
  DECL_FUNC 40 21 0 1 100
  DECL_FUNC 41 21 3 65 101
  DECL_FUNC 42 21 3 65 102
  DECL_FUNC 43 21 1 1 103
  DECL_FUNC 44 21 1 1 104
  DECL_FUNC 45 21 1 1 105
  DECL_FUNC 46 21 1 1 106
  DECL_FUNC 47 21 0 9 107
  DECL_FUNC 48 21 1 1 108
  DECL_VAR 300 22 0 1 8 109
frame REGION supp
  FUNC_BEGIN 40 0
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 41 0
  CONST_INT 1 1
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 42 0
  CONST_INT 1 2
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 43 0
  CONST_INT 1 3 supp{99: 7}
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 44 0
  CONST_INT 1 4 supp{99: 7}
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 46 0
  CONST_INT 1 6
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 45 0
  CALL 46 21 0 0
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 48 0
  CONST_INT 1 8
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 47 0
  CALL 41 21 0 0
  CALL 43 21 0 0
  ADD 1
  CALL 45 21 0 0
  ADD 1
  GREF 300
  LOAD 0
  DROP
  CONST_INT 1 21
  SUB 1
  RETURN_STMT true
  FUNC_END 0
frame GLOBALS
  C_ADDR 22 48 0
  VAR_INIT 300
frame END
  END auto 0
