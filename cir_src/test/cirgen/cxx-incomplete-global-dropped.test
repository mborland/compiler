; A defined variable of a record type that has no body (a class with virtual
; bases) whose initialization the writer dropped (DECL_VAR re-issued with
; "unsupported"): in the default mode that is an error naming the variable, not
; a silent omission (the program would run without constructing the object);
; with --keep-going it is left out with no layout needed.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: %edg-cir --keep-going --emit=cir %t.ecil 2>&1 | %FileCheck %s --check-prefix=KEEP

; CHECK: error [1003]: the definition of 'x' was dropped
; KEEP-NOT: @x
; KEEP: cir.func {{.*}}@main

frame DECLS
  STR 10 "main"
  STR 11 "x"
  TY_RECORD_DECL 20 0 nil
  TY_FUNC 21 1 0 []
  DECL_FUNC 30 21 0 9 10
  DECL_VAR 33 20 0 0 0 11
  DECL_VAR 33 20 0 64 0 11
frame REGION
  FUNC_BEGIN 30 0
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
