ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S3): the typeinfo of pointers to an incomplete class
; (I *, I **, const I *, int I::*: internal, with the INCOMPLETE mask, the
; pointee's typeinfo is a plain abi::__class_type_info of I without facts) and
; the addresses of typeinfo objects in constant initializers (C_ADDR of a
; DECL_ABI_DATA: globals, an array of them, a member of an aggregate).  A g++
; and a clang unit (Inputs/s3_incomplete_host.cpp) compare them with their
; own typeinfo objects.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s3_incomplete_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -c %S/Inputs/s3_incomplete_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe
frame HEADER
