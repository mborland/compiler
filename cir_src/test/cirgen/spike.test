; The toolchain spike program through the real emitter:
;   int g = 5;
;   int f(int a, int b) { return a < b ? a + b : 0; }
;   int main(void) { int s = 0; for (int i = 0; i < g; ++i) s += f(i, 3);
;                    return s == 12 ? 0 : 1; }
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK: cir.global external dso_local @g = #cir.int<5> : !s32i align(4)
; CHECK: cir.func {{.*}}@f(%arg0: !s32i, %arg1: !s32i) -> !s32i
; CHECK: cir.ternary
; CHECK: cir.func {{.*}}@main() -> !s32i
; CHECK: cir.for
; CHECK: cir.call @f

frame DECLS
  STR 10 "g"
  STR 11 "f"
  STR 12 "main"
  TY_FUNC 20 1 0 [1, 1]
  TY_FUNC 21 1 0 []
  DECL_VAR 30 1 0 1 4 10
  C_INT 1 5
  VAR_INIT 30
  DECL_FUNC 31 20 0 1 11
  DECL_FUNC 32 21 0 9 12
frame REGION
  FUNC_BEGIN 31 0
  PARAM 1 1 1 nil 0
  PARAM 2 1 1 nil 0
  LREF 1
  LOAD 0
  LREF 2
  LOAD 0
  CMP 0
  TERN_BEGIN 1
  LREF 1
  LOAD 0
  LREF 2
  LOAD 0
  ADD 1
  TERN_ELSE
  CONST_INT 1 0
  TERN_END
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 32 0
  LOCAL 1 1 nil 4 0
  LREF 1
  CONST_INT 1 0
  STORE 0 0
  FOR_BEGIN
  LOCAL 2 1 nil 4 0
  LREF 2
  CONST_INT 1 0
  STORE 0 0
  FOR_COND true
  LREF 2
  LOAD 0
  GREF 30
  LOAD 0
  CMP 0
  FOR_STEP true
  LREF 2
  INC_DEC 0 1
  DROP
  FOR_BODY
  LREF 1
  DUP
  LOAD 0
  LREF 2
  LOAD 0
  CONST_INT 1 3
  CALL 31 20 2 0
  ADD 1
  STORE 0 0
  FOR_END
  LREF 1
  LOAD 0
  CONST_INT 1 12
  CMP 4
  TERN_BEGIN 1
  CONST_INT 1 0
  TERN_ELSE
  CONST_INT 1 1
  TERN_END
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
