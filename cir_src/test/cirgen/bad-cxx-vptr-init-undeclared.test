; VPTR_INIT in a class whose vtable has no DECL_ABI_DATA: the address point
; cannot be chosen at finish, a fatal diagnostic.
; RUN: cat %S/Inputs/header12_cxx_rtti.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s

; CHECK: error [1001]: a VPTR_INIT in a class whose vtable is not declared (DECL_ABI_DATA) or whose vtable facts were not sent

frame DECLS
  STR 11 "A"
  STR 21 "1A"
  STR 31 "_ZN1A1fEv"
  STR 35 "_ZN1AC1Ev"
  STR 36 "_ZN1AC2Ev"
  TY_VPTR 90
  TY_RECORD_DECL 61 0 11
  TY_RECORD_BODY 61 8 8 8 4 1
  REC_FIELD 90 0 nil nil nil 1
  CLASS_MANGLE 61 21
  CLASS_INFO 61 8 8 nil 1
  CLASS_BASES 61 []
  TY_PTR 62 61
  TY_FUNC 70 11 0 [62]
  DECL_FUNC 100 70 0 1 31
  DECL_FUNC 105 70 0 1 35
  DECL_FUNC 106 70 0 1 36
  STRUCTOR 105 106 0
  CLASS_VFUNCS 61 [100, 0, 0, 1]
  CLASS_OVERRIDES 61 []
frame REGION
  FUNC_BEGIN 106 0
  PARAM 1 62 62 nil 1
  VPTR_INIT
  FUNC_END 1
frame END
  END auto 0
