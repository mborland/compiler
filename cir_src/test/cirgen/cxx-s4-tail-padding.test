ecil 1.2 features=0x0000000a
; C++: initializing a non-POD base (X, size 8, data size 5) from a function call
; result must not write its tail padding, where the virtual base Y lives:
;   struct X { ~X() {} int n; char d; }; struct Y { Y(); char c[3]; };
;   struct Z : X, virtual Y { Z(); };  X f();  Z::Z() : Y(), X(f()) {}
; The call result lands in a temporary and only the data size is copied.
; The stream is the ECIL writer's output (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe
; RUN: %edg-cir --emit=obj -O2 -o %t2.o %t.ecil
; RUN: g++ %t2.o -o %t2.exe
; RUN: %t2.exe

; CHECK-LABEL: cir.func {{.*}}@_ZN1ZC2Ev
; CHECK: cir.alloca "agg.tmp.ensured"
; CHECK: cir.libc.memcpy %{{.*}} bytes from

frame HEADER
