ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S2): an iostream-like hierarchy: ostream and istream
; derive virtually from basic_ios (polymorphic, itself with a virtual base
; ios_base), iostream from both, sstream from iostream.  Construction vtables
; for every base at every depth (_ZTC7sstream32_9basic_ios, ...) and a
; non-trivial VTT; the checks compare the symbols with clang's in the two-TU
; tests.
;   struct ios_base { int flags; virtual ~ios_base(); };
;   struct basic_ios : virtual ios_base { ... };
;   struct ostream : virtual basic_ios { ostream &put(int); };
;   struct istream : virtual basic_ios { };
;   struct iostream : istream, ostream { };  struct sstream : iostream { };
; The stream is the ECIL writer's output for the program (cpfe-cir --ecil_output).
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: cir.global {{.*}}@_ZTT7sstream =
; CHECK-DAG: cir.global {{.*}}@_ZTC7sstream32_9basic_ios = #cir.vtable<
; CHECK-DAG: cir.global {{.*}}@_ZTC7sstream16_7ostream = #cir.vtable<
; CHECK-DAG: cir.global {{.*}}@_ZTC8iostream32_9basic_ios = #cir.vtable<

