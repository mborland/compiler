; C++ (ECIL v1, slice S1): the consumer's C1 strategy for STRUCTOR pairs.
;   external linkage:   C1 is an alias of C2.
;   weak_odr:           C2 in comdat C5 (D5 for destructors), C1 a weak_odr alias.
;   linkonce_odr and internal: no C1 symbol; every use of C1 refers to C2.
; The body is streamed under the base variant (C2/D2) only; the program calls
; the complete variants (C1/D1) and checks the constructors and destructors ran.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil > %t.cir
; RUN: %FileCheck %s < %t.cir
; RUN: %not grep -e _ZN1IC1Ei -e _ZN1ID1Ev -e _ZN1PC1Ei %t.cir
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; CHECK-DAG: cir.func private @_ZN1EC1Ei(!cir.ptr<!rec_E>{{.*}}, !s32i{{.*}}) alias(@_ZN1EC2Ei)
; CHECK-DAG: cir.func private @_ZN1ED1Ev(!cir.ptr<!rec_E>{{.*}}) alias(@_ZN1ED2Ev)
; CHECK-DAG: cir.func comdat("_ZN1WC5Ei") weak_odr dso_local @_ZN1WC2Ei
; CHECK-DAG: cir.func weak_odr private @_ZN1WC1Ei(!cir.ptr<!rec_W>{{.*}}, !s32i{{.*}}) alias(@_ZN1WC2Ei)
; CHECK-DAG: cir.func comdat("_ZN1WD5Ev") weak_odr dso_local @_ZN1WD2Ev
; CHECK-DAG: cir.func weak_odr private @_ZN1WD1Ev(!cir.ptr<!rec_W>{{.*}}) alias(@_ZN1WD2Ev)
; CHECK-DAG: cir.func comdat linkonce_odr dso_local @_ZN1IC2Ei
; CHECK-DAG: cir.func comdat linkonce_odr dso_local @_ZN1ID2Ev
; CHECK-DAG: cir.func internal private dso_local @_ZL1PC2Ei
; CHECK-DAG: cir.call @_ZN1IC2Ei({{.*}}) nothrow
; CHECK-DAG: cir.call @_ZN1ID2Ev({{.*}}) nothrow
; CHECK-DAG: cir.call @_ZN1EC1Ei({{.*}}) nothrow

; SYMS-DAG: {{[Ww]}} _ZN1WC1Ei
; SYMS-DAG: {{[Ww]}} _ZN1WC2Ei
; SYMS-DAG: T _ZN1EC1Ei
; SYMS-DAG: T _ZN1EC2Ei


