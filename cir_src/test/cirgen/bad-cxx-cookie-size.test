; Emitter-side check (ECIL v1, slice S4): an array cookie holds at least the
; element count.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 2'

; CHECK: NEW_ARRAY_COOKIE: a cookie is at least sizeof(size_t) bytes

frame DECLS
  STR 10 "f"
  TY_FUNC 22 11 0 [12]
  DECL_FUNC 31 22 0 1 10
frame REGION
  FUNC_BEGIN 31 0
  PARAM 1 12 12 nil 0
  LREF 1
  LOAD 0
  CONST_INT 2 3
  NEW_ARRAY_COOKIE 1 4
  DROP
  FUNC_END 1
frame END
  END auto 0
