; S2 item 10: a call of a pure or const function inside a try body is an
; invoke, as in clangir: the call carries the LLVM attribute `nounwind`, not
; `nothrow` (the call cannot throw, which would make it a plain call).  The
; stream is the writer's output for torture/pr100382 (a pure function that
; throws, called in a try): with `nothrow` the handler never saw the
; exception and the program terminated.  The call and the definition are
; nounwind willreturn memory(read) in the LLVM IR all the same.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --no-llvm-passes --emit=llvm %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ %t.o -o %t.exe
; RUN: %t.exe

; CHECK: define dso_local noundef i32 @_Z3foov() #[[PURE:[0-9]+]]
; CHECK: invoke noundef i32 @_Z3foov()
; CHECK: landingpad
; CHECK: attributes #[[PURE]] = {{{.*}}nounwind{{.*}}willreturn memory(read)

ecil 1.3 features=0x0000001a
frame HEADER
  STR 1 "x86_64-unknown-linux-gnu"
  STR 2 ""
  STR 3 "EDG C/C++ front end 7.0 (ECIL writer)"
  STR 4 "pr100382.cpp"
  TY_INT 1 32 true 4 4
  TY_INT 2 64 false 8 8
  TY_INT 3 64 true 8 8
  HDR_TARGET 1 2 nil 64 64 6
  HDR_LANG 1 201703 14
  HDR_PRODUCER 3 4
  HDR_TYPE_ROLE 3 1
  HDR_TYPE_ROLE 1 2
  HDR_TYPE_ROLE 2 3
frame REGION supp
  TY_FUNC 4 1 0 []
  STR 5 "_Z3foov"
  DECL_FUNC 5 4 0 0 5 supp{4: true, 14: true}
  DECL_FUNC 5 4 0 1 5 supp{4: true, 14: true}
  TY_BOOL 6 1 1
  STR 6 "x"
  DECL_VAR 7 1 0 0 0 6
  STR 7 "_ZTIi"
  DECL_ABI_DATA 8 2 1 0 0 7
  TYPEINFO_DEF 8 0 0 nil nil
  STR 8 "y"
  DECL_VAR 9 1 0 0 0 8
  FUNC_BEGIN 5 0
  BLOCK_BEGIN
  GREF 7
  LOAD 0
  TO_BOOL
  IF_BEGIN false
  BLOCK_BEGIN
  THROW_BEGIN 1
  CONST_INT 1 1
  STORE 0 0
  THROW_END 8 nil
  BLOCK_END
  IF_END
  GREF 9
  LOAD 0
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION supp
  STR 9 "_Z3barv"
  DECL_FUNC 10 4 0 0 9 supp{14: true}
  DECL_FUNC 10 4 0 1 9 supp{14: true}
  TY_ARRAY 11 1 2 0
  STR 10 "a"
  STR 11 "res"
  TY_PTR 12 1
  FUNC_BEGIN 10 0
  BLOCK_BEGIN
  LOCAL 1 11 10 0 0
  GREF 7
  CONST_INT 1 1
  STORE 0 0
  TRY_BEGIN 0
  BLOCK_BEGIN
  LOCAL 2 1 11 0 0
  LREF 2
  CALL 5 4 0 0
  STORE 0 0
  LREF 1
  ADDR
  CAST 12 12
  CONST_INT 1 0
  PTR_STRIDE 0
  DEREF
  LREF 2
  LOAD 0
  STORE 0 0
  BLOCK_END
  CATCH_BEGIN nil
  BLOCK_BEGIN
  CONST_INT 1 0
  RETURN_STMT true
  BLOCK_END
  TRY_END
  CONST_INT 1 1
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION
  STR 12 "main"
  DECL_FUNC 13 4 0 8 12
  DECL_FUNC 13 4 0 9 12
  TY_VOID 14
  TY_FUNC 15 14 0 []
  STR 13 "abort"
  DECL_FUNC 16 15 0 260 13
  FUNC_BEGIN 13 0
  BLOCK_BEGIN
  CALL 10 4 0 0
  TO_BOOL
  IF_BEGIN false
  BLOCK_BEGIN
  CALL 16 15 0 6
  BLOCK_END
  IF_END
  CONST_INT 1 0
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame GLOBALS
  DECL_VAR 7 1 0 33 0 6
  DECL_VAR 9 1 0 33 0 8
frame NAMES
frame END
  END 6 0
