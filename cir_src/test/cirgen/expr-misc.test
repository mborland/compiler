; Regressions from the C corpus: a bitcast cast between pointer and integer,
; a non-null pointer constant stored by INIT_CONST, a weak function that is
; only declared (extern_weak, null at run time).
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe -lm
; RUN: %t.exe

; CHECK-DAG: cir.cast ptr_to_int
; CHECK-DAG: cir.cast int_to_ptr
; CHECK-DAG: extern_weak
; CHECK-DAG: cir.cast int_to_bool
; CHECK-DAG: cir.load align(1) {{.*}} !cir.long_double

