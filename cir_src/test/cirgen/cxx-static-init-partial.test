; ECIL 1.1: STATIC_INIT_BEGIN flag PARTIAL (partial static initialization as
; g++ does it).  `ar` has a VAR_INIT with its constant element (a = 42) and a
; PARTIAL STATIC_INIT that stores only the dynamic one (b = f()); another
; global's initializer, which comes first in module order, already sees
; ar.a == 42.  The same for a guarded function-local static (sl = {7, 9}).
;   struct S { int a, b; };  S ar = {42, f()};  int seen = ar.a;
;   int h() { static S sl = {7, 9 /* dynamic */}; return sl.a * 10 + sl.b; }
; RUN: cat %S/Inputs/header11_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: @_ZZ1hvE2sl = #cir.const_record<{#cir.int<7> : !s32i, #cir.int<0> : !s32i}> : !rec_S align(4) dynamic_init_info<local = true
; CHECK-DAG: cir.local_init static_local @_ZZ1hvE2sl ctor {
; CHECK-DAG: @ar = #cir.const_record<{#cir.int<42> : !s32i, #cir.int<0> : !s32i}> : !rec_S ctor {

