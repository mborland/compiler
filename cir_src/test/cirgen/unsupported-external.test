; Unsupported policy: a dropped definition with external linkage is an error
; even when nothing in the translation unit references it.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; CHECK: error [1003]: the definition of 'ext_dropped' was dropped

frame DECLS
  STR 11 "ext_dropped"
  STR 13 "main"
  TY_FUNC 21 1 0 []
  DECL_FUNC 41 21 0 32 11
  DECL_FUNC 43 21 0 9 13
frame REGION
  FUNC_BEGIN 43 0
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
