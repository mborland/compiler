'''Unit tests of the edg-cir-* tools (no box, no Docker needed).

  python3 dev_tools/bin/edg-cir-tools-test [-v]

They cover the excused-crash heuristic (edg-cir-summary's crash_excuse, used
by edg-cir-gate-evidence), the C++ feature buckets of edg-cir-summary, the
.cfi_* normalization and the classes of the assembly comparison
(edg-cir-gate-evidence), the generated C++ template TU of edg-cir-rss and the
pruning and disk headroom helpers of edg-cir-checkpoint, and the test-kind
rules of cir_src/doc/support/make_support.py.
'''

import contextlib
import importlib.machinery
import io
import importlib.util
import json
import os
import shutil
import shlex
import signal
import subprocess
import sys
import tempfile
import threading
import time
import unittest
import unittest.mock

from pathlib import Path, PurePosixPath
from typing import List

BIN = Path(__file__).resolve().parent


def load_tool(name: str):
  '''Import dev_tools/bin/<name> (a file without .py) as a module.'''
  loader = importlib.machinery.SourceFileLoader(
    name.replace('-', '_'), str(BIN / name))
  spec = importlib.util.spec_from_loader(loader.name, loader)
  module = importlib.util.module_from_spec(spec)
  loader.exec_module(module)
  return module


summary = load_tool('edg-cir-summary')
gate = load_tool('edg-cir-gate-evidence')
rss = load_tool('edg-cir-rss')
checkpoint = load_tool('edg-cir-checkpoint')
perf = load_tool('edg-cir-perf')
lazy = load_tool('edg-cir-lazy-identity')
attr = load_tool('edg-cir-attr-diff')
chunk_identity = load_tool('edg-cir-chunk-identity')
chunk_rss = load_tool('edg-cir-chunk-rss')
chunk_ir = load_tool('edg-cir-chunk-ir')
names_check = load_tool('edg-cir-names-check')
sandbox = load_tool('edg-cir-sandbox')


def load_support():
  '''Import cir_src/doc/support/make_support.py by path.'''
  path = BIN.parents[1] / 'cir_src' / 'doc' / 'support' / 'make_support.py'
  spec = importlib.util.spec_from_file_location('make_support', path)
  module = importlib.util.module_from_spec(spec)
  spec.loader.exec_module(module)
  return module


support = load_support()

# The compile output of the M3 gate's one excused crash
# (imported/gnu/cpp/DRs/dr2867-2.sft.cpp, --c++11): the front end aborts in
# shared code (il.c), in the reference as well as with the CIR back end.
DR2867_2 = '''"Test_name.c", line 69: warning: structured bindings are a C++17 feature
    const auto &[x, y, z, w] = foo (B {}, B {});
                ^

"Test_name.c", line 69: internal error: assertion failed: \
pop_object_lifetime_full: useful lifetime is unbound (il.c, \
line <suppressed> in pop_object_lifetime_full)

    const auto &[x, y, z, w] = foo (B {}, B {});
                ^

1 catastrophic error detected in the compilation of "Test_name.c".
Compilation aborted.
Aborted
eccp: front end returned an exit status of 134
'''
ASSERT = ('"Test_name.c", line 69: internal error: assertion failed: '
          'pop_object_lifetime_full: useful lifetime is unbound (il.c, '
          'line <suppressed> in pop_object_lifetime_full)')


def result_of(output: str, ref_output: str, **fields) -> dict:
  '''A TestResult as a dict, for a crash with the given compile outputs.'''
  line, frames = summary.crash_details(output)
  ref_line, ref_frames = summary.crash_details(ref_output)
  result = {
    'path': 'a/b.sft.cpp', 'test_type': 'fp', 'variant': '-DTEST_NUMBER=1',
    'bucket': 'FE_CRASH', 'status': 'ABORT(COMPILE)',
    'ref_status': 'ABORT(COMPILE)', 'message': line,
    'crash_line': line, 'frames': frames, 'ref_crash_line': ref_line,
    'ref_frames': ref_frames,
    'ref_output_same': bool(ref_output) and summary.output_digest(
      output) == summary.output_digest(ref_output)
  }
  result.update(fields)
  return result


class CrashExcuseTest(unittest.TestCase):
  def test_dr2867_2_is_excused(self) -> None:
    result = result_of(DR2867_2, DR2867_2)
    self.assertEqual(result['crash_line'], ASSERT)
    excused, reason = summary.crash_excuse(result)
    self.assertTrue(excused, reason)
    # The gate's split uses the same rule.
    crashes, excused_list = gate.split_crashes([result])
    self.assertEqual((crashes, excused_list), ([], [result]))

  def test_shared_fe_code_with_another_assertion(self) -> None:
    # The writer drives the shared copy_expr_tree into an assertion that the
    # reference does not hit (same class of crash, other text): not excused.
    ours = DR2867_2.replace(
      'pop_object_lifetime_full: useful lifetime is unbound (il.c, '
      'line <suppressed> in pop_object_lifetime_full)',
      'copy_expr_tree: node has no copy (il.c, line <suppressed> in '
      'copy_expr_tree)')
    result = result_of(ours, DR2867_2)
    self.assertFalse(summary.crash_excuse(result)[0])

  def test_same_assertion_at_another_line(self) -> None:
    # With real line numbers (outside the test configuration) the file:line
    # decides: the same text at another line of il.c is another assertion.
    reference = DR2867_2.replace('line <suppressed>', 'line 4100')
    ours = DR2867_2.replace('line <suppressed>', 'line 4210')
    self.assertFalse(summary.crash_excuse(result_of(ours, reference))[0])
    self.assertTrue(summary.crash_excuse(result_of(reference, reference))[0])

  def test_same_assertion_at_another_source_position(self) -> None:
    ours = DR2867_2.replace('line 69: internal error',
                            'line 70: internal error')
    self.assertFalse(summary.crash_excuse(result_of(ours, DR2867_2))[0])

  def test_reference_does_not_crash(self) -> None:
    result = result_of(DR2867_2, DR2867_2, ref_status='')
    self.assertFalse(summary.crash_excuse(result)[0])
    result = result_of(DR2867_2, DR2867_2, ref_status='FAIL')
    self.assertFalse(summary.crash_excuse(result)[0])

  def test_other_crash_class(self) -> None:
    result = result_of(DR2867_2, DR2867_2, ref_status='CATASTROPHE(COMPILE)')
    self.assertFalse(summary.crash_excuse(result)[0])

  def test_library_crash_is_never_excused(self) -> None:
    result = result_of(DR2867_2, DR2867_2, bucket = 'LIB_CRASH')
    self.assertFalse(summary.crash_excuse(result)[0])
    self.assertEqual(gate.split_crashes([result]), ([result], []))

  def test_writer_file_in_the_message(self) -> None:
    ours = DR2867_2.replace('il.c, line <suppressed> in '
                            'pop_object_lifetime_full',
                            'ecil_code.c, line <suppressed> in ecil_expr')
    self.assertFalse(summary.crash_excuse(result_of(ours, DR2867_2))[0])

  def test_capital_internal_error_is_the_crash_line(self) -> None:
    text = ('ECIL: the name of a function changed\n'
            'Internal error: assertion failed: an ECIL function name changed '
            '(ecil_type.c, line <suppressed> in ecil_resolve_late_names)\n'
            '\n1 catastrophic error detected in the compilation of "t.c".\n')
    line, _ = summary.crash_details(text)
    self.assertIn('ecil_resolve_late_names', line)
    result = result_of(text, text)
    self.assertFalse(summary.crash_excuse(result)[0])

  def test_signal_without_a_message(self) -> None:
    # No assertion to compare, no backtrace: the writer might have caused it.
    plain = 'Segmentation fault\neccp: front end returned an exit status of '\
            '139\n'
    result = result_of(plain, plain)
    self.assertFalse(summary.crash_excuse(result)[0])

  def test_backtrace_decides(self) -> None:
    clean = DR2867_2 + (
      '==1==ERROR: AddressSanitizer: ABRT on unknown address\n'
      '    #0 0x7f1 in raise (/lib/libc.so.6+0x1)\n'
      '    #1 0x4a2 in assertion_failed /edg/src/util.c:12\n'
      '    #2 0x4b3 in pop_object_lifetime_full /edg/src/il.c:3000\n')
    with_writer = clean + (
      '    #3 0x4c4 in ecil_expr /edg/src/ecil_code.c:1234\n')
    self.assertTrue(summary.crash_excuse(result_of(clean, DR2867_2))[0])
    # A writer frame on the stack: not excused even if the text equals the
    # reference's.
    self.assertFalse(summary.crash_excuse(
      result_of(with_writer, DR2867_2))[0])
    # A clean stack does not excuse another assertion when the reference's
    # crash is an assertion.
    other = clean.replace('pop_object_lifetime_full: useful lifetime is '
                          'unbound', 'something else')
    self.assertFalse(summary.crash_excuse(result_of(other, DR2867_2))[0])
    self.assertEqual(len(summary.crash_details(with_writer)[1]), 4)

  def test_backtrace_without_assertion_in_the_reference(self) -> None:
    # The reference crashes by a signal (no assertion line): the stack
    # decides.
    signal = 'Segmentation fault\n'
    ours = signal + ('    #0 0x7f1 in memcpy (/lib/libc.so.6+0x1)\n'
                     '    #1 0x4b3 in copy_expr_tree /edg/src/il.c:99\n')
    self.assertTrue(summary.crash_excuse(result_of(ours, signal))[0])

  def test_every_frame_is_checked(self) -> None:
    # No cut at 60 frames, and the second and third stacks of a sanitizer
    # report count too.
    stack = ''.join(f"    #{i} 0x{i:x} in fe_function_{i} /edg/src/fe.c:{i}\n"
                    for i in range(80))
    late = stack + '    #80 0x50 in ecil_emit /edg/src/ecil_write.c:5\n'
    output = DR2867_2 + late
    self.assertEqual(len(summary.crash_details(output)[1]), 81)
    self.assertFalse(summary.crash_excuse(result_of(output, DR2867_2))[0])
    three = DR2867_2 + (
      stack + '\nfreed by thread T0 here:\n' + stack +
      '\npreviously allocated by thread T0 here:\n' + late)
    self.assertFalse(summary.crash_excuse(result_of(three, DR2867_2))[0])
    # The same stacks without the writer frame are clean.
    self.assertTrue(summary.crash_excuse(
      result_of(DR2867_2 + stack + stack, DR2867_2))[0])

  def test_unsymbolized_frames_are_no_backtrace(self) -> None:
    bare = DR2867_2 + (
      '    #0 0x7f1 (/lib/libc.so.6+0x1)\n'
      '    #1 0x4b3 (/edg/build/gcc-cir/bin/cpfe-cir+0x4b3)\n'
      './build/cpfe-cir(+0x1234) [0x1234]\n')
    self.assertEqual(summary.crash_details(bare)[1].__len__(), 3)
    self.assertFalse(any(summary.frame_symbolized(f)
                         for f in summary.crash_details(bare)[1]))
    # No symbolized frame: the identity of the assertion decides.
    self.assertTrue(summary.crash_excuse(result_of(bare, DR2867_2))[0])
    other = bare.replace('pop_object_lifetime_full: useful lifetime is '
                         'unbound', 'something else')
    self.assertFalse(summary.crash_excuse(result_of(other, DR2867_2))[0])
    # A signal with only bare frames: not excused (no evidence).
    signal = 'Segmentation fault\n    #0 0x7f1 (/lib/libc.so.6+0x1)\n'
    self.assertFalse(summary.crash_excuse(result_of(signal, signal))[0])
    self.assertTrue(summary.frame_symbolized(
      '    #2 0x4b3 in f /edg/src/il.c:3000'))
    self.assertTrue(summary.frame_symbolized('./cpfe(f+0x12) [0x4]'))

  def test_library_frames_are_cir_code(self) -> None:
    base = DR2867_2 + ('==1==ERROR: AddressSanitizer: ABRT\n'
                       '    #0 0x7f1 in raise (/lib/libc.so.6+0x1)\n'
                       '    #1 0x4b3 in pop_object_lifetime_full '
                       '/edg/src/il.c:3000\n')
    self.assertTrue(summary.crash_excuse(result_of(base, DR2867_2))[0])
    for frame in ('edg_cir::compat::emit_call(mlir::Value) /edg/x.cpp:5',
                  'edg_cir::CIRGen::emitExpr /edg/cir_src/lib/cirgen/e.cpp:9',
                  'ecil::Reader::next /edg/cir_src/lib/format/r.cpp:1',
                  'edg_abi::classify /edg/cir_src/lib/abi.cpp:2',
                  'mlir::Operation::erase() /llvm/mlir/lib/IR/Operation.cpp:1',
                  'cir::CallOp::verify /llvm/clang/lib/CIR/Dialect/IR.cpp:2',
                  'llvm::report_fatal_error /llvm/lib/Support/E.cpp:3'):
      text = base + f"    #2 0x4c4 in {frame}\n"
      self.assertFalse(summary.crash_excuse(result_of(text, DR2867_2))[0],
                       frame)
    # An unsymbolized frame of the library's shared object.
    bare = DR2867_2 + ('    #0 0x7f1 (/edg/build/cir/lib/libedg_cir.so.0+'
                       '0x4b3)\n')
    self.assertFalse(summary.crash_excuse(result_of(bare, DR2867_2))[0])
    # Namespaces that only look alike are not library code.
    ok = base + '    #2 0x4c4 in circle::area /edg/src/geom.c:1\n'
    self.assertTrue(summary.crash_excuse(result_of(ok, DR2867_2))[0])

  def test_glibc_backtrace_frame(self) -> None:
    text = 'Aborted\n./build/cpfe-cir(cir_be_finish+0x42) [0x4d2]\n'
    self.assertEqual(summary.crash_details(text)[1],
                     ['./build/cpfe-cir(cir_be_finish+0x42) [0x4d2]'])
    result = result_of(DR2867_2 + text, DR2867_2)
    self.assertFalse(summary.crash_excuse(result)[0])

  def test_reference_recording_by_case(self) -> None:
    # reference_output picks the recording of the case's options.
    with tempfile.TemporaryDirectory() as tmp:
      tests = Path(tmp)
      rto = tests / 'imported' / 'gnu' / 'cpp' / '.dr.rto'
      rto.mkdir(parents = True)
      (rto / 'default.1.1.txt').write_text(
        'eccp -DTEST_NUMBER=1 -tused --c++11 Test_name.c\nfirst case\n')
      (rto / 'default.2.1.txt').write_text(
        'eccp -DTEST_NUMBER=1 -tused --c++14 Test_name.c\nsecond case\n')
      (rto / 'edg_x86_64.2.1.txt').write_text(
        'eccp -DTEST_NUMBER=1 -tused --c++14 Test_name.c\nown second\n')
      path = 'imported/gnu/cpp/dr.sft.cpp'
      self.assertEqual(summary.reference_output(
        tests, path, '-DTEST_NUMBER=1 --c++11'), 'first case')
      self.assertEqual(summary.reference_output(
        tests, path, '-DTEST_NUMBER=1 --c++14'), 'own second')
      self.assertEqual(summary.reference_output(
        tests, path, '-DTEST_NUMBER=1 --c++99'), '')


class CommandTimeoutTest(unittest.TestCase):
  def context(self, tmp: str, **limits: int):
    import types
    args = types.SimpleNamespace(
      tree = tmp, out = str(Path(tmp) / 'out'), command_timeout = 60,
      step_timeout = [f"{k}={v}" for k, v in limits.items()])
    return gate.Context(args)

  def test_a_hanging_command_is_stopped(self) -> None:
    import tempfile, time
    with tempfile.TemporaryDirectory() as tmp:
      ctx = self.context(tmp, hang = 1)
      started = time.time()
      code = gate.run_logged(ctx, 'hang', ['sleep', '30'], label = 'sleep')
      self.assertEqual(code, 124)
      self.assertLess(time.time() - started, 20)
      self.assertEqual(ctx.timed_out['hang'], ['sleep'])
      log = (Path(tmp) / 'out/hang/log.txt').read_text()
      self.assertIn('[TIMEOUT after 1 s', log)

  def test_container_labels_are_per_gate_run(self) -> None:
    import tempfile, os
    with tempfile.TemporaryDirectory() as tmp:
      ctx = self.context(tmp)
      prefix = gate.job_prefix(ctx, 'cpp-stress')
      self.assertEqual(prefix, f"cir-config-{Path(tmp).name}-cpp-stress-g"
                               f"{os.getpid()}")
      # Another gate run (another pid) of the same tree and step gets
      # another prefix; the filter holds the whole prefix.
      real = os.getpid
      try:
        os.getpid = lambda: real() + 1
        other = gate.job_prefix(ctx, 'cpp-stress')
      finally:
        os.getpid = real
      self.assertNotEqual(prefix, other)
      self.assertEqual(gate.container_filter(prefix),
                       f"label=edg.job={prefix}")
      self.assertNotEqual(gate.container_filter(prefix),
                          gate.container_filter(other))

  def test_a_normal_command_is_not(self) -> None:
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
      ctx = self.context(tmp)
      self.assertEqual(gate.run_logged(ctx, 'fine', ['true']), 0)
      self.assertEqual(ctx.timed_out, {})
      self.assertEqual(gate.command_timeout(ctx, 'fine'), 60)
      self.assertEqual(gate.command_timeout(ctx, 'isolation'), 900)


class FingerprintTest(unittest.TestCase):
  def test_tree_fingerprint(self) -> None:
    import tempfile
    module = checkpoint
    with tempfile.TemporaryDirectory() as tmp:
      root = Path(tmp)
      for name in ('src', 'cir_src', 'dev_tools/bin', 'tests/.edgy',
                   'cmake'):
        (root / name).mkdir(parents = True)
      (root / 'src/a.c').write_text('one')
      (root / 'cir_src/b.cpp').write_text('two')
      first = module.local_fingerprint(root)
      self.assertEqual(module.local_fingerprint(root), first)
      self.assertTrue(first.endswith(' 2'))
      # A change of a file, or a new file, changes it ...
      (root / 'src/a.c').write_text('three')
      changed = module.local_fingerprint(root)
      self.assertNotEqual(changed, first)
      (root / 'tests/.edgy/f.txt').write_text('x')
      self.assertNotEqual(module.local_fingerprint(root), changed)
      # ... files outside the hashed directories, build directories, caches
      # and symbolic links do not.
      again = module.local_fingerprint(root)
      (root / 'build').mkdir()
      (root / 'build/x').write_text('y')
      (root / 'cir_src/build').mkdir()
      (root / 'cir_src/build/z').write_text('y')
      (root / 'src/__pycache__').mkdir()
      (root / 'src/__pycache__/m.pyc').write_text('y')
      (root / 'src/link').symlink_to(root / 'src/a.c')
      (root / 'README').write_text('y')
      self.assertEqual(module.local_fingerprint(root), again)


class M4StepsTest(unittest.TestCase):
  ABI = '''==== dev_tools/cir-abi-cases/s1/%s: %s identical 4, normalized 1, spelling 2, fe 0, ours %d, unknown 0, missing %d, vbase 0, norecord 2
%s
'''

  def abi(self, extra: str = '') -> str:
    names = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j']
    text = ''.join(self.ABI % (n + '.cpp', 'PASS', 0, 0, '') for n in names)
    return text + extra

  def test_abi_diff_rule(self) -> None:
    ok, detail = gate.judge_abi_batch(self.abi())
    self.assertTrue(ok, detail)
    # A difference of ours fails; so do missing blocks (but not of a known
    # tool limit), and a file that did not compare.
    bad = self.abi(self.ABI % ('k.cpp', 'DIFF', 2, 0, 'DIFFERS (OURS) x'))
    self.assertFalse(gate.judge_abi_batch(bad)[0])
    bad = self.abi(self.ABI % ('k.cpp', 'DIFF', 0, 3, 'MISSING vtable A'))
    self.assertFalse(gate.judge_abi_batch(bad)[0])
    known = self.abi(self.ABI % ('template.cpp', 'DIFF', 0, 4,
                                 'MISSING vtable Box (6 entries)'))
    ok, detail = gate.judge_abi_batch(known)
    self.assertTrue(ok, detail)
    self.assertIn('4 missing from known tool limits', detail)
    self.assertFalse(gate.judge_abi_batch(
      self.abi() + 'foo.cpp                  FE-REJECT\n')[0])
    self.assertFalse(gate.judge_abi_batch(
      'SKIP: ecil-dump has no --vtable-layouts option yet\n')[0])

  def test_abi_diff_needs_a_comparison_per_file(self) -> None:
    # An all-zero file, and a known-limit file that compared nothing, fail.
    empty = self.ABI % ('k.cpp', 'PASS', 0, 0, '')
    empty = empty.replace('identical 4, normalized 1, spelling 2',
                          'identical 0, normalized 0, spelling 0')
    ok, detail = gate.judge_abi_batch(self.abi(empty))
    self.assertFalse(ok)
    self.assertIn('k.cpp: no block was compared', detail)
    limited = (self.ABI % ('template.cpp', 'DIFF', 0, 4, 'MISSING x')
               ).replace('identical 4, normalized 1, spelling 2',
                         'identical 0, normalized 0, spelling 0')
    ok, detail = gate.judge_abi_batch(self.abi(limited))
    self.assertFalse(ok)
    self.assertIn('template.cpp: no block was compared', detail)
    # With one compared block (identical or loose) a known-limit file passes.
    some = (self.ABI % ('template.cpp', 'DIFF', 0, 4, 'MISSING x')
            ).replace('identical 4, normalized 1, spelling 2',
                      'identical 0, normalized 0, spelling 1')
    self.assertTrue(gate.judge_abi_batch(self.abi(some))[0])

  def test_eh_probes_rule(self) -> None:
    rows = ''.join(f"e{i}.cpp                     PASS        \n"
                   for i in range(5))
    rows += 'u1.cpp                     UNSUPPORTED* edg-cir: error ...\n'
    skip = {'u1.cpp'}
    ok, detail = gate.judge_eh_probes(rows, skip, 6)
    self.assertTrue(ok, detail)
    # Fewer probes than expected (a glob that matched nothing) fails, and a
    # step that expects no probe at all is not a pass.
    self.assertFalse(gate.judge_eh_probes('0 probe(s): ...\n', skip, 6)[0])
    ok, detail = gate.judge_eh_probes('', set(), 0)
    self.assertFalse(ok)
    self.assertIn('no probe file was found', detail)
    # Every probe unsupported is not a pass either.
    self.assertFalse(gate.judge_eh_probes(
      'u1.cpp                     UNSUPPORTED* x\n', {'u1.cpp'}, 1)[0])
    self.assertFalse(gate.judge_eh_probes(rows, skip, 7)[0])
    # A probe on the skip list that passes now must be removed from it.
    ok, detail = gate.judge_eh_probes(rows, skip | {'e1.cpp'}, 6)
    self.assertFalse(ok)
    self.assertIn('e1.cpp passes: remove it from the skip list', detail)
    # An unsupported probe that is not on the list, and a DIFF, fail.
    self.assertFalse(gate.judge_eh_probes(rows, set(), 6)[0])
    bad = rows.replace('e2.cpp                     PASS',
                       'e2.cpp                     DIFF')
    self.assertFalse(gate.judge_eh_probes(bad, skip, 6)[0])

  def test_symbols_rule(self) -> None:
    def one(name: str, rows: str = '') -> str:
      return (f"==== dev_tools/cir-abi-cases/s1/{name}\n"
              f"14 ABI-family symbols in the reference, 12 in ours; "
              f"{rows.count(chr(10))} difference(s)\n"
              f"family symbol difference detail\n{rows}"
              f"g++ against the reference (clang): 0 difference(s)\n")
    names = [f"c{i}.cpp" for i in range(10)]
    text = ''.join(one(n) for n in names)
    self.assertTrue(gate.judge_symbols(text)[0])
    allowed = one('no-key.cpp',
                  'dtor _ZN1AD0Ev only in ours WEAK FUNC\n'
                  'vtable _ZTV1A only in ours WEAK OBJECT\n')
    ok, detail = gate.judge_symbols(text + allowed)
    self.assertTrue(ok, detail)
    self.assertIn('2 known difference(s)', detail)
    other = one('no-key.cpp', 'vtable _ZTV1B only in ours WEAK OBJECT\n')
    self.assertFalse(gate.judge_symbols(text + other)[0])
    skipped = text + '==== x/skip.cpp\nSKIP: the CIR back end ...\n'
    self.assertFalse(gate.judge_symbols(skipped)[0])

  def test_mixed_tu_rule(self) -> None:
    cases = {'a': set(), 'b': {'ref+ours'}}
    good = ('case direction result detail\n'
            'a                               ref+ours    PASS \n'
            'a                               ours+ref    PASS \n'
            'b                               ref+ours    XFAIL why\n'
            'b                               ours+ref    PASS \n'
            '2 case(s), 0 not passing\n')
    ok, detail = gate.judge_mixed_tu(good, cases)
    self.assertTrue(ok, detail)
    self.assertIn('4 of 4 rows', detail)
    # A missing row (a case or a direction that did not run) fails, also when
    # the name of the case is as wide as its column (no space before the
    # direction).
    ok, detail = gate.judge_mixed_tu(good.replace(
      'b                               ours+ref    PASS \n', ''), cases)
    self.assertFalse(ok)
    self.assertIn('b ours+ref: no row', detail)
    wide = {'a-case-with-a-name-of-33-characters': set()}
    rows = ''.join(f"a-case-with-a-name-of-33-characters{d}    PASS \n"
                   for d in ('ref+ours', 'ours+ref'))
    self.assertTrue(gate.judge_mixed_tu(rows, wide)[0])
    # An XFAIL that the case does not list, an XPASS (a stale xfail line), any
    # other result, a duplicate row and a row of an unknown case fail.
    row = '{}                               {}    {}'
    for bad in (good.replace(row.format('a', 'ours+ref', 'PASS'),
                             row.format('a', 'ours+ref', 'XFAIL')),
                good.replace(row.format('b', 'ref+ours', 'XFAIL'),
                             row.format('b', 'ref+ours', 'XPASS')),
                good.replace(row.format('b', 'ours+ref', 'PASS'),
                             row.format('b', 'ours+ref', 'LINK')),
                good + row.format('a', 'ours+ref', 'PASS') + '\n',
                good + row.format('c', 'ours+ref', 'PASS') + '\n'):
      self.assertFalse(gate.judge_mixed_tu(bad, cases)[0], bad)
    self.assertFalse(gate.judge_mixed_tu('nothing\n', cases)[0])
    self.assertFalse(gate.judge_mixed_tu(good, {})[0])

  def test_mixed_tu_cases_load(self) -> None:
    cases = gate.load_mixed_tu_cases(
      Path(__file__).resolve().parent.parent / 'cir-mixed-tu-cases')
    self.assertGreaterEqual(len(cases), 19)
    self.assertIn('s1-deleting-dtor', cases)

  def test_mixed_tu_names_a_failing_baseline(self) -> None:
    text = ('b                               all-ref     REF-FAIL    link: x\n'
            'a                               ref+ours    PASS \n'
            'a                               ours+ref    PASS \n')
    ok, detail = gate.judge_mixed_tu(text, {'a': set(), 'b': set()})
    self.assertFalse(ok)
    self.assertIn('b: REF-FAIL (the baseline itself fails: link: x)', detail)
    self.assertNotIn('no row', detail)

  def test_context_drops_the_default_options(self) -> None:
    import argparse
    import contextlib
    import io
    saved = os.environ.get('EDG_CPFE_DEFAULT_OPTIONS')
    os.environ['EDG_CPFE_DEFAULT_OPTIONS'] = '--cir_opt_level=2'
    try:
      with tempfile.TemporaryDirectory() as tmp:
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
          context = gate.Context(argparse.Namespace(tree = tmp, out = tmp))
        self.assertNotIn('EDG_CPFE_DEFAULT_OPTIONS', context.env)
        self.assertIn('WARNING', err.getvalue())
    finally:
      if saved is None:
        del os.environ['EDG_CPFE_DEFAULT_OPTIONS']
      else:
        os.environ['EDG_CPFE_DEFAULT_OPTIONS'] = saved

  def test_perf_worst_change(self) -> None:
    def perf(big: int, cxx: int, fe: int) -> dict:
      return {'big': {'inproc': {'ir': big}}, 'big_cxx': {'inproc': {'ir': cxx},
              'cgen-total': {'ir': 0}}, 'corpus': {'fe_ir': fe, 'cir_ir': 100}}
    before = perf(1000, 2000, 500)
    worst, compared, problems = gate.perf_worst_change(before,
                                                       perf(1010, 1900, 500))
    self.assertEqual((compared, problems), (4, []))
    self.assertAlmostEqual(worst, 1.0)
    # Rows that shrank only: no increase (the unchanged row is 0).
    worst, _, _ = gate.perf_worst_change(before, perf(900, 1900, 400))
    self.assertEqual(worst, 0.0)
    # Nothing in common compares nothing; a baseline row that is missing or
    # 0 in the new run is a problem, not a skipped row.
    self.assertEqual(gate.perf_worst_change({}, before), (0.0, 0, []))
    _, compared, problems = gate.perf_worst_change(before, {})
    self.assertEqual(compared, 0)
    self.assertEqual(len(problems), 4, problems)
    _, _, problems = gate.perf_worst_change(before, perf(1000, 0, 500))
    self.assertEqual(problems, ['big_cxx/inproc is missing or 0 in the new '
                                'run'])
    self.assertEqual(gate.DEFAULT_PERF_MAX_REGRESSION, 2.0)

  def test_opt_corpus_rules(self) -> None:
    before = {('a', ''): 'PASS', ('b', ''): 'PASS', ('c', ''): 'FAIL',
              ('d', ''): 'PASS'}
    after = {('a', ''): 'PASS', ('b', ''): 'RUN_FAIL', ('c', ''): 'PASS',
             ('d', ''): 'LIB_CRASH'}
    triage = {('b', ''): ('ub', 'overflow'), ('d', ''): ('our-ir', 'x')}
    ok, detail, lists = gate.judge_opt_changes(before, after, triage, 'C')
    self.assertTrue(ok, detail)
    self.assertIn('2 worse (our-ir 1, ub 1)', detail)
    self.assertEqual(lists['our-ir'], [('d', '')])
    self.assertEqual(lists['improved'], [('c', '')])
    # A FAIL that becomes a crash (or a kill, a timeout) is a new problem
    # that needs a line too; a crash that was already one is not.
    ok, detail, lists = gate.judge_opt_changes(
      {('a', ''): 'FAIL', ('b', ''): 'LIB_CRASH'},
      {('a', ''): 'LIB_CRASH', ('b', ''): 'LIB_CRASH'}, {}, 'C')
    self.assertFalse(ok)
    self.assertEqual(lists['unattributed'], [('a', '')])
    # A change without a line, a stale line, and a different set of cases.
    ok, detail, lists = gate.judge_opt_changes(
      before, after, {('b', ''): ('ub', 'x')}, 'C')
    self.assertFalse(ok)
    self.assertEqual(lists['unattributed'], [('d', '')])
    ok, detail, lists = gate.judge_opt_changes(
      before, after, {**triage, ('a', ''): ('ub', 'x')}, 'C')
    self.assertFalse(ok)
    self.assertEqual(lists['stale'], [('a', '')])
    short = dict(after)
    del short[('a', '')]
    self.assertFalse(gate.judge_opt_changes(before, short, triage, 'C')[0])
    self.assertFalse(gate.judge_opt_changes({}, {}, {}, 'C')[0])
    # The triage file: categories are checked.
    with tempfile.TemporaryDirectory() as tmp:
      path = Path(tmp) / 'triage.txt'
      path.write_text('# c\nimported/x.c | -O | our-ir | why\n')
      self.assertEqual(gate.read_opt_triage(path),
                       {('imported/x.c', '-O'): ('our-ir', 'why')})
      path.write_text('x | | bogus | why\n')
      with self.assertRaises(ValueError):
        gate.read_opt_triage(path)
      self.assertEqual(gate.read_opt_triage(Path(tmp) / 'none.txt'), {})

  def test_canary_output(self) -> None:
    import tarfile
    with tempfile.TemporaryDirectory() as tmp:
      run = Path(tmp)
      path = 'cir/config/opt-level-canary.sft.c'
      config_dir = run / 'edg_x86_64_cir' / 'cir' / 'config'
      config_dir.mkdir(parents = True)
      self.assertIsNone(gate.canary_output(run, 'edg_x86_64_cir', path))
      output = config_dir / 'output.txt'
      output.write_text('canary: optimizing\n')
      with tarfile.open(config_dir / 'opt-level-canary.sft.rt.tar.gz',
                        'w:gz') as tar:
        tar.add(output, arcname = 'cases/1/2/output.txt')
      self.assertIn('canary: optimizing',
                    gate.canary_output(run, 'edg_x86_64_cir', path))

  def test_opt_corpus_asm_rule(self) -> None:
    with tempfile.TemporaryDirectory() as tmp:
      o0, o2 = Path(tmp) / 'o0', Path(tmp) / 'o2'
      for directory, text in ((o0, 'a\n'), (o2, 'b\n')):
        directory.mkdir()
        (directory / 'x.0.s').write_text(text)
        (directory / 'y.0.s').write_text(text)
        (directory / 'manifest.json').write_text(json.dumps({
          'x.0.s': {'asm': True, 'rc': 0}, 'y.0.s': {'asm': True, 'rc': 0},
          'z.0.s': {'asm': False, 'rc': 1}}))
      ok, detail = gate.judge_opt_asm(o0, o2, 'smoke')
      self.assertTrue(ok, detail)
      self.assertIn('2/2 differ', detail)
      (o2 / 'y.0.s').write_text('a\n')
      ok, detail = gate.judge_opt_asm(o0, o2, 'smoke')
      self.assertFalse(ok)
      self.assertIn('1 case(s) with the same assembly', detail)
      # Nothing with assembly is no pass either.
      for directory in (o0, o2):
        (directory / 'manifest.json').write_text(json.dumps(
          {'z.0.s': {'asm': False, 'rc': 1}}))
      self.assertFalse(gate.judge_opt_asm(o0, o2, 'smoke')[0])
      self.assertFalse(gate.judge_opt_asm(o0, Path(tmp) / 'no', 'smoke')[0])

  def test_rss_rule(self) -> None:
    ceilings = {('c', 'asan', 'inproc'): 100, ('c', 'asan', '2p-fe'): 50,
                ('cxx', 'release', 'inproc'): 80}
    text = ('== RSS c asan\nmode wall s peak\n'
            'inproc          1.00           90    0\n'
            '2p-fe           1.00           40    0\n'
            '== RSS cxx release\n'
            'inproc          1.00           79    0\n')
    ok, detail = gate.judge_rss(text, ceilings)
    self.assertTrue(ok, detail)
    self.assertIn('99% of its ceiling', detail)
    # Over a ceiling, a failing exit status, a missing row and no ceilings.
    self.assertFalse(gate.judge_rss(text.replace('79', '81'), ceilings)[0])
    self.assertFalse(gate.judge_rss(text.replace('40    0', '40    1'),
                                    ceilings)[0])
    ok, detail = gate.judge_rss(text.split('== RSS cxx')[0], ceilings)
    self.assertFalse(ok)
    self.assertIn('cxx/release/inproc: no measurement', detail)
    self.assertFalse(gate.judge_rss(text, {})[0])
    # A row measured several times counts with its minimum (the ASan
    # in-process rows), and a failing exit status of any run fails it.
    again = text + ('== RSS c asan\ninproc 1.00 120 0\n'
                    '== RSS c asan\ninproc 1.00 95 0\n')
    self.assertEqual(gate.parse_rss(again)[('c', 'asan', 'inproc')], (0, 90.0))
    ok, detail = gate.judge_rss(
      text.replace('inproc          1.00           90    0',
                   'inproc          1.00          130    0') +
      '== RSS c asan\ninproc 1.00 95 0\n', ceilings)
    self.assertTrue(ok, detail)
    self.assertFalse(gate.judge_rss(
      text + '== RSS c asan\ninproc 1.00 95 1\n', ceilings)[0])
    # Rows outside a block are not taken for a measurement.
    self.assertFalse(gate.judge_rss('inproc 1.0 5 0\n', ceilings)[0])

  def test_stress_rule(self) -> None:
    lines = ''.join(
      f"{c.split(':')[0]:<8} {int(c.split(':')[1]):6d} rc=0 total_ms={m} "
      f"stages(decode)=1 rss={mb * 1024} \n"
      for c, (m, mb) in gate.M4_STRESS_CASES.items())
    ok, detail = gate.judge_stress(lines)
    self.assertTrue(ok, detail)
    slow = lines.replace('total_ms=107', 'total_ms=999999')
    self.assertFalse(gate.judge_stress(slow)[0])
    self.assertFalse(gate.judge_stress(
      lines.replace('rc=0', 'rc=139', 1))[0])
    self.assertFalse(gate.judge_stress(lines.splitlines()[0])[0])
    self.assertEqual(gate.stress_limits((107, 59)), (2000, 177))


class SanitizerTrailerTest(unittest.TestCase):
  def test_nested_bug_trailer_is_not_compiler_output(self) -> None:
    reference = ('"t.c", line 10: error: target attribute not recognized\n'
                 'Segmentation fault\neccp: front end returned an exit '
                 'status of 139\n')
    debug = ('"t.c", line 10: error: target attribute not recognized\n'
             'Segmentation fault\nAddressSanitizer: nested bug in the same '
             'thread, aborting.\nSegmentation fault\neccp: front end '
             'returned an exit status of 139\n')
    self.assertEqual(summary.non_cir_text(debug), reference)
    self.assertEqual(summary.non_cir_text(reference), reference)
    # Another AddressSanitizer report is not removed.
    other = reference + '==1==ERROR: AddressSanitizer: heap-use-after-free\n'
    self.assertEqual(summary.non_cir_text(other), other)


class FeatureBucketTest(unittest.TestCase):
  def feature(self, message: str) -> str:
    return summary.cxx_feature(summary.TestResult(
      'a.cpp', 'FAIL', 'UNSUPPORTED', message))

  def test_member_pointer_operators(self) -> None:
    for kind in ('pointer-to-data-member selection (.*)',
                 'pointer-to-data-member selection (->*)',
                 'pointer to member function selection (.*)',
                 'pointer to member function selection (->*)',
                 'call through a pointer to member (.*)',
                 'call through a pointer to member (->*)',
                 'pm base class cast', 'pm derived class cast',
                 'pointer-to-member constant'):
      message = (f'warning: CIR back end: the body of "<id>" uses the '
                 f'expression kind "{kind}", which the CIR back end does '
                 f'not support')
      self.assertEqual(self.feature(message), 'member pointers', kind)

  def test_m4_families(self) -> None:
    body = 'warning: CIR back end: the body of "<id>" uses %s, which the ' \
           'CIR back end does not support'
    cases = {
      'a virtual function': 'vtables/virtual: virtual functions and calls',
      'a virtual call': 'vtables/virtual: virtual functions and calls',
      'a constructor or destructor of a class with virtual functions or '
      'virtual bases': 'vtables/virtual: constructors and destructors of '
                       'polymorphic classes',
      'a virtual base class': 'vtables/virtual: virtual bases',
      'the delete of an object with a virtual destructor':
        'vtables/virtual: virtual functions and calls',
      'the expression kind "throw expression"': 'exceptions: throw',
      'the statement "try statement"': 'exceptions: try/catch/function-try',
      'the expression kind "typeid expression"': 'rtti: typeid',
      'the expression kind "dynamic_cast"': 'rtti: dynamic_cast',
      'the expression kind "dynamic_cast to a reference"':
        'rtti: dynamic_cast',
    }
    for what, feature in cases.items():
      self.assertEqual(self.feature(body % what), feature, what)
    for message, feature in (
        ('undefined reference to `<mangled:vtable>\'',
         'vtables/virtual: vtable, VTT and thunk symbols'),
        ('undefined reference to `<mangled:vtt>\'',
         'vtables/virtual: vtable, VTT and thunk symbols'),
        ('undefined reference to `<mangled:typeinfo>\'', 'rtti: typeinfo'),
        ('undefined reference to `__cxa_begin_catch\'',
         'exceptions: try/catch/function-try')):
      self.assertEqual(self.feature(message), feature, message)

  def test_m4_slices(self) -> None:
    for feature, slice_name in (
        ('vtables/virtual: virtual functions and calls', 'S1 polymorphism'),
        ('vtables/virtual: vtable, VTT and thunk symbols',
         'S1 polymorphism'),
        ('vtables/virtual: constructors and destructors of polymorphic '
         'classes', 'S1 polymorphism'),
        ('vtables/virtual: virtual bases', 'S2 virtual bases'),
        ('rtti: typeid', 'S3 rtti and member pointers'),
        ('rtti: typeinfo', 'S3 rtti and member pointers'),
        ('member pointers', 'S3 rtti and member pointers'),
        ('exceptions: throw', 'S4-S5 exceptions'),
        ('exceptions: try/catch/function-try', 'S4-S5 exceptions'),
        ('templates', ''), ('other', '')):
      self.assertEqual(summary.m4_slice(feature), slice_name, feature)

  def test_unrelated_messages_stay(self) -> None:
    self.assertEqual(self.feature('error: invalid type conversion'), 'other')
    self.assertEqual(
      self.feature('uses a vector type, which the CIR back end does not '
                   'support'), 'other')


class CrashSweepTest(unittest.TestCase):
  def result(self, **fields) -> dict:
    base = {'path': 'imported/gnu/cpp/cpp2a/lambda-uneval17.sft.cpp',
            'test_type': 'fp', 'variant': '-DTEST_NUMBER=1 --c++20',
            'status': 'ABORT(COMPILE)', 'bucket': 'FE_CRASH', 'message': '',
            'ref_status': '', 'crash_line': '', 'frames': [],
            'ref_crash_line': '', 'ref_frames': []}
    base.update(fields)
    return base

  def test_report(self) -> None:
    lower = ('"Test_name.c", line 7: internal error: assertion failed at: '
             '"lower_name.c", line <suppressed> in '
             'type_is_lambda_in_default_argument')
    # The reference passes: a CIR-specific crash, with a reproducer.
    cir = self.result(crash_line = lower, message = lower)
    # The reference aborts at the same place: excused.
    same = self.result(path = 'a/same.sft.cpp', ref_status = 'ABORT(COMPILE)',
                       crash_line = lower, ref_crash_line = lower,
                       message = lower)
    lib = self.result(path = 'a/lib.sft.cpp', bucket = 'LIB_CRASH',
                      status = 'ABORT(COMPILE)', ref_status = 'ABORT(COMPILE)',
                      message = 'CIR back end: internal error in the pass')
    killed = self.result(path = 'a/kill.sft.cpp', bucket = 'TIMEOUT',
                         status = 'TIMEOUT')
    both = self.result(path = 'a/both.sft.cpp', bucket = 'TIMEOUT',
                       status = 'TIMEOUT', ref_status = 'TIMEOUT')
    ok = self.result(path = 'a/ok.sft.cpp', bucket = 'PASS',
                     status = 'PASS')
    fatal_error = self.result(
      path = 'a/fatal.sft.cpp', status = 'CATASTROPHE(COMPILE)',
      crash_line = '1 catastrophic error detected in the compilation of '
                   '"Test_name.c".', message = 'CATASTROPHE')
    cir_lib_fatal = self.result(
      path = 'a/libfatal.sft.cpp', bucket = 'LIB_CRASH',
      status = 'CATASTROPHE(COMPILE)', message = 'CATASTROPHE after: '
      'warning: CIR back end: the body of "f" uses a vector type',
      crash_line = '1 catastrophic error detected in this compilation.')
    segv = self.result(path = 'a/segv.sft.cpp', status = 'ABORT(COMPILE)',
                       crash_line = 'Segmentation fault',
                       ref_status = 'ABORT(COMPILE)')
    problems, excused, fatal, counts = gate.sweep_report(
      [cir, same, lib, killed, both, ok, fatal_error, cir_lib_fatal, segv],
      'c++', 'edg_x86_64_cir', ['a/x.sft.cpp'])
    self.assertEqual(counts, {'cases': 9, 'excused': 1, 'fatal': 2,
                              'problems': 5})
    self.assertEqual(len(fatal), 2)
    self.assertIn('a/segv.sft.cpp', '\n'.join(problems))
    self.assertNotIn('a/fatal.sft.cpp', '\n'.join(problems))
    text = '\n'.join(problems)
    self.assertIn('lambda-uneval17', text)
    self.assertIn('reproduce: edg-docker-test --non-interactive --posture '
                  'cir --only-configs edg_x86_64_cir -T 180 imported/gnu/'
                  'cpp/cpp2a/lambda-uneval17.sft.cpp', text)
    self.assertIn('a/lib.sft.cpp', text)
    self.assertIn('a/kill.sft.cpp', text)
    self.assertNotIn('a/both.sft.cpp', text)
    self.assertIn('a/x.sft.cpp: cancelled by edgy', text)
    self.assertEqual(len(excused), 1)

  def test_in_the_default_steps(self) -> None:
    self.assertIn('crash-sweep', gate.STEPS)
    self.assertNotIn('crash-sweep', gate.LONG_STEPS)
    self.assertIn('crash-sweep', checkpoint.DEFAULT_STEPS)

  def test_equal_output_excuses_a_crash_with_an_identity(self) -> None:
    limit = 'Internal error: CPU time limit exceeded.\nAborted\n'
    result = result_of(limit, limit)
    excused, reason = summary.crash_excuse(result)
    self.assertTrue(excused)
    self.assertIn('output equals its recording', reason)
    # An assertion with its file and line, and a symbolized frame, count.
    assertion = DR2867_2.replace('line <suppressed>', 'line 12')
    self.assertTrue(summary.crash_excuse(result_of(assertion, assertion))[0])
    # The reference must crash too, and the crash must not be the writer's.
    self.assertFalse(summary.crash_excuse(dict(result, ref_status = ''))[0])
    self.assertFalse(summary.crash_excuse(dict(
      result, crash_line = 'internal error: assertion failed at: '
      '"ecil_write.c", line 5 in ecil_x'))[0])
    problems, excused_lines, _, counts = gate.sweep_report(
      [result], 'c', 'edg_x86_64_cir', [])
    self.assertEqual((counts['excused'], counts['problems']), (1, 0))
    self.assertIn('output equals its recording', excused_lines[0])

  def test_equal_output_never_excuses_a_bare_signal(self) -> None:
    for text in ('Segmentation fault\neccp: front end returned an exit '
                 'status of 139\n', 'Aborted\n', ''):
      result = result_of(text, text)
      self.assertEqual(result['ref_output_same'], bool(text))
      self.assertFalse(summary.crash_excuse(result)[0], text)
      self.assertFalse(summary.crash_excuse(dict(
        result, ref_output_same = True))[0], text)
    # Only the output text that proves the same crash counts: equal output
    # with a bare signal and unsymbolized frames is still no identity.
    bare = 'Segmentation fault\n    #0 0x7f1 (/lib/libc.so.6+0x1)\n'
    self.assertFalse(summary.crash_excuse(result_of(bare, bare))[0])

  def test_allowlist(self) -> None:
    with tempfile.TemporaryDirectory() as tmp:
      path = Path(tmp) / 'allow.txt'
      path.write_text(
        '# c\n'
        'a/one.sft.cpp | assertion=assertion failed at: "lower_name.c", '
        'line <suppressed> in mangled_entity_reference | same FE bug\n'
        'a/two.sft.cpp | variant=-DTEST_NUMBER=2 --c++14 | signal=SIGSEGV '
        '| reviewed\n')
      allow = gate.read_crash_allowlist(path)
      self.assertEqual(allow[('a/one.sft.cpp', '')][2], 'same FE bug')
      self.assertIn('mangled_entity_reference',
                    allow[('a/one.sft.cpp', '')][0])
      self.assertEqual(allow[('a/two.sft.cpp', '-DTEST_NUMBER=2 --c++14')],
                       ('', 'SIGSEGV', 'reviewed'))
      for bad in ('a/*.sft.cpp | pattern\n', 'a/x.sft.cpp |\n',
                  'a/x.sft.cpp\n', 'a/x[1].sft.cpp | pattern\n',
                  'a/x.sft.cpp | variant=v? | r\n',
                  'a/x.sft.cpp | nonsense | r\n',
                  'a/x.sft.cpp | r\n',
                  'a/x.sft.cpp | variant=-D1 | r\n',
                  'a/x.sft.cpp | signal=SIGNOPE | r\n',
                  'a/x.sft.cpp | signal=SIGSEGV | assertion=a | r\n'):
        path.write_text(bad)
        with self.assertRaises(ValueError):
          gate.read_crash_allowlist(path)
      path.write_text('a/one.sft.cpp | assertion=in mangled_entity_reference'
                      ' | reviewed\n'
                      'a/two.sft.cpp | variant=-DTEST_NUMBER=2 | '
                      'assertion=in mangled_entity_reference | reviewed\n')
      allow = gate.read_crash_allowlist(path)
    lower = ('"Test_name.c", line 19: internal error: assertion failed at: '
             '"lower_name.c", line <suppressed> in mangled_entity_reference')
    other = ('"Test_name.c", line 19: internal error: assertion failed at: '
             '"il.c", line <suppressed> in copy_expr_tree')
    one = self.result(path = 'a/one.sft.cpp', crash_line = lower,
                      ref_status = 'ABORT(COMPILE)',
                      ref_crash_line = 'At end of source: ' + lower[28:])
    one_other = self.result(path = 'a/one.sft.cpp', crash_line = other,
                            ref_status = 'ABORT(COMPILE)')
    two_ok = self.result(path = 'a/two.sft.cpp', variant = '-DTEST_NUMBER=2',
                         crash_line = lower, ref_status = 'ABORT(COMPILE)')
    two_other = self.result(path = 'a/two.sft.cpp',
                            variant = '-DTEST_NUMBER=3', crash_line = lower,
                            ref_status = 'ABORT(COMPILE)')
    problems, excused, _, counts = gate.sweep_report(
      [one, two_ok, two_other, one_other], 'c++', 'edg_x86_64_cir', [],
      allow)
    # one (pinned assertion matches) and two_ok are excused; two_other has
    # another variant; one_other is the allowlisted test with another crash.
    self.assertEqual((counts['excused'], counts['problems']), (2, 2))
    text = '\n'.join(problems)
    self.assertIn('TEST_NUMBER=3', text)
    self.assertIn('allowlisted for the assertion', text)
    self.assertTrue(all('allowlisted: reviewed' in e for e in excused))
    self.assertEqual(gate.sweep_report([one, two_ok], 'c++',
                                       'edg_x86_64_cir', [])[3]['problems'], 2)

  def test_checked_in_allowlist_pins_every_assertion(self) -> None:
    path = Path(__file__).resolve().parents[2] / 'tests/.edgy/filters/' \
      'cir-excused-crashes.txt'
    allow = gate.read_crash_allowlist(path)
    self.assertGreaterEqual(len(allow), 3)
    for key, (assertion, signal_name, reason) in allow.items():
      self.assertTrue(assertion or signal_name, f"{key} is not pinned")
      self.assertTrue(reason)

  def test_signal_pinned_entry(self) -> None:
    segv = ('Segmentation fault\neccp: front end returned an exit status of '
            '139\n')
    allow = {('a/sig.sft.cpp', ''): ('', 'SIGSEGV', 'bare signal, output '
                                     'equal')}
    def run(result):
      return gate.sweep_report([result], 'c', 'edg_x86_64_cir', [],
                               allow)[3]
    ok = result_of(segv, segv, path = 'a/sig.sft.cpp', signal = 'SIGSEGV')
    self.assertEqual(summary.crash_signal(segv), 'SIGSEGV')
    self.assertEqual(summary.crash_signal('x\neccp: front end returned an '
                                          'exit status of 134\n'), 'SIGABRT')
    self.assertEqual(summary.crash_signal('internal error\n'), '')
    self.assertEqual((run(ok)['excused'], run(ok)['problems']), (1, 0))
    # Another signal, differing output, a reference that does not crash,
    # another test: problems.
    other = result_of(segv, segv, path = 'a/sig.sft.cpp', signal = 'SIGABRT')
    self.assertEqual(run(other)['problems'], 1)
    differs = result_of(segv, 'Segmentation fault\nmore output\n',
                        path = 'a/sig.sft.cpp', signal = 'SIGSEGV')
    self.assertFalse(differs['ref_output_same'])
    self.assertEqual(run(differs)['problems'], 1)
    no_ref = result_of(segv, segv, path = 'a/sig.sft.cpp',
                       signal = 'SIGSEGV', ref_status = '')
    self.assertEqual(run(no_ref)['problems'], 1)
    unlisted = result_of(segv, segv, path = 'a/x.sft.cpp', signal = 'SIGSEGV')
    self.assertEqual(run(unlisted)['problems'], 1)

  def test_identity_from_the_compared_text(self) -> None:
    # The first "internal error" is in a CIR back end paragraph; the front
    # end's own crash text decides.
    text = ('Warning: CIR back end: the body of "f" hit an internal error in '
            'the pass.\n\nSegmentation fault\n')
    line, _ = summary.crash_details(text)
    self.assertEqual(line, 'Segmentation fault')
    ref = 'Segmentation fault\n'
    result = result_of(text, ref)
    self.assertTrue(result['ref_output_same'])
    self.assertFalse(summary.crash_excuse(result)[0])
    # With a real internal error line in the compared text, it is excused.
    both = ('Warning: CIR back end: the body of "f" dropped.\n\n'
            'Internal error: CPU time limit exceeded.\nAborted\n')
    self.assertTrue(summary.crash_excuse(result_of(
      both, 'Internal error: CPU time limit exceeded.\nAborted\n'))[0])



class AsmDiffTest(unittest.TestCase):
  PLAIN = '''\t.text
\t.globl\tf
\t.type\tf,@function
f:
\tpushq\t%rbp
\tmovl\t$1, %eax
\tpopq\t%rbp
\tretq
.Lfunc_end0:
\t.size\tf, .Lfunc_end0-f
'''
  UNWIND = '''\t.text
\t.globl\tf
\t.type\tf,@function
f:
\t.cfi_startproc
\tpushq\t%rbp
\t.cfi_def_cfa_offset 16
\t.cfi_offset %rbp, -16
\tmovl\t$1, %eax
\tpopq\t%rbp
\t.cfi_def_cfa %rsp, 8
\tretq
.Lfunc_end0:
\t.size\tf, .Lfunc_end0-f
\t.cfi_endproc
'''

  def directories(self, old: str, new: str) -> tuple:
    root = Path(tempfile.mkdtemp(prefix = 'cirtools.'))
    self.addCleanup(shutil.rmtree, root, ignore_errors = True)
    for name, text in (('old', old), ('new', new)):
      directory = root / name
      directory.mkdir()
      (directory / 't.c.0.s').write_text(text)
      (directory / 'manifest.json').write_text(json.dumps(
        {'t.c.0.s': {'asm': True, 'rc': 0}}))
    return root / 'old', root / 'new', root

  def test_strip_cfi(self) -> None:
    self.assertEqual(gate.strip_cfi(self.UNWIND), self.PLAIN)
    self.assertEqual(gate.strip_cfi(self.PLAIN), self.PLAIN)

  def test_only_frame_description_directives_are_stripped(self) -> None:
    kept = ('\t.cfi_personality 155, DW.ref.__gxx_personality_v0\n'
            '\t.cfi_lsda 27, .Lexception0\n'
            '\t.cfi_escape 0x2e, 0x10\n'
            '\t.cfi_signal_frame\n'
            '\t.cfi_sections .eh_frame\n')
    stripped = ''.join(f"\t.cfi_{d}\n" for d in (
      'startproc', 'endproc', 'def_cfa %rsp, 8', 'def_cfa_offset 16',
      'def_cfa_register %rbp', 'adjust_cfa_offset 8', 'offset %rbp, -16',
      'rel_offset %rbx, 8', 'register %rax, %rbx', 'restore %rbp',
      'remember_state', 'restore_state', 'undefined %rip',
      'same_value %rbx', 'window_save'))
    text = '\tpushq\t%rbp\n' + stripped + kept + '\tretq\n'
    self.assertEqual(gate.strip_cfi(text), '\tpushq\t%rbp\n' + kept +
                     '\tretq\n')
    # A difference in a personality routine stays visible.
    old, new, root = self.directories(
      self.PLAIN.replace('\tmovl', kept + '\tmovl'),
      self.PLAIN.replace('\tmovl', kept.replace('155', '156') + '\tmovl'))
    groups, _ = gate.compare_asm_dirs(old, new, root, True)
    self.assertEqual(groups['cfi'], [])
    self.assertEqual(len(groups['other']) + len(groups['symbols']), 1)

  def test_off_by_default(self) -> None:
    old, new, root = self.directories(self.PLAIN, self.UNWIND)
    groups, _ = gate.compare_asm_dirs(old, new, root)
    self.assertEqual(groups['identical'], [])
    self.assertEqual(len(groups['other']), 1)

  def test_normalized(self) -> None:
    old, new, root = self.directories(self.PLAIN, self.UNWIND)
    groups, details = gate.compare_asm_dirs(old, new, root, True)
    self.assertEqual(groups['cfi'], ['t.c.0.s'])
    self.assertEqual(groups['other'], [])
    self.assertEqual([d for d in details if not d.startswith(('ALLOCA',
                                                              '    '))], [])

  def test_normalized_keeps_real_differences(self) -> None:
    changed = self.UNWIND.replace('$1', '$2')
    old, new, root = self.directories(self.PLAIN, changed)
    groups, _ = gate.compare_asm_dirs(old, new, root, True)
    self.assertEqual(groups['cfi'], [])
    self.assertEqual(len(groups['other']), 1)

  def test_identical(self) -> None:
    old, new, root = self.directories(self.UNWIND, self.UNWIND)
    groups, _ = gate.compare_asm_dirs(old, new, root, True)
    self.assertEqual(groups['identical'], ['t.c.0.s'])


class RssGeneratorTest(unittest.TestCase):
  def test_template_tu_compiles_and_runs(self) -> None:
    compiler = shutil.which('c++') or shutil.which('g++')
    with tempfile.TemporaryDirectory() as tmp:
      source = Path(tmp) / 't.cpp'
      rss.generate_cxx_templates(3, source)
      text = source.read_text()
      for feature in ('template <class U, int M> struct Inner',
                      'constexpr int cfib', '[this, u](auto a)',
                      'int dummy[] = { 0, (r += (long)ts, 0)... };',
                      '(0L + ... + (long)ts)', 'static_assert',
                      '[k = x + 1]', 'sizeof...(Ts)', 'int... Ns'):
        self.assertIn(feature, text)
      # More units, more of the same.
      bigger = Path(tmp) / 'b.cpp'
      rss.generate_cxx_templates(6, bigger)
      self.assertGreater(len(bigger.read_text()), 1.8 * len(text))
      if compiler is None:
        self.skipTest('no C++ compiler on this host')
      binary = Path(tmp) / 't'
      proc = subprocess.run([compiler, '-std=c++17', '-Wall', '-Werror',
                             '-o', str(binary), str(source)],
                            stdout = subprocess.PIPE,
                            stderr = subprocess.STDOUT, text = True)
      self.assertEqual(proc.returncode, 0, proc.stdout)
      run = subprocess.run([str(binary)], stdout = subprocess.PIPE,
                           text = True)
      self.assertEqual(run.returncode, 0)
      self.assertRegex(run.stdout, r'^\d+\n$')


class OptPlumbingTest(unittest.TestCase):
  '''eccp's -O mapping and cpfe-cir-2p's forwarding of --cir_opt_level.'''

  def map_options(self, enabled: str, argument: str) -> str:
    '''The --cir_opt_level that eccp's cir_map_opt_level adds for the
    argument of -O (empty if none).'''
    text = (BIN.parent.parent / 'util' / 'eccp.sh').read_text()
    start = text.index('cir_map_opt_level()')
    end = text.index('}  # cir_map_opt_level', start)
    script = (text[start:end + 1] + '\nfeoptions=\ncir_map_opt_level "$1"\n'
              'printf "%s" "$feoptions"\n')
    proc = subprocess.run(
      ['sh', '-c', script, 'sh', argument], text = True,
      stdout = subprocess.PIPE, env = {**os.environ,
                                       'EDG_CIR_MAP_OPT_LEVEL': enabled})
    return proc.stdout.strip()

  def test_eccp_maps_the_levels(self) -> None:
    expected = {'': 1, '0': 0, '1': 1, '2': 2, '3': 3, '4': 3, '07': 3,
                '02': 2, 'g': 1, 's': 2, 'z': 2, 'fast': 3}
    for argument, level in expected.items():
      self.assertEqual(self.map_options('1', argument),
                       f"--cir_opt_level={level}", argument)
    # Nothing for an unknown argument, and nothing at all unless the base
    # turns the mapping on (the other configurations are unchanged).
    self.assertEqual(self.map_options('1', 'x'), '')
    self.assertEqual(self.map_options('1', '2x'), '')
    for argument in ('', '2', 'fast'):
      self.assertEqual(self.map_options('', argument), '')
      self.assertEqual(self.map_options('0', argument), '')

  def test_two_process_wrapper_forwards_the_level(self) -> None:
    with tempfile.TemporaryDirectory() as tmp:
      root = Path(tmp)
      fe = root / 'fe'
      fe.write_text('#!/bin/sh\nfor a in "$@"; do echo "$a"; done '
                    '> "$FE_ARGS"\ncat /dev/null > "$FE_STREAM_ARG"\n'
                    'for a in "$@"; do case "$a" in --ecil_output=*) '
                    ': > "${a#--ecil_output=}";; esac; done\n')
      tool = root / 'tool'
      tool.write_text('#!/bin/sh\necho "$@" > "$TOOL_ARGS"\n')
      for path in (fe, tool):
        path.chmod(0o755)
      env = {**os.environ, 'CPFE_CIR_BIN': str(fe), 'EDG_CIR_TOOL': str(tool),
             'FE_ARGS': str(root / 'fe.args'),
             'FE_STREAM_ARG': str(root / 'stream'),
             'TOOL_ARGS': str(root / 'tool.args')}

      def level(*options: str) -> str:
        subprocess.run([str(BIN / 'cpfe-cir-2p'), *options,
                        f"--gen_c_file_name={root / 'out.s'}", 'x.c'],
                       env = env, check = True)
        return (root / 'tool.args').read_text()

      self.assertIn(' -O0 ', level('-w'))
      self.assertIn(' -O2 ', level('--cir_opt_level=2', '-w'))
      # The last one wins (the options of a test follow the defaults), also
      # when the number has leading zeros.
      self.assertIn(' -O0 ', level('--cir_opt_level=2', '--cir_opt_level=0'))
      self.assertIn(' -O3 ', level('--cir_opt_level=0', '--cir_opt_level=03'))
      # The front end still gets the option and the other arguments in order.
      level('--cir_opt_level=1', '-w')
      args = (root / 'fe.args').read_text().split()
      self.assertEqual(args[0:3], ['--ecil_output=' + args[0].split('=', 1)[1],
                                   '--cir_opt_level=1', '-w'])


class CheckpointTest(unittest.TestCase):
  def test_headroom(self) -> None:
    self.assertEqual(checkpoint.headroom_gb('Avail\n 126G\n'), 126)
    self.assertEqual(checkpoint.headroom_gb('Avail\n  39G\n'), 39)
    self.assertEqual(checkpoint.headroom_gb(''), -1)
    self.assertEqual(checkpoint.headroom_gb('ssh: error\n'), -1)

  def make_tree(self, tree: Path) -> None:
    '''Entries prunetest_old1..prunetest_old5 (prunetest_old1 has a KEEP
    file), fresh1 and fresh2 (now) in every directory that can be pruned, and
    the evidence directories.'''
    directories = [*checkpoint.PRUNE_DIRS, *checkpoint.EVIDENCE_DIRS]
    for directory in directories:
      names = [f"prunetest_old{n}" for n in range(1, 6)] + ['fresh1', 'fresh2']
      for name in names:
        entry = tree / directory / name
        entry.mkdir(parents = True, exist_ok = True)
        (entry / 'f').write_text('x')
        if name.startswith('prunetest_old'):
          stamp = 1_700_000_000 + int(name[len('prunetest_old'):])
          os.utime(entry, (stamp, stamp))
    for name in [f"prunetest_old{n}" for n in range(1, 6)] + \
        ['fresh1', 'fresh2']:
      entry = tree / '.tmp' / f"checkpoint-{name}"
      entry.mkdir(parents = True, exist_ok = True)
      if name.startswith('prunetest_old'):
        stamp = 1_700_000_000 + int(name[len('prunetest_old'):])
        os.utime(entry, (stamp, stamp))
    for directory in (*checkpoint.PRUNE_DIRS, *checkpoint.EVIDENCE_DIRS):
      (tree / directory / 'prunetest_old1' / 'KEEP').write_text('')
      os.utime(tree / directory / 'prunetest_old1',
               (1_700_000_001, 1_700_000_001))
    (tree / '.tmp' / 'checkpoint-prunetest_old1' / 'KEEP').write_text('')

  def names(self, tree: Path, directory: str, pattern: str = '*') -> List[str]:
    return sorted(p.name for p in (tree / directory).glob(pattern))

  def test_prune_command(self) -> None:
    with tempfile.TemporaryDirectory() as tmp:
      tree = Path(tmp)
      self.make_tree(tree)
      # A process that uses prunetest_old3: its name is on a command line.
      # (read, not sleep: the helper must outlast a slow loaded host, and
      # killing the shell must end it.)
      user = subprocess.Popen(
        ['bash', '-c', 'read -t 300 _; : prunetest_old3 '
         'checkpoint-prunetest_old3'], stdin = subprocess.PIPE)
      self.addCleanup(user.stdin.close)
      self.addCleanup(user.kill)
      # On a loaded host the shell may not have started yet: wait until the
      # name is on a command line (pgrep -f is what prune_command asks).
      for _ in range(100):
        if subprocess.run(['pgrep', '-f', '--', 'prunetest_old3'],
                          stdout = subprocess.DEVNULL).returncode == 0:
          break
        time.sleep(0.1)
      proc = subprocess.run(
        ['bash', '-c', checkpoint.prune_command(1)], cwd = tree,
        stdout = subprocess.PIPE, text = True)
      self.assertEqual(proc.returncode, 0)
      # keep=1: the newest (fresh) survive by age; prunetest_old1 has KEEP;
      # prunetest_old3 is in use; prunetest_old2, prunetest_old4 and
      # prunetest_old5 are pruned.
      for directory in checkpoint.PRUNE_DIRS:
        self.assertEqual(self.names(tree, directory),
                         ['fresh1', 'fresh2', 'prunetest_old1',
                          'prunetest_old3'], directory)
      self.assertEqual(self.names(tree, '.tmp', 'checkpoint-*'),
                       ['checkpoint-fresh1', 'checkpoint-fresh2',
                        'checkpoint-prunetest_old1',
                        'checkpoint-prunetest_old3'])
      # The evidence directories are not touched without the option.
      for directory in checkpoint.EVIDENCE_DIRS:
        self.assertEqual(len(self.names(tree, directory)), 7, directory)
      self.assertIn('kept (KEEP marker)', proc.stdout)
      self.assertIn('kept (in use)', proc.stdout)
      self.assertEqual(proc.stdout.count('pruned'), 3 + 3)
      # With the option they are pruned like the runs.
      proc = subprocess.run(
        ['bash', '-c', checkpoint.prune_command(1, evidence = True)],
        cwd = tree, stdout = subprocess.PIPE, text = True)
      for directory in checkpoint.EVIDENCE_DIRS:
        self.assertEqual(self.names(tree, directory),
                         ['fresh1', 'fresh2', 'prunetest_old1',
                          'prunetest_old3'], directory)

  def test_protected_trees(self) -> None:
    # the trees that hold the baselines and the evidence they came from
    for tree in ('day-base', 'm5-int'):
      self.assertIn(tree, checkpoint.PROTECTED_TREES)

  def test_default_tree_is_not_stale(self) -> None:
    # The default tree is wiped and rebuilt by every checkpoint, so it may
    # not be one of the protected trees that hold gate evidence.
    self.assertEqual(checkpoint.DEFAULT_TREE, 'm6r-int')
    self.assertNotIn(checkpoint.DEFAULT_TREE, checkpoint.PROTECTED_TREES)

  def test_default_baselines_are_the_m6r_ones(self) -> None:
    text = (BIN / 'edg-cir-checkpoint').read_text()
    for name in ('m6r-base-asm', 'm6r-base-cpp-asm', 'm6r-base-perf.json',
                 'm5a-base-perf.json', 'day-base/baseline-64'):
      self.assertIn(name, text)
    self.assertNotIn('m5p-base', text)
    self.assertNotIn('m4-base', text)
    gate_text = (BIN / 'edg-cir-gate-evidence').read_text()
    for name in ('m6r-base-perf.json', 'm6r-base-status', 'm6r-base-asm',
                 'm6r-base-cpp-asm', 'm5a-base-perf.json',
                 'day-base/baseline-64'):
      self.assertIn(f"~/edg-cir-config/{name}", gate_text)
    self.assertNotIn('m5p-base-status', gate_text)
    self.assertNotIn('~/edg-cir-config/m4-base', gate_text)
    self.assertEqual(checkpoint.DAY_BASELINE, gate.DEFAULT_DAY_BASELINE)


class RssCeilings(unittest.TestCase):
  def test_the_ceilings_are_the_m5p_measurements_plus_a_quarter(self) -> None:
    # The C rows are the M5.1 values (decision 56; the release in-process and
    # keep rows the M6.R gate's), the others the M5p ones.
    measured = {('c', 'asan', 'inproc'): 438, ('c', 'asan', 'keep'): 571,
                ('c', 'asan', '2p-fe'): 113, ('c', 'asan', '2p-edg-cir'): 232,
                ('c', 'release', 'inproc'): 253,
                ('c', 'release', 'keep'): 344,
                ('c', 'release', '2p-fe'): 65,
                ('c', 'release', '2p-edg-cir'): 232,
                ('tmpl', 'asan', 'inproc'): 988,
                ('tmpl', 'asan', 'keep'): 1030}
    for key, megabytes in measured.items():
      ceiling = gate.RSS_CEILINGS_MB[key]
      self.assertGreaterEqual(ceiling, 1.25 * megabytes, key)
      self.assertLess(ceiling, 1.25 * megabytes + 10, key)
      self.assertEqual(ceiling % 10, 0, key)

  def test_every_row_has_a_ceiling(self) -> None:
    self.assertEqual(len(gate.RSS_CEILINGS_MB), 24)

  def test_the_m5p_run_passes_its_own_ceilings(self) -> None:
    rows = {
      ('c', 'asan'): (438, 573, 113, 232),
      ('cxx', 'asan'): (299, 317, 109, 153),
      ('tmpl', 'asan'): (988, 1030, 502, 355),
      ('c', 'release'): (253, 344, 65, 232),
      ('cxx', 'release'): (191, 204, 61, 153),
      ('tmpl', 'release'): (687, 711, 353, 355)}
    text = ''
    for (workload, build), values in rows.items():
      text += f"== RSS {workload} {build}\n"
      for name, value in zip(gate.RSS_ROWS, values):
        text += f"{name} 1.00 {value} 0\n"
    ok, detail = gate.judge_rss(text, gate.RSS_CEILINGS_MB)
    self.assertTrue(ok, detail)


class LeanSteps(unittest.TestCase):
  def test_toolchain_matches_the_m5p_set(self):
    steps, reasons = gate.lean_steps(['toolchain'])
    self.assertEqual(set(steps), {
      'build', 'ctest', 'smoke', 'cpp-smoke', 'cir-suite', 'corpus',
      'cpp-corpus', 'opt-corpus', 'asm-diff', 'cpp-asm-diff', 'mixed-tu',
      'symbols', 'eh-probes', 'm4-stress', 'cpp-stress', 'crash-sweep',
      'perf', 'rss', 'stress', 'release-smoke', 'support-sweep'})
    self.assertIn('compare-modes', reasons['modes'])
    self.assertIn('compare-modes', reasons['cpp-modes'])
    self.assertIn('ASan preset', reasons['cpp-stress-asan'])
    self.assertNotIn('stress', reasons)
    self.assertNotIn('release-smoke', reasons)
    self.assertEqual(set(steps) | set(reasons), set(gate.STEPS))

  def test_areas_combine_in_step_order(self):
    steps, reasons = gate.lean_steps(['linkage', 'fe-options'])
    self.assertEqual(steps, ['build', 'release-smoke', 'symbols', 'mixed-tu'])
    self.assertIn('linkage', reasons['smoke'])

  def test_tooling_alone_needs_no_build(self):
    self.assertEqual(gate.lean_steps(['tooling'])[0], ['tools-test'])

  def test_every_mapped_step_exists(self):
    for steps in gate.AREA_STEPS.values():
      for step in steps:
        self.assertIn(step, gate.STEPS)
        self.assertIn(step, gate.STEP_FUNCTIONS)


class LeanAreas(unittest.TestCase):
