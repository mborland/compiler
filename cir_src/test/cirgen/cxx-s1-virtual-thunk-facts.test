ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S1 review): a translation unit that defines only overriders
; (C::g and the covariant C::h of C : A1, A2); C's key function f, its vtable
; and the rest are in the g++/clang unit (Inputs/s1_thunk_facts_host.cpp).  The
; definition of a virtual function sends the vtable facts of its class, so this
; unit emits the thunks to its overriders (_ZThn16_N1C1gEi, _ZThn16_N1C1hEv)
; that the other unit's vtable of C refers to.
;   struct A2 { virtual int g(int); virtual R0 *h(); };
;   struct C : A1, A2 { int f() override; int g(int) override; R1 *h() override; };
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: g++ -c %S/Inputs/s1_thunk_facts_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s1_thunk_facts_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS

; SYMS-DAG: T _ZThn16_N1C1gEi
; SYMS-DAG: T _ZThn16_N1C1hEv

