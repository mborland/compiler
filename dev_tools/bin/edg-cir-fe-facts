SAMPLE_CLANG = '''## record struct A
0 | struct A
0 |   (A vtable pointer)
  | [sizeof=8, dsize=8, align=8,
  |  nvsize=8, nvalign=8]
## record struct B
0 | struct B
0 |   struct A (primary base)
0 |     (A vtable pointer)
  | [sizeof=8, dsize=8, align=8,
  |  nvsize=8, nvalign=8]
## vtable A (4 entries)
0 | offset_to_top (0)
1 | A RTTI
    -- (A, 0) vtable address --
2 | int A::f()
3 | A::~A() [complete]
4 | A::~A() [deleting]
## vtable B (4 entries)
0 | offset_to_top (0)
1 | B RTTI
    -- (A, 0) vtable address --
    -- (B, 0) vtable address --
2 | int B::f()
3 | A::~A() [complete]
4 | A::~A() [deleting]
## vtable-indices A (3 entries)
0 | int A::f()
1 | A::~A() [complete]
2 | A::~A() [deleting]
## vtable-indices B (1 entries)
0 | int B::f()
'''


class SelfTest(unittest.TestCase):
  def test_clang_ir_timeout_is_a_failure(self) -> None:
    class Stub:
      class abi:
        @staticmethod
        def canonical(text: str) -> str:
          return text
      def fe_il(self, source, work):
        return SAMPLE_IL
      def clang_dump(self, source):
        return 0, ''
      def clang_ir(self, source):
        raise subprocess.TimeoutExpired('clang', 600)
    result, message = check_one(Stub(), Path('t.cpp'))
    self.assertIn('timed out', message)
    self.assertIn('not compared', message)

  def test_complex_spelling(self) -> None:
    self.assertEqual(normalize_params('X, float __complex__, Small'),
                     normalize_params('X, _Complex float, Small'))
    self.assertEqual(normalize_params('double __complex__ *'),
                     normalize_params('_Complex double *'))

  def test_parse_il(self) -> None:
    entries = parse_il(SAMPLE_IL)
    self.assertEqual(entries['a1'].get('size'), '8')
    self.assertEqual(entries['n1'.replace('n1', 'a1')].get(
      'source_corresp.name'), 'file-scope id-name@n1: "A"')
    self.assertEqual(entries['s1'].get('highest_virtual_function_number'),
                     '2')
    self.assertTrue(entries['a1'].flag(
      'any_virtual_functions_including_in_base_classes'))
    self.assertEqual(pointer('file-scope routine@r1: f'),
                     ('routine', 'r1', 'f'))
    self.assertIsNone(pointer('NULL'))

  def test_facts(self) -> None:
    facts = FeFacts(parse_il(SAMPLE_IL))
    by_name = facts.by_name()
    a, b = by_name['A'][0], by_name['B'][0]
    self.assertEqual([(f.name, f.number, f.dtor) for f in a.functions],
                     [('f', 0, False), ('~A', 1, True)])
    self.assertEqual(b.primary, 'A')
    self.assertEqual(b.vptr_base, 'A')
    self.assertEqual(len(b.bases[0].overriders), 1)
    self.assertEqual(b.bases[0].overriders[0].over.key(), 'B::f()')
    self.assertEqual(key_function(a).name, 'f')
    self.assertIsNone(key_function(FeClass(Entry('type', 'x'), 'x')))

  def test_key_function(self) -> None:
    def make(*specs):
      cls = FeClass(Entry('type', 'x'), 'K')
      cls.own_virtual = True
      for index, flags in enumerate(specs):
        entry = Entry('routine', f"r{index}")
        entry.fields['is_virtual'] = 'TRUE'
        for flag in flags:
          entry.fields[flag] = 'TRUE'
        cls.functions.append(FeFunction(entry, 'K', f"f{index}", ''))
      return cls
    self.assertEqual(key_function(make([], [])).name, 'f0')
    self.assertEqual(key_function(make(['pure_virtual'], [])).name, 'f1')
    self.assertEqual(key_function(make(['inline_in_class_definition',
                                        'is_inline'], [])).name, 'f1')
    # Inline later (flag set, not in the class): no key function.
    self.assertIsNone(key_function(make(['is_inline'], [])))
    self.assertIsNone(key_function(make(['compiler_generated'])))

  def test_function_keys(self) -> None:
    self.assertEqual(clang_function_key('int A::f()'), 'A::f()')
    self.assertEqual(clang_function_key('A::~A() [complete]'),
                     'A::~A()#complete')
    self.assertEqual(clang_function_key('void ns::A::g(int, char) const'),
                     'ns::A::g(int,char;const)')
    self.assertEqual(clang_function_key('N::B::~B() [complete] [pure]'),
                     'N::B::~B()#complete')
    self.assertEqual(clang_function_key('N::A &N::A::operator=(const A &)'),
                     'N::A::operator=(const A &)')
    self.assertEqual(clang_function_key('A *A::getThis()'), 'A::getThis()')
    self.assertEqual(clang_function_key('d::operator int()'),
                     'd::operator int()')
    self.assertEqual(
      clang_function_key('std::vector<int> N::T<int, char>::f()'),
      'N::T<int, char>::f()')
    self.assertEqual(signature_params('void (int, char) const noexcept'),
                     'int,char;const')
    self.assertEqual(signature_params('int ()'), '')
    self.assertEqual(demangle_simple('1A'), 'A')
    self.assertEqual(demangle_simple('N2ns1AE'), 'A')

  def test_compare_agrees_and_finds(self) -> None:
    facts = FeFacts(parse_il(SAMPLE_IL))
    records, vtables = parse_clang(SAMPLE_CLANG)
    result = compare_file('x', facts, records, vtables,
                          {'A': 'external', 'B': 'external'})
    self.assertEqual(result.problems, [])
    self.assertEqual(result.classes, 2)
    self.assertGreater(result.agree, 10)
    # A wrong number is found.
    bad = SAMPLE_IL.replace('number.virtual_function: 1',
                            'number.virtual_function: 2')
    result = compare_file('x', FeFacts(parse_il(bad)), records, vtables, {})
    self.assertTrue(result.problems)
    # A different final overrider is found.
    other = SAMPLE_CLANG.replace('2 | int B::f()', '2 | int A::f()')
    records, vtables = parse_clang(other)
    result = compare_file('x', facts, records, vtables, {})
    self.assertTrue(any('slot 0' in text for _, text in result.problems))


def main() -> None:
  parser = argparse.ArgumentParser(
    description = __doc__.split('\n')[0],
    formatter_class = argparse.RawDescriptionHelpFormatter,
    epilog = __doc__.split('\n', 2)[2]
  )
  parser.add_argument('command', nargs = '?', choices = ('facts', 'check'))
  parser.add_argument('files', nargs = '*')
  parser.add_argument('--list', default = '',
                      help = 'a file that lists the files to check')
  parser.add_argument('--il-file', default = '',
                      help = 'facts: an --il_display output to read')
  parser.add_argument('--std', default = 'c++17')
  parser.add_argument('--fe-opts', default = '')
  parser.add_argument('--fe-build', default = 'build/gcc-cir')
  parser.add_argument('--clang', default = '')
  parser.add_argument('--root', default = '.')
  parser.add_argument('--json', default = '',
                      help = 'check: write the results as JSON')
  parser.add_argument('-v', dest = 'verbose', action = 'store_true')
  parser.add_argument('--self-test', action = 'store_true')
  args = parser.parse_args()

  if args.self_test:
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(SelfTest)
    result = unittest.TextTestRunner(verbosity = 1).run(suite)
    sys.exit(0 if result.wasSuccessful() else 1)
  if not args.command:
    parser.error('a command or --self-test is required')
  files = list(args.files)
  if args.list:
    files += [l.strip() for l in Path(args.list).read_text().splitlines()
              if l.strip() and not l.startswith('#')]
  if args.command == 'facts' and args.il_file:
    print_facts(FeFacts(parse_il(Path(args.il_file).read_text())))
    return
  if not files:
    parser.error('a C++ file is required')
  runner = Runner(Path(args.root).resolve(), args.std, args.fe_build,
                  args.fe_opts.split(), args.clang)
  if args.command == 'facts':
    for name in files:
      with tempfile.TemporaryDirectory(prefix = 'edg-cir-fe-facts.') as tmp:
        il = runner.fe_il(Path(name).resolve(), Path(tmp))
      print_facts(FeFacts(parse_il(il)))
    return
  total = Result('total')
  rows = []
  failed_setup = 0
  report: List[dict] = []
  for name in files:
    try:
      result, message = check_one(runner, Path(name).resolve())
    except (subprocess.TimeoutExpired, KeyError, OSError) as error:
      result, message = Result(name), f"error: {error!r}"
    if message:
      failed_setup += 1
      rows.append((name, '-', '-', '-', message))
      report.append({'file': name, 'setup': message})
      continue
    rows.append((name, str(result.classes), str(result.checks),
                 str(len(result.problems)),
                 '; '.join(result.skipped[:2])))
    total.classes += result.classes
    total.checks += result.checks
    total.agree += result.agree
    total.problems += [(f"{name}:{c}", t) for c, t in result.problems]
    report.append({'file': name, 'classes': result.classes,
                   'checks': result.checks, 'agree': result.agree,
                   'kinds': result.kinds,
                   'problems': result.problems, 'notes': result.notes,
                   'skipped': result.skipped})
    for cls, text in result.problems:
      print(f"DISAGREE {name} {cls}: {text}", flush = True)
    if args.verbose:
      for note in result.notes:
        print(f"note {name}: {note}")
  print(f"{'file':<48}{'classes':>8}{'checks':>8}{'disagree':>9}  notes")
  for name, classes, checks, bad, note in rows:
    print(f"{name[-47:]:<48}{classes:>8}{checks:>8}{bad:>9}  {note}")
  print(f"{len(files)} files ({failed_setup} not checked), {total.classes} "
        f"classes, {total.checks} checks, {total.agree} agreements, "
        f"{len(total.problems)} disagreements")
  if args.json:
    Path(args.json).write_text(json.dumps(report, indent = 1))
  sys.exit(1 if total.problems else (2 if failed_setup == len(files) else 0))


if __name__ == '__main__':
  main()
