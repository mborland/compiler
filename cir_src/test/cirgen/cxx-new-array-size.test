; C++ (ECIL v1, slice S4): NEW_ARRAY_SIZE gives SIZE_MAX for a negative
; signed count (also when the arithmetic would not overflow: new char[-2]) and
; for an overflowing size. Counts wider than 64 bits cannot occur (such integer
; types are unsupported). operator new[] just receives SIZE_MAX: no exception
; machinery is needed with exceptions off.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: cir.cmp lt
; CHECK-DAG: cir.cmp ne

frame DECLS
  STR 11 "szc"
  STR 12 "szl"
  STR 14 "szu"
  STR 15 "main"
  TY_FUNC 91 2 0 [4]
  TY_FUNC 92 2 0 [3]
  TY_FUNC 94 2 0 [2]
  TY_FUNC 95 1 0 []
  DECL_FUNC 100 91 0 1 11
  DECL_FUNC 101 92 0 1 12
  DECL_FUNC 103 94 0 1 14
  DECL_FUNC 104 95 0 9 15
frame REGION
  FUNC_BEGIN 100 0
  PARAM 1 4 4 nil 0
  LREF 1
  LOAD 0
  NEW_ARRAY_SIZE 4 0
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 101 0
  PARAM 1 3 3 nil 0
  LREF 1
  LOAD 0
  NEW_ARRAY_SIZE 1 8
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 103 0
  PARAM 1 2 2 nil 0
  LREF 1
  LOAD 0
  NEW_ARRAY_SIZE 1 0
  RETURN_STMT true
  FUNC_END 0
  FUNC_BEGIN 104 0
  ; new char[-2] / new char[5]: negative signed count, no multiplication overflow
  CONST_INT 4 -2
  CALL 100 91 1 0
  CONST_INT 2 -1
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 1
  RETURN_STMT true
  IF_END
  CONST_INT 4 5
  CALL 100 91 1 0
  CONST_INT 2 5
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 2
  RETURN_STMT true
  IF_END
  ; 64-bit signed: -1 and a small count with a 4-byte element and cookie 8
  CONST_INT 3 -1
  CALL 101 92 1 0
  CONST_INT 2 -1
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 3
  RETURN_STMT true
  IF_END
  CONST_INT 3 3
  CALL 101 92 1 0
  CONST_INT 2 20
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 4
  RETURN_STMT true
  IF_END
  ; unsigned: a huge count with a 4-byte element overflows
  CONST_INT 2 4611686018427387904
  CALL 103 94 1 0
  CONST_INT 2 -1
  CMP 5
  IF_BEGIN 0
  CONST_INT 1 5
  RETURN_STMT true
  IF_END
  CONST_INT 1 0
  RETURN_STMT true
  FUNC_END 0
frame END
  END auto 0
