; A pointer to data member constant whose offset names no member of the
; class's type (the member type selects among the members at one offset): a
; format error, not a wrong constant.
; RUN: cat %S/Inputs/header12_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s

; CHECK: error [1001]: no data member of that type at offset 2 of the class (G-id {{[0-9]+}}) of a pointer to data member constant

frame DECLS
  STR 100 "S"
  STR 101 "m"
  STR 102 "g"
  TY_RECORD_DECL 201 0 100
  TY_RECORD_BODY 201 8 8 4 0 2
  REC_FIELD 1 0 nil nil 101 0
  REC_FIELD 1 4 nil nil 101 0
  TY_DATA_MEMBER 202 1 201
  DECL_VAR 300 202 0 1 8 102
  C_DATA_MEMBER 202 2
  VAR_INIT 300
frame END
  END auto 0
