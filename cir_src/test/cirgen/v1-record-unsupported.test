; ECIL v1 (C++) records are decoded and validated but not implemented yet:
; the emitter reports "not supported" (status 4), never a crash or a silent
; miscompile.
; RUN: cat %S/Inputs/header08.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 4'

; CHECK: FULLEXPR_BEGIN: C++ records (ECIL v1) are not supported yet

frame DECLS
  STR 10 "f"
  TY_FUNC 21 11 0 []
  DECL_FUNC 40 21 0 1 10
frame REGION
  FUNC_BEGIN 40 0
  FULLEXPR_BEGIN
  FULLEXPR_END
  FUNC_END 1
frame END
  END auto 0
