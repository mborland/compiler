; Floating point: arithmetic, conversions, comparisons (NaN), x87 long double.
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe -lm
; RUN: %t.exe

; CHECK-DAG: cir.fadd {{.*}} : !cir.double
; CHECK-DAG: cir.fmul {{.*}} : !cir.float
; CHECK-DAG: cir.fdiv
; CHECK-DAG: cir.fsub
; CHECK-DAG: cir.fneg
; CHECK-DAG: cir.cast float_to_int
; CHECK-DAG: cir.cast int_to_float
; CHECK-DAG: cir.cast floating
; CHECK-DAG: cir.cast float_to_bool
; CHECK-DAG: !cir.long_double<!cir.f80>

