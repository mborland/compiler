frame REGION supp
  STR 15 "Pair"
  TY_RECORD_DECL 12 0 15
  TY_FUNC 13 3 0 [12, 7] supp{15: 4}
  TY_RECORD_BODY 12 16 16 8 0 2
  REC_FIELD 3 0 nil nil 7 0
  REC_FIELD 3 8 nil nil 8 0
  STR 16 "_Z6takesp4PairRi"
  DECL_FUNC 14 13 0 0 16
  DECL_FUNC 14 13 0 1 16
  STR 17 "p"
  FUNC_BEGIN 14 0
  PARAM 1 12 12 17 0
