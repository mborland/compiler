; RUN: %edg-cir --emit=obj -O2 --verify-each -o %t2.o %t.ecil
; RUN: g++ %S/Inputs/s4_eh_std_host.cpp %S/Inputs/s4_eh_std_ref.cpp %t2.o -Wl,--wrap=__cxa_free_exception -o %t2.exe
; RUN: %t2.exe

