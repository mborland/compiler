ecil 1.2 features=0x0000000a
; C++ (ECIL 1.2, slice S1 review): the stream holds only the vtable facts
; (CLASS_INFO, CLASS_BASES, CLASS_VFUNCS, CLASS_OVERRIDES) and the definitions
; of two overriders (C::g, C::k of C : A1, A2): no virtual destructor (so no
; STRUCTOR_DELETING), no constructor or VPTR_INIT, no DECL_ABI_DATA.  Only the
; vtable facts make finish emit the this-adjusting thunks _ZThn16_N1C1gEi and
; _ZThn16_N1C1kEv, which the vtable of C in the g++ and clang unit
; (Inputs/s1_thunk_only_host.cpp, key function C::f) refers to.
; RUN: %ecil-asm %s -o %t.ecil
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: nm %t.o | %FileCheck %s --check-prefix=SYMS
; RUN: g++ -c %S/Inputs/s1_thunk_only_host.cpp -o %t.host.o
; RUN: g++ %t.host.o %t.o -o %t.exe
; RUN: %t.exe
; RUN: %clang -x c++ -std=c++17 -fno-exceptions -c %S/Inputs/s1_thunk_only_host.cpp -o %t.hostclang.o
; RUN: g++ %t.hostclang.o %t.o -o %t.clang.exe
; RUN: %t.clang.exe

; SYMS-DAG: T _ZN1C1gEi
; SYMS-DAG: T _ZN1C1kEv
; SYMS-DAG: T _ZThn16_N1C1gEi
; SYMS-DAG: T _ZThn16_N1C1kEv
; SYMS-NOT: _ZTV
; SYMS-NOT: _ZN1C1fEv
frame HEADER
  STR 1 "x86_64-unknown-linux-gnu"
  STR 2 ""
  STR 3 "EDG C/C++ front end 7.0 (ECIL writer)"
  STR 4 "m2_lib.cpp"
  TY_INT 1 32 true 4 4
  TY_INT 2 64 false 8 8
  TY_INT 3 64 true 8 8
  HDR_TARGET 1 2 nil 64 64 6
  HDR_LANG 1 201703 12
  HDR_PRODUCER 3 4
  HDR_TYPE_ROLE 3 1
  HDR_TYPE_ROLE 1 2
  HDR_TYPE_ROLE 2 3
frame REGION
  STR 5 "A1"
  TY_RECORD_DECL 4 0 5
  TY_PTR 5 4
  TY_FUNC 6 1 0 [5]
  TY_VPTR 7
  STR 6 "a1"
  TY_RECORD_BODY 4 16 12 8 4 2
  REC_FIELD 7 0 nil nil nil 1
  REC_FIELD 1 8 nil nil 6 0
  STR 7 "2A1"
  CLASS_MANGLE 4 7
  CLASS_INFO 4 12 8 nil 1
  CLASS_BASES 4 []
  STR 8 "_ZN2A11fEv"
  DECL_FUNC 8 6 0 2 8
  DECL_FUNC 8 6 3 67 8
  CLASS_VFUNCS 4 [8, 0, 0, 1]
  CLASS_OVERRIDES 4 []
  STR 9 "this"
  FUNC_BEGIN 8 0
  PARAM 1 5 5 9 1
  BLOCK_BEGIN
  CONST_INT 1 1
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION
  STR 10 "A2"
  TY_RECORD_DECL 9 0 10
  TY_PTR 10 9
  TY_FUNC 11 1 0 [10, 1]
  STR 11 "a2"
  TY_RECORD_BODY 9 16 12 8 4 2
  REC_FIELD 7 0 nil nil nil 1
  REC_FIELD 1 8 nil nil 11 0
  STR 12 "2A2"
  CLASS_MANGLE 9 12
  CLASS_INFO 9 12 8 nil 2
  CLASS_BASES 9 []
  STR 13 "_ZN2A21gEi"
  DECL_FUNC 12 11 0 2 13
  DECL_FUNC 12 11 3 67 13
  TY_FUNC 13 1 0 [10]
  STR 14 "_ZN2A21kEv"
  DECL_FUNC 14 13 0 2 14
  CLASS_VFUNCS 9 [12, 0, 0, 2, 14, 1, 0, 3]
  CLASS_OVERRIDES 9 []
  FUNC_BEGIN 12 0
  PARAM 1 10 10 9 1
  PARAM 2 1 1 nil 0
  BLOCK_BEGIN
  CONST_INT 1 2
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION
  DECL_FUNC 14 13 3 67 14
  FUNC_BEGIN 14 0
  PARAM 1 10 10 9 1
  BLOCK_BEGIN
  CONST_INT 1 3
  RETURN_STMT true
  BLOCK_END
  FUNC_END 0
frame REGION
  STR 15 "C"
  TY_RECORD_DECL 15 0 15
  TY_PTR 16 15
  TY_FUNC 17 1 0 [16, 1]
  TY_RECORD_BODY 15 32 28 8 4 2
  REC_FIELD 4 0 nil nil nil 17
  REC_FIELD 9 16 nil nil nil 17
  STR 16 "1C"
  CLASS_MANGLE 15 16
  CLASS_INFO 15 28 8 0 3
  CLASS_BASES 15 [0, 1, 1, 1]
  STR 17 "_ZN1C1gEi"
  DECL_FUNC 18 17 0 0 17
  DECL_FUNC 18 17 0 1 17
  TY_FUNC 19 1 0 [16]
  STR 18 "_ZN1C1fEv"
  DECL_FUNC 20 19 0 0 18
  STR 19 "_ZN1C1kEv"
