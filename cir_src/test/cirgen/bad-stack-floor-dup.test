; Stack floor: DUP may not copy a value of an enclosing construct.
; RUN: cat %S/Inputs/header.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %not %edg-cir --emit=cir %t.ecil 2>&1 | %FileCheck %s
; RUN: sh -c '%edg-cir --emit=cir %t.ecil > /dev/null 2>&1; test $? -eq 2'

; CHECK: DUP below the value base of the innermost construct

frame DECLS
  STR 10 "f"
  TY_FUNC 21 11 0 []
  DECL_FUNC 40 21 0 1 10
frame REGION
  FUNC_BEGIN 40 0
  CONST_INT 1 1
  FULLEXPR_BEGIN
  DUP
  FULLEXPR_END
  DROP
  FUNC_END 1
frame END
  END auto 0
