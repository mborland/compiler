; Lazy emission: a function-local static whose owner nothing calls goes with the
; owner.  The body of _Z2h2v (internal here, uninstantiated by main) is deferred
; and never replayed, so neither the function nor the static it initializes
; (_ZZ2h2vE2lr and its temporary _ZGRZ2h2vE2lr_) is emitted, while the owner
; _Z1hv that main calls (external, eager) keeps its statics.  An eager run
; emits all of them.  Derived from cxx-static-init.test.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --stats --emit=cir -o %t.lazy.cir %t.ecil 2> %t.err
; RUN: %FileCheck %s --check-prefix=LAZY --implicit-check-not=_Z2h2v --implicit-check-not=_ZZ2h2vE2lr < %t.lazy.cir
; RUN: %FileCheck %s --check-prefix=STATS < %t.err
; RUN: %edg-cir --eager-bodies --emit=cir -o %t.eager.cir %t.ecil
; RUN: %FileCheck %s --check-prefix=EAGER < %t.eager.cir
; RUN: %edg-cir --emit=asm -o %t.lazy.s %t.ecil
; RUN: %edg-cir --eager-bodies --emit=asm -o %t.eager.s %t.ecil
; RUN: cmp %t.lazy.s %t.eager.s

; LAZY-DAG: cir.local_init static_local @_ZZ1hvE2ls
; LAZY-DAG: cir.get_global static_local @_ZZ1hvE1x
; STATS: stats: lazy bodies: 1 deferred, 0 replayed, 1 dropped
; EAGER-DAG: cir.func {{.*}}@_Z2h2v
; EAGER-DAG: cir.register_exit_dtor @_ZGRZ2h2vE2lr_

