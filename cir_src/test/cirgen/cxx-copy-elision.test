; C++ (ECIL v1, slice S1): copy elision through CallConvLowering.  A has a
; user-provided copy constructor, so it is NONTRIVIAL_ABI (passed and returned
; indirectly) although its destructor is trivial.  The program records the
; address every constructor ran at and checks that it is the address of the
; object that ends up in the caller, with no copy constructor call:
;   A make(int x) { return A(x); }          // RETURN_SLOT ... RETURN_FROM_SLOT
;   A chain(int x) { return make(x); }
;   A nrvo(int x) { A a(x); return a; }     // LOCAL(RETURN_SLOT)
;   int take(A a);                          // the parameter is the caller's temporary
;   main: A a = make(5); A b = chain(6); A c = nrvo(7); take(A(8)); take(make(9));
; The constructor is declared as a STRUCTOR pair: C1 (G 101) is an alias of C2.
; RUN: cat %S/Inputs/header08_cxx.txt %s > %t.txt
; RUN: %ecil-asm %t.txt -o %t.ecil
; RUN: %edg-cir --emit=cir %t.ecil | %FileCheck %s
; RUN: %edg-cir --emit=obj -o %t.o %t.ecil
; RUN: gcc %t.o -o %t.exe
; RUN: %t.exe

; CHECK-DAG: A = #cir.record_layout<arg_passing_kind = cannot_pass_in_regs, has_trivial_dtor = true, record_align = 4>
; CHECK-DAG: cir.func private @_ZN1AC1Ei(!cir.ptr<!rec_A>{{.*}}, !s32i{{.*}}) alias(@_ZN1AC2Ei)
; CHECK-DAG: cir.func private @_ZN1AC1ERKS_(!cir.ptr<!rec_A>{{.*}}, !cir.ptr<!rec_A>{{.*}}) alias(@_ZN1AC2ERKS_)
; CHECK-LABEL: cir.func {{.*}}@_Z4makei(%arg0: !s32i{{.*}}) -> !rec_A
; CHECK: %[[R:[0-9]+]] = cir.alloca "__retval"
; CHECK: cir.call @_ZN1AC1Ei(%[[R]], {{.*}}) nothrow
; CHECK: cir.load {{.*}}%[[R]]
; CHECK: cir.return
; CHECK-LABEL: cir.func {{.*}}@_Z5chaini(%arg0: !s32i{{.*}}) -> !rec_A
; CHECK: cir.alloca "__retval"
; CHECK: cir.call @_Z4makei({{.*}}) nothrow : (!s32i{{.*}}) -> !rec_A
; CHECK-NEXT: cir.store
; CHECK-LABEL: cir.func {{.*}}@_Z4nrvoi(%arg0: !s32i{{.*}}) -> !rec_A
; CHECK: %[[N:[0-9]+]] = cir.alloca "__retval"
; CHECK: cir.call @_ZN1AC1Ei(%[[N]], {{.*}})
; CHECK-LABEL: cir.func {{.*}}@main
; CHECK: cir.call @_Z4makei({{.*}}) nothrow : (!s32i{{.*}}) -> !rec_A
; CHECK-NEXT: cir.store

frame DECLS
  STR 11 "A"
  STR 12 "_ZN1AC2Ei"
  STR 13 "_ZN1AC1Ei"
  STR 14 "_ZN1AC2ERKS_"
  STR 15 "_ZN1AC1ERKS_"
  STR 16 "_Z4makei"
  STR 17 "_Z5chaini"
  STR 18 "_Z4nrvoi"
  STR 19 "_Z4take1A"
  STR 20 "main"
  STR 21 "g_this"
  STR 22 "g_param"
  STR 23 "g_copies"
  STR 24 "this"
  STR 25 "x"
  STR 26 "a"
  STR 27 "src"
  TY_RECORD_DECL 31 0 11
  TY_RECORD_BODY 31 4 4 4 4 1
  REC_FIELD 1 0 nil nil nil 0
  TY_PTR 32 31
  TY_FUNC 33 11 0 [32, 1]
  TY_FUNC 34 11 0 [32, 32]
  TY_FUNC 35 31 0 [1]
  TY_FUNC 36 1 0 [31]
  TY_FUNC 37 1 0 []
