{
  "config": {
    "c": {
      "bin_path_env": [
        "CPFE"
      ],
      "variants": [
        {
          "name": "edg_x86_64"
        },
        {
          "name": "edg_x86_32"
        }
      ]
    },
    "cpp": {
      "bin_path_env": {
        "c": [
          "CPFE"
        ],
        "cpp": [
          "CPFE_CP"
        ]
      },
      "variants": [
        {
          "name": "edg_x86_64_cp"
        },
        {
          "name": "edg_x86_32_cp"
        }
      ]
    },
    "cir": {
      "bin_path_env": [
        "CPFE_CIR"
      ],
      "sidecar_env": [
        "EDG_CIR_LIB"
      ],
      "variants": [
        {
          "name": "edg_x86_64_cir"
        },
        {
          "name": "edg_x86_64_cir_2p",
          "two_process": true
        }
      ]
    }
  },
  "config_sets": {
    "default": [
      "edg_x86_64",
      "edg_x86_64_cp"
    ],
    "x86": [
      "edg_x86_64",
      "edg_x86_64_cp",
      "edg_x86_32",
      "edg_x86_32_cp"
    ],
    "cir": [
      "edg_x86_64_cir",
      "edg_x86_64_cir_2p"
    ]
  },
  "test_suites": {
    "primary": [
      "sandbox",
      "changes",
      "regressions",
      "edg",
      "cwg",
      "stdlib",
      "modules",
      "reflections",
      "imported"
    ],
    "secondary": [
      "cir"
    ]
  }
}
